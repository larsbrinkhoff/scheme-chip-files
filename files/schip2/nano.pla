(field 00000020000000000       (TO-TYPE-STACK BIT 1 37 NIL))
(field 00000040000000000       (FROM-STACK BIT 1 40 NIL))
(field 00000100000000000       (TO-INTERMEDIATE-ARGUMENT BIT 1 41 NIL))
(field 00000200000000000       (FROM-INTERMEDIATE-ARGUMENT BIT 1 42 NIL))
(field 00000400000000000       (TO-DISPLAY BIT 1 43 NIL))
(field 00001000000000000       (FROM-DISPLAY BIT 1 44 NIL))
(field 00002000000000000       (TO-ARGS BIT 1 45 NIL))
(field 00004000000000000       (FROM-ARGS BIT 1 46 NIL))
(field 00010000000000000       (TO-MEMTOP BIT 1 47 NIL))
(field 00020000000000000       (FROM-MEMTOP BIT 1 50 NIL))
(field 00040000000000000       (FROM-NIL BIT 1 51 NIL))
(field 00100000000000000       (READ BIT 1 52 NIL))
(field 00200000000000000       (MERGE-MARK-1 BIT 1 53 NIL))
(field 00400000000000000       (MERGE-MARK-0 BIT 1 54 NIL))
(field 01000000000000000       (SET-GC-NEEDED-IF-ADDRESS-NEWCELL=BUS BIT 1 55 NIL))
(field 02000000000000000       (CLR-GC-NEEDED BIT 1 56 NIL))
(field 04000000000000000       (READ-INTERRUPT BIT 1 57 NIL))
(field 10000000000000000       (WRITE BIT 1 60 NIL))
(field 20000000000000000       (ALE BIT 1 61 NIL))
(field 40000000000000000       (CDR BIT 1 62 NIL)))


