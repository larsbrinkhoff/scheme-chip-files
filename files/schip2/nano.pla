
(make-pla nano-pla
 16.   ;AND field
 51.   ;OR field
 69.   ;PLA size 

;PLA-AND field definitions - LSB is farthest from OR plane
(
(field 000017       (TO BIT-REVERSE 4 0 PH1))
(field 000360       (FROM BIT-REVERSE 4 4 PH1))
(field 177400       (NANO-AND-STATE BIT-REVERSE 10 10 PH1)))

;PLA-OR field definitions - LSB is closest to AND plane
(
(field 00000000000000377       (NANO-OR-STATE NUMBER 10 0 NIL))
(field 00000000000000400       (FROM-CONSTANT BIT 1 10 NIL))
(field 00000000000007000       (BRANCH NUMBER 3 11 NIL))
      ;0   NIL
      ;1   FRAME=0-BUS
      ;2   ADDRESS=0-BUS
      ;3   ADDRESS=BUS-NEWCELL
      ;4   TYPE=BUS-VAL
      ;5   =BUS-VAL
      ;6   TYPE=POINTER-BUS
      ;7   MARK-BIT-BUS
; Unused field decodes - (NIL)
(field 00000000000010000       (DISPATCH BIT 1 14 NIL))
(field 00000000000020000       (NANO-RUN BIT 1 15 NIL))
(field 00000000000040000       (ALLOW-INTERRUPTS BIT 1 16 NIL))
(field 00000000000100000       (TO-FRAME-EXP BIT 1 17 NIL))
