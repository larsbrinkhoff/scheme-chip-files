(field 00000000020000000       (FROM-NEWCELL BIT 1 26 NIL))
(field 00000000040000000       (FROM-INCREMENTED-NEWCELL BIT 1 27 NIL))
(field 00000000100000000       (TO-ADDRESS-VAL BIT 1 30 NIL))
