(This is the modular pattern matcher.  It is 2 bits by 4 characters,
with all signals brought to pads that are needed for multichips);

(This contains positive and negative cells hooked to pads for
testing.  The hooked up negative cell is symbol 220, and the
positive cell is 230);

(This file contains the definition for inverse and positive
comparitor cells for the pattern matcher.  Symbols 160 and
170 are the ones.

161 and 171 are negative and positive comparator cells with
extended pullups on the = gate.

Symbols 150 and 151 should be combined into 1 symbol, whenever
the bug in ckp is fixed.);

(--------------------------------------------------------------------);
(Standard symbols copped from srcell.cif);

(Symbol 1: Green-to-Red butting contact; origin at center);
DS 1 300 2;  (units of lambda/2);
LND; B 8,8 -2,0;
LNP; B 6,8 3,0;
LNC; B 8,4 0,0;
LNM; B 12,8 0,0;
DF;

(Symbol 2: Green-to-Metal contact; origin at center);
DS 2 300 1; (units of lambda);
LND; B 4,4 0,0;
LNC; B 2,2 0,0;
LNM; B 4,4 0,0;
DF;

(Symbol 3: 2/6 pulldown transistor; origin at center);
(Input is in poly.  2 lambda high at -5,0 or 5,0);
DS 3 300 1; (units of lambda);
LND; B 6,6 0,0;
LNP; B 10,2 0,0;
DF;

(Symbol 4: 6/2 pullup transistor; origin at center);
(This has the butting contact over the gate);
DS 4 300 1; (units of lambda);
LND; B 2,10 0,0;
LNP; B 6,6 0,0;
LNI; B 6,10 0,0;
C 1 R 0,1 T 0,-4; (butting contact for gate);
DF;

(Symbol 5: 2/2 pulldown transistor; origin at center);
DS 5 300 1; (units of lambda);
LND; B 2,6 0,0;
LNP; B 6,2 0,0;
DF;


(-----------------------------------------------------------------);
(These are some that I defined, rather than getting from sproull);

(Symbol 11:  Red to metal contact, origin at center);
DS 11 300 1;  (units of lambda);
LNP;  B 4,4 0,0;
LNM;  B 4,4 0,0;
LNC;  B 2,2 0,0;
DF;

(Symbol 12:  2/8 pulldown transistor, origin at center);
(Input in poly is 2 lambda high at -6,0 or 6,0);
DS 12 300 1;  (units of lambda);
LND;  B 8,6 0,0;
LNP;  B 12,2 0,0;
DF;

(Symbol 13:  6/2 pullup with side contact.  Origin at center
of pullup gate);
DS 13 300 1; (units of lambda);
LND;  B 2,10 0,0;   (Two lambda wide channel, with slop);
	B 4,2 1,-5;	(Connects the channel to the contact);
C 1 R 0,1 T 4,-3;	(The butting contact);
LNP;  B 6,6 0,0;	(The pullup gate);
LNI;  B 6,10 0,0;	(Implant);
DF;

(Symbol 14:  2/3 pulldown.  Origin is lambda/2 left of center.
This transistor will therefore stick out more on the right than
on the left);
DS 14 300 2;  (units of lambda/2);
LND;  B 6,12 1,0;	(the channel);
LNP;  B 14,4 1,0;	(the gate);
DF;

(Symbol 15:  8/2 pullup with butting contact over gate.
Origin is center of pullup gate.);
DS 15 300 1; (units of lambda);
LND; B 2,12 0,0;
LNP; B 6,8 0,0;
LNI; B 6,12 0,0;
C 1 R 0,1 T 0,-5; (butting contact for gate);
DF;

(Symbol 16:  8/2 pullup with side contact.  Origin at center
of pullup gate);
DS 16 300 1; (units of lambda);
LND;  B 2,12 0,0;   (Two lambda wide channel, with slop);
	B 4,2 1,-6;	(Connects the channel to the contact);
C 1 R 0,1 T 4,-4;	(The butting contact);
LNP;  B 6,8 0,0;	(The pullup gate);
LNI;  B 6,12 0,0;	(Implant);
DF;

(----------------------------------------------------------------);

(Symbol 101:  9:1 inverter, using 6/2 and 2/6 transisitors.
This is extra long, to allow an extra metal wire to pass
over the pulldown.  Origin is center of power contact.
Output may be in metal, to the right, or diffusion, to the
left.  Input is in poly, to either left or right.
***This comment uses units of lambda***
Metal output is up to 6 high, centered at 6,-9.
Diffusion output is two high, centered at -1,-11.
poly input is two high, centered at -5,-14 or 5,-14.
Metal crossing is 3 high, with ports at -5,-16.5 and 9,-16.5.
     4 high ports at -5,-16 and 9, -16 may be used instead.
Typical outputs are given below as comments.);
DS 101 300 2;  (units of lambda/2);
C 2 T 0,0;	(power contact);
C 13 T 0,-12;	(pullup);
C 3 T 0,-28;	(pulldown);
LNM;  B 28,6 4,-33;	(metal crossing of pulldown);
(** comments to show how to hook it up **);
(LND;  B 4,8 0,-38);	(connection to ground);
(C 2 T 0,-46);		(ground contact);
(LNM;  B 16,8 20,-16);	(output wire in metal);
(LND;  B 16,4 -10,-22);	(output in diffusion);
DF;

(Symbol 102:  9:1 NOR gate for the positive accumulator cell.
Origin is center of power contact.  Ground contacts are at 0,24
and -10,24.  The pulldown inputs are 4,20 and -14,16.
Output is at 4,12);

DS 102 300 1;		(units of lambda);
C 2 T 0,0;		(power contact);
C 13 M Y T 0,7;		(6/2 pullup);
LND;	B 12,2 -6,12;	(connection to left pulldown);
C 3 T -9,16;		(2/6 pulldown for left branch);
LND;	B 2,4 -10,20;	(connection to ground contact);
C 2 T -10 24;		(ground contact);
LND;	B 2,4 0,15;	(connection to right pulldown);
C 3 T 0,20;		(2/6 pulldown for right branch);
C 2 T 0,24;		(ground contact for right branch);
DF;

(Symbol 103:  Nand gate for accumulator.  Origin is in power
contact);
DS 103 300 1;		(units of lambda);
C 2 T 0,0;		(power contact);
C 16 M Y T 0,7;		(8/2 pullup);
C 12 T -1,16;		(2/8 pulldown);
LNP;	B 8,2 -10,16;	(connection to pulldown);
C 12 T -1,20;		(Another 2/8 pulldown);
C 2 T 0,24;		(the ground contact);
DF;

(--------------------------------------------------------------);

