;;; -*- LISP -*-

(deflayout pass-transistor (length width)
	   (box 'poly
		(- 0 *poly-overhang* (// width 2.0))
		(+ *poly-overhang* (// width 2.0))
		(- 0 (// length 2.0))
		(// length 2.0))
	   (box 'diff
		(- 0 (// width 2.0))
		(// width 2.0)
		(- 0 *diffusion-overhang* (// length 2.0))
		(+ *diffusion-overhang* (// length 2.0))))

(deflayout general-pullup (length width)
	   (boxes (poly (+ (* 2 *poly-overhang*) width)) (pt 0 0) (+Y length))
	   (boxes (diff width) (pt 0 -1) (+Y (+ length 2)))
	   (boxes (implant (+ (* 2 *implant-overhang*) width))
		  (pt 0 (- 0 *implant-overhang*))
		  (+Y (+ length (* 2 *implant-overhang*)))))

(deflayout pullup-without-contact (length)
	   (boxes (poly 6) (pt 0 0) (+Y length))
	   (boxes diff (pt 0 0) (+Y length))
	   (boxes (implant (+ (* 2 *implant-overhang*) 2))	;default width
		  (pt 0 (- 0 *implant-overhang*))
		  (+Y (+ length (* 2 *implant-overhang*)))))

(deflayout pullup (length)
   (call 'butting-contact nil)
   (boxes (poly 6) (pt 0 0) (+Y (1+ length)))
   (boxes diff (pt 0 0) (+Y (1+ length)))
   (set-the' top *XY)
   (boxes (implant (+ (* 2 *implant-overhang*) 2))	;default width
	  (pt 0 (- 0 *implant-overhang*))
	  (+Y (+ length (* 2 *implant-overhang*) 1)))
   (boxes implant (pt 0 0) (+Y (1+ length))))

(deflayout pullup-without-extra-length (length)
   (call 'butting-contact nil)
   (boxes (poly 6) (pt 0 0) (+Y length))
   (boxes diff (pt 0 (- 0 *diffusion-overhang*))
	  (+Y (+ length (* 2 *diffusion-overhang*))))
   (set-the' top *XY)
   (boxes (implant (+ (* 2 *implant-overhang*) 2))	;default width
	  (pt 0 (- 0 *implant-overhang*))
	  (+Y (+ length (* 2 *implant-overhang*) 1)))
   (boxes implant (pt 0 0) (+Y length)))

;Vertical butting contact with Poly on top
(deflayout butting-contact ()
   (boxes (diff 4) (pt 0 1) (-Y 4))
   (boxes (poly 4) (pt 0 0) (+Y 3))
   (boxes (metal 4) (pt 0 -3) (+Y 6))
   (boxes (cuts 2) (pt 0 -2) (+Y 4)))

;;; Simple Steele register cell

(deflayout regcell ()
   (set-the' v-pitch 40)
   (set-the' h-pitch 38)
   (set-the' gnd-height 4)
   (set-the' bus-height 24)
   (set-the' left-bus-contact (pt 2 (the bus-height)))
   (set-the' right-bus-contact (pt 40 (the bus-height)))
   (set-the' vdd-height 31)
   (set-the' boundary (pt 42 40))
   (set-the' q1-gate-contact (pt 9 13))
   (set-the' q1 (pt 16 13))
   (set-the' q1-gate (pt 16 8))
   (set-the' q2-output-contact (pt 34 16))
   (set-the' q2 (pt 24 17))
   (set-the' q2-gate (pt (- (the-x q2) .5) 12))

   (set-the' ph1-to
	     (wire poly (pt 4 0) (+Y 20) (+X 2) (+Y 8) (-X 2) (Y (the-y boundary))))
   (set-the' ph2 (wire poly (pt 30 0) (Y (the-y boundary))))
   (set-the' ph1-from (wire poly (pt 38 0) (+Y 20) (-X 2) (+Y 8) (+X 2) (Y (the-y boundary))))
   ;Q1
   (set-the' q1-pullup (call 'pullup '(8) 'trans (the q1)))
   (boxes (diff 4) (pt (the-x q1) (1+ (the-y q1))) (Y (the gnd-height)))
   (contact S diff *xy)
   (boxes diff (the-pt top q1-pullup) (Y (the vdd-height)))
   (contact S diff *xy)
   ;Q1 to Q2
   (boxes poly (pt (the-x q1) (1+ (the-y q1)))
	  (+X 4) (Y (the-y q2-gate)) (X (+ 1.5 *poly-overhang* (the-x q2-gate))))
   ;Q2
   (set-the' q2-pullup (call 'pullup '(5) 'trans (the q2)))
   (boxes metal (pt (the-x q2-output-contact) (- (the-y q2-output-contact) .5))
	  (X (- (the-x q2) 2)))
   (boxes (diff 3) (pt (- (the-x q2) .5) (+ (the-y q2) 1))
	  (Y (the gnd-height)))
   (contact S diff (pt (the-x q2) (the gnd-height)))
   (boxes diff (the-pt top q2-pullup) (Y (the vdd-height)))
   (contact S diff *XY)
   
   ;feedback
   (call 'butting-contact '() 'mirror 'Y 'trans (the q1-gate-contact))
   (boxes poly (pt (+ (the-x q1-gate-contact) 1) (the-y q1-gate-contact))
	  (Y (the-y q1-gate)) (X (+ 2 *poly-overhang* (the-x q1-gate))))
   (boxes diff (the q1-gate-contact)
	  (+Y 24) (X (1- (the-x q2-output-contact))) (Y (the-y q2-output-contact)))
   (contact S diff (the q2-output-contact))

   ;From and To pass gates
   (boxes (diff 4) (the left-bus-contact) (X (the-x q1-gate-contact)))
   (boxes (diff 4) (the right-bus-contact) (X (the-x q2-output-contact)))

   ;The busses
   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the-x boundary))))
   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the-x boundary))))
   (set-the' bus (wire metal (pt 0 (+ .5 (the-y left-bus-contact)))
		       (X (the-x right-bus-contact))))
   (contact S diff (the left-bus-contact))
   (contact S diff (the right-bus-contact))

   (boxes (diff 4) (pt (- (the-x q1) 2) (the vdd-height)) (X (+ 2 (the-x q2))))
   (boxes (diff 4) (pt (- (the-x q1) 2) (the gnd-height)) (X (+ 2 (the-x q2))))
  )

; Register cell which interfaces with HEQ and HINC.

(deflayout hbit ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 40)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)
	   (set-the' left-bus-contact (pt 2 (the bus-height)))
	   (set-the' q-height 18)
	   (set-the' not-q-height 11)
	   (set-the' q1-gate-contact (pt 9 12))
	   (set-the' q1 (pt 16 6))
	   (set-the' q1-b-contact (pt 17 (the not-q-height)))
	   (set-the' q1-pullup (pt 15 14))
	   (set-the' q2 (pt 22.5 10))
	   (set-the' q2-pullup (pt 23 25))
	   (set-the' q2-b-contact (pt (1+ (the-x q2-pullup)) (the q-height)))
	   (set-the' feedback-contact (pt 34 (1- (the q-height))))
	   
	   (set-the' ph1-to
		     (wire poly (pt 4 0) (+Y 20) (+X 2) (+Y 8) (-X 2) (Y (the v-pitch))))
	   (set-the' ph2 
		     (wire poly (pt 30 0) (Y (the v-pitch))))
	   (set-the' ph1-from
		     (wire poly (pt 38 0) (Y (the v-pitch))))

;The busses
   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the h-pitch))))
   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))
   (set-the' bus (wire metal (pt 0 (+ .5 (the-y left-bus-contact)))
		       (X (the h-pitch))))



;feedback
(contact s diff (the left-bus-contact))
(boxes (diff 4) (the left-bus-contact) (X (the-x q1-gate-contact)))
(boxes diff (the q1-gate-contact) (Y (- (the h-pitch) 3)) (X (1- (the-x feedback-contact)))
       (Y (the-y feedback-contact)))
(contact s diff (the feedback-contact))

(boxes (diff 4) (pt (the-x feedback-contact) (the bus-height)))

;q1 cruft
(call 'butting-contact '() 'mirror 'y 'trans (the q1-gate-contact))
(boxes poly (pt (1+ (the-x q1-gate-contact)) (the-y q1-gate-contact)) (Y  (the-y q1))
       (X (+ (the-x q1) 4)))
(contact h diff (pt (the-x q2-b-contact) (the gnd-height)))
(boxes (diff 2) (pt (the-x q2-b-contact) 3) (X (the-x q1)))
(boxes (diff 4) (pt (the-x q1) 2) (Y (the not-q-height)))
(boxes (diff 3) (pt (the-x q2) (the gnd-height)) (Y (1- (the bus-height))))
(boxes (diff 4) (pt (the-x feedback-contact) (the bus-height)) (X (the h-pitch)))
(boxes diff (pt (the-x q2-pullup) (1- (the bus-height))) (Y (1+ (the vdd-height)))
       (X (the-x q1-pullup)) (Y (the not-q-height)))
(contact h diff (pt (the-x q1) (the vdd-height)))
(call 'pullup-without-contact '(8) 'trans (the q1-pullup))
(boxes poly (pt 26 (the-y q2)) (X (the-x q1-b-contact)))
(boxes (poly 3) (pt (+ *x 1.5) *y) (+Y 12))
(boxes poly (pt (+ (the-x q2-b-contact) 2) (the-y q2-b-contact)) (Y (- (the vdd-height) 1)))
(call 'butting-contact '() 'rot '(0 -1) 'trans (the q1-b-contact))

;rest of q2
(call 'pullup-without-contact '(5) 'trans (the q2-pullup))
(call 'butting-contact '() 'rot '(0 -1) 'trans (the q2-b-contact))

(boxes metal (pt (the-x q2-b-contact) (- (the q-height) .5)) (X (the h-pitch)))
(boxes metal (pt (the-x q1-b-contact) (- (the not-q-height) .5)) (X (the h-pitch))))

(deflayout hinc ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 43)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)
	   (set-the' q-height 18)
	   (set-the' not-q-height 11)

	   (set-the' left-bus-contact (pt 2 (the bus-height)))
	   (set-the' not-q-contact (pt 8 (the not-q-height)))
	   (set-the' q-contact (pt 16 (the q-height)))
	   (set-the' inv-1-g-contact (pt 14 (the gnd-height)))
	   (set-the' inv-2-g-contact (pt 37 (the gnd-height)))
	   (set-the' vdd-contact (pt 36 (the vdd-height)))
	   (set-the' in-gate-contact (pt 24 (the not-q-height)))
	   (set-the' inv-1-but-contact (pt 26 (the q-height)))
	   (set-the' inv-2-but-contact (pt 38 17))

	   (contact S diff (the left-bus-contact))
	   (contact S diff (the not-q-contact))
	   (contact S diff (the q-contact))
	   (contact H diff (the inv-1-g-contact))
	   (contact H diff (the inv-2-g-contact))
	   (contact H diff (the vdd-contact))
	   (contact S poly (the in-gate-contact))
	   (call 'butting-contact '() 'rot '(0 1) 'trans (the inv-1-but-contact))
	   (call 'pullup '(5) 'trans (the inv-2-but-contact))
	   (call 'pullup-without-contact '(8) 'trans (pt 29 21))

	   ;The busses
	   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the h-pitch))))
	   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))
	   (set-the' bus (wire metal (pt 0 (+ .5 (the-y left-bus-contact))) (X (the h-pitch))))

	   (boxes metal (pt 0 (- (the q-height) .5)) (X (the-x q-contact)))
	   (boxes metal (pt 0 (- (the not-q-height) .5)) (X (the-x not-q-contact)))
	   (boxes (metal 4) (the in-gate-contact) (X (the-x q-contact)))

;	   (boxes (metal 4) (the not-q-contact) (X (the-x q-contact)))		;decrement
;	   (boxes (metal 4) (the q-contact) (Y (- (the-y in-gate-contact) 2)))	;increment

	   (set-the' ph1-from+
		     (wire poly (pt 2 0) (+Y 20) (+X 4) (+Y 8) (-X 4) (Y (the v-pitch))))
	   (set-the' -cin
		     (wire poly (pt 33 (- (the v-pitch) 1)) (-X 21) (-Y 19)))
	   (set-the' cin
		     (wire poly (pt 42 (the v-pitch)) (-Y 5) (X 20) (Y 2)))
		   (boxes poly (pt 20 14) (-X 8) (+Y 2) (-X 6))
	   (boxes poly (the in-gate-contact) (Y 2))
	   (set-the' -cout (wire poly (pt 32 0) (Y (the-y left-bus-contact))))
	   	(boxes poly (pt 32 10) (+X 7))
		(boxes (poly 3) (pt (- (the-x inv-1-but-contact) 1.5)
				    (the-y inv-1-but-contact))
		       (Y (the-y left-bus-contact)))
	   (set-the' cout (wire poly (pt 42 0) (Y 23)))
	   
	   (boxes (diff 4) (the left-bus-contact) (X (the-x q-contact)) (Y (the-y q-contact)))
	   (boxes diff (pt (+ (the-x not-q-contact) 1) (the-y not-q-contact))
		  (Y (the bus-height)))
	   (boxes (diff 4) (pt (the-x inv-1-g-contact) (+ (the-y inv-1-g-contact) 2)) (X 29))
	   (boxes diff (the inv-2-but-contact)
		  (Y (the vdd-height)) (X (+ (the-x inv-1-but-contact) 3))
		  (Y (the gnd-height)))
	   (boxes (diff 3) (pt (- (the-x inv-2-g-contact) 1.5) (the-y inv-2-g-contact))
		  (Y (- (the-y inv-2-but-contact) 3.5)) (X (+ (the-x inv-2-but-contact) 2))))

(deflayout hinc-dummy ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 43)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)
	   (set-the' q-height 18)
	   (set-the' not-q-height 11)

	   (set-the' left-bus-contact (pt 2 (the bus-height)))

	   (contact S diff (the left-bus-contact))

	   ;The busses
	   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the h-pitch))))
	   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))
	   (set-the' bus (wire (metal 4) (pt 0 (the-y left-bus-contact)) (X (the h-pitch))))

	   (set-the' ph1-from+
		     (wire poly (pt 2 0) (+Y 20) (+X 4) (+Y 8) (-X 4) (Y (the v-pitch)))))

(deflayout inc ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 43)
	   (set-the' incer (call 'hinc '()))
	   (boxes (metal 4) (the-pt q-contact incer)
		  (Y (- (y-of (the-pt in-gate-contact incer)) 2))))

(deflayout dec ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 43)
	   (set-the' decr (call 'hinc '()))
	   (boxes (metal 4) (the-pt not-q-contact decr)
		  (X (x-of (the-pt q-contact decr)))))

(deflayout heq ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 45)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)
	   (set-the' q-height 17.5)
	   (set-the' not-q-height 10.5)

	   (set-the' left-bus-contact (pt 2 (the bus-height)))
	   (contact S diff (the left-bus-contact))

	   (set-the' vdd-contact (pt 14 (the vdd-height)))
	   (contact S diff (the vdd-contact))
	   
	   (set-the' pullup-contact (pt 25 (- (the vdd-height) 1)))
	   (call 'pullup-without-extra-length '(8)
		 'rot '(0 1) 'trans (the pullup-contact))

	   (set-the' bus-contact (pt 23 (- (the bus-height) 1.0)))
	   (contact S poly (the bus-contact))

	   (set-the' q-contact (pt 31 (- (the q-height) .5)))
	   (contact S poly (the q-contact))

	   (set-the' not-q-contact (pt 10 (+ (the not-q-height) .5)))
	   (contact S poly (the not-q-contact))

	   (set-the' g-1-contact (pt 18 (the gnd-height)))
	   (contact H diff (the g-1-contact))
	   (set-the' g-2-contact (pt 25 (the gnd-height)))
	   (contact H diff (the g-2-contact))

	   ;The busses
	   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height))
			   (X (the-x vdd-contact)) (+Y 6) (+X 19) (-Y 6) (X (the h-pitch))))
	   (set-the' bus (wire metal (pt 0 (- (the-y left-bus-contact) .5)) (X (the h-pitch))))
	   (set-the' q (wire metal (pt 0 (the q-height))
			   (+X 16.5) (-Y 1) (+X 14) (+Y 1) (X (the h-pitch))))
	   (set-the' not-q (wire metal (pt 0 (the not-q-height)) (X (the h-pitch))))
	   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))

	   (set-the' eq-bus (wire diff (pt 41 0) (Y (the v-pitch))))
	   
	   ;The transistors
	   (set-the' b-pass (pt 9 (the-y left-bus-contact)))
	   (call 'pass-transistor '(2 4) 'trans (the b-pass))

	   (set-the' not-b-pass (pt 33 34))
	   (call 'pass-transistor '(2 4) 'trans (the not-b-pass))

	   (set-the' q-pass (pt 33 22))
	   (call 'pass-transistor '(2 4) 'rot '(0 1) 'trans (the q-pass))

	   (set-the' not-q-pass (pt 13 17))
	   (call 'pass-transistor '(2 4) 'rot '(0 1) 'trans (the not-q-pass))

	   (set-the' binv (pt 27 24))
	   (call 'pass-transistor '(2 2) 'trans (the binv))	   

	   ;Boxes
	   (boxes poly (the b-pass) (X (the-x binv)))
	   (boxes poly (the q-pass) (Y (the-y q-contact)))
	   (boxes poly (the not-q-pass) (Y (the-y not-q-contact)))
	   (boxes poly (the not-b-pass) (X (- (the-x pullup-contact) 2)))
	   
	   (boxes (diff 13) (pt 21.5 2) (+Y 17))
	   (boxes diff (pt (- (the-x b-pass) 1) (the-y b-pass))
		  (Y 37) (X (x-of (the-pt start eq-bus))))
	   (boxes (diff 4) (the b-pass) 
		  (Y (the-y not-q-pass)) (X (the-x not-q-pass)))
	   (boxes (diff 4) (the not-b-pass) (-Y 7))
	   (boxes diff (pt (+ (the-x q-pass) 3) (- (the-y q-pass) 2)) (+Y 9))
	   (boxes diff (pt (+ (the-x pullup-contact) 2) (the-y pullup-contact)) (-Y 12))
	   (boxes diff (pt (the-x q-pass) (- (the-y q-pass) 1))
		  (X (+ (the-x pullup-contact) 2))))

(deflayout heq-dummy ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 45)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)
	   (set-the' q-height 17.5)
	   (set-the' not-q-height 10.5)

	   (set-the' left-bus-contact (pt 2 (the bus-height)))
	   (contact S diff (the left-bus-contact))

	   ;The busses
	   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the h-pitch))))
	   (set-the' bus (wire metal (pt 0 (- (the-y left-bus-contact) .5)) (X (the h-pitch))))
	   (set-the' q (wire metal (pt 0 (the q-height))
			   (+X 16.5) (-Y 1) (+X 14) (+Y 1) (X (the h-pitch))))
	   (set-the' not-q (wire metal (pt 0 (the not-q-height)) (X (the h-pitch))))
	   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))

	   (set-the' eq-bus (wire diff (pt 41 0) (Y (the v-pitch)))))

(deflayout nilcell ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 12)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)

	   (set-the' left-bus-contact (pt 2 (the bus-height)))
	   (contact S diff (the left-bus-contact))

	   (set-the' gnd-contact (pt 10 (the gnd-height)))
	   (contact S diff (the gnd-contact))

	   ;The busses
	   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the h-pitch))))
	   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))
	   (set-the' bus (wire (metal 4) (pt 0 (the-y left-bus-contact)) (X (the h-pitch))))
	   (set-the' ph1-from (wire poly (pt 6 0) (Y (the v-pitch))))
	   (boxes (diff 4) (the left-bus-contact)
		  (X (the-x gnd-contact)) (Y (the-y gnd-contact))))

(deflayout zerop ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 10)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)

	   (set-the' bus-contact (pt 6 (the bus-height)))
	   (contact S poly (the bus-contact))

	   (set-the' gnd-contact (pt 7 (the gnd-height)))
	   (contact S diff (the gnd-contact))

	   ;The busses
	   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the h-pitch))))
	   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))
	   (set-the' bus (wire (metal 4) (pt 0 (the bus-height)) (X (the h-pitch))))
	   (set-the' zerop (wire diff (pt 1 0) (Y (the v-pitch))))
	   (boxes poly (pt (- (the-x bus-contact) 1) (the-y bus-contact)) (-Y 11))
	   (boxes diff (pt (+ (the-x gnd-contact) 1) (the-y gnd-contact)) (+Y 12) (-X 7)))

(deflayout zerop-dummy ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 10)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)

	   ;The busses
	   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the h-pitch))))
	   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))
	   (set-the' bus (wire (metal 4) (pt 0 (the bus-height)) (X (the h-pitch))))
	   (set-the' zerop (wire diff (pt 1 0) (Y (the v-pitch)))))

(deflayout zerop-column ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 5)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)

	   ;The busses
	   (set-the' vdd (wire (metal 4) (pt 0 (the vdd-height)) (X (the h-pitch))))
	   (set-the' gnd (wire (metal 4) (pt 0 (the gnd-height)) (X (the h-pitch))))
	   (set-the' bus (wire (metal 4) (pt 0 (the bus-height)) (X (the h-pitch))))
	   (set-the' zerop (wire diff (pt 1 0) (Y (the v-pitch)))))

(deflayout one-poly-column ()
	   (set-the' v-pitch 40)
	   (set-the' h-pitch 7)
	   (set-the' gnd-height 4)
	   (set-the' bus-height 24)
	   (set-the' vdd-height 31)
