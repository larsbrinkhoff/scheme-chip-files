		     (call 'narrow-one-poly-elbow '() 'trans (the-pt lower-right exp-dec)))
	   (set-the' newcell-hbit (call 'to-entrance '()
					'trans (the-pt lower-right exp-newcell-channel)))
	   (set-the' newcell-= (call 'heq-coupler '()
				     'trans (the-pt lower-right newcell-hbit)))
	   (set-the' newcell-inc (call 'hinc-coupler '()
				       'trans (the-pt lower-right newcell-=)))
	   (set-the' newcell-val-channel
		     (call 'narrow-one-poly-elbow '()
			   'trans (the-pt lower-right newcell-inc)))
	   (set-the' val-hbit (call 'to-entrance '()
				    'trans (the-pt lower-right newcell-val-channel)))
	   (set-the' val-= (call 'heq-enter '() 'trans (the-pt lower-right val-hbit)))
	   (set-the' val-retpc-channel
		     (call 'diff-poly-elbow '() 'trans (the-pt lower-right val-=)))
	   (set-the' retpc-bit (call 'regcell-to-enter '()
				     'trans (the-pt lower-right val-retpc-channel)))
	   (set-the' retpc-stack-channel
		     (call 'wide-one-poly-elbow '()
			   'trans (the-pt lower-right retpc-bit)))	   
	   (set-the' stack-bit (call 'regcell-to-enter '()
				     'trans (the-pt lower-right retpc-stack-channel)))
	   (set-the' intermediate-argument-bit
		     (call 'regcell-coupler '() 'trans (the-pt lower-right stack-bit)))
	   (set-the' display-bit (call 'regcell-coupler '()
				       'trans (the-pt lower-right intermediate-argument-bit)))
	   (set-the' args-bit (call 'regcell-coupler '()
				    'trans (the-pt lower-right display-bit)))
	   (set-the' memtop-bit (call 'regcell-coupler '()
				      'trans (the-pt lower-right args-bit)))
	   (set-the' nil-bit (call 'nilcell-coupler '()
				   'trans (the-pt lower-right memtop-bit)))
	   (set-the' h-pitch (the-x lower-right nil-bit)))


