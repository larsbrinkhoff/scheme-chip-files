(deflayout type-field-row ()
	   (set-the' v-pitch 40)
	   (set-the' zerop-channel (call 'zerop-column '()))
	   (set-the' zerop (call 'zerop-dummy '() 'trans (the-pt lower-right zerop-channel)))
	   (set-the' exp-channel (call 'two-poly-column '() 'trans (the-pt lower-right zerop)))
	   (set-the' exp-hbit (call 'hbit '() 'trans (the-pt lower-right exp-channel)))
	   (set-the' exp-dec (call 'hinc-dummy '() 'trans (the-pt lower-right exp-hbit)))
	   (set-the' exp-newcell-channel
		     (call 'narrow-one-poly-column '() 'trans (the-pt lower-right exp-dec)))
	   (set-the' newcell-hbit (call 'hbit '()
					'trans (the-pt lower-right exp-newcell-channel)))
	   (set-the' newcell-= (call 'heq-dummy '()  'trans (the-pt lower-right newcell-hbit)))
	   (set-the' newcell-inc (call 'hinc-dummy '() 'trans (the-pt lower-right newcell-=)))
	   (set-the' newcell-val-channel
		     (call 'narrow-one-poly-column '()
			   'trans (the-pt lower-right newcell-inc)))
	   (set-the' val-hbit (call 'hbit '() 'trans (the-pt lower-right newcell-val-channel)))
	   (set-the' val-= (call 'heq '() 'trans (the-pt lower-right val-hbit)))
	   (set-the' val-retpc-channel
		     (call 'diff-poly-column '() 'trans (the-pt lower-right val-=)))
	   (set-the' retpc-bit (call 'regcell '()
				     'trans (the-pt lower-right val-retpc-channel)))
	   (set-the' retpc-stack-channel
		     (call 'wide-one-poly-column '()
			   'trans (the-pt lower-right retpc-bit)))	   
	   (set-the' stack-bit (call 'regcell '()
				     'trans (the-pt lower-right retpc-stack-channel)))
	   (set-the' intermediate-argument-bit
		     (call 'regcell '() 'trans (the-pt lower-right stack-bit)))
	   (set-the' display-bit (call 'regcell '()
				       'trans (the-pt lower-right intermediate-argument-bit)))
	   (set-the' args-bit (call 'regcell '() 'trans (the-pt lower-right display-bit)))
	   (set-the' memtop-bit (call 'regcell '() 'trans (the-pt lower-right args-bit)))
	   (set-the' nil-bit (call 'nilcell '() 'trans (the-pt lower-right memtop-bit))))

(deflayout type-displacement-row ()
	   (set-the' v-pitch 5)
	   (set-the' zerop-channel (call 'zerop-box '()))
	   (set-the' zerop (call 'zerop-coupler '() 'trans (the-pt lower-right zerop-channel)))
	   (set-the' exp-channel (call 'two-poly-elbow '() 'trans (the-pt lower-right zerop)))
