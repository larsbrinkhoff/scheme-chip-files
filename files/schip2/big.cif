(Symbol 370:	positive accumulator cell, hooked to pads);
(uses FAST accumulator);
DS 370 300 1;
C 321 T 0,0;
C 350 T 0,0;
LNM;	B 60,12 260,-24;	(symbol);
	B 12,60 260,-24;
DF;

(-----------------------------------------------------);
(Modules for making large pattern matchers);

(Symbol 400: four comparator cells, hooked together like this:

	-   +
	+   -

The origin is at the lower left cell's origin.
Clock connections are made in the two left cells.);
DS 400 300 1;
C 171 T 0,0;
C 161 T 0,49;
C 161 T 88,0;
C 171 T 88,49;
C 11 T 69,-14;
C 11 T 69,35;
DF;

(Symbol 410: two accumulator cells, hooked together like this:
	-   +

The origin is the origin of the comparator above the leftmost accumulator);
DS 410 300 1;
C 330 T 0,0;
C 340 T 88,0;
DF;

(Symbol 420:  the left boundary of symbol 400.  This is to be
used with the leftmost comparators in a pattern matcher array.
It provides contacts for metal wires to be run to pads for these
symbols:

	p bar in to top		<-46,64>
	s out from top		<-46,56>
	p in to bottom		<-46,16>
	s bar out from bottom	<-46,8>
	- clock in		<-46,35>
	ground			an 8-wide bar at x=-28.

The origin is that of the lower of the comparators, and therefore
of the block of 4.);
DS 420 300 1;	(units of lambda);
(** ground **);
LNM;	B 8,102 -28,23;
	B 10,4 -20,0;	(connect lower ground);
	B 10,4 -20,49;	(connect upper ground);

(** clock **);
LNM;	B 2,4 -16,35;	(extend bridge);
C 2 T -18,35;		(contact to diffusion);
LND;	B 16,4 -28,35;	(tunnel under ground);
C 2 T -38,35;		(contact back to metal);
LNM;	B 4,102 -38,23;	(vertical wire);
	B 4,4 -42,35;
C 2 T -46,35;

(** signals **);
LNM;	B 2,4 -16,7;	(s bar);
C 2 T -18,7;
LND;	B 24,2 -32,8;
C 2 T -46,8;

LND;	B 28,2 -30,16;	(p);
C 2 T -46,16;

LNM;	B 2,4 -16,56;	(s);
C 2 T -18,56;
LND;	B 24,2 -32,56;
C 2 T -46,56;

LND;	B 28,4 -30,64;	(p bar);
C 2 T -46,64;
DF;

(Symbol 430:  Right terminator for comparators.  This is to be
used with symbol 400.  It provides contact pads for these signals:

	p bar out from top	<190,64>
	s in to top		<190,56>
	p out of bottom		<190,16>
	s bar out of bottom	<190,8>
	+ clock			<190,35>
	power			8 wide at x=172

Origin is the origin of the symbol 400 that this bounds);
DS 430 300 1;
(** power **);
LNM;	B 8,102 172,23;	(vertical bar);
	B 6,4 165,23;	(low power wire);
	B 6,4 165,72;	(high power wire);

(** clock **);
C 2 T 162,-14;		(contact metal to diffusion);
LND;	B 16,4 172,-14;	(tunnel under power);
C 2 T 182,-14;		(back to metal);
LNM;	B 4,102 182,23;	(vertical bar);
	B 4,4 186,35;
C 2 T 190,35;		(contact metal to diffusion);
LNP;	B 16,2 172,27;	(poly out to vertical line);
C 11 T 182,27;	(contact metal to poly);

(** signals **);
LND;	B 24,2 176,8;	(s bar);
C 2 T 190,8;

LND;	B 24,4 176,16;	(p);
C 2 T 190,16;

LND;	B 24,2 176,56;	(s);
C 2 T 190,56;

LND;	B 24,4 176,64;	(p bar);
C 2 T 190,64;
DF;

(Symbol 440:  The upper boundary for comparators, to be used with symbol 400.
This just connects the d inputs.  The left, or negative, d input is tied
to ground.  The right, or positive, d input is tied to Vdd.  Origin is
that of the associated symbol 400.);
DS 440 300 1;
(right, or positive hookup);
LND;	B 6,2 101,73;	(over to the right);
C 2 T 106,72;		(contact to power);

(left, or negative hookup);
C 2 T 7,49;
DF;

(Symbol 450:  left boundary for accumulators.  This contains connections
for the following signals:
	x bar in	<-46,-34>
	lambda bar in	<-46,-76>
	r out		<-46,-118>
	- clock in	<-46,-58>
	ground		vertical bar at x=-28. connect to <-124,-28>
Origin is the origin of the associated symbol 410.);
DS 450 300 1;
(** ground **);
LNM;	B 8,104 -28,-76;
	B 8,4 -20,-126;	(low ground);
	B 8,4 -20,-84;	(middle ground);
	B 8,4 -20,-42;	(high ground);

(** - clock **);
C 2 T -18,-58;	(contact to diffusion);
LND;	B 16,4 -28,-58;	(tunnel under ground);
C 2 T -38,-58;	(back to metal);
LNM;	B 4,28 -38,-42;	(vertical connection to comparators);
	B 4,4 -42,-58;	(over to contact);
C 2 T -46,-58;		(contact metal to diffusion);

(** signals **);
LND;	B 28,2 -30,-34;	(x bar);
C 2 T -46,-34;

LND;	B 28,2 -30,-76;	(lambda bar);
C 2 T -46,-76;

LND;	B 28,2 -30,-118;	(r);
C 2 T -46,-118;
DF;

(Symbol 460:  right boundary for accumulators.  This contains contacts
for the following signals:
	x bar out	<190,-34>
	lambda bar out	<190,-76>
	r in		<190,-118>
	+ clock in	<190,-58>
	power		vertical bar at x=172.  connect at <172,-124>
Origin is origin of associated symbol 410, which is comparator group
above.);
DS 460 300 1;
(** power **);
LNM;	B 8,104 172,-76;	(vertical wire);
	B 8,4 164,-108;	(low power);
	B 8,4 164,-66;	(middle power);
	B 8,4 164,-26;	(high power);

(** + clock **);
C 2 T 162,-58;		(contact to diffusion);
LND;	B 16,4 172,-58;	(tunnel under power);
C 2 T 182,-58;		(back to metal);
LNM;	B 4,28 182,-42;	(vertical connection to comparators);
	B 4,4 186,-58;	(out to contact);
C 2 T 190,-58;		(contact between metal and diffusion);

(** signals **);
LND;	B 28,2 174,-34;	(x bar);
C 2 T 190,-34;

LND;	B 28,2 174,-76;	(lambda bar);
C 2 T 190,-76;

LND;	B 28,2 174,-118;	(r);
C 2 T 190,-118;
DF;


(-------------------------------------------------------------------------);

(Symbol 620:  A four long by 1 high hookup of quad cells.  This matches
patterns of up to 4 characters, 2 bits each.);
DS 620 300 1;
(first, lay out the array);
C 400 T 0,0;		(accumulators);
C 400 T 176,0;
C 400 T 352,0;
C 400 T 528,0;

(accumulators);
C 410 T 0,0;
C 410 T 176,0;
C 410 T 352,0;
C 410 T 528,0;

(tops);
C 440 T 0,0;		(Top row);
C 440 T 176,0;
C 440 T 352,0;
C 440 T 528,0;

(left boundary);
C 450 T 0,0;		(accumulator);
C 420 T 0,0;		(comparators);

(right boundary);
C 460 T 528,0;		(accumulator);
C 430 T 528,0;		(comparators);

(** Pads **);
(Bottom edge, left to right);
C 10004 M Y M X T 78,-348;	(lambda bar in);
C 10002 M Y T 78,-348;		(r out);
C 10002 M Y T 206,-348;		(lambda bar out);
C 10002 M Y T 334,-348;		(x bar out);
C 10002 M Y T 462,-348;		(p0 out);
C 10002 M Y T 590,-348;		(p1 bar out);
C 10006 M Y M X T 846,-348;	(ground);

(Right edge);
C 10004 M X R 0,-1 T 892,-220;	(r in);
C 10004 M X R 0,-1 T 892,-92;	(+ clock);
C 10004 M X R 0,-1 T 892,36;	(s0 bar in);
C 10004 R 0,-1 T 892,292;	(s1 in);


(Top, right to left);
C 10005 T 718,420;		(Vdd);
C 10004 M X T 718,420;		(p1 bar in);
C 10002 M X T 590,420;		(s1 out);
C 10004 M X T 462,420;		(p0 in);
C 10002 M X T 334,420;		(s0 out);
C 10004 M X T 206,420;		(x bar in);
C 10004 M X T 78,420;		(- clock);

(** hook up bottom row of pads **);
(r out);
LNP;	B 2,4 142,-170;		(into pad);
C 11 T 142,-166;		(contact to metal);
LNM;	B 190,4 49,-166;	(metal wire to contact for r out);
	B 4,48 -46,-144;	(innermost path on left);

(lambda bar in);
LND;	B 2,4 -40,-218;		(out of pad);
C 2 T -40,-214;		(contact to metal);
LNM;	B 16,4 -48,-214;	(metal wire to contact);
	B 4,140 -54,-144;	(2nd path);
	B 8,4 -50,-76;

(lambda bar out);
LNP;	B 2,4 270,-170;		(into pad);
C 11 T 270,-166;		(contact metal to poly);
LNM;	B 4,32 270,-148;	(up);
	B 460,4 498,-134;	(right);
	B 4,62 726,-105;	(up);
	B 8,4 724,-76;		(over to cell);

(x bar out -- 3rd innermost);
LNP;	B 2,4 398,-170;		(as above);
C 11 T 398 -166;
LNM;	B 4,24 398,-152;
	B 340,4 566,-142;
	B 4,112 734,-88;
	B 16,4 728,-34;

(p0 out -- 4th innermost);
LNP;	B 2,4 526,-170;
C 11 T 526,-166;
LNM;	B 4,16 526,-156;
B 220,4 634,-150;
	B 4,170 742,-67;
	B 24,4 732,16;

(p1 bar out -- 5th innermost);
LNP;	B 2,4 654,-170;
C 11 T 654,-166;
LNM;	B 4,8 654,-160;
	B 100,4 702,-158;
	B 4,226 750,-47;
	B 32,4 736,64;

(** Hookup right side pads.  These are all inputs, and all in diffusion **);
(r in);
LND;	B 4,2 762,-102;		(out of pad);
	B 36,4 742,-102;
	B 4,20 726,-110;	(up);
	B 8,4 722,-118;		(over to cell);
(+ clock);
LND;	B 4,2 762,26;		(out of pad);
	B 4,4 758,26;
	B 8,88 756,-16;		(down);
	B 44,4 738,-58;		(into cell);

(s0 bar in);
LND;	B 4,2 762,154;		(as above);
	B 20,4 750,154;
	B 8,150 740,81;
	B 28,4 730,8;

(s1 in);
LND;	B 4,2 762,174;
	B 36,4 742,174;
	B 4,122 726,115;
	B 4,100 722,126;
	B 8,4 722,56;

(** Top row of pads, right to left **);
(p1 bar in -- innermost);
LND;	B 2,4 600,290;		(out of pad);
C 2 T 600,286;		(contact to metal);
LNM;	B 4,146 600,211;	(down);
	B 650,4 277,140;	(left);
	B 4,80 -46,102;		(down to cell);

(s1 out -- 2nd innermost);
LNP;	B 2,4 526,242;
C 11 T 526,238;		(contact metal to poly);
LNM;	B 4,94 526,193;		(down);
	B 580,4 236,148;	(left);
	B 4,96 -54 102;		(down again);
	B 8,4 -50 56;		(connect to cell);

(p0 in -- 3rd innermost);
LND;	B 2,4 344,290;
C 2 T 344,286;
LNM;	B 4,130 344,219;
	B 406,4 143,156;
	B 4,144 -62,86;
	B 16,4 -54,16;

(s0 bar out -- 3rd outermost);
LNP;	B 2,4 270,242;
C 11 T 270,238;
LNM;	B 4,74 270,199;
	B 344,4 100,164;
	B 4,160 -70,86;
	B 24,4 -58,8;

(x bar in -- 2nd outermost);
LND;	B 2,4 88,290;
C 2 T 88,286;
LNM;	B 4,114 88 227;
	B 170,4 5,172;
	B 4,210 -78,69;
	B 32,4 -62,-34;

(- clock -- outermost);
LND;	B 2,4 -40,290;
C 2 T -40,286;
LNM;	B 4,106 -40,231;
	B 50,4 -63,180;
	B 4,242 -86,61;
	B 40,4 -66,-58;

(** Ground hookup **);
(top row);
LNM;	B 24,8 78,296;	(- clock to x bar in);
LNM;	B 24,8 206,296;	(x bar in to s0 bar out);
	B 8,56 218,272;
LNM;	B 24,8 334,296;	(s0 bar out to p0 in);
	B 8,56 322,272;
LNM;	B 24,8 462,296;	(p0 in to s1 out);
	B 8,56 474,272;
LNM;	B 24,8 590,296;	(s1 out to p1 bar in);
	B 8,56 578,272;

(bottom row);
LNM;	B 8,56 90,-200;	(lambda bar in to r out);
	B 24,8 78,-224;
LNM;	B 24,8 206,-176;	(rout to lambda bar out);
LNM;	B 24,8 334,-176;	(lambda bar out to x bar out);
LNM;	B 24,8 462,-176;	(x bar out to p0 out);
LNM;	B 24,8 590,-176;	(p0 out to p1 bar out);

(lower right corner);
LNM;	B 8,56 706,-200;
	B 24,8 718,-224;
	B 8,12 768,-214;

(right side);
LNM;	B 8,24 768,-92;
	B 8,24 768,36;
	B 8,24 768,164;

(upper right corner);
LND;	B 158,112 689,240;

(left side);
LNM;	B 66,8 -66,-224;	(across on bottom);
	B 8,528 -96,36;		(down);
	B 66,8 -66,296;		(across on top);

(cell hookup);
LNM;	B 12,40 194,-152;	(up to cell);
	B 222,12 79,-134;		(across bottom of it);

(Power connections);
(upper right corner);
LNM;	B 8,128 888,356;	(down);
	B 46,8 869,416;		(across);

(lower right corner);
LNM;	B 8,128 888 -284;	(down);
	B 46,8 869,-344;	(across);

(left side);
LNM;	B 60,8 -80,416;		(across on top);
	B 6,768 -107,36;	(down);
	B 60,8 -80,-344;	(across on bottom);

(Hook circuit directly to power pad);
LNM;	B 12,100 740,290;
	B 44,20 724,230;
	B 12,70 698,205;
	B 12,98 698,121;

DF;

(call it);
C 620 T 0,0;
E
