)


;(defprop micro-pla state-0 folded)
;(defprop nano-pla nil folded)

;Do the SCHIP2 PLAs into a file PLA CIF
(defun do-schip ()
   (do-pla 'micro 10. 20. 'state-0)
   (do-pla 'nano 9. 20. nil)
   (do-pla 'contrl 99. 8. nil))

