;;; -*-LISP-*-

(comment SCHEME chip II -- by GJS H GLS
	 |Gerald Jay Sussman, Jack Holloway, and Guy Lewis Steele Jr.|)

(declare (read))
(sstatus macro /% '(lambda ()()))
(declare (sstatus macro /% '(lambda () ((lambda (/%) (eval /%) /%) (read)))) )

(declare (mapex t))

%
(setq backquote-expand-when 'read)

(defmacro if (predicate consequent . alternative)
	  `(cond (,predicate ,consequent) (t . ,alternative)))


;;; The machine simulation:
; ** variables are part of the MACLISP simulation system
; * variables are actually scheme machine registers

(declare (special **pc-subr-ptrs** **stop-flag** **pc**
		  **pointer-types** **non-pointer-types**
		  **interrupt-routine** **debug-trace**
		  **machine-registers**))

%
(setq **pc-subr-ptrs** nil)				;permanently!



; Macros used in ucode definitions

(defmacro deftype (name . body)
	  (if (not (or (assq name **pointer-types**)
		       (assq name **non-pointer-types**)))
	      (error '|Undeclared type| name))
	  `(progn 'compile
		  (declare (special ,name))
		  (defun ,name () . ,body)
		  (setq ,name
			(get ',name
			     ',(cond ((status feature complr) 'subr)
				     (t 'expr))))
		  ',name))

(defmacro defreturn (name . body)
	  `(progn 'compile
		  (declare (special ,name))
		  (setq **pointer-types**
			(cons (list (pctag ,name)) **pointer-types**))
		  (defun ,name () . ,body)
		  (setq ,name
			(get ',name
			     ',(cond ((status feature complr) 'subr)
				     (t 'expr))))
		  ',name))

(defmacro defpc (name . body)
	`(progn 'compile
		(declare (special ,name))
		(defun ,name () . ,body)
		(setq ,name
		      (get ',name
			   ',(cond ((status feature complr) 'subr)
				   (t 'expr))))
		',name))


(defmacro pctag (tag)
	  (cond ((and (status feature complr) **pc-subr-ptrs**) tag)
		(t `',tag)))

(defmacro defmicromacro args
	  `(defmacro ,@args))

(defmacro defschip args				;pass to Microcode Compiler
	  `(eval-when (compile load eval)
		      (setq . ,args)))

(defmacro defreg (name control-lines sense-lines)
	  `(progn 'compile
		  (putprop ',name ',control-lines 'control-lines)
		  (putprop ',name ',sense-lines 'sense-lines)
		  ',name))


; Used by compiler of SCHEME to RTE.

(defmacro typed-cons (type a d)
	  `(pointer (pctag ,type)
		    (let ((x ,a) (y ,d))
			 (address (&cons x y)))))

(defmacro immediate-data (type goodie)
	  `(cons (pctag ,type) ,goodie))

;Types
;
;	GC pointer types -- address part points at something.
;

(defschip **pointer-types**
      '((self-evaluating-pointer 0)
	(symbol 1)
	(global 2)
	(set-global 3)
	(conditional 4)
	(procedure 5)
	(first-argument 6)
	(next-argument 7)
	(last-argument 10)
	(apply-no-args 11)
	(apply-1-arg 12)
	(primitive-apply-1 13)
	(primitive-apply-2 14)
	(sequence 15)
	(spread-argument 16)
	(closure 17)
	(get-control-point 20)
	(control-point 21)
	(interrupt-point 22)
	(self-evaluating-pointer-1 23)
	(self-evaluating-pointer-2 24)
	(self-evaluating-pointer-3 25)
	(self-evaluating-pointer-4 26)
	))

(defschip **pointer** 100)			;100 bit means non-pointer.



; Non-pointer types -- essentially immediate data.

(defschip **non-pointer-types**
      '((self-evaluating-immediate 100)
	(local 101)
	(tail-local 102)
	(set-local 103)
	(set-tail-local 104)
	(set-only-tail-local 105)
	(primitive-car 106)			;Built-in operators
	(primitive-cdr 107)
	(primitive-cons 110)
	(primitive-rplaca 111)
	(primitive-rplacd 112)
	(primitive-eq 113)
	(primitive-type? 114)
	(primitive-type! 115)
	(gc-special-type 116)			;Never appears except during gc
	(self-evaluating-immediate-1 117)
	(self-evaluating-immediate-2 120)
	(self-evaluating-immediate-3 121)
	(self-evaluating-immediate-4 122)
	(mark 123)
	(done 124)
	(primitive-add1 125)
	(primitive-sub1 126)
	(primitive-zerop 127)
	(primitive-displacement-add1 130)
	(primitive-not-atom 131)
	(boot-load 776)				;micro-address forced by RESET
	(process-interrupt 777)			;micro-address forced by EXT INT RQ

	(lisp-function 775)))			;PDP-10 simulation

; registers may have the following operations:
;	FETCH, ASSIGN, SAVE, RESTORE.

; The following registers are used by EVAL:
;	*VAL*, *EXP*, *ARGS*, *DISPLAY*, *STACK*

; *GC-NEEDED* is one bit -- indicating need for garbage-collection.
; *INTERRUPT* is used in processing interrupts.

; *NIL* is a dummy register, it cannot be set, and its value is nil.

; *STACK-TOP*, *NODE-POINTER*, *LEADER* are used by the GC mark phase only.
; *SCAN-UP* *SCAN-DOWN* and *MEMTOP* are used by the GC sweep phase.
; *REL-TEM-1*, *REL-TEM-2* are temporaries used in GC relocate phase only.

; *SCAN-UP* is the newcell pointer when in EVAL.

; The above registers are really aliases for the real underlying
; physical registers.  The mapping is made below:

%
(defschip **machine-registers**
      '((*nil*)
	(*memtop*)
	(*newcell*)
	(*scan-up* *newcell*)
	(*exp*)
	(*scan-down* *exp*)
	(*val*)
	(*rel-tem-2* *val*)
	(*stack-top* *val*)
	(*args*)
	(*leader* *args*)
	(*rel-tem-1* *args*)
	(*display*)
	(*node-pointer* *display*)
	(*stack*)
	(*retpc-count-mark*)		;Used in mark bit and increment ops and for ucode subrs
	(*intermediate-argument*)))	;Used by Microcode Compiler

(declare (special *nil* *memtop* *newcell* *exp* *val* *args* *display* *stack*
		  *retpc-count-mark* *intermediate-argument*
		  *gc-needed* *interrupt*))


(defmacro fetch (register)
	  (let ((r (assoc register **machine-registers**)))
	       (if r (if (cdr r) (cadr r) (car r))
		   (error '|Undefined Register FETCHed| register))))

(defmacro assign (register value)
	  (let ((r (assoc register **machine-registers**)))
	       (if r
		   (progn (if (cdr r) (setq r (cadr r)) (setq r (car r)))
			  (if (get r 'assign-op)
			      `(progn (setq ,r ,value)
				      ,(get r 'assign-op))
			      `(setq ,r ,value)))
		   (error '|Undefined Register ASSIGNed| register))))

;Properties of Physical Registers


(defprop *exp* (setup-frame-and-displacement) assign-op)

(declare (special frame displacement))

(defun setup-frame-and-displacement ()
       (cond ((memq (type (fetch *exp*))
		    '(local tail-local set-local
		      set-tail-local set-only-tail-local))
	      (setq frame (cadr (fetch *exp*)))
	      (setq displacement (cddr (fetch *exp*))))
	     (t (setq frame 'bad-frame)
		(setq displacement 'bad-displacement))))


; The following define the control lines and sense wires on the registers.

(defreg *exp* (to-type to-displacement to-frame from from-decremented) ())

(defreg *newcell* (to-type to-address from from-incremented) (address=bus))

(defreg *val*
	(to-type to-address from)
	(type=bus address=bus =bus))		 ;=bus is AND of type, address=bus

(defreg *retpc-count-mark* (to-type to-address from) ())

(defreg *stack* (to-type to-address from) ())

(defreg *memtop* (to from) ())

(defreg *args* (to from) ())

(defreg *display* (to from) ())

(defreg *intermediate-argument* (to from) ())

(defreg *nil* (from) ())

;The bus is sensitive to several conditions:

(defreg bus () (mark-bit type-not-pointer frame=0 displacement=0 address=0))


; The machine registers have type fields and address fields comprising
; a pointer.  We simulate pointers with LISP conses.

(defmacro address (x) `(cdr ,x))
(defmacro type (x) `(car ,x))
(defmacro pointer (type address) `(cons ,type ,address))


; The following are the primitive machine operations:

(defmacro &set-type (x y)
	  (cond ((and (not (atom y)) (eq (car y) 'fetch))	;from another register
		 `(assign ,x (pointer (type ,y) (address (fetch ,x)))))
		(t					;from a pla constant
		 `(assign ,x (pointer (pctag ,y) (address (fetch ,x)))))))

(defmacro &=type? (register tag)			;constant type tags
	  `(eq (type ,register) (pctag ,tag)))

(defmacro go-to (tag) `(setq **pc** (pctag ,tag)))	;constant tag

(defmicromacro micro-call (micro-subroutine-tag return-tag)
	  `(progn (&set-type *retpc-count-mark* ,return-tag)
		  (go-to ,micro-subroutine-tag)))

(defmacro dispatch (reg) `(setq **pc** (type ,reg)))

(defmicromacro micro-return () `(dispatch (fetch *retpc-count-mark*)))

(defmacro dispatch-on-exp-allowing-interrupts ()
	'(if *interrupt*
	     (go-to process-interrupt)
	     (dispatch (fetch *exp*))))

(defmicromacro eval-exp-popj-to (tag)			;constant tag
	  `(progn (&set-type *stack* ,tag)
		  (dispatch-on-exp-allowing-interrupts)))

(defmicromacro dispatch-on-stack () '(dispatch (fetch *stack*)))

; Storage-Allocator register primitives:

(defun &increment-scan-up ()
       (assign *scan-up*
	       (pointer (type (fetch *scan-up*))
			(1+ (address (fetch *scan-up*)))))
       (if (&scan-up=memtop?) (&set-gc-needed)))

(defun &increment-scan-up-to-val ()
       (assign *val*
	       (pointer (type (fetch *scan-up*))
			(1+ (address (fetch *scan-up*))))))

(defun &decrement-scan-down ()
       (assign *scan-down*
	       (pointer (type (fetch *scan-down*))
			(1- (address (fetch *scan-down*))))))

(defun &decrement-scan-down-to-val ()
       (assign *val*
	       (pointer (type (fetch *scan-down*))
			(1- (address (fetch *scan-down*))))))

(defun &scan-up=scan-down? ()
       (= (address (fetch *scan-up*)) (address (fetch *scan-down*))))

(defun &scan-down=0? ()
       (= (address (fetch *scan-down*)) 0))

(defun &scan-up=memtop? ()
       (= (address (fetch *scan-up*)) (address (fetch *memtop*))))

(defun &pointer? (register)
       (assq (type register) **pointer-types**))

(defun &set-gc-needed ()
       (cause-interrupt)				;simulator only
       (terpri)
       (princ '|Setting *gc-needed*|)
       (setq *gc-needed* t))

(defun &clear-gc-needed () (setq *gc-needed* nil))


; Eval register primitives.

(defun &decrement-frame ()				;exp register part
       (setq frame (1- frame)))

(defun &decrement-displacement ()			;exp register part
       (setq displacement (1- displacement)))

(defun &frame=0? () (= frame 0))

(defun &displacement=0? () (= displacement 0))

(defun &eq-val (stuff) (equal (fetch *val*) stuff))

(defun &val=0? ()
       (= (address (fetch *val*)) 0))

(defun &val-displacement-to-exp-displacement ()
       (break |&val-displacement-to-exp-displacement not really defined|))

(defun &val-frame-to-exp-frame ()
       (break |&val-frame-to-exp-frame not really defined|))

;Memory operations:

(defun &car (x) (**the-cars** (address x)))

(defun &cdr (x) (**the-cdrs** (address x)))

(defun &rplaca (x y)
       (store (**in-use-marks** (address x)) nil)
       (store (**the-cars** (address x)) y))

(defun &rplaca-and-mark! (x y)
       (store (**in-use-marks** (address x)) 't)
       (store (**the-cars** (address x)) y))

(defun &rplacd (x y)
       (store (**car-being-traced-marks** (address x)) nil)
       (store (**the-cdrs** (address x)) y))

(defun &global-value (x) (**the-cars** (address x)))

(defun &set-global-value (x y) (store (**the-cars** (address x)) y))

(defun &in-use? (x) (**in-use-marks** (address x)))

(defun &mark-in-use! (x) (store (**in-use-marks** (address x)) 't))

(defun &unmark! (x) (store (**in-use-marks** (address x)) 'nil))

(defun &car-being-traced? (x) (**car-being-traced-marks** (address x)))

(defun &mark-car-being-traced! (x) (store (**car-being-traced-marks** (address x)) 't))

(defun &mark-car-trace-over! (x) (store (**car-being-traced-marks** (address x)) 'nil))

(defmacro &cons (x y)
	  `(progn (assign *intermediate-argument* ,y)
		  (&increment-scan-up)
		  (&rplacd (fetch *scan-up*) (fetch *intermediate-argument*))
		  (&rplaca (fetch *scan-up*) ,x)
		  (fetch *scan-up*)))				


; Interrupts

(defun &get-interrupt-routine-pointer ()
       (setq *interrupt* nil)
       (or (prog2 () **interrupt-routine**
		  (setq **interrupt-routine** nil))
	   (and *gc-needed* gcint)
	   (break |Interrupt request pending.|)))

;The simulation machine.

;some things only get done because of simulation:

(defmacro simulation stuff `(progn ,@stuff))

(defmacro fastcall (fun . args)				;seldom have any args in RTE
       (cond ((status features complr)
	      (cond (**pc-subr-ptrs**
		     `(subrcall nil ,fun . ,args))
		    (t `(subrcall nil (symeval ,fun) . ,args))))
	     (t `(funcall ,fun . ,args))))

(defun mloop ()
       (do ((**stop-flag** nil)) (**stop-flag** (fetch *val*))
	   (and **debug-trace** (funcall **debug-trace**))
	   (fastcall **pc**)))

(setq **debug-trace** nil)

(defun run-scheme ()
       (setq **interrupt-routine** (scheme-intern 'read-eval-print-loop))
       (setq **pc** (pctag boot-load))
       (mloop))

(setq **margin** 100)


(declare (*fexpr define))

(defun memory-alloc (size)
       (if (< size **margin**) (break |Allocation too small|))
       (array **the-cars** t size)
       (array **the-cdrs** t size)
       (array **in-use-marks** t size)
       (array **car-being-traced-marks** t size)
       (setq *nil* (pointer (pctag self-evaluating-pointer) 0))
       (setq *interrupt* nil)
       (&clear-gc-needed)
       (&rplaca (fetch *nil*) (fetch *nil*))
       (&rplacd (fetch *nil*) (fetch *nil*))
       (assign *scan-up* (fetch *nil*))
       (assign *memtop*
	       (pointer (pctag self-evaluating-immediate)
			(- size **margin**)))
       (let ((loc1 (&cons (fetch *nil*) (fetch *nil*))))
	    (scheme-intern 'read-eval-print-loop)
	    (setq gcint (scheme-intern 'gc-interrupt))
	    (setq uint (scheme-intern 'user-interrupt))
	    (scheme-intern 'location-1)
	    (&set-global-value (scheme-intern 'read-eval-print-loop)
			       (enclose read-eval-print-loop nil))
	    (&set-global-value (scheme-intern 'gc-interrupt)
			       (enclose gc-interrupt nil))
	    (&set-global-value (scheme-intern 'user-interrupt)
			       (enclose user-interrupt nil))
	    (&set-global-value (scheme-intern 'location-1) loc1)
	    (&rplaca loc1				;for *memtop
		     (fetch *memtop*)))
       (assign *retpc-count-mark* (fetch *nil*))
       (assign *val* (fetch *nil*))
       (assign *exp* (fetch *nil*))
       (assign *display* (fetch *nil*))
       (assign *args* (fetch *nil*))
       (assign *stack* (fetch *nil*)))

(defun cause-interrupt () (setq *interrupt* t))

; Chip control and initialization:

(deftype boot-load
	 (assign *scan-up* (fetch *nil*))
	 (&increment-scan-up)				;to location 1
	 (assign *memtop* (&car (fetch *scan-up*)))
	 (assign *scan-up* (fetch *memtop*))
	 (assign *stack* (&get-interrupt-routine-pointer))	;from pads
	 (&set-type *stack* boot-load-return)
	 (go-to mark))

(defreturn boot-load-return
	 (assign *exp* (&car (fetch *stack*)))
	 (assign *stack* (fetch *nil*))
	 (&set-type *stack* done)
	 (dispatch-on-exp-allowing-interrupts))

(deftype done
	 (simulation (setq **stop-flag** t))
	 (go-to done))

(defpc debug-routine
       (&write-to-pads (fetch *exp*))
       (&write-to-pads (fetch *val*))
       (&write-to-pads (fetch *args*))
       (&write-to-pads (fetch *display*))
       (&write-to-pads (fetch *stack*))
       (&write-to-pads (fetch *newcell*))
       (&write-to-pads (fetch *memtop*))
       (&write-to-pads (fetch *retpc-count-mark*))
       (&write-to-pads (fetch *intermediate-argument*))
       (&read-from-pads *exp*)
       (&read-from-pads *val*)
       (&read-from-pads *args*)
       (&read-from-pads *display*)
       (&read-from-pads *stack*)
       (&read-from-pads *newcell*)
       (&read-from-pads *memtop*)
       (&read-from-pads *retpc-count-mark*)
       (&read-from-pads *intermediate-argument*)
       (go-to debug-routine))


(deftype process-interrupt
       (save (fetch *args*))
       (save (fetch *exp*))
       (save (fetch *display*))
       (save (fetch *val*))
       (&set-type *stack* interrupt-point)
       (assign *args* (fetch *stack*))
       (assign *exp* (&car (&get-interrupt-routine-pointer)))	;from pads
       (dispatch-on-exp-allowing-interrupts))

(defpc get-memtop
       (assign *val* (fetch *memtop*))
       (dispatch-on-stack))

(defpc set-memtop
       (assign *memtop* (fetch *val*))
       (dispatch-on-stack))

(defpc get-scan-up
       (assign *val* (fetch *scan-up*))
       (dispatch-on-stack))

(defpc set-scan-up
       (assign *scan-up* (fetch *val*))
       (&set-type *scan-up* self-evaluating-pointer)
       (dispatch-on-stack))

; SCHEME CHIP STORAGE ALLOCATOR AND GARBAGE COLLECTOR

; MARK is the garbage-collector entry point.  It is called as an interrupt routine
; with one argument being the interrupt point to continue.

; Deutsch-Schorr-Waite mark algorithm
; 3 registers containing pointer data: *STACK-TOP*, *NODE-POINTER*, *LEADER*. 
;    registers accessed using FETCH and ASSIGN operations. 
; a datum may be a pointer or a terminal datum. 
;    this may be tested by POINTER? 
; objects have 2 data parts which can fit a pointer -- car and cdr. 
;    accessed by CAR and CDR functions of pointer to object
;    clobbered by RPLACA and RPLACD functions of
;      a pointer to the object and the replacement datum. 
; objects also have two mark bits -- in-use and car-trace-in-progress. 
;    accessed by IN-USE? and CAR-BEING-TRACED? of pointer to object. 
;    set by MARK-IN-USE!, MARK-CAR-BEING-TRACED!, MARK-CAR-TRACE-OVER! of pointer to object. 

(deftype mark
       (&rplaca (fetch *nil*) (fetch *stack*))
       (assign *node-pointer* (fetch *nil*))
       (assign *stack-top* (fetch *nil*))
       (&set-type *stack-top* gc-special-type)
       (go-to mark-node))

(defpc mark-node
       (assign *leader* (&car (fetch *node-pointer*)))
       (cond ((and (&pointer? (fetch *leader*))
		   (not (&in-use? (fetch *leader*))))
	      (&mark-car-being-traced! (fetch *node-pointer*))
	      (&rplaca-and-mark! (fetch *node-pointer*) (fetch *stack-top*))
	      (go-to down-trace))
	     (t 
	      (&mark-in-use! (fetch *node-pointer*))
	      (go-to trace-cdr))))

(defpc down-trace
       (assign *stack-top* (fetch *node-pointer*))
       (assign *node-pointer* (fetch *leader*))
       (go-to mark-node))

(defpc trace-cdr
       (assign *leader* (&cdr (fetch *node-pointer*)))
       (cond ((and (&pointer? (fetch *leader*)) (not (&in-use? (fetch *leader*))))
	      (&rplacd (fetch *node-pointer*) (fetch *stack-top*))
	      (go-to down-trace))
	     (t (go-to up-trace))))

(defpc up-trace
       (cond ((&=type? (fetch *stack-top*) gc-special-type)
	      (go-to sweep))
	     (t (assign *leader* (fetch *stack-top*))
		(cond ((&car-being-traced? (fetch *leader*))
		       (&mark-car-trace-over! (fetch *leader*))
		       (assign *stack-top* (&car (fetch *leader*)))
		       (&rplaca-and-mark! (fetch *leader*)
					  (fetch *node-pointer*))
		       (assign *node-pointer* (fetch *leader*))
		       (go-to trace-cdr))
		      (t (assign *stack-top* (&cdr (fetch *leader*)))
			 (&rplacd (fetch *leader*) (fetch *node-pointer*))
			 (assign *node-pointer* (fetch *leader*))
			 (go-to up-trace))))))

;Two finger compacting sweep algorithm.
; registers for sweep are: *scan-up*, *scan-down*
; *scan-up* is the newcell register for cons.

; initially, *scan-up* points at the last successfully completed cons.

(defpc sweep
       (simulation (print-gc-stats))
       (&increment-scan-up)
       (assign *scan-down* (fetch *scan-up*))			;initialization
       (assign *scan-up* (fetch *nil*))				;make address = 0
       (&set-type *scan-up* gc-special-type)
       (&clear-gc-needed)
       (go-to scan-down-for-thing))

(defpc scan-down-for-thing
       (&decrement-scan-down)
       (cond ((&scan-up=scan-down?) (go-to relocate-pointers))
	     ((&in-use? (fetch *scan-down*)) (go-to scan-up-for-hole))
	     (t (go-to scan-down-for-thing))))

(defpc scan-up-for-hole
       (cond ((&in-use? (fetch *scan-up*))
	      (&increment-scan-up)
	      (cond ((&scan-up=scan-down?) (go-to relocate-pointers))
		    (t (go-to scan-up-for-hole))))
	     (t (go-to swap-thing-and-hole))))

(defpc swap-thing-and-hole
       (&rplaca-and-mark! (fetch *scan-up*) (&car (fetch *scan-down*)))
       (&rplacd (fetch *scan-up*) (&cdr (fetch *scan-down*)))
       (&rplaca (fetch *scan-down*) (fetch *scan-up*))	;type of *SCAN-UP* is GC-SPECIAL-TYPE
       ;       (&unmark! (fetch *scan-down*)) done by previous rplaca.
       (go-to scan-down-for-thing))

;at relocate-pointers *scan-up* = *scan-down* points at last occupied location.

(defpc relocate-pointers
       (assign *rel-tem-1* (&car (fetch *scan-down*)))
       (cond ((&pointer? (fetch *rel-tem-1*))
	      (assign *rel-tem-2* (&car (fetch *rel-tem-1*)))
	      (cond ((&=type? (fetch *rel-tem-2*) gc-special-type)
		     (&set-type *rel-tem-2* (fetch *rel-tem-1*))
		     (&rplaca (fetch *scan-down*) (fetch *rel-tem-2*))))))
       (assign *rel-tem-1* (&cdr (fetch *scan-down*)))
       (cond ((&pointer? (fetch *rel-tem-1*))
	      (assign *rel-tem-2* (&car (fetch *rel-tem-1*)))
	      (cond ((&=type? (fetch *rel-tem-2*) gc-special-type)
		     (&set-type *rel-tem-2* (fetch *rel-tem-1*))
		     (&rplacd (fetch *scan-down*) (fetch *rel-tem-2*))))))
       (&unmark! (fetch *scan-down*))
       (cond ((&scan-down=0?)
	      (&set-type *scan-up* self-evaluating-pointer)
	      (assign *stack* (&car (fetch *nil*)))	;might have been relocated
	      (&rplaca (fetch *nil*) (fetch *nil*))
	      (simulation (princ '/ ) (prin1 (fetch *scan-up*)))
	      (assign *val* (fetch *nil*))
	      (dispatch-on-stack))
	     (t (&decrement-scan-down)
		(go-to relocate-pointers))))

;forgot to relocate root registers!

(defun print-gc-stats ()
       (print 'sweeping)
       (prin1 (fetch *scan-up*)))

; THE EVALUATOR STARTS HERE

(defmacro save (quantity)
	       `(assign *stack* (&cons ,quantity (fetch *stack*))))

(defmacro restore (register)
	       `(progn (assign ,register (&car (fetch *stack*)))
		       (assign *stack* (&cdr (fetch *stack*)))))


; Lexical access of local variables uses LOOKUP-EXP to get locative to value.

(deftype local					;(LOCAL . lexical-address)
	 (micro-call lookup-exp local-return))

(defpc local-return
       (assign *val* (&car (fetch *display*)))
       (dispatch-on-stack))

(deftype tail-local				;(TAIL-LOCAL . lexical-address)
	 (micro-call lookup-exp tail-local-return))

(defpc tail-local-return
       (assign *val* (fetch *display*))
       (dispatch-on-stack))

(deftype global					;(GLOBAL . symbol) atomic type.
       (assign *val* (&global-value (fetch *exp*)))	;global-value=&car
       (dispatch-on-stack))

(deftype set-local				;(SET-LOCAL . lexical-address)
	 (micro-call lookup-exp set-local-return))

(defpc set-local-return
       (&rplaca (fetch *display*) (fetch *val*))
       (dispatch-on-stack))

(deftype set-tail-local				;(SET-TAIL-LOCAL . lexical-address)
	 (micro-call lookup-exp set-tail-local-return))

(defpc set-tail-local-return
       (&rplacd (fetch *display*) (fetch *val*))
       (dispatch-on-stack))

(deftype set-only-tail-local			;(SET-ONLY-TAIL-LOCAL . lexical-address)
	 (if (&frame=0?)
	     (progn (&rplaca (fetch *display*) (fetch *val*))
		    (dispatch-on-stack))
	     (progn (assign *display* (&cdr (fetch *display*)))
		    (&decrement-frame)
		    (go-to set-only-tail-local))))

(deftype set-global				;(SET-GLOBAL . symbol)
	 (&set-global-value (fetch *exp*) (fetch *val*))	;&set-global-value = &rplaca
	 (dispatch-on-stack))

(defpc lookup-exp
       (if (&frame=0?)
	   (progn (assign *display* (&car (fetch *display*)))
		  (go-to count-displacement))
	   (progn (&decrement-frame)
		  (assign *display* (&cdr (fetch *display*)))
		  (go-to lookup-exp))))

(defpc count-displacement
       (if (&displacement=0?)
	   (micro-return)
	   (progn (&decrement-displacement)
		  (assign *display* (&cdr (fetch *display*)))
		  (go-to count-displacement))))

(deftype self-evaluating-immediate 		;(SELF-EVALUATING-IMMEDIATE . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))

(deftype self-evaluating-immediate-1 		;(SELF-EVALUATING-IMMEDIATE . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))
(deftype self-evaluating-immediate-2 		;(SELF-EVALUATING-IMMEDIATE . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))
(deftype self-evaluating-immediate-3 		;(SELF-EVALUATING-IMMEDIATE . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))
(deftype self-evaluating-immediate-4 		;(SELF-EVALUATING-IMMEDIATE . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))


(deftype self-evaluating-pointer		;(SELF-EVALUATING-POINTER . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))

(deftype symbol					;(SYMBOL . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))

(deftype self-evaluating-pointer-1 		;(SELF-EVALUATING-POINTER . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))
(deftype self-evaluating-pointer-2 		;(SELF-EVALUATING-POINTER . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))
(deftype self-evaluating-pointer-3 		;(SELF-EVALUATING-POINTER . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))
(deftype self-evaluating-pointer-4 		;(SELF-EVALUATING-POINTER . frob)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))

(deftype procedure 				;(PROCEDURE  script . documentation)
	 (assign *val* (&cons (fetch *exp*) (fetch *display*)))
	 (&set-type *val* closure)
	 (dispatch-on-stack))

(deftype conditional				;(CONDITIONAL consequent . alternative)
	 (if (&eq-val (fetch *nil*))
	     (assign *exp* (&cdr (fetch *exp*)))
	     (assign *exp* (&car (fetch *exp*))))
	 (dispatch-on-exp-allowing-interrupts))

(defmicromacro save-cdr-and-eval-car (return-tag)
	  `(progn (&set-type *retpc-count-mark* ,return-tag)
		  (go-to standard-eval)))

(defpc standard-eval
       (save (fetch *display*))
       (&set-type *stack* (fetch *retpc-count-mark*))
       (save (&cdr (fetch *exp*)))
       (&set-type *stack* standard-return)
       (assign *exp* (&car (fetch *exp*)))
       (dispatch-on-exp-allowing-interrupts))

(defreturn standard-return
       (restore *exp*)
       (assign *retpc-count-mark* (fetch *stack*))
       (restore *display*)
       (dispatch (fetch *retpc-count-mark*)))


(deftype sequence				;(SEQUENCE expression . rest)
	 (assign *val* (fetch *nil*))			;for gc
	 (save-cdr-and-eval-car sequence-return))

(defreturn sequence-return
	   (dispatch-on-exp-allowing-interrupts))


(deftype get-control-point			;(GET-CONTROL-POINT variable-setter . rest)
	 (assign *val* (&cons (fetch *stack*) (fetch *nil*)))
	 (&set-type *val* control-point)
	 (save-cdr-and-eval-car sequence-return))

(deftype first-argument				;(FIRST-ARGUMENT arg1 . rest)
	 (save-cdr-and-eval-car first-argument-return))

(defreturn first-argument-return
	   (assign *args* (&cons (fetch *val*) (fetch *nil*)))
	   (save (fetch *args*))
	   (dispatch-on-exp-allowing-interrupts))

(deftype next-argument				;(NEXT-ARGUMENT arg . rest)
	 (save (fetch *args*))
	 (save-cdr-and-eval-car next-argument-return))

(defreturn next-argument-return
	   (restore *args*)
	   (&rplacd (fetch *args*) (&cons (fetch *val*) (fetch *nil*)))
	   (assign *args* (&cdr (fetch *args*)))
	   (dispatch-on-exp-allowing-interrupts))

(deftype last-argument				;(LAST-ARGUMENT arg . fun)
	 (save (fetch *args*))
	 (save-cdr-and-eval-car last-argument-return))

(defreturn last-argument-return
	   (restore *args*)
	   (&rplacd (fetch *args*) (&cons (fetch *val*) (fetch *nil*)))
	   (eval-exp-popj-to internal-apply))	;Amazing! Where did retpc go?

(deftype apply-1-arg				;(APPLY-1-ARG arg . fn)
	 (save-cdr-and-eval-car apply-1-arg-return))

(defreturn apply-1-arg-return
	   (assign *args* (&cons (fetch *val*) (fetch *nil*)))
	   (save (fetch *args*))
	   (eval-exp-popj-to internal-apply))

(deftype apply-no-args				;(APPLY-NO-ARGS fn . ?)
	 (assign *exp* (&car (fetch *exp*)))
	 (save (fetch *nil*))				;losey,losey -- gotta have a
	 (eval-exp-popj-to internal-apply))	;place for retpc.

(deftype spread-argument			;(SPREAD-ARGUMENT arg . fun)
	 (save-cdr-and-eval-car spread-argument-return))

(defreturn spread-argument-return
	   (save (fetch *val*))
	   (eval-exp-popj-to internal-apply))

(defreturn internal-apply			;function is in *val*
	   (restore *args*)
	   (assign *exp* (fetch *val*))
	   (dispatch-on-exp-allowing-interrupts))

(deftype closure				;(CLOSURE script . display)
	 (assign *display*
		 (&cons (fetch *args*) (&cdr (fetch *exp*))))
	 (assign *exp* (&car (&car (fetch *exp*))))
	 (dispatch-on-exp-allowing-interrupts))

(deftype control-point				;(CONTROL-POINT . state)
	 (assign *val* (&car (fetch *args*)))
	 (assign *stack* (&car (fetch *exp*)))
	 (dispatch-on-stack))

(deftype interrupt-point			;(INTERRUPT-POINT . state)
	 (assign *stack* (fetch *exp*))
	 (restore *val*)
	 (restore *display*)
	 (go-to restore-exp-args-dispatch))

(deftype primitive-apply-1			;(PRIMITIVE-APPLY-1 arg . primop)
	 (save (&cdr (fetch *exp*)))
	 (assign *exp* (&car (fetch *exp*)))
	 (eval-exp-popj-to primitive-apply-1-return))

(defreturn primitive-apply-1-return
	   (restore *exp*)
	   (dispatch-on-exp-allowing-interrupts))

(deftype primitive-car				;(PRIMITIVE-CAR . ?)
	 (assign *val* (&car (fetch *val*)))
	 (dispatch-on-stack))

(deftype primitive-cdr				;(PRIMITIVE-CDR . ?)
	 (assign *val* (&cdr (fetch *val*)))
	 (dispatch-on-stack))

(deftype primitive-type?			;(PRIMITIVE-TYPE? . ?)
	 (assign *exp* (fetch *val*))
	 (assign *val* (fetch *nil*))
	 (&set-type *val* (fetch *exp*))		;build "prototype".
	 (dispatch-on-stack))

(deftype primitive-not-atom
	 (if (&pointer? (fetch *val*))
	     (progn (assign *val* (fetch *nil*))
		    (&set-type *val* self-evaluating-immediate))	;T
	     (assign *val* (fetch *nil*)))
	 (dispatch-on-stack))

(deftype primitive-zerop
	 (if (&val=0?)
	     (progn (assign *val* (fetch *nil*))
		    (&set-type *val* self-evaluating-immediate))	;T
	     (assign *val* (fetch *nil*)))
	 (dispatch-on-stack))

(deftype primitive-sub1
	 (assign *scan-down* (fetch *val*))
	 (&decrement-scan-down-to-val)
	 (dispatch-on-stack))

(deftype primitive-add1
	 (assign *exp* (fetch *scan-up*))
	 (assign *scan-up* (fetch *val*))
	 (&increment-scan-up-to-val)
	 (assign *scan-up* (fetch *exp*))
	 (dispatch-on-stack))

(deftype primitive-displacement-add1
	 (assign *exp* (fetch *nil*))
	 (&decrement-frame)				;make -1 in frame part
	 (&val-displacement-to-exp-displacement)
	 (assign *args* (fetch *scan-up*))
	 (assign *scan-up* (fetch *exp*))
	 (&increment-scan-up)
	 (assign *exp* (fetch *scan-up*))
	 (&val-frame-to-exp-frame)
	 (assign *val* (fetch *exp*))
	 (dispatch-on-stack))



; Expected to be used until all except last arg built up in *args*.  Thus cons = list*

(deftype primitive-apply-2			;(PRIMITIVE-APPLY-2 arg . primop)
	 (save (fetch *args*))
	 (save (&cdr (fetch *exp*)))
	 (assign *exp* (&car (fetch *exp*)))
	 (eval-exp-popj-to restore-exp-args-dispatch))

(defreturn restore-exp-args-dispatch
	   (restore *exp*)
	   (restore *args*)
	   (dispatch-on-exp-allowing-interrupts))

(deftype primitive-cons
	 (&rplacd (fetch *args*) (fetch *val*))
	 (restore *val*)
	 (dispatch-on-stack))

(deftype primitive-eq
	 (restore *args*)
	 (assign *args* (&car (fetch *args*)))
	 (if (&eq-val (fetch *args*))
	     (progn (assign *val* (fetch *nil*))
		    (&set-type *val* self-evaluating-immediate))	;T
	     (assign *val* (fetch *nil*)))
	 (dispatch-on-stack))

(deftype primitive-rplaca
	 (restore *args*)
	 (assign *val* (&rplaca (&car (fetch *args*)) (fetch *val*)))
	 (dispatch-on-stack))

(deftype primitive-rplacd
	 (restore *args*)
	 (assign *val* (&rplacd (&car (fetch *args*)) (fetch *val*)))
	 (dispatch-on-stack))

(deftype primitive-type!
	 (restore *args*)
	 (assign *exp* *val*)
	 (assign *val* (&car (fetch *args*)))
	 (&set-type *val* (fetch *exp*))
	 (dispatch-on-stack))

(simulation 
(deftype lisp-function					;(LISP-FUNCTION . symbol)
	 (let ((val (apply (cdr (fetch *exp*)) (get-lisp-args (fetch *args*)))))
	      (assign *val*
		      (cond (val (immediate-data self-evaluating-immediate val))
			    (t (fetch *nil*)))))
	 (dispatch-on-stack))

(defun get-lisp-args (l)
       (cond ((equal l (fetch *nil*)) nil)
	     (t (cons (cond ((equal (&car l) (fetch *nil*)) nil)
			    (t (address (&car l))))
		      (get-lisp-args (&cdr l))))))
)

(defun define fexpr (gorp)
       (let ((zarg (defambiguate gorp)))
	    (*define (car zarg) (cdr zarg) gorp)))

(defun *define (name defn l)
       (let ((realdefn (cond (defn
			      (and (eq (car defn) 'lambda)
				   (putprop name
					    defn
					    'scheme!function)))
			     ((get name 'scheme!function)))))
	    (or (and (eq (typep name) 'symbol)
		     realdefn)
		(error '|Bad Definition| (cons 'define l) 'fail-act))
	    (let ((closure (enclose realdefn '())))
		 (&set-global-value (scheme-intern name) closure)
		 name)))

(defun defambiguate (defn)
       (cond ((null (cdr defn)) (cons (car defn) nil))	;crock for DEFINE
	     ((not (atom (car defn)))
	      (cons (caar defn) `(lambda ,(cdar defn) . ,(cdr defn))))
	     ((null (cddr defn)) (cons (car defn) (cadr defn)))
	     (t (cons (car defn) `(lambda ,(cadr defn) . ,(cddr defn))))))

(defun scheme-intern (the-symbol)
  (do ((obl (&cdr (fetch *nil*)) (&cdr obl)))
      ((equal obl (fetch *nil*))
       (let ((newsym (typed-cons symbol
			  (cond ((getl the-symbol '(expr subr lsubr))
				 (immediate-data lisp-function the-symbol))
				(t (fetch *nil*)))		;the value cell
			  (immediate-data self-evaluating-immediate the-symbol))))
	    (&rplacd (fetch *nil*) (typed-cons self-evaluating-pointer
				       newsym
				       (&cdr (fetch *nil*))))
	    newsym))
      (cond ((eq (address (&cdr (&car obl))) the-symbol)
	     (return (&car obl))))))

;;; The compiler

(defun enclose (lexp alist)
       (typed-cons closure
		   (tcomp lexp
			  (and alist (list (mapcar (function car) alist))))
		   (fetch *nil*)))

(defun tcomp (exp env)
       (cond ((atom exp)
	      (cond ((numberp exp) (immediate-data self-evaluating-immediate exp))
		    ((eq exp 'nil) (fetch *nil*))
		    ((symbolp exp) (tcomp-symbol exp env))
		    (t (error '|Unknown data type in program source code|
			      exp 'fail-act))))
	     ((symbolp (car exp))
	      (let ((foo (get (car exp) 'magic)))
		   (cond ((null foo) (tcomp-apply exp env))
			 (t (funcall foo exp env)))))
	     (t (tcomp-apply exp env))))

(defun tcomp-symbol (symbol env)
       (do ((e env (cdr e))
	    (frame 0 (+ frame 1)))
	   ((null e) (immediate-data global (address (scheme-intern symbol))))
	   (declare (fixnum frame))
	   (let ((foo
		  (do ((b (car e) (cdr b))
		       (displacement 0 (+ displacement 1)))
		      ((atom b)
		       (and (not (null b))
			    (eq symbol b)
			    (immediate-data tail-local
					    (cons frame displacement))))
		      (and (eq symbol (car b))
			   (return (immediate-data local
						   (cons frame
							 displacement)))))))
		(and foo (return foo)))))

(defun tcomp-apply (exp env)
       (cond ((null (cdr exp))
	      (typed-cons apply-no-args
			  (tcomp (car exp) env)
			  (fetch *nil*)))
	     ((null (cddr exp))
	      (typed-cons apply-1-arg
			  (tcomp (cadr exp) env)
			  (tcomp (car exp) env)))
	     (t (typed-cons first-argument
			    (tcomp (cadr exp) env)
			    (tcomp-apply-iter (cddr exp)
					      env
					      (tcomp (car exp) env))))))

(defun tcomp-apply-iter (exp env fun)
       (cond ((null (cdr exp))
	      (typed-cons last-argument
			  (tcomp (car exp) env)
			  fun))
	     (t (typed-cons next-argument
			    (tcomp (car exp) env)
			    (tcomp-apply-iter (cdr exp) env fun)))))

(defun (aset magic) (exp env)
       (cond ((or (atom (cadr exp))
		  (not (eq (caadr exp) 'quote))
		  (not (symbolp (cadadr exp))))
	      (error '|ASET of non-quoted argument is not implemented - you lose!|
		     exp 'fail-act))
	     (t (typed-cons sequence
			    (tcomp (caddr exp) env)
			    (varsetter (tcomp (cadadr exp) env)
				       exp)))))

(defun varsetter (slot exp)
       (cond ((eq (car slot) (pctag global))
	      (immediate-data set-global (address slot)))
	     ((eq (car slot) (pctag local))
	      (immediate-data set-local (address slot)))
	     ((eq (car slot) (pctag tail-local))
	      (cond ((zerop (cdr (address slot)))
		     (immediate-data set-only-tail-local (address slot)))
		    (t (immediate-data set-tail-local
				       (cons (car (address slot))
					     (- (cdr (address slot))
						1))))))
	     (t (error '|Unknown variable type - ASET| exp 'fail-act))))

(defun (if magic) (exp env)
       (typed-cons sequence
		   (tcomp (cadr exp) env)
		   (typed-cons conditional
			       (tcomp (caddr exp) env)
			       (tcomp (cadddr exp) env))))

(defun (block magic) (exp env)
       (block-iter (cdr exp) env))

(defun block-iter (exp env)
       (cond ((null (cdr exp))
	      (tcomp (car exp) env))
	     (t (typed-cons sequence
			    (tcomp (car exp) env)
			    (block-iter (cdr exp) env)))))

(defun (quote magic) (exp env)
       (cond ((atom (cadr exp))
	      (immediate-data self-evaluating-immediate (cadr exp)))
	     (t (immediate-data self-evaluating-pointer (cadr exp)))))

(defun (lambda magic) (exp env)
       (typed-cons procedure
		   (tcomp (blockify (cddr exp))
			  (cons (cadr exp) env))
		   (immediate-data self-evaluating-immediate
				   (cons exp env))))

(defun blockify (x)
       (cond ((null (cdr x)) (car x))
	     (t (cons 'block x))))

(defun (get-control-point magic) (exp env)
       (typed-cons get-control-point
		   (varsetter (tcomp (cadr exp) env) exp)
		   (tcomp (blockify (cddr exp)) env)))

(defun (car magic) (exp env)
       (typed-cons primitive-apply-1
		   (tcomp (cadr exp) env)
		   (immediate-data primitive-car nil)))

(defun (cdr magic) (exp env)
       (typed-cons primitive-apply-1
		   (tcomp (cadr exp) env)
		   (immediate-data primitive-cdr nil)))

(defun (mark magic) (exp env) (immediate-data mark nil))

(defun (1+ magic) (exp env)
       (typed-cons primitive-apply-1
		   (tcomp (cadr exp) env)
		   (immediate-data primitive-add1 nil)))

(defun (1+displacement magic) (exp env)
       (typed-cons primitive-apply-1
		   (tcomp (cadr exp) env)
		   (immediate-data primitive-displacement-add1 nil)))

(defun (1- magic) (exp env)
       (typed-cons primitive-apply-1
		   (tcomp (cadr exp) env)
		   (immediate-data primitive-sub1 nil)))

(defun (zerop magic) (exp env)
       (typed-cons primitive-apply-1
		   (tcomp (cadr exp) env)
		   (immediate-data primitive-zerop nil)))

(defun (natom magic) (exp env)
       (typed-cons primitive-apply-1
		   (tcomp (cadr exp) env)
		   (immediate-data primitive-not-atom nil)))

(defun (atom magic) (exp env)
       (tcomp `(not (natom ,(cadr exp))) env))

(defun (type? magic) (exp env)
       (typed-cons primitive-apply-1
		   (tcomp (cadr exp) env)
		   (pointer primitive-type? nil)))

(defun (eq magic) (exp env)
       (typed-cons first-argument
		   (tcomp (cadr exp) env)
		      (typed-cons primitive-apply-2
				  (tcomp (caddr exp) env)
				  (immediate-data primitive-eq nil))))

(defun (cons magic) (exp env)
       (typed-cons first-argument
		   (tcomp (cadr exp) env)
		      (typed-cons primitive-apply-2
				  (tcomp (caddr exp) env)
				  (immediate-data primitive-cons nil))))

(defun (rplaca magic) (exp env)
       (typed-cons first-argument
		   (tcomp (cadr exp) env)
		   (typed-cons primitive-apply-2
			       (tcomp (caddr exp) env)
			       (immediate-data primitive-rplaca nil))))

(defun (rplacd magic) (exp env)
       (typed-cons first-argument
		   (tcomp (cadr exp) env)
		   (typed-cons primitive-apply-2
			       (tcomp (caddr exp) env)
			       (immediate-data primitive-rplacd nil))))

(defun (type! magic) (exp env)
       (typed-cons first-argument
		   (tcomp (cadr exp) env)
		   (typed-cons primitive-apply-2
			       (tcomp (caddr exp) env)
			       (immediate-data primitive-type! nil))))

(defun (list* magic) (exp env)
       (cond ((null (cdr exp)) *nil*)
	     ((null (cddr exp)) (tcomp (cadr exp) env))
	     (t (typed-cons first-argument
			    (tcomp (cadr exp) env)
			    (tcomp-list*-iter (cddr exp) env)))))

(defun tcomp-list*-iter (exp env)
       (cond ((null (cdr exp))
	      (typed-cons primitive-apply-2
			  (tcomp (car exp) env)
			  (immediate-data primitive-cons nil)))
	     (t (typed-cons next-argument
			    (tcomp (car exp) env)
			    (tcomp-list*-iter (cdr exp) env)))))

(defun (list magic) (exp env)
       (tcomp `((lambda x x) . ,(cdr exp)) env))


(defun (spread magic) (exp env)
       (typed-cons spread-argument
		   (tcomp (caddr exp) env)
		   (tcomp (cadr exp) env)))

(defun (nthq magic) (exp env)
  (typed-cons spread-argument
	      (tcomp (caddr exp) env)
	      (typed-cons procedure
			  (immediate-data local (cons 0 (cadr exp)))
			  (immediate-data self-evaluating-immediate exp))))

(defun (nthcdrq magic) (exp env)
  (typed-cons spread-argument
	      (tcomp (caddr exp) env)
	      (typed-cons procedure
			  (immediate-data tail-local (cons 0 (cadr exp)))
			  (immediate-data self-evaluating-immediate exp))))

(defun (setnthq magic) (exp env)
  (typed-cons spread-argument
      (tcomp (caddr exp) env)
      (typed-cons procedure
	  (typed-cons sequence
	      (tcomp (cadddr exp) env)
	      (immediate-data set-local (cons 0 (cadr exp))))
	  (immediate-data self-evaluating-immediate exp))))

(defun (setnthcdrq magic) (exp env)
  (typed-cons spread-argument
      (tcomp (caddr exp) env)
      (typed-cons procedure
	  (typed-cons sequence
	      (tcomp (cadddr exp) env)
	      (immediate-data set-tail-local (cons 0 (cadr exp))))
	  (immediate-data self-evaluating-immediate exp))))

(defun schmac-macro (exp env)
       (tcomp (funcall (get (car exp) 'amacro) exp) env))

(defun macro-macro (exp env)
       (tcomp (scheme-apply (symeval (get (car exp) 'smacro)) (list exp)) env))       

(declare (/@define schmac |scheme macro|) (macros t))

(defun schmac macro (x)			;define SCHEME macro
       ((lambda (newname)
		`(progn 'compile
			(defprop ,(cadr x) schmac-macro magic)
			(defprop ,(cadr x) ,newname amacro)
			(defun ,newname (*z*)
			       ((lambda ,(do ((a (caddr x) (cdr a))
					      (b nil (cons (car a) b)))
					     ((or (null a)
						  (eq (typep a) 'symbol))
					      (cond ((null a) (nreverse b))
						    (t (nreverse
							(cons a b))))))
					,(cadddr x))
				,@(do ((a (caddr x) (cdr a))
				       (b '(cdr *z*) `(cdr ,b))
				       (c nil (cons `(car ,b) c)))
				      (nil)
				      (cond ((null a) (return (nreverse c)))
					    ((eq (typep a) 'symbol)
					     (return
					      (nreverse (cons b c))))))))))
	(implode (append (explodec (cadr x)) '(- a m a c r o)))))

;;; The macro MACRO must itself be a SCHMAC, not a LISP macro, so that
;;; it will have higher priority in the SCHEME interpreter than the MACRO macro
;;; used in the LISP DEFMACRO package.

(schmac macro (name vars body)
       ((lambda (newname)
		`(progn 'compile
			(defprop ,name macro-macro magic)
			(defprop ,name ,newname smacro)
			(define ,newname (*z*)
				((lambda ,(do ((a vars (cdr a))
					       (b nil (cons (car a) b)))
					      ((or (null a)
						   (eq (typep a) 'symbol))
					       (cond ((null a) (nreverse b))
						     (t (nreverse
							 (cons a b))))))
					 ,body)
				 ,@(do ((a vars (cdr a))
					(b '(cdr *z*) `(cdr ,b))
					(c nil (cons `(car ,b) c)))
				       (nil)
				       (cond ((null a) (return (nreverse c)))
					     ((eq (typep a) 'symbol)
					      (return
					       (nreverse (cons b c))))))))))
	(implode (append (explodec name) '(- s m a c r o)))))

(schmac let (defns . body)
	`((lambda ,(mapcar 'car defns) ,(blockify body))
	   ,@(mapcar 'cadr defns)))

(declare (special **doname** **dobody**))

(setq **doname** (maknam (explodec '*doloop*)))

(schmac do (specs end . body)
	`(labels ((,**doname**
		   (lambda ,(mapcar 'car specs)
			    (if ,(car end)
				,(blockify (cdr end))
				,(blockify
				    (append body
					`((,**doname** 
					  ,@(mapcar '(lambda (y)
							     (cond ((and (cdr y)
									 (cddr y))
								    (caddr y))
								   (t (car y))))
						    specs)))))))))
		 (,**doname** ,@(mapcar '(lambda (y) (and (cdr y) (cadr y))) specs))))

(schmac iterate (name varinits . body)
	`(labels ((,name (lambda ,(mapcar 'car varinits) ,(blockify body))))
		 (,name . ,(mapcar 'cadr varinits))))

(schmac test (pred fn alt)
	`((lambda (p f a)
		  (if p ((f) p) (a)))
	  ,pred
	  (lambda () ,fn)
	  (lambda () ,alt)))

(schmac cond clauses
	(cond ((null clauses) nil)
	      ((eq (caar clauses) 't)
	       (blockify (cdar clauses)))		;bum
	      ((null (cdar clauses))
	       `(or ,(caar clauses)
		     (cond . ,(cdr clauses))))
	      ((eq (cadar clauses) '=>)
	       `(test ,(caar clauses)
		       ,(caddar clauses)
		       (cond . ,(cdr clauses))))
	      (t `(if ,(caar clauses)
		       ,(blockify (cdar clauses))
		       (cond . ,(cdr clauses))))))

(schmac or args
	(cond ((null args) nil)
	      ((null (cdr args)) (car args))
	      (t `((lambda (p r) (if p p (r)))
		    ,(car args)
		    (lambda () (or . ,(cdr args)))))))

(schmac and args
	(cond ((null args) t)
	      ((null (cdr args)) (car args))
	      (t `(if ,(car args) (and . ,(cdr args)) nil))))

(defun orify (x)
       (cond ((null x) nil)
	     ((null (cdr x)) (car x))
	     (t (cons 'or x))))

(schmac amapcar (fn . arglists)
	((lambda (fnname result names)
		 `(do ((,fnname ,fn)
		       ,@(mapcar '(lambda (y n) `(,n ,y (cdr ,n)))
				 arglists
				 names)
		       (,result
			nil
			(cons (,fnname ,@(mapcar '(lambda (y) `(car ,y))
						 names))
			      ,result)))
		      (,(orify (mapcar '(lambda (n) `(null ,n)) names))
		       (nreverse ,result))))
	 (gensym)
	 (gensym)
	 (mapcar '(lambda (x) (gensym)) arglists)))

(schmac amaplist (fn . arglists)
	((lambda (fnname result names)
		 `(do ((,fnname ,fn)
		       ,@(mapcar '(lambda (y n) `(,n ,y (cdr ,n)))
				 arglists
				 names)
		       (,result nil (cons (,fnname ,@names) ,result)))
		      (,(orify (mapcar '(lambda (n) `(null ,n)) names))
		       (nreverse ,result))))
	 (gensym)
	 (gensym)
	 (mapcar '(lambda (x) (gensym)) arglists)))

(schmac amapc (fn . arglists)
	((lambda (fnname names)
		 `(do ((,fnname ,fn)
		       ,@(mapcar '(lambda (y n) `(,n ,y (cdr ,n)))
				 arglists
				 names))
		      (,(orify (mapcar '(lambda (n) `(null ,n)) names))
		       nil)
		      (,fnname ,@(mapcar '(lambda (y) `(car ,y))
					 names))))
	 (gensym)
	 (mapcar '(lambda (x) (gensym)) arglists)))

(schmac aarraycall (type . args)
	`(funcall ,@args))

(schmac labels (procspecs . body)
       (let ((stuff (mapcar (function defambiguate) procspecs)))
	    `((lambda ,(mapcar 'car stuff)
		      (block ,@(mapcar '(lambda (spec)
						`(aset' ,(car spec) ,(cdr spec)))
				       stuff)
			     ,@body))
	      ,@(mapcar '(lambda (x) nil) stuff))))

(schmac catch (var . body) `(let ((,var nil)) (get-control-point ,var ,@body)))

(defun e (n)
       (list (**the-cars** n)
	     (**the-cdrs** n)
	     (**in-use-marks** n)
	     (**car-being-traced-marks** n)))

(setq edit (list* 'scheme!function edit))

(defun compile-to-++ (e)
	(&set-global-value (scheme-intern '++)
			   (enclose `(lambda () ,e) nil)))

(setq read-eval-print-loop
      '(lambda ()
	       (terpri)
	       (princ '|==> |)
	       (compile-to-++ (read))
	       (aset '** (++))
	       (print **)
	       (read-eval-print-loop)))

(setq gc-interrupt
      '(lambda return (mark) (print 'GC!) (return)))

(setq user-interrupt '(lambda return (print 'HI!) (return)))

(memory-alloc 1000)

(sstatus ttyint 1 '(lambda (f c) (cause-interrupt)) tyi)

