(defun st (obj rot)
       (stipple-to-file obj (mapcar 'fix (boundaries obj)) '|ai:schip2;mpla xgp| rot))

(setq base 10. ibase 10.)

(defun elide (bit# n)
   (let ((base 2)
	 (ibase 2))
	(readlist (cons '/0 (reverse (delete-nth bit# (reverse (explodec n))))))))

(defun delete-nth (n l)
   (cond ((null l) nil)
	 ((<= n 0) (cdr l))
	 (t (cons (car l) (delete-nth (1- n) (cdr l))))))

(defun get-state (x #ands)
   (cond ((atom x) (list x (1- (^ 2 #ands))))
	 (t x)))



;Produce list of names from field specs.
;Field spec is of form:
;	(FIELD number (name type width position output-gating bit-reverse-flag))
; output gating is the name of the output clock signal (usually PH2)
; or "un-clocked" or nil which means no different from previous field.
;assume field specs are LSB - MSB, return names LSB first
;list of form (name ... *gnd* *break* ...)
; where *gnd* means insert a gnd mesh in this or plane
; where *break* means insert a gap to break the output gating
; <name> is of form (name gate) if folded
;		or (name1 name2 gate) if unfolded.
; gate can be "un-clocked" which may cause a different output driver
;  if compiling an unfolded PLA

(defun explode-or-fields (fields gnd-mesh folded-p)
   (let ((l (explode-gated fields)))
	(if (not folded-p) (setq l (explode-merge l)))
	(mesh-grounds l gnd-mesh)))

(defun explode-gated (fields)
    (do ((fl fields (cdr fl))
	 (out-gate nil)
	 (out nil))
	((null fl) (reverse out))
	(let* ((spec (third (car fl)))
	       (name (first spec))
	       (type (second spec))
	       (size (third spec))
	       (gate (fifth spec)))
	      (cond ((null out-gate) (setq out-gate gate))
		    ((and gate (neq gate out-gate))
		     (push '*break* out)
		     (setq out-gate gate)))
	      (caseq type
		     (BIT (push (list name out-gate) out))
		     (NUMBER
		      (do ((i 0 (1+ i)))
			  ((= i size))
			  (push (list (concat name '- i) out-gate)
				out)))
		     (BIT-REVERSE
		      (do ((i (1- size) (1- i)))
			  ((< i 0))
			  (push (list (concat name '- i) out-gate)
				out)))
		     (t (error '|Garbage field list| fl))))))

(defun explode-merge (l)
   (cond ((null l) nil)
	 ((atom (car l)) (cons (car l) (explode-merge (cdr l))))
	 ((and (not (atom (cadr l)))
	       (eq (second (car l))
		   (second (cadr l))))
	  (cons (list (caar l) (caadr l) (cadar l))
		(explode-merge (cddr l))))
	 (t (cons (list (caar l) nil (cadar l))
		  (explode-merge (cdr l))))))

(defun mesh-grounds (list gnd-mesh)
   (do ((count 0 (1+ count))
	(l list (cdr l))
	(brk)
	(out nil))
       ((null l) (reverse out))
       (cond ((eq (car l) '*break*) (setq count -1))
	     ((and (>= count gnd-mesh)			;No gnd for a while?
		   (> (length l) 1)
		   (or (not (setq brk (find-position-in-list '*break* l)))
		       (> brk 1)))
	      (push '*gnd* out)
	      (setq count 0)))
       (push (car l) out)))

(defun explode-fields (fields)
    (do ((fl fields (cdr fl))
	 (f)
	 (out nil))
	((null fl) (reverse out))
	(caseq (second (setq f (third (car fl))))
	    (BIT (push (first f) out))
	    (BIT-REVERSE
	     (do ((i (1- (third f)) (1- i)))
		 ((< i 0))
		 (push (concat (first f) '- i) out)))
	    (NUMBER
	     (do ((i 0 (1+ i)))
		 ((= i (third f)))
		 (push (concat (first f) '- i) out)))
	    (t (error '|Garbage field list| f)))))

(defun explode-gates (fields)
    (do ((fl fields (cdr fl))
	 (f)
	 (out nil))
	((null fl) (reverse out))
	(caseq (second (setq f (third (car fl))))
	    (BIT (push (fifth f) out))
	    (BIT-REVERSE
	     (do ((i (1- (third f)) (1- i)))
		 ((< i 0))
		 (push (fifth f) out)))
	    (NUMBER
	     (do ((i 0 (1+ i)))
		 ((= i (third f)))
		 (push (fifth f) out)))
	    (t (error '|Garbage field list| f)))))

;;;PLA parts

(deflayout pla-cell-pair ()
   (let ((dx 14) (dy -14)
	 (y1 -4) (y2 -11)
	 (x1 2))
	(set-the' h-pitch dx)
	(set-the' v-pitch dy)
	(set-the' first-poly 6)
	(set-the' second-poly 12)
	(set-the' first-metal 4)
	(set-the' second-metal 11)

	(boxes (metal 4.0) (pt 0.0 y1) (+x dx))
	(contact S diff (pt 2 y1))

	(boxes (metal 4.0) (pt 0.0 y2) (+x dx))
	(contact S diff (pt 2 y2))

	(boxes poly (pt 6 0) (+Y dy))
	(boxes diff (pt 9 0) (+Y dy))
	(boxes poly (pt 12 0) (+Y dy))))

(deflayout pullup-gnd (gnd-width)
	   (set-the' v-pitch -10)
	   (set-the' pullup-pair (invoke 'pullup-pair (list gnd-width)))
	   (set-the' vdd (wire (metal 4) (pt (the-x end vdd pullup-pair) 0) (Y -10)))
	   (set-the' vdd2 (wire (metal 4) (pt (the-x end vdd pullup-pair) -5)
				(X (the-x vdd2 pullup-pair))))
	   (set-the' gnd (wire (metal gnd-width) (pt (the-x end gnd pullup-pair) 0) (y -10)))
	   (boxes (metal 4) (pt (the-x end gnd) -5) (X (the h-pitch pullup-pair))))

(DEFLAYOUT PULLUP-PAIR (gnd-width)
	   (set-the' h-pitch (+ 32. gnd-width))
	   (set-the' v-pitch -14)
	   (set-the' vdd2 (pt -5 -7))			;where the outside VDD will go
           (BOXES (DIFF 4.0) (PT 0.0 -6.0) (+X 5.0))
           (BOXES (POLY 4.0) (PT 0.0 -3.0) (+X 4.0))
           (BOXES (METAL 6.0) (PT 0.0 -5.0) (+X 4.0))
           (BOXES (CUTS 4.0) (PT 1.0 -5.0) (+X 2.0))
           (BOXES (DIFF 2.0) (PT 3.0 -11.0) (X (the h-pitch)))
           (BOXES (DIFF 2.0) (PT 3.0 -5.0) (+X 9.0))
           (BOXES (DIFF 5.0) (PT 3.0 -9.5) (+X 2.0))
           (BOXES (IMPLANT 6.0) (PT 4.0 -5.0) (+X 8.0))
           (BOXES (POLY 2.0) (PT 4.0 -2.0) (+X 6.0))
           (BOXES (POLY 6.0) (PT 6.0 -5.0) (+X 4.0))

	   (set-the' vdd (wire (metal 4) (pt 13 0) (Y -14)))

           (BOXES (DIFF 4.0) (PT 11.0 -5.0) (+X 4.0))
           (BOXES (CUTS 2.0) (PT 12.0 -5.0) (+X 2.0))
           (BOXES (CUTS 2.0) (PT 12.0 -5.0) (+X 2.0))
           (BOXES (DIFF 2.0) (PT 14.0 -5.0) (+X 9.0))
           (BOXES (IMPLANT 6.0) (PT 14.0 -5.0) (+X 8.0))
           (BOXES (POLY 6.0) (PT 16.0 -5.0) (+X 4.0))
           (BOXES (POLY 2.0) (PT 16.0 -8.0) (+X 6.0))

           (BOXES (DIFF 4.0) (PT 21.0 -4.0) (X (the h-pitch)))
	   (set-the' gnd (wire (metal gnd-width)
			       (pt (+ 29 (// gnd-width 2)) 0)
			       (Y -14)))

           (BOXES (POLY 4.0) (PT 22.0 -7.0) (+X 4.0))
           (BOXES (METAL 6.0) (PT 22.0 -5.0) (+X 4.0))
           (BOXES (CUTS 4.0) (PT 23.0 -5.0) (+X 2.0)))


(deflayout pla-gnd-cross nil
	   (set-the' pla-gnd (invoke 'pla-gnd nil))
	   (set-the' pla-connect (invoke 'pla-connect nil))
	   (set-the' h-pitch (the h-pitch pla-connect))
	   (boxes (metal 4) (pt 0 (the-y end gnd pla-gnd)) (X (the-x end gnd pla-connect)))
	   (boxes (metal 4) (pt (the-x end gnd pla-connect) 0) (Y -10)))

(deflayout pla-connect nil
	   (set-the' h-pitch 16)
           (boxes (metal 4.0) (pt 0.0 -4.0) (+x 6.0))
           (boxes (diff 4.0) (pt 0.0 -4.0) (+x 4.0))
           (boxes (diff 4.0) (pt 0.0 -11.0) (+x 4.0))
           (boxes (metal 4.0) (pt 0.0 -11.0) (+x 6.0))
           (boxes (cuts 2.0) (pt 1.0 -4.0) (+x 2.0))
           (boxes (cuts 2.0) (pt 1.0 -11.0) (+x 2.0))
           (boxes (cuts 2.0) (pt 3.0 -4.0) (+x 2.0))
           (boxes (cuts 2.0) (pt 3.0 -11.0) (+x 2.0))
           (boxes (poly 4.0) (pt 3.0 -11.0) (+x 3.0))
           (boxes (poly 2.0) (pt 4.0 -12.0) (x 16))	;poly 2 out
           (boxes (poly 4.0) (pt 3.0 -4.0) (X 6))
           (boxes (poly 2.0) (pt 6.0 -4.0) (X 16))	;poly 1 out
	   (set-the' gnd (wire (metal 4) (pt 11 0) (Y -14)))
;           (boxes (metal 14.0) (pt 9.0 -7.0) (+x 4.0))
           (boxes (diff 4.0) (pt 9.0 -8.0) (+x 4.0))
           (boxes (cuts 2.0) (pt 10.0 -8.0) (+x 2.0))
           (boxes (diff 2.0) (pt 11.0 -9.0) (X 16))	;gnd on diff
           (boxes (poly 4.0) (pt 14.0 -5.0) (+x 2.0)))

(deflayout pla-diff-gnd ()
	   (set-the' v-pitch -14)
	   (set-the' h-pitch 10)
	   (set-the' first-contact (pt 2 -4))
	   (contact S diff (the first-contact))
	   (boxes (metal 4) (the first-contact) (X (the h-pitch)))
	   (set-the' second-contact (pt 2 -11))
	   (contact S diff (the second-contact))
	   (boxes (metal 4) (the second-contact) (X (the h-pitch))))


(deflayout pla-or-gnd ()
	   (set-the' v-pitch -10)
	   (set-the' h-pitch 10)
	   (boxes (metal 4) (pt 0 -5) (X (the h-pitch))))

; Origin is upper-left, -10 Lambda high, 
(deflayout pla-In-gnd nil
	   (set-the' height 10)

	   (boxes (poly 2) (pt 7 -9) (X 4) (Y -1) (X 7))	;left poly
							;connect at X = 4 or 6
	   (boxes (poly 2) (pt 12 -10) (Y 0))		;right poly

	   (contact S diff (pt 8 -5))
           (set-the' gnd (wire (metal 4.0) (pt 0.0 -5.0) (+x 14.0)))
	   (boxes (diff 2) (pt 9 -9) (Y 0)))		;gnd

; Origin is upper-left, -10 Lambda high, 
(deflayout pla-gnd nil
	   (set-the' height 10)

	   (boxes (poly 2) (pt 7 -9) (X 4) (Y -1) (X 7))	;left poly
							;connect at X = 4 or 6
	   (boxes (poly 2) (pt 12 -10) (Y 0))		;right poly

	   (contact S diff (pt 8 -5))
           (set-the' gnd (wire (metal 4.0) (pt 0.0 -5.0) (x 14.0)))
	   (boxes (diff 2) (pt 9 -10) (Y 0)))		;gnd

;Origin is in upper right, box overlaps 1 unit over right boundary
(deflayout PlaIn nil
           (set-the' VDD (wire (metal 4.0) (pt -14.0 -16.0) (+x 15.0)))
           (set-the' GND (wire (metal 4.0) (pt -14.0 -34.0) (+x 15.0)))

	   (set-the' ph1-left (pt -14 -50))
           (boxes (poly 2.0) (pt -14.0 -50.0) (+x 15.0))
	   (set-the' ph1-right *XY)

           (boxes (poly 4.0) (pt -13.0 -26.0) (+x 4.0))
           (boxes (poly 6.0) (pt -13.0 -22.0) (+x 2.0))
           (boxes (poly 6.0) (pt -13.0 -10.0) (+x 2.0))
           (boxes (poly 4.0) (pt -13.0 -6.0) (+x 4.0))
           (boxes (metal 4.0) (pt -12.0 -26.0) (+x 6.0))
           (boxes (implant 6.0) (pt -12.0 -20.0) (+x 6.0))
           (boxes (poly 2.0) (pt -12.0 -20.0) (+x 9.0))
           (boxes (implant 6.0) (pt -12.0 -12.0) (+x 6.0))
           (boxes (poly 2.0) (pt -12.0 -12.0) (+x 6.0))
           (boxes (metal 4.0) (pt -12.0 -6.0) (+x 6.0))

	   (boxes (poly 2) (pt -11 -5) (Y 0))		;non-invert output
	   (set-the' A *XY)

           (boxes (cuts 2.0) (pt -11.0 -26.0) (+x 4.0))
           (boxes (diff 4.0) (pt -11.0 -16.0) (+x 4.0))
           (boxes (cuts 2.0) (pt -11.0 -6.0) (+x 4.0))
           (boxes (diff 6.0) (pt -10.0 -25.0) (+x 4.0))
           (boxes (diff 6.0) (pt -10.0 -20.0) (+x 2.0))
           (boxes (diff 1.0) (pt -10.0 -22.5) (+x 2.0))
           (boxes (cuts 2.0) (pt -10.0 -16.0) (+x 2.0))
           (boxes (diff 6.0) (pt -10.0 -13.0) (+x 2.0))
           (boxes (diff 1.0) (pt -10.0 -9.5) (+x 2.0))
           (boxes (diff 6.0) (pt -10.0 -7.0) (+x 4.0))

	   (boxes (diff 4) (pt -8 -44) (Y -53))
	   (set-the' input *XY)

           (boxes (metal 6.0) (pt -10.0 -45.0) (+x 4.0))
           (boxes (poly 3.0) (pt -10.0 -43.5) (+x 7.0))
           (boxes (cuts 4.0) (pt -9.0 -45.0) (+x 2.0))
           (boxes (diff 16.0) (pt -7.0 -33.0) (+x 8.0))
           (boxes (diff 8.0) (pt -6.0 -6.0) (+x 7.0))
	   (boxes (poly 2) (pt -4 -43) (Y -23))

	   (boxes (poly 2) (pt -3 -21) (Y 0))
	   (set-the' -A *xy)				;inverting output

