;;; Generalized (hah) PLA constructor -*- Mode:Lisp; Base:10.; Ibase:10. -*-

(comment Generalized PLA constructor - H and GJS)

(setq base 10. ibase 10.)
(declare (setq base 10. ibase 10.))

(defmacro set-the (x y)
   `(let ((obj ,y))
       (putprop *instance* obj ,x)
       (if (symbolp obj)
	   (addprop obj (cons ,x *instance*) 'name))))

(defmacro the path
   `(the-1 ',path))

(defmacro >= args `(not (< . ,args)))
(defmacro / args `(not (< . ,args)))
(defmacro <= args `(not (> . ,args)))
(defmacro / args `(not (> . ,args)))
(defmacro neq args `(not (eq . ,args)))
(defmacro / args `(not (= . ,args)))
(macro first (x) (displace x `(car ,(cadr x))))
(macro second (x) (displace x `(cadr ,(cadr x)))) 
(macro third (x) (displace x `(caddr ,(cadr x)))) 
(macro fourth (x) (displace x `(cadddr ,(cadr x))))
(macro fifth (x) (displace x `(car (cddddr ,(cadr x)))))
(macro sixth (x) (displace x `(cadr (cddddr ,(cadr x)))))
(macro seventh (x) (displace x `(caddr (cddddr ,(cadr x)))))

(macro rest1 (x) (displace x `(cdr ,(cadr x))))
(macro rest2 (x) (displace x `(cddr ,(cadr x))))
(macro rest3 (x) (displace x `(cdddr ,(cadr x))))
(macro rest4 (x) (displace x `(cddddr ,(cadr x))))
(defmacro if (p c . a)
   `(cond (,p ,c)
	  (t . ,a)))


;MAPC with a prog body instead of a function.  <form> evaluates to a list,
;and <body> is executed with <var> bound to successive elements of the list.
(DEFMACRO DOLIST ((VAR FORM) &REST BODY)
   (LET ((DUMMY (GENSYM))) 
     `(DO ((,DUMMY ,FORM (CDR ,DUMMY))
           (,VAR))
          ((NULL ,DUMMY))
         (SETQ ,VAR (CAR ,DUMMY))
         . ,BODY)))

;Repeat a number of times.  <form> evaluates to the number of times,
;and <body> is executed with <var> bound to 0, 1, ...
(defmacro dotimes ((var form) &rest body)
   (let ((dummy (gensym)))
     `(do ((,var 0 (1+ ,var))
	   (,dummy ,form))
	  ((>= ,var ,dummy))
	. ,body)))

(defmacro pt (x y) `(list* 'pt ,x ,y))
(defmacro pt? (x) `(and (not (atom ,x)) (eq (car ,x) 'pt)))
(defmacro x-of (x) `(cadr ,x))
(defmacro y-of (y) `(cddr ,y))


(defmacro logand (x y)
   `(boole 1 ,x ,y))

(DEFUN FIND-POSITION-IN-LIST (ITEM IN-LIST)
    (DO ((L IN-LIST (CDR L))
	 (C 0 (1+ C)))
	((NULL L))
      (AND (eq ITEM (CAR L)) (RETURN C))))


;Note that the cell definitions must be mirrored in Y
; to make the upper left corner of the AND array be 0,0


;            |--------------|   |----------------------|----|
;            |              |   |                      |    |
;            |   InPair     |   |      Out             | O  |
;            |   Mir Y      |   |     Mir Y            | u  |
;            |              |   |                      | t  |
;            ---------------|   |                      |    |
;            |   Gnd MirY   |   |                      |Gnd |
;   |-------------------------------------------------------|
;   |        |              | C |                      |G   |
;   |        |     AND      | o |          OR          |n   |
;   | Pullup |     Cell     | n |         Cells        |d   |
;   |  MirY  |     Mir Y    | n |                      |    |
;   |        |              | e |     Rot 0,-1; MirY   |Rot |
;   |        |              | c |                      |0,-1|
;   |--------|--------------------------------------------- |
;   | PullGnd| -- Ground -- | * |     Diffusion ground | &  |
;   |--------|--------------------------------------------- |
;   |        |              |   |                      |    |
;   |        |              |   |                      |  G |
;   |        |              |   |          Cells       |  n |
;   |        |              |   |                      |  d |
;   ---------------------------------------------------------
;      |   |-| Ground       |-- |                      |
;      |     |--------------|   |        Pullup        |
;      |----- VDD wires ------- |      Rot 0,-1; MirY  |
;                               ------------------------
;   * - Pla-gnd-cross: a special cell to merge ground at PlaGround,
;		DiffusionGnd,Connect
;   & - Pla-gnd-cross Rot 0,-1 MirY
;   Note that there is an extra row of Pla-gnd above and below
;	the AND plane

(deflayout foo nil
   (call* plain (trans (pt 15 0)))
   (call* pla-in-gnd (trans (pt 0 10)))
   (call* pla-cell-pair (trans (pt 0 24))))

(deflayout foo1 nil
   (set-the' pp (invoke 'pullup-pair '(4)))
   (call* (pullup-pair 4) (mirror y) (trans (pt (- 0 (the h-pitch pp)) 0)))
   (call* (pullup-gnd 4) (mirror y) (trans (pt (- 0 (the h-pitch pp)) -10)))
   (call* (pullup-pair 4) (mirror y) (trans (pt (- 0 (the h-pitch pp)) -24)))

   (call* pla-cell-pair (mirror y) (trans (pt 0 0)))
   (call* pla-gnd (mirror y) (trans (pt 0 -10)))
   (call* pla-cell-pair (mirror y) (trans (pt 0 -24)))

   (call* pla-cell-pair (mirror y) (trans (pt 14 0)))
   (call* pla-gnd (mirror y) (trans (pt 14 -10)))
   (call* pla-cell-pair (mirror y) (trans (pt 14 -24)))

   (call* pla-connect (mirror y) (trans (pt 28 0)))
   (call* pla-gnd-cross (mirror y) (trans (pt 28 -10)))
   (call* pla-connect (mirror y) (trans (pt 28 -24)))

   (set-the' pla-connect (invoke 'pla-connect nil))
   (setq x (+ 14 28 (the h-pitch pla-connect)))
   (call* pla-cell-pair (rot 0 -1) (mirror y) (trans (pt x 0)))
;   (call* pla-diff-gnd (mirror y) (trans (pt 14 -10)))
   (call* pla-cell-pair (rot 0 -1) (mirror y) (trans (pt x -24)))

   (call* pla-gnd (rot 0 -1) (mirror y) (trans (pt (+ x 10) 0)))
   (call* pla-gnd (rot 0 -1) (mirror y) (trans (pt (+ x 10) -24)))

   )
;The PLA builders

(defmacro check-mesh (idx . body)
	  `(cond ((>= ,idx gnd-mesh)
		  (setq ,idx 0)
		  ,@body)))

;Points defined:
;The input points as named
; ph1-left - input ph1 of AND array
; ph1-right
; and-top-left-pla-gnd, and-top-right-pla-gnd - The pla-gnd row between cells, pla-in
; and-bottom-left-pla-gnd, and-bottom-right-pla-gnd
; and-pp-top-vdd, -bottom-vdd, top-gnd, -bottom-gnd  	- points on AND pullups along left edge
; and-pp-bottom, and-pp-top			-actual pullups
; and-right-edge	- X at AND right edge
; left-plain, right-plain	-PLA input cells

;the output points
; ph2-left, ph2-not-left, ph2-right, ph2-not-right
; left-out, right-out		- the pla-out leftmost, rightmost
; or-pp-left-gnd, -right-gnd, -left-vdd, -right-vdd	-OR pullups along bottom
; or-left-edge, or-right-edge

; top-line, bottom-line		-The rows of the pla
; y-bottom

(deflayout pla (#Ands #ors nterms and-fields or-fields program gnd-mesh gnd-width folded-p)
    (cond ((not (= (length program) nterms))
	   (format t '|~%The length (~D) of the PLA program isn't ~D steps|
		   (length program) nterms)
	   (break t)))
    (set-the' Cell-Size 14)
    (set-the' gnd-height (get-the (invoke 'Pla-gnd nil) 'height))
    (set-the' connect-width (get-the (invoke 'Pla-connect nil) 'h-pitch))
    (let ((actual-#and-cells (if folded-p (1- #ands) #ands))
	  (gnd-width//2 (// (1+ gnd-width) 2))
	  elided-bit# names or-descriptor gates)

	;;Build the And inputs

	(setq names (explode-fields and-fields))
	(setq gates (explode-gates and-fields))
	(if (not (= (length names) #ands))
	    (error '|#ands and field description inconsistent|
		   (list (length names) #ands)))
	(cond (folded-p
	       (setq elided-bit# (find-position-in-list folded-p names))
	       (if (not elided-bit#) (error '|LSB not found| folded-p))
	       (setq names (delete-nth elided-bit# names))
	       (format t '|~%Eliding bit ~D, leaving ~S| elided-bit# names)))
	(set-the' And-Names names)
	(do ((i 0 (+ i 1))
	     (gates gates (cdr gates))
	     (names names (cdr names))
	     (phase t (not phase))
	     (x 0 (+ x (the Cell-Size))))
	    ((>= i actual-#and-cells)
	       (set-the' and-right-edge x)
	       (set-the 'ph1-right (max-x (the-pt ph1-left plain)
					  (the-pt ph1-right plain)))
	       (set-the' right-plain (the plain))
	       (set-the 'and-top-right-pla-gnd (the-pt end gnd and-pla-gnd)))
	    
	    (format t '|~%Placing AND input for ~A at X=~D|
		    (car names)
		    x)
	    (set-the' and-pla-gnd (call* Pla-In-Gnd (Mirror Y) (Trans (pt x 0))))
	    ;;check for gated or non-gated inputs?
	    (cond ((eq (car gates) 'un-clocked)
		   (set-the' plain
			     (if phase
				 (call* PlaIn-un-gated (Mirror Y) (Trans (pt (+ x 15) (the gnd-height))))
				 (call* PlaIn-un-gated (Mirror Y) (mirror X)
					(Trans (pt (1+ x) (the gnd-height)))))))
		  (t (set-the' plain
			       (if phase
				   (call* PlaIn (Mirror Y) (Trans (pt (+ x 15) (the gnd-height))))
				   (call* PlaIn (Mirror Y) (mirror X)
					  (Trans (pt (1+ x) (the gnd-height))))))))
	    (set-the (car names) (the-pt input plain))
	    (cond ((= i 0)
		   (set-the 'ph1-left (min-x (the-pt ph1-left plain)
					      (the-pt ph1-right plain)))
		   (set-the' left-plain (the plain))
		   (set-the 'and-top-left-pla-gnd (the-pt start gnd and-pla-gnd)))))
	

	;;;Now build the output drivers
	(setq or-descriptor (explode-or-fields or-fields gnd-mesh folded-p))
	(set-the' or-left-edge (+ (the and-right-edge) (the connect-width)))
;	(format t '|~%Or line is |)
;	(sprinter or-descriptor)
	(do ((names or-descriptor (cdr names))
	     (left t)
	     (gate)
	     (name)
	     (first t nil)
	     (x (the or-left-edge)))
	    ((null names)
	     (set-the' or-right-edge x)
	     (set-the 'right-out (the plaout)))
	    (setq name (car names))
	    ;;if we will break here, name the right part of the gate bus
	    (if (not (atom name))
		(setq gate (if folded-p (second name) (third name))))
	    ;;put out output driver or gnd
	    (cond ((eq name '*gnd*)
		   (if folded-p
		       (call* pla-2-out-gnd (mirror Y) (trans (pt x 0)))
		       (call* pla-out-gnd (mirror Y) (trans (pt x 0))))
		   (format t '|~%Placing PLA-OUT-GND at X=~D| x)
		   (setq x (+ x (the gnd-height))))
		  ((eq name '*break*)
		   (if folded-p
		       (call* pla-2-out-break (mirror Y) (trans (pt x 0)))
		       (call* pla-out-break (mirror Y) (trans (pt x 0))))
		   (format t '|~%Placing Break at X=~D| x)
		   (setq x (+ x (the gnd-height)))
		   (setq left t))
		  (folded-p
		   (format t '|~%Placing PLA-OUT for ~A at X=~D| (first name) x)
		   (set-the' plaout (call* pla-2-out (mirror Y) (Trans (pt x 0))))
		   (set-the (first name) (the-pt output plaout))
		   (setq x (+ x 14)))
		  (t (if (eq gate 'un-clocked)
			 (set-the' plaout (call* pla-out-un-clocked (mirror Y) (Trans (pt x 0))))
			 (set-the' plaout (call* pla-out (mirror Y) (Trans (pt x 0)))))
		     (set-the (first name) (the-pt left-output plaout))
		     (if (second name)
			 (set-the (second name) (the-pt right-output plaout)))
		     (format t '|~%Placing PLA-OUT for ~A, ~A at X=~D|
			     (first name)
			     (second name)
			     x)
		     (setq x (+ x 14))))
	    (cond ((neq gate 'un-clocked)
		   (cond ((or (null (cdr names))
			      (eq (cadr names) '*break*))
			  (set-the (concat gate '-right) (the-pt end ph2 plaout))
			  (if folded-p (set-the (concat gate '-not-right)
						(the-pt end ph2-not plaout)))))
		   (cond ((and left (not (atom name)))
			  (setq left nil)
			  (set-the (concat gate '-left) (the-pt start ph2 plaout))
			  (if folded-p (set-the (concat gate '-not-left)
					     (the-pt start ph2-not plaout)))))))
	    (if first (set-the 'left-out (the plaout))))

    

	;;;now for the program

	;;canonicalize program if folding PLA
        (cond (folded-p
	       (setq program
		     (mapcar
		      '(lambda (x)
			 (let ((state (get-state (car x) #ands)))
			      (list (list (elide elided-bit# (car state))
					  (elide elided-bit# (cadr state)))
				    (if (atom (car x))
					(second x)
					(third x))
				    state)))
		      program))
	       (setq program (sort program
				   '(lambda (x y) (lessp (caar x) (caar y)))))))

	(set-the' gnd-row (invoke 'pla-gnd-row (list actual-#and-cells
						     or-descriptor)))
	(set-the' pla-cell-pair (invoke 'pla-cell-pair nil))
	;;Build minterms
	(do ((y 0 (- y 14))
	     (gnd-row 0 (1+ gnd-row))
	     (i 0 (1+ i))
	     (lines program))
	    ((null lines)
	     (set-the' #lines i)
	     (set-the' bottom-line (the line))
	     (set-the' y-bottom y))
	    (check-mesh gnd-row
		   (call* (pla-gnd-row actual-#and-cells or-descriptor)
			  (trans (pt 0 (- y 10))))
		   (setq y (- y 10)))
	    (set-the' line (call* (pla-row actual-#and-cells or-descriptor)
				  (trans (pt 0 (- y 14)))))
	    (cond ((= i 0) (set-the' top-line (the line))))
	    (do ((j 0 (1+ j))
		 (andy (+ y -14 (the second-metal pla-cell-pair))
		       (+ y -14 (the first-metal pla-cell-pair)))
		 (ory  (+ y -14 (the second-poly pla-cell-pair))
		       (+ y -14 (the first-poly pla-cell-pair)))
		 line even-line odd-line state mask value)
		((>= j 2))
		(cond ((and lines folded-p)
		       ;;Construct folded OR PLA
		       (setq even-line (car lines))
		       (cond ((equal (caar lines) (caadr lines))
			      (setq odd-line (cadr lines)
				    lines (cddr lines)))
			     (t (setq odd-line nil
				      lines (cdr lines))))
		       ;;make sure we have even line first
		       (if (not (zerop (logand (^ 2 elided-bit#)
					       (car (third even-line)))))
			   (setq even-line
				 (prog2 nil odd-line
					(setq odd-line even-line))))
		       (if (or (and even-line (not (zerop (logand (^ 2 elided-bit#)
						   (car (third even-line))))))
			       (and odd-line (zerop (logand (^ 2 elided-bit#)
							    (car (third odd-line))))))
			   (error '|Gubbish line pair| (list even-line odd-line)))
		       (format t '|~%Even: ~S~%Odd: ~S, andY=~D, orY=~D|
			       even-line odd-line andy ory)
		       (setq state (if even-line (car even-line) (car odd-line)))
		       (build-ands 0 andy
				   (car state)		;state #
				   (cadr state)		;state mask
				   actual-#and-cells)
		       (build-folded-ors (the or-left-edge) ory
					 (if (null even-line) 0 (second even-line))
					 (if (null odd-line) 0 (second odd-line))
					 or-descriptor))
		      ;;else, contruct normal OR PLA
		      (lines
		       (setq line (car lines) lines (cdr lines))
		       (setq state (get-state (car line) #ands)
			     mask (cadr state)
			     state (car state)
			     value (if (atom (car line))
				       (second line)
				       (third line)))
		       (format t '|~%State ~O: ~O at andY=~D, orY=~D| state value andy ory)
		       (build-ands 0 andy state mask #Ands)
		       (build-ors (the or-left-edge) ory value or-descriptor)))))
    

	;;Add the pullups at the bottom of the OR plane
	(set-the' pullup-pair (invoke 'pullup-pair (list gnd-width)))
	(do ((l or-descriptor (cdr l))
	     (i 0 (1+ i))
	     (x (the or-left-edge)))
	    ((null l)
	     (set-the' or-pp-right-gnd (the-pt start gnd or-pp))
	     (set-the' or-pp-right-vdd (the-pt start vdd or-pp))
	     (set-the' or-pp-right (the or-pp)))
	    (cond ((memq (car l) '(*break* *gnd*))
		   (call* (pullup-gnd gnd-width) (rot 0 -1) (mirror y)
			  (trans (pt (+ x 10) (- (the y-bottom) (the h-pitch pullup-pair)))))
		   (setq x (+ x 10)))
		  (t (set-the' or-pp (call* (pullup-pair gnd-width) (rot 0 -1)
					    (mirror y)
					    (trans (pt (+ x 14)
						       (- (the y-bottom) (the h-pitch pullup-pair))))))
		     (setq x (+ x 14))))
	    (cond ((= i 0)
		   (set-the' or-pp-left-gnd (the-pt end gnd or-pp))
		   (set-the' or-pp-left-vdd (the-pt end vdd or-pp))
		   (set-the' or-pp-left (the or-pp)))))
    
	;;Add the PLA grounds at the bottom of the AND plane
	(do ((i 0 (1+ i))
	     (x 0 (+ x 14)))
	    ((>= i actual-#and-cells)
	       (set-the' and-bottom-right-pla-gnd (the-pt end gnd and-bottom-pla-gnd)))
	    (set-the' and-bottom-pla-gnd (call* pla-gnd (trans (pt x (the y-bottom)))))
	    (cond ((= i 0)
		   (set-the' and-bottom-left-pla-gnd (the-pt start gnd and-bottom-pla-gnd)))))
    
	(format t '|~%The number of lines used is ~D| (the #lines))
	;;Add the pullups to the left of the AND plane
	(do ((i 0 (+ i 1))
	     (count 0 (1+ count))
	     (y 0 (- y 14)))
	    ((>= i (the #lines)) (set-the' and-pp-bottom-gnd (the-pt start gnd and-pp))
				 (set-the' and-pp-bottom-vdd (the-pt start vdd and-pp))
				 (set-the' and-pp-bottom (the and-pp)))
	    (check-mesh count
		   (call* (pullup-gnd gnd-width) (mirror y)
			  (trans (pt (- 0 (the h-pitch pullup-pair))
				     (- y 10))))
		   (setq y (- y 10)))
	    (set-the' and-pp (call* (pullup-pair gnd-width) (mirror y)
				   (trans (pt (- 0 (the h-pitch pullup-pair))
					      (- y 14)))))
	    (cond ((= i 0)
		   (set-the' and-pp-top-gnd (the-pt end gnd and-pp))
		   (set-the' and-pp-top-vdd (the-pt end vdd and-pp))
		   (set-the' and-pp-top (the and-pp)))))
    
	;;Now wire up some of the VDD, GND buses
	
	(boxes (metal 4) (the-pt and-pp-top-gnd)
	       (Y (the-pt and-top-left-pla-gnd)) (X *))
	(boxes (metal gnd-width) (the-pt and-pp-top-gnd)
	       (Y (+ 2 (the-y start gnd left-plain))))
	(boxes (metal 4) (the-pt start gnd left-plain)
	       (X (the-pt and-pp-top-gnd)))

	;;VDD along bottom from AND to OR pullups
	(boxes (metal 4) (the-pt and-pp-bottom-vdd)
	       (Y (the-pt or-pp-left-vdd)))
	(set-the' bottom-left-vdd *XY)
	(boxes (metal 4) (the-pt bottom-left-vdd) (X (the-pt or-pp-left-vdd)))
	
	;;VDD along left and around top
	(boxes (metal gnd-width) (the-pt bottom-left-vdd)
	       (X (- (the-x vdd2 and-pp-bottom) gnd-width//2))
	       (Y (+ (the-y input left-plain) 3 gnd-width//2))
	       (X (+ (the or-left-edge) gnd-width//2))
	       (Y (+ (the-y top left-out) gnd-width//2))
	       (X (the or-right-edge)))

	(boxes (metal 4) (the-pt and-pp-top-vdd)
	       (+Y 2)
	       (X (the-pt vdd2 and-pp-top)))

	;;VDD along bottom of OR pullups
	(boxes (metal gnd-width) (the-pt bottom-left-vdd)
	       (Y (- (the-y vdd2 or-pp-left) gnd-width//2))
	       (X (the-pt vdd2 or-pp-right)))
	(boxes (metal 4) *XY
	       (X (+ 5 (the-x or-pp-right-vdd)))
	       (Y (the-pt or-pp-right-vdd))
	       (X *))

	;;GND along right side of OR plane
	(let ((x (+ (the-x or-pp-right-gnd) 3 gnd-width//2)))
	     (boxes (metal gnd-width) (the-pt or-pp-right-gnd)
		    (X x) (Y (the-y end gnd right-out)))
	     (boxes (metal 4) (the-pt end gnd right-out)
		    (X (+ x gnd-width//2))))
    
	;;ground at bottom of AND plane
	(boxes (metal 4) (the-pt and-bottom-right-pla-gnd)
	       (X (the-pt end gnd connect bottom-line)) (Y *))
	(boxes (metal 4) (the-pt or-pp-left-gnd)
	       (X (the-pt end gnd connect bottom-line)) (Y *))
	(boxes (metal gnd-width) (the-pt and-pp-bottom-gnd)
	       (Y (the-pt or-pp-left-gnd))
	       (X *))
	(boxes (metal 4) (the-pt and-pp-bottom-gnd)
	       (Y (the-pt and-bottom-left-pla-gnd)) (X *))
    
	(boxes (metal 4) (the-pt start gnd connect top-line)
	       (Y (the-pt start gnd left-out)) (X *))
	(boxes (metal 4) (the-pt and-top-right-pla-gnd)
	       (X (the-pt start gnd connect top-line)) (Y *))

	;;VDD interconnect from AND PLA-IN to OR PLA-OUT
	(boxes (metal 4) (the-pt end vdd right-plain)
	       (X (- (the-x start gnd connect top-line) 7))
	       (Y (+ 7 (the-y start gnd left-out)))
	       (X (- (the-x start vdd left-out) 3))
	       (Y (the-pt start vdd left-out))
	       (X *))

	(cond ((not folded-p)
	       (boxes (metal 4) (leftmost vdd left-out)
		      (-X 3) (Y (leftmost vdd2 left-out)) (X *))
	       (boxes (metal 4) (rightmost vdd right-out)
		      (+X 3) (Y (rightmost vdd2 right-out)) (X *))))
))

(defun rightmost fexpr (wire)
   (let ((p1 (the-point-relative wire '(start)))
	 (p2 (the-point-relative wire '(end))))
	(if (greaterp (x-of p1) (x-of p2))
	    p1
	    p2)))

(defun leftmost fexpr (wire)
   (let ((p1 (the-point-relative wire '(start)))
	 (p2 (the-point-relative wire '(end))))
	(if (lessp (x-of p1) (x-of p2))
	    p1
	    p2)))

(deflayout pla-row (ands or-desc)
   (let ((x 0))
      (dotimes (i ands)
	  (call* pla-cell-pair (mirror y) (trans (pt x 0)))
	  (setq x (+ x 14)))
      (set-the' connect (call* pla-connect (mirror Y) (trans (pt x 0))))
      (setq x (+ x (the h-pitch connect)))
      (dolist (type or-desc)
	 (cond ((memq type '(*break* *gnd*))
		(call* pla-gnd (rot 0 -1) (mirror y) (trans (pt (+ x 10) 0)))
		(setq x (+ x 10)))
	       (t (call* pla-cell-pair (rot 0 -1) (mirror y)
			 (trans (pt (+ x 14) 0)))
		  (setq x (+ x 14)))))))

(deflayout pla-gnd-row (ands or-desc)
     (let ((x 0))
	(dotimes (i ands)
	     (call* pla-gnd (mirror Y) (trans (pt x 0)))
	     (setq x (+ x 14)))
	(set-the' gnd-cross (call* pla-gnd-cross (mirror y) (trans (pt x 0))))
	(setq x (+ x (the h-pitch gnd-cross)))
	(dolist (type or-desc)
	   (cond ((memq type '(*break* *gnd*))
		  (call* pla-or-gnd (rot 0 -1) (mirror y) (trans (pt (+ x 10) 0)))
		  (setq x (+ x 10)))
		 (t (call* pla-diff-gnd (rot 0 -1) (mirror y)
			   (trans (pt (+ x 14) 0)))
		    (setq x (+ x 14)))))))

;The pla-in drivers are alternanately flipped, therefore
; the  columns of cell pairs are flashed:
;	*-   for 0  even cells
;	-*   for 1      "
;	-*   for 0  odd cells
;	*-   for 1      "

(defun build-ands (x y and mask n)
    (do ((xx x (+ xx 14))
	 (count 0 (1+ count))
	 (i 0 (1+ i))
	 (word and (lsh word -1))
	 (mask mask (lsh mask -1)))
	((>= i n))
	(cond ((oddp mask)  ;this term active?
	       (if (oddp i)
		   (if (oddp word)
		       (call-boxes 'and-10 xx y)
		       (call-boxes 'and-01 xx y))
		   (if (oddp word)
		       (call-boxes 'and-01 xx y)
		       (call-boxes 'and-10 xx y)))))))


(defun build-ors (x y or or-desc)
    (do ((dl or-desc (cdr dl)))
	((null dl))
	(cond ((memq (car dl) '(*gnd* *break*))
	       (setq x (+ x 10)))
	      (t (caseq (remainder or 4)
			(0)					;LSB is to left
			(1 (call-boxes 'or-10 x y))
			(2 (call-boxes 'or-01 x y))
			(3 (call-boxes 'or-11 x y)))
		 (setq x (+ x 14)
		       or (quotient or 4))))))

(defun build-folded-ors (x y or1 or2 or-desc)
    (do ((dl or-desc (cdr dl)))
	((null dl))
	(cond ((memq (car dl) '(*break* *gnd*))
	       (setq x (+ x 10)))
	      (t (if (oddp or1)
		     (if (oddp or2)
			 (call-boxes 'or-11 x y)
			 (call-boxes 'or-10 x y))
		     (if (oddp or2)
			 (call-boxes 'or-01 x y)
			 ;  (call-boxes 'or-00 x y)
			 ))
		 (setq x (+ x 14))
		 (setq or1 (quotient or1 2))
		 (setq or2 (quotient or2 2))))))


(declare (special *ofile *instance*))

(defun call-boxes (obj x y)
   (let ((base 10.)
	 (*nopoint t))
	(terpri *ofile)
	
	(princ '|Call | *ofile)
	(princ (get obj 'cif-no) *ofile)
	(princ '| Trans | *ofile)
	(princ (scale x) *ofile)
	(princ '|, | *ofile)
	(princ (scale y) *ofile)
	(princ '| ;| *ofile)))

;    (format *ofile '|~%Call ~D Trans ~D, ~D ;| (get obj 'cif-no)
;	    (scale x)
;	    (scale y)))

(declare (special *flashes))

(defun out-flashes ()
   (do ((x *flashes (cdr x))
	(cifno 2000. (1+ cifno))
	flashes)
       ((null x))
       (setq flashes (get (car x) 'flashes))
       (format *ofile '|~%Define Symbol ~D 200 2 ;| cifno)
       (dolist (box flashes)
	     (format *ofile '|~%Layer ~A; Box Width ~D Length ~D Center ~D, ~D ;|
		     (get (second box) 'cifname)
		     (scale (abs (- (fifth box) (sixth box))))
		     (scale (abs (- (third box) (fourth box))))
		     (scale (average (third box) (fourth box)))
		     (scale (average (fifth box) (sixth box)))))
       (format *ofile '|~%Definition Finished ;|)
       (putprop (car x) cifno 'cif-no)))
       
(setq *flashes '(and-01 and-10 and-11 or-01 or-10 or-11))

(defun defflashes fexpr (x) (putprop (car x) (cddr x) 'flashes))

