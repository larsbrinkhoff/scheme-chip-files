(declare (special *ofile))
(defun read-pla (f)
    (let* ((ifilename (defaultf (mergef f '((dsk *) * PLA))))
	   (ifile (open ifilename '(in ascii)))
	   (*ofile (open (mergef '((* *) * CIF) ifilename)
			 '(out ascii)))
	   (eof (list nil))
	   (base 8.)
	   (ibase 8.)
	   pla gnd-mesh gnd-width)
	  (format t '|~%What ground mesh spacing?  |)
	  (setq gnd-mesh (read))
	  (format t '|~%What ground bus width (in Lambda's)?  |)
	  (setq gnd-width (read))
	  (out-flashes)					;define cif for flashes
	  (format *ofile '|~%Definition Start 1999 200 2 ;~%9 ~A ;~%| f) 
	  (do ((x (read ifile eof) (read ifile eof))
	       folded-bit)
	      ((eq x eof)
	       (close ifile)
	       (close *ofile))
	      (cond ((and (not (atom x))
			  (eq (car x) 'make-pla))
		     (setq folded-bit (get (second x) 'folded))
		     (format T
			     '|~%Making PLA ~S, ~D AND bits, ~D OR outputs, ~D terms, folded on ~A|
			     (second x)
			     (third x)
			     (fourth x)
			     (fifth x)
			     folded-bit)
		     (setq pla (invoke 'pla
				       (list
					(third x)
					(fourth x)
					(fifth x)
					(sixth x)
					(seventh x)
					(cdddr (cddddr x))
					gnd-mesh
					gnd-width
					folded-bit)))
		     (set-the (second x) pla)
		     (let ((bound (boundaries pla)))
			  (format t '|~%Boundaries are ~D < X < ~D, ~D < Y < ~D|
				  (first bound)
				  (second bound)
				  (third bound)
				  (fourth bound))
			  (format *ofile '|~%(Boundaries are ~D < X < ~D, ~D < Y < ~D);|
				  (first bound)
				  (second bound)
				  (third bound)
				  (fourth bound))
			  (format *ofile '|~%Definition Finished ; ~%End;|))
		     )))))

(defprop micro-pla state-0 folded)
(defprop nano-pla nil folded)

