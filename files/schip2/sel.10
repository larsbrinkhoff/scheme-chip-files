;selector low order stuff is at bottom:

(deflayout selector (nbits)
   (let ((nrows (expt 2 nbits))
	 (row-space 5)
	 (col-space 14)
	 (q1-offset-x 4)
	 (q-offset-y 3)
	 (q2-offset-x 11))
	(set-the' v-pitch (+ (* nrows row-space) 1))
	(set-the' h-pitch (* nbits col-space))
	(do ((row 0 (1+ row)))
	    ((= row nrows))
	    (boxes diff (pt 2 (+ q-offset-y (* row row-space))) (X (the h-pitch)))
	    (set-the (concat 'row row) *XY))
	(do ((col 0 (1+ col)))
	    ((= col nbits))
	    (boxes poly (pt (+ q1-offset-x (* col col-space)) (the v-pitch)) (Y 0))
	    (set-the (concat '+ 'col col) *XY)
	    (boxes poly (pt (+ q2-offset-x (* col col-space)) (the v-pitch)) (Y 0))
	    (set-the (concat '- 'col col) *XY))
	(do ((row 0 (1+ row)))
	    ((= row nrows))
	    (let ((base 2))
		 (do ((col 0 (1+ col))
		      (binexp (reverse (explode row)) (cdr binexp)))	;leading zero
		     ((= col nbits))
		     (if (and binexp (eq (car binexp) '/1))
			 (boxes (implant 6)
				(pt (+ q1-offset-x (* col col-space))
				    (+ q-offset-y (* row row-space) -3))
				(+Y 6))
			 (boxes (implant 6)
				(pt (+ q2-offset-x (* col col-space))
				    (+ q-offset-y (* row row-space) -3))
				(+Y 6))))))
	(boxes diff (pt 1 (- q-offset-y 1)) (+Y (+ (* (- nrows 1) row-space) 2)))
	(set-the' output (pt 0 (+ q-offset-y (* (- nrows 1) row-space))))))
