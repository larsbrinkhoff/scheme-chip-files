;Origin in upper left
(deflayout pla-2-out nil
	   (set-the' h-pitch 14)
	   (set-the' v-pitch -57)
	   (set-the' top (pt 0 (the v-pitch)))
	   (set-the' even-con1 (pt 3 -2))
	   (set-the' even-contact (pt 3 -10))
	   (set-the' odd-con1 (pt 10 -2))
	   (set-the' odd-con2 (pt 10 -10))
	   (set-the' even-butting (pt 3 -19))
	   (set-the' odd-con3 (pt 10 -18))
	   (set-the' gnd-contact (pt 5 -27))
	   (set-the' even-q (pt 5 -32))
	   (set-the' odd-q (pt 9 -25))
	   (set-the' out-butting (pt 6 -40))
	   (set-the' pullup (pt 6 -44))
	   (set-the' vdd-contact (pt 5 -55))
	   (set-the' output (pt 9 -57))
	   (set-the' ph2 (wire poly (pt 0 -6) (X (the h-pitch))))
	   (set-the' ph2-not (wire poly (pt 0 -14) (X (the h-pitch))))

	   (contact S diff (the even-con1))	;even input
	   (boxes metal (pt 2.5 0) (Y (the-y even-contact)))
	   (contact S diff (the even-contact))
	   (boxes diff (the even-contact) (Y (the-y even-butting)))
	   (call* butting-contact (mirror Y) (trans (the even-butting)))

	   (contact S diff (the odd-con1))			;odd input
	   (boxes diff (the odd-con1) (Y (the-y odd-con2)))
	   (contact S diff (the odd-con2))
	   (boxes (metal 4) (the odd-con2) (Y (the-y odd-con3)))
	   (contact S poly (the odd-con3))

	   (contact S diff (the gnd-contact))
	   (set-the' gnd (wire (metal 4) (pt 0 (the-y gnd-contact))
			       (X (the h-pitch))))

	   (call* (pass-transistor 2 4) (trans (the even-q)))	;output OR
	   (call* (pass-transistor 2 4) (rot 0 -1) (trans (the odd-q)))
	   (boxes (diff 4) (pt (the-x gnd-contact) (- (the-y out-butting) 3))
		  (Y (+ (the-y gnd-contact) 2)) (X (1- (the h-pitch))))
	   (boxes diff (pt (1- *X) *Y) (Y -35) (X (the-x gnd-contact)))
	   (boxes poly (pt (- (the-x even-butting) 2) (the-y even-butting))
		  (Y (1- (the-y even-q))))
	   (boxes poly (the odd-q) (Y (the-y odd-con3)))

	   (call* butting-contact (rot 0 -1) (trans (the out-butting)))	;output pullup
	   (call* (general-pullup 8 2) (rot -1 0) (trans (the pullup)))
	   (boxes poly (pt (+ (the-x out-butting) 3) (the-y out-butting))
		  (Y (the-y output)))
	   (set-the'output *XY)

	   (contact S diff (the vdd-contact))
	   (set-the' vdd (wire (metal 4) (pt 0 (the-y vdd-contact)) (X (the h-pitch)))))

