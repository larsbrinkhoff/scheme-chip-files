(deflayout pla-cell-pair ()
   (let ((dx 14) (dy -14)
	 (y1 -4) (y2 -11)
	 (x1 2))
	(set-the' h-pitch dx)
	(set-the' v-pitch dy)
	(set-the' first-poly 6)
	(set-the' second-poly 12)
	(set-the' first-metal 4)
	(set-the' second-metal 11)

	(boxes (metal 4.0) (pt 0.0 y1) (+x dx))
	(contact S diff (pt 2 y1))

	(boxes (metal 4.0) (pt 0.0 y2) (+x dx))
	(contact S diff (pt 2 y2))

	(boxes poly (pt 6 0) (+Y dy))
	(boxes diff (pt 9 0) (+Y dy))
	(boxes poly (pt 12 0) (+Y dy))))

(deflayout pullup-gnd (gnd-width)
	   (set-the' v-pitch -10)
	   (set-the' pullup-pair (invoke 'pullup-pair (list gnd-width)))
	   (set-the' vdd (wire (metal 4) (pt (the-x end vdd pullup-pair) 0) (Y -10)))
	   (set-the' vdd2 (wire (metal 4) (pt (the-x end vdd pullup-pair) -5)
				(X (the-x vdd2 pullup-pair))))
	   (set-the' gnd (wire (metal gnd-width) (pt (the-x end gnd pullup-pair) 0) (y -10)))
	   (boxes (metal 4) (pt (the-x end gnd) -5) (X (the h-pitch pullup-pair))))

(DEFLAYOUT PULLUP-PAIR (gnd-width)
	   (set-the' h-pitch (+ 32. gnd-width))
	   (set-the' v-pitch -14)
	   (set-the' vdd2 (pt -5 -7))			;where the outside VDD will go
           (BOXES (DIFF 4.0) (PT 0.0 -6.0) (+X 5.0))
           (BOXES (POLY 4.0) (PT 0.0 -3.0) (+X 4.0))
           (BOXES (METAL 6.0) (PT 0.0 -5.0) (+X 4.0))
           (BOXES (CUTS 4.0) (PT 1.0 -5.0) (+X 2.0))
           (BOXES (DIFF 2.0) (PT 3.0 -11.0) (X (the h-pitch)))
           (BOXES (DIFF 2.0) (PT 3.0 -5.0) (+X 9.0))
           (BOXES (DIFF 5.0) (PT 3.0 -9.5) (+X 2.0))
           (BOXES (IMPLANT 6.0) (PT 4.0 -5.0) (+X 8.0))
           (BOXES (POLY 2.0) (PT 4.0 -2.0) (+X 6.0))
           (BOXES (POLY 6.0) (PT 6.0 -5.0) (+X 4.0))

	   (set-the' vdd (wire (metal 4) (pt 13 0) (Y -14)))

           (BOXES (DIFF 4.0) (PT 11.0 -5.0) (+X 4.0))
           (BOXES (CUTS 2.0) (PT 12.0 -5.0) (+X 2.0))
           (BOXES (CUTS 2.0) (PT 12.0 -5.0) (+X 2.0))
           (BOXES (DIFF 2.0) (PT 14.0 -5.0) (+X 9.0))
           (BOXES (IMPLANT 6.0) (PT 14.0 -5.0) (+X 8.0))
           (BOXES (POLY 6.0) (PT 16.0 -5.0) (+X 4.0))
           (BOXES (POLY 2.0) (PT 16.0 -8.0) (+X 6.0))

           (BOXES (DIFF 4.0) (PT 21.0 -4.0) (X (the h-pitch)))
	   (set-the' gnd (wire (metal gnd-width)
			       (pt (+ 29 (// gnd-width 2)) 0)
			       (Y -14)))

           (BOXES (POLY 4.0) (PT 22.0 -7.0) (+X 4.0))
           (BOXES (METAL 6.0) (PT 22.0 -5.0) (+X 4.0))
           (BOXES (CUTS 4.0) (PT 23.0 -5.0) (+X 2.0)))


(deflayout pla-gnd-cross nil
	   (set-the' pla-gnd (invoke 'pla-gnd nil))
	   (set-the' pla-connect (invoke 'pla-connect nil))
	   (set-the' h-pitch (the h-pitch pla-connect))
	   (boxes (metal 4) (pt 0 (the-y end gnd pla-gnd)) (X (the-x end gnd pla-connect)))
	   (boxes (metal 4) (pt (the-x end gnd pla-connect) 0) (Y -10)))

(deflayout pla-connect nil
	   (set-the' h-pitch 16)
           (boxes (metal 4.0) (pt 0.0 -4.0) (+x 6.0))
           (boxes (diff 4.0) (pt 0.0 -4.0) (+x 4.0))
           (boxes (diff 4.0) (pt 0.0 -11.0) (+x 4.0))
           (boxes (metal 4.0) (pt 0.0 -11.0) (+x 6.0))
           (boxes (cuts 2.0) (pt 1.0 -4.0) (+x 2.0))
           (boxes (cuts 2.0) (pt 1.0 -11.0) (+x 2.0))
           (boxes (cuts 2.0) (pt 3.0 -4.0) (+x 2.0))
           (boxes (cuts 2.0) (pt 3.0 -11.0) (+x 2.0))
           (boxes (poly 4.0) (pt 3.0 -11.0) (+x 3.0))
           (boxes (poly 2.0) (pt 4.0 -12.0) (x 16))	;poly 2 out
           (boxes (poly 4.0) (pt 3.0 -4.0) (X 6))
           (boxes (poly 2.0) (pt 6.0 -4.0) (X 16))	;poly 1 out
	   (set-the' gnd (wire (metal 4) (pt 11 0) (Y -14)))
;           (boxes (metal 14.0) (pt 9.0 -7.0) (+x 4.0))
           (boxes (diff 4.0) (pt 9.0 -8.0) (+x 4.0))
           (boxes (cuts 2.0) (pt 10.0 -8.0) (+x 2.0))
           (boxes (diff 2.0) (pt 11.0 -9.0) (X 16))	;gnd on diff
           (boxes (poly 4.0) (pt 14.0 -5.0) (+x 2.0)))

(deflayout pla-diff-gnd ()
	   (set-the' v-pitch -14)
	   (set-the' h-pitch 10)
	   (set-the' first-contact (pt 2 -4))
	   (contact S diff (the first-contact))
	   (boxes (metal 4) (the first-contact) (X (the h-pitch)))
	   (set-the' second-contact (pt 2 -11))
	   (contact S diff (the second-contact))
	   (boxes (metal 4) (the second-contact) (X (the h-pitch))))


(deflayout pla-or-gnd ()
	   (set-the' v-pitch -10)
	   (set-the' h-pitch 10)
	   (boxes (metal 4) (pt 0 -5) (X (the h-pitch))))

; Origin is upper-left, -10 Lambda high, 
(deflayout pla-In-gnd nil
	   (set-the' height 10)

	   (boxes (poly 2) (pt 7 -9) (X 4) (Y -1) (X 7))	;left poly
							;connect at X = 4 or 6
	   (boxes (poly 2) (pt 12 -10) (Y 0))		;right poly

	   (contact S diff (pt 8 -5))
           (set-the' gnd (wire (metal 4.0) (pt 0.0 -5.0) (+x 14.0)))
	   (boxes (diff 2) (pt 9 -9) (Y 0)))		;gnd

; Origin is upper-left, -10 Lambda high, 
(deflayout pla-gnd nil
	   (set-the' height 10)

	   (boxes (poly 2) (pt 7 -9) (X 4) (Y -1) (X 7))	;left poly
							;connect at X = 4 or 6
	   (boxes (poly 2) (pt 12 -10) (Y 0))		;right poly

	   (contact S diff (pt 8 -5))
           (set-the' gnd (wire (metal 4.0) (pt 0.0 -5.0) (x 14.0)))
	   (boxes (diff 2) (pt 9 -10) (Y 0)))		;gnd

