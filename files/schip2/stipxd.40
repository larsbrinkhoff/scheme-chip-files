(defmacro xd*poly (x y)
	  `(progn (line ,x ,y (+ ,x 5) (+ ,y 5))
		  (line (+ ,x 3) ,y (+ ,x 5) (+ ,y 2))
		  (line ,x (+ ,y 3) (+ ,x 2) (+ ,y 5))))

(defmacro xd*diff (x y)
	  `(progn (line (+ ,x 1) ,y (+ ,x 1) (+ ,y 5))
		  (line (+ ,x 4) ,y (+ ,x 4) (+ ,y 5))))

(defmacro xd*metal (x y)
	  `(progn (point ,x ,y)
		  (point (+ ,x 1) ,y)
		  (point ,x (+ ,y 1))
		  (point (+ ,x 1) (+ ,y 1))
		  (point (+ ,x 3) (+ ,y 3))
		  (point (+ ,x 3) (+ ,y 4))
		  (point (+ ,x 4) (+ ,y 3))
		  (point (+ ,x 4) (+ ,y 4))))

(defmacro xd*cut (x y)
	  `(progn (line ,x ,y (+ ,x 5) ,y)
		  (line ,x (+ ,y 1) (+ ,x 5) (+ ,y 1))
		  (line ,x (+ ,y 2) (+ ,x 5) (+ ,y 2))
		  (line ,x (+ ,y 3) (+ ,x 5) (+ ,y 3))
		  (line ,x (+ ,y 4) (+ ,x 5) (+ ,y 4))
		  (line ,x (+ ,y 5) (+ ,x 5) (+ ,y 5))))

(defmacro xd*implant (x y)
	  `(progn (line ,x (+ ,y 1) (+ ,x 5) (+ ,y 1))
		  (line ,x (+ ,y 4) (+ ,x 5) (+ ,y 4))))

(defun @ (x y) nil)
(defun # (x y) (xd*cut x y))
(defun A (x y) (xd*diff x y))
(defun B (x y) (xd*metal x y))
(defun C (x y) 
       (xd*metal x y)
       (xd*diff x y))
(defun D (x y) (xd*implant x y))
(defun E (x y)
       (xd*implant x y)
       (xd*diff x y))
(defun F (x y)
       (xd*implant x y)
       (xd*metal x y))
(defun G (x y)
       (xd*implant x y)
       (xd*metal x y)
       (xd*diff x y))
(defun H (x y) (xd*poly x y))
(defun I (x y)
       (xd*poly x y)
       (xd*diff x y))
(defun J (x y)
       (xd*poly x y)
       (xd*metal x y))
(defun K (x y)
       (xd*poly x y)
       (xd*metal x y)
       (xd*diff x y))
(defun L (x y)
       (xd*implant x y)
       (xd*diff x y))
(defun M (x y)
       (xd*poly x y)
       (xd*diff x y)
       (xd*implant x y))
(defun N (x y)
       (xd*poly x y)
       (xd*metal x y)
       (xd*implant x y))
(defun O (x y)
       (xd*implant x y)
       (xd*metal x y)
       (xd*poly x y)
       (xd*diff x y))
(defun | | (x y) nil)


(defun display-stipple-array (a)
       (declare (fixnum i j))
       (let ((ap (get a 'array)))
	    (clear)
	    (do ((i 0 (+ i 1.)))
		((> i 90.))
		(do ((j 0 (+ j 1.)))
		    ((> j 75.))	
		    (funcall (implode (list (arraycall fixnum ap i j)))
			     (* i 6.) (+ (* j 6.) 10.))))))