(if-for-lispm

(defmacro caseq (&rest x) `(selectq . ,x))

;  (let* ((a 3) (b a)) body) --> ((lambda (a) ((lambda (b) body) a)) 3)
;  Maclisp has this already.

(defun construct-let* (binding-forms body)
   (cond ((null binding-forms)
	  (cond ((null (cdr body)) (car body))
		(t `(progn . ,body))))
	 (t (construct-let*
	     (cdr binding-forms)
	     (cond
	      ;;(let* (a b) x) --> ((lambda (a) ((lambda (b) x) nil)) nil)
	      ((atom (car binding-forms))
	       `(((lambda (,(car binding-forms)) . ,body) nil)))
	      ;;(let* ((a) (b)) x) --> ((lambda (a) ((lambda (b) x) nil)) nil)
	      ((null (cdar binding-forms))
	       `(((lambda (,(caar binding-forms)) . ,body) nil)))
	      ;;(let* ((a 3) (b 4)) x) --> ((lambda (a) ((lambda (b) x) 4)) 3)
	      (t `(((lambda (,(caar binding-forms)) . ,body)
		    ,(cadar binding-forms)))))))))

(defmacro let* (binding-forms &rest body)
   (do ((l binding-forms (cdr l))
	vars
	pairs)
       ((null l) `(let ,vars (setq . ,(nreverse pairs)) . ,body))
     (cond ((atom (car l))
	    (setq vars (cons (car l) vars)
		  pairs `(nil ,(car l) . ,pairs)))
	   (t (setq vars (cons (caar l) vars)
		    pairs `(,(cadar l) ,(caar l) . ,pairs))))))

(comment
(defmacro let* (binding-forms &rest body)
	   (construct-let* (reverse binding-forms) body))
)

(defun mergef (f1 f2)
    (si:file-unspread-path (si:file-merge-paths (make-path f1) (make-path f2))))

(defun defaultf (f)
    (si:file-unspread-path (si:file-default-path (make-path f))))

(defun make-path (p)
   (cond ((listp p)
	  (mapcar #'(lambda (x) (if (eq x '*) nil (string x)))
		  (list (and (listp (car p)) (cdar p) (caar p))
			(and (listp (car p)) (if (cdar p) (cadar p)
						 (caar p)))
			(if (listp (car p)) (second p) (first p))
			(if (listp (car p)) (third p) (second p)))))
	 (t (si:file-spread-pathname p))))

);if-for-lispm

