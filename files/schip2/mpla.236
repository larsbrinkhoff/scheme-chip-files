(defflashes and-01 ()			  (box cuts 10 14 -2 2))

(defflashes or-11 () (box cuts 1 5 -2 2) (box cuts 8 12 -2 2))
(defflashes or-10 () (box cuts 1 5 -2 2))
(defflashes or-01 () 			 (box cuts 8 12 -2 2))
)
