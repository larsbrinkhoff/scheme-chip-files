(defflashes and-11 () (box diff 4 8 -2 2) (box diff 10 14 -2 2))
(defflashes and-10 () (box diff 4 8 -2 2))
(defflashes and-01 ()			  (box diff 10 14 -2 2))

(defflashes or-11 () (box diff 1 5 -2 2) (box diff 8 12 -2 2))
(defflashes or-10 () (box diff 1 5 -2 2))
(defflashes or-01 () 			 (box diff 8 12 -2 2))
;)

(declare (special *ofile))
(defun read-pla (f &optional gnd-mesh gnd-width folded-bit)
    (let* ((ifilename (defaultf (mergef f '((dsk *) * PLA))))
	   (ifile (open ifilename '(in ascii)))
	   (*ofile (open (mergef '((* *) * CIF) ifilename)
			 '(out ascii)))			;file for flashes
	   (eof (list nil))
	   (base 8.)
	   (ibase 8.)
	   needed-symbols
	   pla)
	  (cond ((not gnd-mesh)
		 (format t '|~%What ground mesh spacing?  |)
		 (setq gnd-mesh (read))))
	  (cond ((not gnd-width)
		 (format t '|~%What ground bus width (in Lambda's)?  |)
		 (setq gnd-width (read))))
	  (out-flashes)					;define cif for flashes
	  (do ((x (read ifile eof) (read ifile eof))
	       (pla-symbol))
	      ((eq x eof))
	      (cond ((and (not (atom x))
			  (eq (car x) 'make-pla))
		     (format T
			     '|~%Making PLA ~S, ~D AND bits, ~D OR outputs, ~D terms~%    Folded on ~A, Gnd-mesh ~D, Gnd-width ~D|
			     (second x)
			     (third x)
			     (fourth x)
			     (fifth x)
			     folded-bit
			     gnd-mesh
			     gnd-width)
		     (setq pla-symbol *pla-symbol-number*
			   *pla-symbol-number* (1+ *pla-symbol-number*))
		     (format *ofile '|~%Definition Start ~D ~D ~D ;~%9 ~A ;~%|
			     pla-symbol
			     *lambda-size
			     (fix *mingrid)
			     (second x)) 
		     (setq pla (invoke 'pla
				       (list
					pla-symbol
					(third x)
					(fourth x)
					(fifth x)
					(sixth x)
					(seventh x)
					(cdddr (cddddr x))
					gnd-mesh
					gnd-width
					folded-bit)))
		     (setq needed-symbols (get-needed-symbols pla needed-symbols))
		     (set-the (second x) pla)
		     (let ((bound (boundaries pla)))
			  (format t '|~%Boundaries are ~D < X < ~D, ~D < Y < ~D|
				  (first bound)
				  (second bound)
				  (third bound)
				  (fourth bound))
			  (format *ofile '|~%(Boundaries are ~D < X < ~D, ~D < Y < ~D);|
				  (first bound)
				  (second bound)
				  (third bound)
				  (fourth bound)))
		     (format *ofile '|~%Definition Finished ;~2%|))))
	  (cifout-file *ofile needed-symbols (1+ *pla-symbol-number*))
	  (format *ofile '|~%End;~%|)
	  (close ifile)
	  (close *ofile)
))

(setq base 8 ibase 8)
(setq test '(8. 12. 15.
	       ((f 0 (and number 8))) ((f 0 (or number 8)))
	       ((0  0000)   ;0
		(1  7777)
		(2  0002)   ;1
		(3 7703)
		(4 0004)    ;2
		(5 7705)
		(6 0006)    ;3
		(7 7707)
		(10 0010)   ;4
		(11 7711)
		(12 0012)   ;5
		(14 0077)   ;6
		(16 0016)   ;7
		(20 0020)   ;10
		(22 0022)   ;11
		)
	       4					;mesh spacing
	       12.))

(setq ts '(set-the' test (call 'pla (append test '(t)))))

(setq ts1 '(set-the' test1 (call 'pla (append test '(NIL)))))
(defun st (obj rot)
       (stipple-to-file obj (mapcar 'fix (boundaries obj)) '|ai:schip2;mpla xgp| rot))

(setq base 10. ibase 10.)


;DO-PLAS -- Process PLA files. (do-plas pla-file-name gnd-mesh-spacing metal-size folding)
;Reads the file <pla-input-file> PLA which should contain a series
; of (MAKE-PLA name #ands #ors #lines input-fields output-fields . program)
;Writes the following files:
;    <pla-input-file> CIF	;The flashes and structure for PLAs in input-file
;    <pla-input-file> SPECS	;Record of PLA assembly


;Format of MAKE-PLA
; name - symbolic cell name for PLA flashes
; #ands #ors #lines - must agree with pla-program
; input-fields output-fields - two lists of field specifications
; program - ((state state-mask) (symbolic state) output (symbolic output))
;
; Field specifications:
;Field spec is of form:
;	(FIELD number (name type width position gating))
;   i.e.(FIELD 002 (nano-run BIT 1 1 UN-CLOCKED))
; number - a comment, ignored, a word with ones in this field
; name - name of this bit or field, ignored except appears in CIF output
; type - {BIT, BIT-REVERSE, NUMBER}
; width - # of bits in field (Must be 1 for BIT type)
; position - position of field (Must be in order starting from 0, for now)
; gating - The name of the clock signal PH1 or PH2, or UN-CLOCKED.

; gating is the name of the output clock signal (usually PH2)
; or "un-clocked" or nil which means no different from previous field.
; assumes field specs are LSB - MSB, where 
; LSB of the AND input is farthest from the AND/OR boundary.
; LSB of the OR outputs is closest to the AND/OR boundary.

;The program is a list of implicants in the form of:
; ((STATE STATE-MASK) (SYMBOLIC STATE) OUTPUT (SYMBOLIC OUTPUT))
; where the input into the AND array is specified by (STATE STATE-MASK).
; Those bits of the AND input that are don't-cares are zero in the STATE-MASK.
; The OUTPUT value is what is programmed into the OR side of this term.
; (For now, the symbolic state and output are ignored, and are there for comments only.)

; For an example of use, see SCHIP2;CONTRL PLA

(declare (special *lambda-size *initial-symbol-number))
(if-for-maclisp
(defun do-PLA (&rest pla-list)
  (let ((*specs (open (mergef '((DSK *) * SPECS) (car pla-list)) '(out ascii)))
	(*pla-symbol-number* *initial-symbol-number)
	(*lambda-size))
       (format t '|~%How many microns per Lambda? |)
       (setq *lambda-size (fix (times (read) 100.)))
       (let ((outfiles (cons *specs outfiles))
	     (^R t))
	    (terpri)
	    (format t '|~%;This is the PLA construction for ~S|
		    (probef (mergef '((* *) * PLA) (first pla-list))))
	    (timestamp)
	    (terpri)
	    (apply 'read-pla pla-list))
       (close *specs)))
)

(if-for-lispm
(defun do-PLA (&rest pla-list)
  (let ((*pla-symbol-number* *initial-symbol-number)
	(*lambda-size))
       (format t '|~%How many microns per Lambda? |)
       (setq *lambda-size (fix (times (read) 100.)))

	    (terpri)
	    (format t '|~%;This is the PLA construction for ~S|
		    (probef (mergef '((* *) * PLA) (first pla-list))))
;	    (timestamp)
	    (terpri)
	    (apply 'read-pla pla-list)))
)

(defun elide (bit-no n)
   (let ((base 2)
	 (ibase 2))
	(readlist (cons '/0 (reverse (delete-nth bit-no (reverse (explodec n))))))))

(defun delete-nth (n l)
   (cond ((null l) nil)
	 ((<= n 0) (cdr l))
	 (t (cons (car l) (delete-nth (1- n) (cdr l))))))

(defun get-state (x n-ands)
   (cond ((atom x) (list x (1- (^ 2 n-ands))))
	 (t x)))



;Produce list of names from field specs.
;Field spec is of form:
;	(FIELD number (name type width position output-gating bit-reverse-flag))
; output gating is the name of the output clock signal (usually PH2)
; or "un-clocked" or nil which means no different from previous field.
;assume field specs are LSB - MSB, return names LSB first
;list of form (name ... *gnd* *break* ...)
; where *gnd* means insert a gnd mesh in this or plane
; where *break* means insert a gap to break the output gating
; <name> is of form (name gate) if folded
;		or (name1 name2 gate) if unfolded.
; gate can be "un-clocked" which may cause a different output driver
;  if compiling an unfolded PLA

(defun explode-or-fields (fields gnd-mesh folded-p)
   (let ((l (explode-gated fields)))
	(if (not folded-p) (setq l (explode-merge l)))
	(mesh-grounds l gnd-mesh)))

(defun explode-gated (fields)
    (do ((fl fields (cdr fl))
	 (out-gate nil)
	 (out nil))
	((null fl) (reverse out))
	(let* ((spec (third (car fl)))
	       (name (first spec))
	       (type (second spec))
	       (size (third spec))
	       (gate (fifth spec)))
	      (cond ((null out-gate) (setq out-gate gate))
		    ((and gate (neq gate out-gate))
		     (push '*break* out)
		     (setq out-gate gate)))
	      (caseq type
		     (BIT (push (list name out-gate) out))
		     (NUMBER
		      (do ((i 0 (1+ i)))
			  ((= i size))
			  (push (list (concat name '- i) out-gate)
				out)))
		     (BIT-REVERSE
		      (do ((i (1- size) (1- i)))
			  ((< i 0))
			  (push (list (concat name '- i) out-gate)
				out)))
		     (t (error '|Garbage field list| fl))))))

(defun explode-merge (l)
   (cond ((null l) nil)
	 ((atom (car l)) (cons (car l) (explode-merge (cdr l))))
	 ((and (not (atom (cadr l)))
	       (eq (second (car l))
		   (second (cadr l))))
	  (cons (list (caar l) (caadr l) (cadar l))
		(explode-merge (cddr l))))
	 (t (cons (list (caar l) nil (cadar l))
		  (explode-merge (cdr l))))))

(defun mesh-grounds (list gnd-mesh)
   (do ((count 0 (1+ count))
	(l list (cdr l))
	(brk)
	(out nil))
       ((null l) (reverse out))
       (cond ((eq (car l) '*break*) (setq count -1))
	     ((and (>= count gnd-mesh)			;No gnd for a while?
		   (> (length l) 1)
		   (or (not (setq brk (find-position-in-list '*break* l)))
		       (> brk 1)))
	      (push '*gnd* out)
	      (setq count 0)))
       (push (car l) out)))

(defun explode-fields (fields)
    (do ((fl fields (cdr fl))
	 (f)
	 (out nil))
	((null fl) (reverse out))
	(caseq (second (setq f (third (car fl))))
	    (BIT (push (first f) out))
	    (BIT-REVERSE
	     (do ((i (1- (third f)) (1- i)))
		 ((< i 0))
		 (push (concat (first f) '- i) out)))
	    (NUMBER
	     (do ((i 0 (1+ i)))
		 ((= i (third f)))
		 (push (concat (first f) '- i) out)))
	    (t (error '|Garbage field list| f)))))

(defun explode-gates (fields)
    (do ((fl fields (cdr fl))
	 (f)
	 (out nil))
	((null fl) (reverse out))
	(caseq (second (setq f (third (car fl))))
	    (BIT (push (fifth f) out))
	    (BIT-REVERSE
	     (do ((i (1- (third f)) (1- i)))
		 ((< i 0))
		 (push (fifth f) out)))
	    (NUMBER
	     (do ((i 0 (1+ i)))
		 ((= i (third f)))
		 (push (fifth f) out)))
	    (t (error '|Garbage field list| f)))))


