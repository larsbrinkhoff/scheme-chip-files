(setq ibase (setq base 10.))
(declare (special cif-readtable file-in file-out defs feature-size
		  default-layer layer-stack layer-alist symbol-alist))

(setq layer-alist '((nmet . metal) (ndif . diff) (ncut . cuts)
		    (npol . poly) (nimp . implant) (ngls . glass)
		    (nm . metal) (nd . diff) (nc . cuts)
		    (np . poly) (ni . implant) (ng . glass)
		    (poly . poly) (diffusion . diff) (implant . implant)
		    (contact . cuts) (metal . metal)))

(setq cif-readtable (si:copy-readtable readtable nil))

(set-syntax-from-description #/; 'si:single cif-readtable)

(set-syntax-from-description #/: 'si:single cif-readtable)

(set-syntax-from-description #/, 'si:whitespace cif-readtable)

(setq layer-stack  nil default-layer nil)

(defun get-files (&aux file-in-string file-out-string)    
    (print "input file name")
    (setq file-in-string (eval (read)))
    (print "output file name")
    (setq file-out-string (eval (read)))
    (setq file-in (open file-in-string 'in))
    (setq file-out (open file-out-string 'out))
    (print "At what feature size was this output produced?")
    (setq feature-size (* 100.0 (read))))

(defun fix-up-defs (def &aux (name (car def)) (forms (cdr def)) fixed-forms)
    (putprop 'box 0 'num)
    (push default-layer layer-stack)
    (mapc '(lambda (pair) (putprop (cdr pair) 0 'num)) symbol-alist)
    (setq fixed-forms (mapcan 'gobble-item forms))
    (let ((standard-output file-out))
      (grind-top-level `(deflayout ,name nil . ,fixed-forms)))
    (setq default-layer (pop layer-stack))
    (print name))

(defun gobble-item (form &aux (type (car form)) item)
    (setq item
	  (selectq type
	    (box (build-box-definition (cdr form)))
	    (layer (setq default-layer (cdr (assq (cadr form) layer-alist))) nil)
	    ((c call) (build-prototype-call (cdr form)))))
    (and item (list item)))
    
(defun build-box-definition (form &aux x-dim y-dim (center-x 0) (center-y 0)
				  (name  'box))
    (do ((f (car form) (car form)))
	((null form)
	 `(boxes  (,default-layer ,y-dim)
			  (pt ,(- center-x (// x-dim 2)) ,center-y) (+X ,x-dim)))	

      (selectq f
	((len length) (setq x-dim (// (cadr form) feature-size))
	 (setq form (cddr form)))
	((wid width) (setq y-dim (// (cadr form) feature-size))
	 (setq form (cddr form)))
	((cen center) (setq center-x (// (cadr form) feature-size)
			    center-y (// (caddr form) feature-size))
	 (setq form (cdddr form))))))

(defun build-prototype-call (form &aux (symbol-number (car form))
				       (symbol-name (cdr (assq symbol-number symbol-alist)))
				       (name symbol-name)
				       (xfrm 'identity)
				       (center-x 0)
				       (center-y 0)
				       (mirror nil))
    (setq form (cdr form))
    (do ((f (car form) (car form)))
	((null form)
	 (cond ((eq xfrm 'identity)
		(cond ((eq mirror nil)
		       	 `(call ',symbol-name nil 'trans (pt ,center-x ,center-y)))
		      (t `(call ',symbol-name nil 
				'mirror ',mirror 'trans (pt ,center-x ,center-y)))))
	       (t `(call ',symbol-name nil 'rot ',xfrm 'trans (pt ,center-x ,center-y)))))
      (selectq f
	((trans t) (setq center-x (// (cadr form) feature-size)
			 center-y (// (caddr form) feature-size))
	           (setq form (cdddr form)))
	(mir (setq mirror (cond ((eq (cadr form) 'x) 'X)
			    ((eq (cadr form) 'y) 'Y)
			    (t (ferror ':bad-xfrm "Unknown mirroring ~A" (cadr form)))))
	   (setq form (cddr form)))
	(rot (let ((x (cadr form)) (y (caddr form)))
	       (setq form (cdddr form))
	       (cond ((and (= x 0) (= y 1)) (setq xfrm `(,x ,y)))
		     ((and (= x 0) (= y -1) (setq xfrm `(,x ,y))))
		     ((and (= x -1) (= y 0)) (setq xfrm `(,x ,y)))
		     (t (ferror ':bad-xfrm "Unknown rotation ~A ~A" x y))))))))

(defun ciftran (&aux (old-ibase ibase))
    (get-files)
    (setq ibase 10.)
    (setq symbol-alist nil)
    (setq defs nil)
    (do ((x (get-next-symbol-definition) (get-next-symbol-definition)))
	((eq x 'eof) (close file-in))
      (push x defs))
    (setq defs (nreverse defs))
    (terpri)
    (mapc 'fix-up-defs defs)
    (setq ibase old-ibase)
    (close file-out))

(defun read-cif-line (&optional (skip-comments t) &aux goodies)
  (do ((x (read file-in 'eof) (read file-in 'eof)))
      ((eq x '|;|)
       (cond (goodies (nreverse goodies))
	     (t (read-cif-line))))
    (and (eq x 'eof) (return x))
    (or (and skip-comments (listp x)) (push x goodies))))

(defunp get-next-symbol-definition (&aux symbol-number symbol-name items exit-flag
					(readtable cif-readtable))
    (do ((x (read-cif-line) (read-cif-line)))
	((eq x 'eof) (setq exit-flag x))
      (cond ((eq (car x) 'ds) (setq symbol-number (cadr x)) (return x))
	    ((and (eq (car x) 'define) (eq (cadr x) 'symbol))
	     (setq symbol-number (caddr x)) (return x))))
    (and exit-flag (return exit-flag))
    (setq symbol-name (car (read-cif-line nil)))
    (cond ((and (eq (car symbol-name) 'name) (eq (cadr symbol-name) '|:|))
	   (setq symbol-name (caddr symbol-name)))
	  ((and (eq (car symbol-name) 'definition) (eq (cadr symbol-name) 'of))
	   (setq symbol-name (intern (caddr symbol-name)))))	   
    (push (cons symbol-number symbol-name) symbol-alist)
    (print symbol-name)
    (do ((current-item nil))
	((eq (car current-item) 'DF) (cons symbol-name  (nreverse items)))
      (setq current-item (read-cif-line))
      (and (eq (car current-item) 'definition) (eq (cadr current-item) 'finished)
	   (setq current-item '(df)))
      (selectq (car current-item)
	(DF )
	(layer (cond ((eq (cadr current-item) 'n)
		      (setq current-item `(layer ,(caddr current-item)))))
	       (push current-item items))
	(t (push current-item items)))))
