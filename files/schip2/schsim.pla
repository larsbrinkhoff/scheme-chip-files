(make-pla nano-pla
 16.   ;AND field
 51.   ;OR field
 68.   ;PLA size 

;PLA-AND field definitions - LSB is farthest from OR plane
(
(field 177400       (NANO-AND-STATE NUMBER 10 10 NIL))
(field 000360       (TO NUMBER 4 4 NIL))
(field 000017       (FROM NUMBER 4 0 NIL)))

;PLA-OR field definitions - LSB is closest to AND plane
(
(field 40000000000000000       (READ-INTERRUPT BIT 1 62 USED))
(field 20000000000000000       (READ BIT 1 61 USED))
(field 10000000000000000       (WRITE BIT 1 60 USED))
(field 04000000000000000       (ALE BIT 1 57 USED))
(field 02000000000000000       (CDR BIT 1 56 USED))
(field 01000000000000000       (MERGE-MARK-0 BIT 1 55 USED))
