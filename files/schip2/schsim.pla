(field 00000000000020000       (ALLOW-INTERRUPTS BIT 1 15 USED))
(field 00000000000010000       (DISPATCH BIT 1 14 USED))
(field 00000000000007000       (BRANCH -list- 3 11 *))
      ;0   NIL
      ;1   FRAME=0-BUS
      ;2   ADDRESS=0-BUS
      ;3   ADDRESS=BUS-NEWCELL
      ;4   TYPE=BUS-VAL
      ;5   =BUS-VAL
      ;6   TYPE=POINTER-BUS
      ;7   MARK-BIT-BUS
; Unused field decodes - (NIL)
(field 00000000000000400       (NANO-RUN BIT 1 10 USED))
(field 00000000000000377       (NANO-OR-STATE NUMBER 10 0 NIL)))


