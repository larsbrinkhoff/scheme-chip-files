(field 00040000000000000       (TO-MEMTOP BIT 1 51 NIL))
(field 00020000000000000       (FROM-ARGS BIT 1 50 NIL))
(field 00010000000000000       (TO-ARGS BIT 1 47 NIL))
(field 00004000000000000       (FROM-DISPLAY BIT 1 46 NIL))
(field 00002000000000000       (TO-DISPLAY BIT 1 45 NIL))
(field 00001000000000000       (FROM-INTERMEDIATE-ARGUMENT BIT 1 44 NIL))
(field 00000400000000000       (TO-INTERMEDIATE-ARGUMENT BIT 1 43 NIL))
(field 00000200000000000       (FROM-STACK BIT 1 42 USED))
(field 00000100000000000       (TO-TYPE-STACK BIT 1 41 USED))
(field 00000040000000000       (TO-ADDRESS-STACK BIT 1 40 USED))
(field 00000020000000000       (FROM-RETPC-COUNT-MARK BIT 1 37 USED))
(field 00000010000000000       (TO-TYPE-RETPC-COUNT-MARK BIT 1 36 NIL))
(field 00000004000000000       (TO-ADDRESS-RETPC-COUNT-MARK BIT 1 35 USED))
(field 00000002000000000       (FROM-VAL BIT 1 34 NIL))
(field 00000001000000000       (TO-TYPE-VAL BIT 1 33 NIL))
(field 00000000400000000       (TO-ADDRESS-VAL BIT 1 32 NIL))
(field 00000000200000000       (FROM-INCREMENTED-NEWCELL BIT 1 31 USED))
(field 00000000100000000       (FROM-NEWCELL BIT 1 30 USED))
(field 00000000040000000       (TO-TYPE-NEWCELL BIT 1 27 NIL))
(field 00000000020000000       (TO-ADDRESS-NEWCELL BIT 1 26 USED))
(field 00000000010000000       (FROM-DECREMENTED-EXP BIT 1 25 USED))
(field 00000000004000000       (FROM-EXP BIT 1 24 NIL))
