; The following define the control lines and sense wires on the registers.

(defreg *exp* (to-type to-displacement to-frame from from-decremented) ())

(defreg *newcell* (to-type to-address from from-incremented) (address=bus))

(defreg *val*
	(to-type to-address from)
	(type=bus address=bus =bus))		 ;=bus is AND of type, address=bus

(defreg *retpc-count-mark* (to-type to-address from) ())

(defreg *stack* (to-type to-address from) ())

(defreg *memtop* (to from) ())

(defreg *args* (to from) ())

(defreg *display* (to from) ())

(defreg *intermediate-argument* (to from) ())

(defreg *nil* (from) ())

;The bus is sensitive to several conditions:

(defreg bus () (mark-bit type=pointer frame=0 displacement=0 address=0))





(defpc standard-eval
       (save (fetch *display*))
       (&set-type *stack* (fetch *retpc-count-mark*))
       (save (&cdr (fetch *exp*)))
       (&set-type *stack* standard-return)
       (assign *exp* (&car (fetch *exp*)))
       (dispatch-on-exp-allowing-interrupts))

(defreturn standard-return
       (restore *exp*)
       (assign *retpc-count-mark* (fetch *stack*))
       (restore *display*)
       (dispatch (fetch *retpc-count-mark*)))


(deftype sequence				;(SEQUENCE expression . rest)
	 (assign *val* (fetch *nil*))			;for gc
	 (save-cdr-and-eval-car sequence-return))

(defreturn sequence-return
	   (dispatch-on-exp-allowing-interrupts))



                                   FIELD DEFINITIONS

(setq **micro-and-fields**
   (parse-fields (state 9 ph1 bit-reverse)))		;LSB is furthest from OR plane

(setq **micro-or-fields**				;LSB is closest to AND plane
    (parse-fields (next 9 ph2)
		  (nano-op *nano-state-bits* un-clocked bit-reverse)
		  (from 7				;room for use as constant
			(exp				; decremented-exp
			newcell				;incremented-newcell
			val
			retpc-count-mark
			stack
			memtop
			args
			display
			intermediate-argument
			nil)
			un-clocked)			;no gating on outputs
		  (to nil				;not all these are used
		      (no-op
		       displacement-exp address-exp exp ;type-exp
		       type-newcell newcell		;address-newcell
		       type-val val			;address-val
		       type-retpc-count-mark retpc-count-mark    ;address-retpc-count-mark
		       type-stack stack			;address-stack
		       memtop
		       args
		       display
		       intermediate-argument)
		      un-clocked)))



                                      NANO SEQUENCES

(defnano (do-increment-newcell)
    (() (from-incremented-newcell to-address-retpc-count-mark))
    (() (from-memtop set-gc-needed-if-address-newcell=bus))
    (() (from-retpc-count-mark to-address-newcell)))

(defnano (do-save)
   (() (from-incremented-newcell to-address-retpc-count-mark ale))
   (() (from-memtop set-gc-needed-if-address-newcell=bus))
   (() (from-retpc-count-mark to-address-newcell))
   ((from*) (write))
   (() (from-stack write cdr))
   (() (from-newcell to-address-stack to-type-stack)))

(defnano (do-restore)
   (() (from-stack ale))
   ((to*) (read))
   (() (read cdr to-address-stack to-type-stack)))

(defnano (do-car)
   ((from*) (ale))
   ((to*) (read)))

(defnano (do-cdr)
   ((from*) (ale))
   ((to*) (read cdr)))


;This is the assembled PLA for ((DSK SCHIP2) SCHSIM /203)
;The moon is 1 day, 9 hours, 28 minutes, and 30 seconds past the last quarter.
;The sun is 1*56'27" west of north, 26*28'45" below the horizon.
;That means it is now 12:43 AM on Wednesday, July 18, 1979.

(make-pla micro-pla
 9.   ;AND field
 28.   ;OR field
 297.   ;PLA size 

;PLA-AND field definitions - LSB is farthest from OR plane
(
(field 777       (STATE BIT-REVERSE 11 0 PH1))
)

;PLA-OR field definitions - LSB is closest to AND plane
(
(field 0000000777       (NEXT NUMBER 11 0 PH2))
(field 0000377000       (NANO-OP BIT-REVERSE 10 11 UN-CLOCKED))
(field 0077400000       (FROM NUMBER 7 21 UN-CLOCKED))
