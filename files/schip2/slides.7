      ;11   RETPC-COUNT-MARK
      ;12   TYPE-STACK
      ;13   STACK
      ;14   MEMTOP
      ;15   ARGS
      ;16   DISPLAY
      ;17   INTERMEDIATE-ARGUMENT
; Unused field decodes - (NO-OP)
)


