      ;1   NEWCELL
      ;2   VAL
      ;3   RETPC-COUNT-MARK
      ;4   STACK
      ;5   MEMTOP
      ;6   ARGS
      ;7   DISPLAY
      ;10   INTERMEDIATE-ARGUMENT
      ;11   NIL
(field 1700000000       (TO NUMBER 4 30 UN-CLOCKED))
