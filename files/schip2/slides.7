;Note that the cell definitions must be mirrored in Y
; to make the upper left corner of the AND array be 0,0


;            |--------------|   |----------------------|----|
;            |              |   |                      |    |
;            |   InPair     |   |      Out             | O  |
;            |   Mir Y      |   |     Mir Y            | u  |
;            |              |   |                      | t  |
;            ---------------|   |                      |    |
;            |   Gnd MirY   |   |                      |Gnd |
;   |-------------------------------------------------------|
;   |        |              | C |                      |G   |
;   |        |     AND      | o |          OR          |n   |
;   | Pullup |     Cell     | n |         Cells        |d   |
;   |  MirY  |     Mir Y    | n |                      |    |
;   |        |              | e |     Rot 0,-1; MirY   |Rot |
;   |        |              | c |                      |0,-1|
;   |--------|--------------------------------------------- |
;   | PullGnd| -- Ground -- | * |     Diffusion ground | &  |
;   |--------|--------------------------------------------- |
;   |        |              |   |                      |    |
;   |        |              |   |                      |  G |
;   |        |              |   |          Cells       |  n |
;   |        |              |   |                      |  d |
;   ---------------------------------------------------------
;      |   |-| Ground       |-- |                      |
;      |     |--------------|   |        Pullup        |
;      |----- VDD wires ------- |      Rot 0,-1; MirY  |
;                               ------------------------
;   * - Pla-gnd-cross: a special cell to merge ground at PlaGround,
;		DiffusionGnd,Connect
;   & - Pla-gnd-cross Rot 0,-1 MirY
;   Note that there is an extra row of Pla-gnd above and below
;	the AND plane




(deflayout pla (#Ands #ors nterms and-fields or-fields
		 program gnd-mesh gnd-width folded-p)

	...

	;;Build the And inputs

	(setq names (explode-fields and-fields))
	(setq gates (explode-gates and-fields))
	(if (not (= (length names) #ands))
	    (error '|#ands and field description inconsistent|
		   (list (length names) #ands)))
	(cond (folded-p
	       (setq elided-bit# (find-position-in-list folded-p names))
	       (if (not elided-bit#) (error '|LSB not found| folded-p))
	       (setq names (delete-nth elided-bit# names))
	       (format t '|~%Eliding bit ~D, leaving ~S| elided-bit# names)))
	(set-the' And-Names names)
	(do ((i 0 (+ i 1))
	     (gates gates (cdr gates))
	     (names names (cdr names))
	     (phase t (not phase))
	     (x 0 (+ x (the Cell-Size))))
	    ((>= i actual-#and-cells)
	       (set-the' and-right-edge x)
	       (set-the 'ph1-right (max-x (the-pt ph1-left plain)
					  (the-pt ph1-right plain)))
	       (set-the' right-plain (the plain))
	       (set-the 'and-top-right-pla-gnd (the-pt end gnd and-pla-gnd)))
	    
	    (format t '|~%Placing AND input for ~A at X=~D|
		    (car names)
		    x)
	    (set-the' and-pla-gnd (call* Pla-In-Gnd (Mirror Y) (Trans (pt x 0))))
	    ;;check for gated or non-gated inputs?
	    (cond ((eq (car gates) 'un-clocked)
		   (set-the' plain
			     (if phase
				 (call* PlaIn-un-gated (Mirror Y)
					(Trans (pt (+ x 15) (the gnd-height))))
				 (call* PlaIn-un-gated (Mirror Y) (mirror X)
					(Trans (pt (1+ x) (the gnd-height)))))))
		  (t (set-the' plain
			       (if phase
				   (call* PlaIn (Mirror Y)
					  (Trans (pt (+ x 15) (the gnd-height))))
				   (call* PlaIn (Mirror Y) (mirror X)
					  (Trans (pt (1+ x) (the gnd-height))))))))
	    (set-the (car names) (the-pt input plain))
	    (cond ((= i 0)
		   (set-the 'ph1-left (min-x (the-pt ph1-left plain)
					      (the-pt ph1-right plain)))
		   (set-the' left-plain (the plain))
		   (set-the 'and-top-left-pla-gnd (the-pt start gnd and-pla-gnd)))))
	
