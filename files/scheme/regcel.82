;;; -*-LISP-*-

;;; Rectangle = (<left-x> <right-x> <top-y> <bot-y>)
;;; For implant, OMIT the 1 1/2 lambda margin -- just specify transistor area.
;;; For cuts, just give center of cut, plus H (horiz),  (vert), or S (square).

(comment register cell definitions)

(layout regcell (42 40) =
	(poly (3 5 0 12) (5 7 10 20) (3 5 18 40)	;PHI1*LD
	      (7 11 26 29) (9 11 29 30) (9 20 30 32)
	      (13 19 17 26) (19 21 24 26) (19 27 26 28)
	      (21 27 16 22)
	      (29 31 -1 40)				;PHI2
	      (37 39 0 12) (35 37 10 20) (37 39 18 40))	;PHI1*RD
	(diff (0 8 13 17) (8 10 1 23) (7 11 23 27) (10 32 1 3)
	      (32 34 1 21) (32 36 21 25) (34 42 13 17)
	      (14 26 6 10) (15 17 10 25) (14 18 25 37) (18 26 33 37)
	      (22 25 25 33) (22 26 21 25) (23 25 10 21))
	(metal (0 42 6 10)				;VDD
	       (0 42 13 16) (0 4 13 17) (38 42 13 17)	;BUS
	       (7 11 23 29)
	       (14 18 23 29)
	       (22 26 19 25) (26 32 22 25) (32 36 21 25)
	       (0 42 33 37))				;GND
	(cuts (2 15 S) (16 8 S) (24 8 S) (40 15 S) (9 26 V) (16 26 V)
              (24 22 V) (34 23 S) (16 35 S) (24 35 S))
	(implant (15 17 17 26) (23 25 16 22)))

(layout regout (42 40) =
	(poly (3 5 0 12) (5 7 10 20) (3 5 18 40)	;PHI1*LD
	      (7 11 26 29) (9 11 29 30) (9 20 30 32)
	      (13 19 17 26) (19 21 24 26) (19 27 26 28)
	      (21 27 16 22)
	      (29 31 -1 40))				;PHI2
	(diff (0 8 13 17) (8 10 1 23) (7 11 23 27) (10 32 1 3)
	      (32 34 1 21) (32 36 21 25)
	      (14 26 6 10) (15 17 10 25) (14 18 25 37) (18 26 33 37)
	      (22 25 25 33) (22 26 21 25) (23 25 10 21))
	(metal (0 42 6 10)				;VDD
	       (0 4 13 17)				;BUS
	       (7 11 23 29)
	       (14 18 23 29)
	       (22 26 19 25) (26 32 22 25) (32 36 21 25)
	       (0 26 33 37))				;GND
	(cuts (2 15 S) (16 8 S) (24 8 S) (9 26 V) (16 26 V)
              (24 22 V) (34 23 S) (16 35 S) (24 35 S))
	(implant (15 17 17 26) (23 25 16 22)))

(layout reginc (85 39) =
	(poly (3 5 0 12) (5 7 10 20) (3 5 18 40)	;PHI1*LD
	      (7 11 27 30) (9 11 30 32) (9 20 32 34)
	      (12 20 17 25) (17 20 25 30) (20 26 28 30)	;PULLUP
	      (20 27 10 15) (25 27 15 19) (24 27 19 23)	;PULLUP
	      (29 31 -1 40)				;PHI2
	      (37 39 0 40)				;PHI1*RD
	      (41 43 0 12) (43 45 10 12) (45 47 10 20)	;PHI1*RD+...
	      (43 45 18 20) (41 43 18 40)
	      (51 53 -1 19) (53 71 -1 1) (71 73 -3 1)	;-CIN
	      (46 53 22 24) (51 59 24 26) (59 61 3 37)	;CIN...
	      (61 83 3 5) (83 85 -3 5)
	      (63 67 26 30) (63 65 30 37)		;Q
	      (63 66 14 23) (66 71 14 18) (71 73 14 37) (73 81 28 30)	;-COUT
	      (72 80 9 12) (77 80 12 24) (80 85 22 24) (83 85 24 37))	;COUT
	(diff (0 8 13 17) (7 11 24 28) (8 10 1 24) (10 34 1 3)
	      (32 34 3 20) (32 36 20 24) (34 44 13 17)
	      (13 19 6 10) (14 16 10 26) (14 18 26 37) (18 21 35 37)
	      (21 27 33 37) (21 24 16 33) (24 25 19 23) (22 24 6 16)
	      (19 24 6 8)
	      (44 57 13 17) (48 50 17 26) (46 50 26 30) (55 57 17 19)
	      (54 58 19 23)
	      (51 57 33 37) (55 70 31 35) (68 70 23 31) (65 70 19 23)
	      (67 69 10 19) (64 70 6 10) (70 76 6 8) (74 76 8 20)
	      (74 78 20 26) (74 79 26 33) (74 80 33 37))
	(metal (0 85 6 10)				;VDD
	       (0 85 13 16) (0 4 13 17) (40 44 13 17)	;BUS
	       (7 11 24 30)
	       (14 20 26 30) (20 46 27 30) (46 50 26 30)	;-Q
	       (21 27 19 23) (27 54 20 23) (32 36 20 24)	;Q...
	       (34 38 20 23) (54 58 19 23) (54 57 23 27) (54 63 27 30) (63 67 26 30)
	       (63 69 19 23)
	       (74 80 20 24)
	       (0 85 33 37))				;GND
	(cuts (16 8 H) (67 8 H)				;VDD
	      (2 15 S) (42 15 S)			;BUS
	      (24 21 H) (34 22 S) (56 21 S) (65 28 S)	;Q
	      (9 27 V)
	      (17 28 H) (48 28 S)			;-Q
	      (66 21 H)
	      (77 22 H)
	      (24 35 H) (54 35 H) (77 35 H))		;GND
	(implant (14 16 17 25) (22 24 10 15) (67 69 14 18) (74 76 9 12)))

