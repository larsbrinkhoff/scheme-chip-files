(layout clocked-phase1-driver (21 53) =
	(poly (1 3 0 13) (1 7 13 17)			;PHI1*X
	      (5 18 5 11)				;SUPERBUFFER PULLUP
	      (2 18 19 21) (2 4 21 43) (2 5 38 42) (2 10 43 48)	;-(PHI*X)
	      (7 17 30 32) (17 21 29 33)		;PHI1
	      (7 18 35 37) (16 18 37 53))		;X
	(diff (7 16 0 4) (7 10 4 13) (6 10 13 22) (6 16 22 26)
	      (13 16 17 22) (13 17 10 17) (14 16 4 10)
	      (9 15 26 42) (4 10 38 42) (6 8 42 49) (4 10 49 53))
	(metal (0 21 0 4)				;VDD
	       (4 10 13 17) (13 17 8 14)
	       (0 21 22 26)				;GND
	       (0 21 29 32) (17 21 29 33)		;PHI1
	       (2 8 38 42)
	       (0 21 49 53))				;VDD
	(cuts (9 2 S) (14 2 S)				;VDD
	      (7 15 H) (15 11 V)
	      (8 24 S) (14 24 S)			;GND
	      (19 31 S)					;PHI1
	      (5 40 H)
	      (7 51 H))					;VDD
	(implant (7 10 5 11) (14 16 5 11) (6 8 43 48)))

(layout phase2-driver (38 20) =
	(poly (7 9 0 8) (5 9 8 12)			;PHI2
	      (16 25 -2 0) (16 18 0 10) (15 16 2 6) (11 18 10 14)
	      (20 27 8 14) (26 30 8 12)			;PHI2/PULLUP
	      (27 30 -1 5))				;BUFFERED PHI2
	(diff (13 15 9 15) (12 15 6 9) (4 16 2 6)
	      (4 6 -5 2) (6 23 -5 -3) (19 23 -3 3)
	      (22 28 1 5) (22 25 5 15) (13 25 15 17))
	(metal (0 38 9 12) (5 9 8 12) (26 30 8 12)	;PHI2
	       (12 18 2 6) (24 30 1 5))
	(cuts (7 10 S) (28 10 S) (15 4 H) (27 3 H))
	(implant (13 15 10 14) (22 25 8 14)))

(layout clocked-phase1-driver-bus-through (38 20) =
	(poly (1 3 0 15)))

(define regcell-driver
	(call phase2-driver (trans 2 0))
	(call clocked-phase1-driver-bus-through (trans 2 0))
	(call clocked-phase1-driver (trans 2 -15))
	(call clocked-phase1-driver-bus-through (mirror x) (trans 40 0))
	(call clocked-phase1-driver (mirror x) (trans 40 -15)))

(layout regout-driver-metal (21 53) =
	(metal (0 40 0 4) (0 40 49 53)))		;VDD

(define regout-driver
	(call phase2-driver (trans 2 0))
	(call clocked-phase1-driver-bus-through (trans 2 0))
	(call clocked-phase1-driver (trans 2 -15))
	(call regout-driver-metal (mirror x) (trans 40 -15)))

(layout reginc-driver-metal (85 53) =
	(metal (38 89 9 12)				;PHI2
	       (59 89 15 19)				;VDD
	       (59 89 37 41)				;GND
	       (59 89 44 47)				;PHI1
	       (59 89 64 68)))				;VDD

(define reginc-driver
	(call regcell-driver)
	(call clocked-phase1-driver-bus-through (trans 40 0))
	(call clocked-phase1-driver (trans 40 -15))
	(call reginc-driver-metal))

(layout bus-connect (130 40) =
	(poly (20 22 0 40) (30 32 0 40)			;EA-LIT, ET-LIT
	      (107 109 0 40) (115 117 0 40) (123 125 0 40))	;CONN-I, CONN-EA, CONN-ET
	(diff (41 43 10 50) (47 49 10 50) (53 55 10 50)	;LIT0, LIT1, LIT2
	      (100 106 0 30) (106 114 24 30))
	(metal (0 52 6 10) (46 122 8 12) (116 134 6 10)	;VDD
	       (0 42 13 16) (38 110 15 18)		;E BUS...
	       (110 114 15 21) (14 18 16 28)
	       (110 114 24 30) (114 126 24 28) (126 130 13 28) (130 134 13 16)	;G BUS
	       (0 134 33 37))				;GND
	(cuts (112 27 V)))

