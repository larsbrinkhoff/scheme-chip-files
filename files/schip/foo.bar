(defun cifile fexpr (x)					;(cifile . <input filename>)
       (let ((filename (defaultf (mergef x '((* *) * >)))))
	    (let ((ifile (open filename '(ascii in)))
		  (eof (list nil)))
		 (let ((ofile (open (mergef '(_cif_ output) ifile) '(ascii out))))
		      (do ((z (read ifile eof) (read ifile eof)))
			  ((eq z eof))
			  (cond ((atom z))
				((eq (car z) 'layout)
				 (putprop (cadr z) (cadddr z) 'cifnumber)
				 (cifcell (cadr z) (cddr z) ofile))
				(t (let ((*cifofile* ofile)) (eval z)))))
		      (renamef ofile (mergef filename '((* *) * cif)))
		      (close ofile)
		      (truename ofile)))))
