;;; Stipple pattern stuff, swiped from H;DAEDAL and modified

;;; A stipple pattern is stored as a numeric array, typically ART-16B,
;;; whose 32-bit data words contain a 2-dimensional stipple patch, a multiple
;;; of 32 bits wide and some number of bits high.  As usual with screens,
;;; the width dimension varies the fastest.  To stipple a region of screen,
;;; BITBLT this into the region; it will be replicated as many times as necessary.

;;; This function creates a stipple pattern with a horizontal period of
;;; up to 16 bits.  The rest args are the successive rows of pattern.
;;; The pattern arguments are strings.

(defun make-stipple (height width byte-size &rest patterns
			    &aux rwidth stipple)
       (check-arg height (= height (length patterns)) "equal to number of patterns")
       (check-arg byte-size ( byte-size 16.) "less than or equal to 16.")
       ;;Convert strings to binary for each row of stipple
       ;;CROCK: losing RPLACA
       (do l patterns (cdr l) (null l)
	   (rplaca l (do ((w 0 (+ w 1))
			  (r 0 (+ (lsh r 1) (if (or (= (aref (car l) w) 40)
						    (= (aref (car l) w) 60))
						0 1))))
			 ((= w byte-size) r))))
       ;;Fill 16B array from stipple pattern
       (setq rwidth					;Number of 16-bit words wide
	     (* 2 (max 1 (\ (+ (* width byte-size) 31.) 32.))))
       (setq stipple (make-array nil 'art-16b (list rwidth height)))
       (do ((l patterns (cdr l))
	    (idx 0 (1+ idx))
	    (pattern)
	    (n height (1- n)))
	   ((zerop n))
	   (setq pattern (car l))
	   ;;Fill in one row with repeats of pattern byte packed into 16 bit chunks
	   (do ((i 0 (1+ i))
		(m rwidth (1- m))
		(bitsoff 0 (\ (+ bitsoff 16.) byte-size)))	;Bit offset of start of hwd
	       ((zerop m))
	       ;;Pack bytes into a 16 bit chunk
	       (do ((byte (lsh pattern (- bitsoff))
			  (dpb pattern (+ (lsh pos 6) byte-size) byte))
		    (pos (- byte-size bitsoff) (+ pos byte-size)))
		   ((>= pos 16.) (aset byte stipple i idx)))))
       ;;Convert result into 1B array
       (make-array nil 'art-1b (list (* rwidth 16.) height) stipple))

