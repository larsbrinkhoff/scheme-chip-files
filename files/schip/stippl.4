(defun stipple (x0 y0 x1 y1
		   &OPTIONAL
		   (stipple poly)
		   (alu tv-alu-ior)
		   (screen (screen-buffer-pixel-array tv-default-screen)))
       (bitblt alu
	       (- x1 x0) (- y1 y0)
	       stipple					;from
	       (logand x0 17) (\ y0 (array-dimension-n 2 stipple))	;align correctly
	       screen					;to
	       x0 y0))

(defun d-rect (layer len width center-x center-y)
   (stipple (- center-x (// width 2))
            (- center-y (// len 2))
            (+ center-x (// width 2))
            (+ center-y (// len 2))
            layer))

(defun invert ()
       (tv-clear-all)
       (d-rect poly 40 300 400 500)			;gate
       (d-rect diffusion 400 60 500 400)		;vertical diff
       (d-rect diffusion 50 300 650 400)		;output diffusion
       (d-rect poly 120 120 500 300)			;pullup poly
       (d-rect contact 30 30 500 350)			;contact
       (d-rect metal 60 500 500 600)			;vcc
       (d-rect contact 30 30 500 600)			;contact
       (d-rect diffusion 70 70 500 600)			;contact
       (d-rect implant 150 110 500 300)			;implant
       (d-rect metal 60 500 500 200)			;vdd
       (d-rect contact 30 30 500 200)			;contact
       (d-rect diffusion 70 70 500 200)			;contact
       )

(defun stcruft ()
       (tv-clear-all)
       (let ((crap (list checks hstripes vstripes diag antidiag
			 bigchecks squares holes mesh faces)))
	    (do i 0 (+ i 1) (= i 10.)
		(do j 0 (+ j 1) (= j 10.)
		    (stipple (* i 70) (* j 70) (* (+ i 1) 70) (* (+ j 1) 70)
			     (nth (\ (+ i j) 10.) crap))))))
