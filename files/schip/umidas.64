
;;; -*-LISP-*-		MICROASSEMBLER FOR SCHEME SCHIP

(DECLARE (MUZZLED T))

(DEFPROP TIMESTAMP |DSK:LIBLSP;PHSPRT FASL| AUTOLOAD)

(DEFUN UMIDAS FEXPR (FILENAME)
       (LET ((IFILENAME (DEFAULTF (MERGEF FILENAME '((DSK *) * >)))))
	    (LET ((IFILE (OPEN FILENAME '(IN ASCII)))
		  (OFILE (OPEN (MERGEF '((* *) _UMID_ OUTPUT) IFILENAME) '(OUT ASCII)))
		  (EOF (LIST 'EOF)))
		 (TERPRI OFILE)
		 (PRINC '|;THIS IS THE ASSEMBLED MICROCODE FOR | OFILE)
		 (PRIN1 (TRUENAME IFILE) OFILE)
		 (TIMESTAMP OFILE)
		 (TERPRI OFILE)
		 (DO ((X (READ IFILE EOF) (READ IFILE EOF)))
		     ((EQ X EOF))
		     (COND ((AND (NOT (ATOM X)) (EQ (CAR X) '*UCODE))
			    (ASSEMBLE X OFILE))
			   (T (PRINT X OFILE))))
		 (TIMESTAMP OFILE)
		 (TERPRI OFILE)
		 (LET ((OFILENAME (MERGEF '((* *) * *UCODE) IFILENAME)))
		      (RENAMEF OFILE OFILENAME)
		      (CLOSE OFILE)
		      OFILENAME))))

(DEFUN ASSEMBLE (STUFF OFILE)
       (COND ((AND (EQ (CAR (CADDR STUFF)) 'FIELDS)
		   (EQ (CAR (CADDDR STUFF)) 'CODE))
	      (TERPRI OFILE)
	      (PRINC '|(UCODE | OFILE)
	      (PRIN1 (CADR STUFF) OFILE)
	      (LET ((FIELDS (PARSE-FIELDS (CDR (CADDR STUFF)))))
		   (LET ((OS (GETSTATE FIELDS 'OSTATE))
			 (NS (GETSTATE FIELDS 'NSTATE)))
			(OR (= (CADDR OS) (CADDR NS))
			    (ERROR '|OSTATE AND NSTATE SIZES DISAGREE|
				   (LIST OS NS)
				   'FAIL-ACT))
			(PASS2 FIELDS
			       (PASS1 (CDR (CADDDR STUFF))
				      (CADDR NS))
			       OFILE)))
	      (TERPRI OFILE)
	      (PRINC '|)	;END OF UCODE | OFILE)
	      (PRIN1 (CADR STUFF) OFILE)
	      (TERPRI OFILE))
	     (T (ERROR '|BAD *UCODE FORMAT| STUFF 'FAIL-ACT))))

;;; RETURNS (TOTAL-BITS FIELD1 ... FIELDN)
;;; WHERE FIELDJ = (NAME TYPE WIDTH LEFTSHIFT)
;;; WHERE TYPE IS "BIT", "NUMBER", "NSTATE", "OSTATE", OR A LIST
;;; OF VALID SYMBOLIC VALUES.

(DEFUN PARSE-FIELDS (SPECS)
       (PF SPECS 0 NIL))

(DEFUN PF (SPECS LSH RESULT)
       (COND ((NULL SPECS) (CONS LSH RESULT))
	     ((ATOM (CAR SPECS))
	      (PF (CDR SPECS)
		  (+ LSH 1)
		  (CONS (LIST (CAR SPECS) 'BIT 1 LSH) RESULT)))
	     ((ATOM (CAAR SPECS))
	      (COND ((NUMBERP (CADAR SPECS))
		     (PF (CDR SPECS)
			 (+ LSH (CADAR SPECS))
			 (CONS (LIST (CAAR SPECS)
				     (OR (CADDAR SPECS) 'NUMBER)
				     (CADAR SPECS)
				     LSH)
			       RESULT)))
		    (T (LET ((Z (LENGTH (CDAR SPECS))))
			    (LET ((ZLOG (- (HAULONG Z) 1)))
				 (COND ((= Z (^ 2 ZLOG))
					(PF (CDR SPECS)
					    (+ LSH ZLOG)
					    (CONS (LIST (CAAR SPECS)
							(CDAR SPECS)
							ZLOG
							LSH)
						  RESULT)))
				       (T (ERROR '|NUMBER OF SYMBOLIC NAMES NOT A POWER OF 2|
						 (CAR SPECS)
						 'FAIL-ACT))))))))
	     (T (ERROR '|BAD FIELD SPECIFICATION| (CAR SPECS) 'FAIL-ACT))))

(DEFUN GETSTATE (FIELDS STATE)
       (DO ((FS (CDR FIELDS) (CDR FS)))
	   ((NULL FS)
	    (ERROR '|FIELD NOT DEFINED| STATE 'FAIL-ACT))
	   (COND ((EQ (CADAR FS) STATE) (RETURN (CAR FS))))))

(DEFUN AREF MACRO (X) `(ARRAYCALL T . ,(CDR X)))

(DEFUN ASET MACRO (X)
       `(STORE (ARRAYCALL T . ,(REVERSE (CDR (REVERSE (CDR X)))))
	       ,(CAR (LAST X))))

;;; WILL RETURN (CRUFT . ALLTAGS).  CRUFT IS A 5XN ARRAY.  FOR EACH N,
;;; ITEM 0 IS THE DEFAULT NSTATE, ITEM 1 IS A LIST OF TAGS, ITEM 2 IS
;;; THE INSTRUCTION, ITEM 3 IS T IFF PART OF A TABLE (FORCED LOCATION).
;;; ITEM 4 IS USED IN PASS 2.
;;; ALLTAGS IS AN ALIST DEFINING THE TAG VALUES.

(DECLARE (SPECIAL *MAXCODELOG* *BLOCKS* *CRUFT*))

(DEFUN PASS1 (CODE *MAXCODELOG*)
       (LET ((*BLOCKS* (*ARRAY NIL T (+ *MAXCODELOG* 1)))
	     (*CRUFT* (*ARRAY NIL T 5 (^ 2 *MAXCODELOG*))))
	    (ASET *BLOCKS* *MAXCODELOG* (LIST 0))	;INIT "BUDDIES" LISTS
	    (CONS *CRUFT* (P1 CODE NIL '? NIL NIL NIL))))

(DEFUN P1 (CODE TAGS LOCS GRITCH PREVLOC ALLTAGS)
       (COND ((EQ LOCS '=)
	      (COND ((NOT (EQUAL (CAR CODE) (LIST '= GRITCH)))
		     (ERROR '|MISSING = AFTER TABLE|
			    `((= ,GRITCH) BEFORE ,(CAR CODE))
			    'FAIL-ACT))
		    ((NOT (NULL TAGS))
		     (ERROR '|TAGS SHOULD NOT PRECEDE A = AFTER TABLE| TAGS 'FAIL-ACT))
		    (T (P1 (CDR CODE) TAGS NIL '? PREVLOC ALLTAGS))))
	     ((NULL CODE)
	      (AND TAGS (ERROR '|HANGING TAGS (CONTINUE TO IGNORE)| TAGS 'FAIL-ACT))
	      (AND LOCS (ERROR '|HANGING TABLE (CONTINUE TO IGNORE)| '? 'FAIL-ACT))
	      ALLTAGS)
	     ((ATOM (CAR CODE))
	      (COND ((ASSQ (CAR CODE) ALLTAGS)
		     (ERROR '|DUPLICATE TAG (CONTINUE TO IGNORE)| (CAR CODE) 'FAIL-ACT)
		     (P1 (CDR CODE) TAGS LOCS GRITCH PREVLOC ALLTAGS))
		    (T (P1 (CDR CODE)
			   (CONS (CAR CODE) TAGS)
			   LOCS
			   GRITCH
			   PREVLOC
			   ALLTAGS))))
	     ((EQ (CAAR CODE) '=)
	      (COND ((NULL (CDAR CODE))
		     (ERROR '|MISPLACED (CONTINUE TO IGNORE)| (CAR CODE) 'FAIL-ACT)
		     (P1 (CDR CODE) TAGS LOCS GRITCH PREVLOC ALLTAGS))
		    (T (P1 (CDR CODE)
			   TAGS
			   (TABLELOCS (COND ((NUMBERP (CADAR CODE))
					     (CDAR CODE))
					    (T (CDDAR CODE))))
			   (COND ((NUMBERP (CADAR CODE)) '!)
				 (T (CADAR CODE)))
			   PREVLOC
			   ALLTAGS))))
	     (T (LET ((B (OR (CAR LOCS) (FINDBLOCK 0))))
		     (AND PREVLOC (ASET *CRUFT* 0 PREVLOC B))
		     (ASET *CRUFT* 1 B TAGS)
		     (ASET *CRUFT* 2 B (CAR CODE))
		     (AND LOCS (ASET *CRUFT* 3 B GRITCH))
		     (P1 (CDR CODE)
			 NIL
			 (CDR LOCS)
			 GRITCH
			 B
			 (DO ((Z TAGS (CDR Z))
			      (A ALLTAGS (CONS (CONS (CAR Z) B) A)))
			     ((NULL Z) A)))))))

;;; TAKE CDDR OF A (= ...) SPECS, RETURN LIST OF LOCS ENDING IN =: (LOC1 LOC2 ... LOCN . =)

(DEFUN TABLELOCS (SPEC)
       (DO ((S SPEC (CDR S))
	    (MASK 0 (+ (LSH MASK 1) (COND ((EQ (CAR S) '*) 0) (T 1))))
	    (ADR 0 (+ (LSH ADR 1)
		      (COND ((OR (EQ (CAR S) '*) (EQUAL (CAR S) '0)) 0)
			    (T (CAR S)))))
	    (HISTAR 0 (COND ((AND (ZEROP HISTAR) (EQ (CAR S) '*)) 2) (T (LSH HISTAR 1)))))
	   ((NULL S)
	    (LET ((BMASK (COND ((ZEROP HISTAR) MASK)
			       (T (BOOLE 4 MASK (- HISTAR 1)))))
		  (LOG (COND ((ZEROP HISTAR) 0)
			     (T (- (HAULONG HISTAR) 1)))))
	    (ENUMERATE (ALLOCATE ADR BMASK LOG) LOG ADR MASK BMASK (AND (NOT (ZEROP HISTAR)) '=))))))

(DEFUN ENUMERATE (BLOCK LOG ADR MASK BMASK SOFAR)
       (COND ((ZEROP (BOOLE 1 BMASK (BOOLE 6 ADR BLOCK)))
	      (COND ((= LOG 0)
		     (COND ((ZEROP (BOOLE 1 MASK (BOOLE 6 ADR BLOCK)))
			    (CONS BLOCK SOFAR))
			   (T (INSERT-BLOCK LOG BLOCK) SOFAR)))
		    (T (ENUMERATE BLOCK (- LOG 1) ADR MASK BMASK
				  (ENUMERATE (+ BLOCK (^ 2 (- LOG 1)))
					     (- LOG 1)
					     ADR
					     MASK
					     BMASK
					     SOFAR)))))
	     (T (INSERT-BLOCK LOG BLOCK) SOFAR)))

(DEFUN ALLOCATE (ADR BMASK LOG)
       (DO ((BS (AREF *BLOCKS* LOG) (CDR BS)))
	   ((NULL BS)
	    (COND ((= LOG *MAXCODELOG*)
		   (ERROR '|CANNOT ALLOCATE TABLE OR SPECIFIED LOCATION|
			  `((ADDRESS = ,ADR) (BMASK = ,BMASK))
			  'FAIL-ACT))
		  (T (LET ((B (ALLOCATE ADR (BOOLE 1 BMASK (- (^ 2 LOG) 1)) (+ LOG 1))))
			  (INSERT-BLOCK LOG (+ B (^ 2 LOG)))
			  (INSERT-BLOCK LOG B))
		     (ALLOCATE ADR BMASK LOG))))
	   (COND ((ZEROP (BOOLE 1 BMASK (BOOLE 6 ADR (CAR BS))))
		  (ASET *BLOCKS* LOG (DELQ (CAR BS) (AREF *BLOCKS* LOG)))
		  (RETURN (CAR BS))))))

(DEFUN FINDBLOCK (LOG)
       (LET ((Z (AREF *BLOCKS* LOG)))
	    (COND ((NOT (NULL Z))
		   (ASET *BLOCKS* LOG (CDR Z))
		   (CAR Z))
		  ((= LOG *MAXCODELOG*)
		   (ERROR '|RAN OUT OF ROOM IN CRUFT ARRAY - FINDBLOCK| LOG 'FAIL-ACT))
		  (T (LET ((B (FINDBLOCK (+ LOG 1))))
			  (INSERT-BLOCK LOG (+ B (^ 2 LOG)))
			  B)))))

(DEFUN INSERT-BLOCK (LOG BLOCK)
       (LET ((L (AREF *BLOCKS* LOG)))
	    (COND ((OR (NULL L) (< BLOCK (CAR L)))
		   (ASET *BLOCKS* LOG (CONS BLOCK L)))
		  (T (DO ((X L (CDR X)))
			 ((NULL (CDR X))
			  (RPLACD X (LIST BLOCK)))
			 (COND ((< BLOCK (CADR X))
				(RPLACD X (CONS BLOCK (CDR X)))
				(RETURN NIL))))))))

(DEFUN PASS2 (FIELDS CRUFT*ALLTAGS OFILE)
       (PRINT (LIST (EXPT 2 (CADDR (GETSTATE FIELDS 'NSTATE))) 'WORDS) OFILE)
       (PRINT `(REMARK MICROWORDS ARE ,(CAR FIELDS) (OCTAL) BITS WIDE) OFILE)
       (DO ((F (CDR FIELDS) (CDR F)))
	   ((NULL F))
	   (PRINTDEF (CAR F) (CAR FIELDS) OFILE))
       (DO ((MAXLOC (CAR (LAST (ARRAYDIMS (CAR CRUFT*ALLTAGS)))))
	    (J 0 (+ J 1))
	    (NINSTS 0)
	    (NS (GETSTATE FIELDS 'NSTATE))
	    (OS (GETSTATE FIELDS 'OSTATE))
	    (CRUFT (CAR CRUFT*ALLTAGS))
	    (ALLTAGS (CDR CRUFT*ALLTAGS)))
	   ((= J MAXLOC)
	    (PRINT `(REMARK NUMBER OF INSTRUCTIONS = ,NINSTS (OCTAL)) OFILE))
	   (LET ((INST (AREF CRUFT 2 J)))
		(COND ((NOT (NULL INST))
		       (LET ((VALUE (EVALUATE INST FIELDS J (AREF CRUFT 0 J) ALLTAGS)))
			    (LET ((NSTATE (STATE-EXTRACT NS VALUE)))
				 (PRINTINST J
					    (HAULONG (- MAXLOC 1))
					    VALUE
					    (CAR FIELDS)
					    (AREF CRUFT 1 J)
					    INST
					    NSTATE
					    (DUPLICHECK VALUE NSTATE OS CRUFT)
					    (AREF CRUFT 3 J)
					    OFILE)))
		       (SETQ NINSTS (+ NINSTS 1)))))))

(DEFUN STATE-EXTRACT (S VALUE)
       (REMAINDER (QUOTIENT VALUE (EXPT 2 (CADDDR S)))
		  (EXPT 2 (CADDR S))))

(DEFUN DUPLICHECK (VALUE NSTATE OS CRUFT)
       (LET ((MYOSTATE (STATE-EXTRACT OS VALUE)))
	    (LET ((MYBAREVALUE (DIFFERENCE VALUE (TIMES MYOSTATE (EXPT 2 (CADDDR OS))))))
		 (PROG2 NIL
			(DO ((X (AREF CRUFT 4 NSTATE) (CDR X)))
			    ((NULL X) NIL)
			    (LET ((HISOSTATE (STATE-EXTRACT OS (CAR X))))
				 (COND ((EQUAL MYBAREVALUE
					       (DIFFERENCE (CAR X)
							   (TIMES HISOSTATE
								  (EXPT 2 (CADDDR OS)))))
					(COND ((NULL (AREF CRUFT 3 MYOSTATE))
					       (RETURN (LIST '|DUPLICATES | HISOSTATE)))
					      ((NULL (AREF CRUFT 3 HISOSTATE))
					       (RETURN (LIST '|DUPLICATED BY | HISOSTATE))))))))
			(ASET CRUFT 4 NSTATE
			      (NCONC (AREF CRUFT 4 NSTATE) (LIST VALUE)))))))

(DEFUN PRINTDEF (DEF NBITS OFILE)
       (TERPRI OFILE)
       (PRINC '|(FIELD | OFILE)
       (PRINNUM (TIMES (SUB1 (EXPT 2 (CADDR DEF)))
		       (EXPT 2 (CADDDR DEF)))
		NBITS
		OFILE)
       (PRINC '| | OFILE)
       (PRIN1 DEF OFILE)
       (PRINC '|)| OFILE)
       (COND ((NOT (EQ (CADR DEF) 'BIT))
	      (DO ((I 0 (+ I 1))
		   (LSH (+ (CADDR DEF) (CADDDR DEF) -1) (- LSH 1)))
		  ((= I (CADDR DEF)))
		  (PRINTDEF (LIST (IMPLODE (APPEND (EXPLODEN (CAR DEF))
						   (LET ((BASE 10.) (*NOPOINT T))
							(EXPLODEN I))))
				  'BIT 1 LSH)
			    NBITS
			    OFILE)))))

(DEFUN PRINTINST (LOC NLOCBITS VALUE NVALBITS TAGS INST NSTATE DUPL FIXED OFILE)
       (TERPRI OFILE)
       (PRINC '|(| OFILE)
       (PRINNUM LOC NLOCBITS OFILE)
       (PRINC '| | OFILE)
       (PRINNUM VALUE NVALBITS OFILE)
       (COND ((NULL FIXED)
	      (PRINC '|   | OFILE))
	     (T (PRINC '| | OFILE)
		(PRINC FIXED OFILE)
		(PRINC '| | OFILE)))
       (COND ((NULL TAGS))
	     ((NULL (CDR TAGS)) (PRIN1 (CAR TAGS) OFILE) (PRINC '| : | OFILE))
	     (T (PRIN1 TAGS OFILE) (PRINC '|: | OFILE)))
       (DO ((J (- (+ (// (+ NLOCBITS 2) 3)
		     (// (+ NVALBITS 2) 3)
		     22)
		  (CHARPOS OFILE))
	       (- J 1)))
	   ((NOT (PLUSP J)))
	   (TYO 40 OFILE))
       (PRIN1 INST OFILE)
       (PRINC '| => | OFILE)
       (PRINNUM NSTATE NLOCBITS OFILE)
       (PRINC '|)| OFILE)
       (COND ((NOT (NULL DUPL))
	      (PRINC '|	;| OFILE)
	      (PRINC (CAR DUPL) OFILE)
	      (PRINC '| | OFILE)
	      (PRIN1 (CADR DUPL) OFILE))))

(DEFUN PRINNUM (NUM NBITS OFILE)
       (COND ((< NBITS 4)
	      (PRINC NUM OFILE))
	     (T (PRINNUM (QUOTIENT NUM 8) (- NBITS 3) OFILE)
		(PRINC (REMAINDER NUM 8) OFILE))))

(DEFUN EVALUATE (INST FIELDS OSTATE NSTATE ALLTAGS)
       (DO ((IN INST (CDR IN))
	    (FIELDS-SEEN NIL)
	    (VALUE 0))
	   ((NULL IN)
	    (AND (NULL NSTATE)
		 (ERROR '|LAST INSTRUCTION HAD NO GOTO| INST 'FAIL-ACT))
	    (LET ((OS (GETSTATE FIELDS 'OSTATE))
		  (NS (GETSTATE FIELDS 'NSTATE)))
		 (PLUS VALUE
		       (TIMES OSTATE (EXPT 2 (CADDDR OS)))
		       (TIMES NSTATE (EXPT 2 (CADDDR NS))))))
	   (COND ((ATOM (CAR IN))
		  (COND ((MEMQ (CAR IN) FIELDS-SEEN)
			 (ERROR '|DUPLICATED FIELD IN INSTRUCTION|
				(LIST (CAR IN) 'IN INST)
				'FAIL-ACT))
			(T (SETQ FIELDS-SEEN (CONS (CAR IN) FIELDS-SEEN))
			   (LET ((F (ASSQ (CAR IN) (CDR FIELDS))))
				(COND ((NULL F)
				       (ERROR '|UNDEFINED FIELD NAME|
					      (LIST (CAR IN) 'IN INST)
					      'FAIL-ACT))
				      ((EQ (CADR F) 'BIT)
				       (SETQ VALUE (PLUS (EXPT 2 (CADDDR F)) VALUE)))
				      (T (ERROR '|INVALID FIELD REFERENCE|
						(LIST (CAR IN) 'IN INST)
						'FAIL-ACT)))))))
		 ((MEMQ (CAAR IN) FIELDS-SEEN)
		  (ERROR '|DUPLICATED FIELD IN INSTRUCTION|
			 (LIST (CAR IN) 'IN INST)
			 'FAIL-ACT))
		 (T (SETQ FIELDS-SEEN (CONS (CAAR IN) FIELDS-SEEN))
		    (LET ((F (ASSQ (CAAR IN) (CDR FIELDS))))
			 (COND ((NULL F)
				(COND ((EQ (CAAR IN) 'GOTO)
				       (LET ((Z (ASSQ (CADAR IN) ALLTAGS)))
					    (COND ((NULL Z)
						   (ERROR '|UNDEFINED GOTO TAG|
							  (LIST (CAR IN) 'IN INST)
							  'FAIL-ACT))
						  (T (SETQ NSTATE (CDR Z))))))
				      (T (ERROR '|UNDEFINED FIELD NAME|
						(LIST (CAR IN) 'IN INST)
						'FAIL-ACT))))
			       ((EQ (CADR F) 'NUMBER)
				(COND ((AND (FIXP (CADAR IN))
					    (NOT (MINUSP (CADAR IN)))
					    (LESSP (CADAR IN)
						   (EXPT 2 (CADDR F))))
				       (SETQ VALUE (PLUS (TIMES (CADAR IN)
								(EXPT 2 (CADDDR F)))
							 VALUE)))
				      (T (ERROR '|INVALID NUMERIC FIELD VALUE|
						(LIST (CAR IN) 'IN INST)
						'FAIL-ACT))))
			       ((NOT (ATOM (CADR F)))
				(DO ((J 0 (+ J 1))
				     (L (CADR F) (CDR L)))
				    ((NULL L)
				     (ERROR '|INVALID SYMBOLIC FIELD VALUE|
					    (LIST (CAR IN) 'IN INST)
					    'FAIL-ACT))
				    (COND ((COND ((ATOM (CAR L))
						  (EQ (CADAR IN) (CAR L)))
						 (T (MEMQ (CADAR IN) (CAR L))))
					   (SETQ VALUE (PLUS (TIMES J (EXPT 2 (CADDDR F)))
							     VALUE))
					   (RETURN NIL)))))
			       (T (ERROR '|INVALID FIELD REFERENCE|
					 (LIST (CAR IN) 'IN INST)
					 'FAIL-ACT))))))))
