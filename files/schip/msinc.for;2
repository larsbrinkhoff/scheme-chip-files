C     PROGRAM MSINC  Version A4
C     .... A MODULAR SIMULATOR FOR INTEGRATED NONLINEAR CIRCUITS
      SUBROUTINE CONTL
C
C     .... SUBROUTINE TO CONTROL TRANSIENT CIRCUIT ANALYSIS
C
C.... GET SCALING FACTOR FOR TIME
      IEXP=-(DLOG10(TMAX)+0.0001)
      IEXP=(IEXP+6)/3
      IF  (TMAX.GE.1.) IEXP=1
      IF (IEXP.GT.5) IEXP=5
      FACTOR=1000.**(IEXP-1)
      WRITE (J6,905) SCAL(IEXP)
      WRITE (J6,910) (NAMO(I),I=1,NOUT)
C     WRITE (J6,920) ((NODO(I,J),J=1,2),I=1,NOUT)
      WRITE (J6,930)
C
C.... INITIALIZE TIME VALUES
  130 QTIME=0.
      TIMP=-DPRT
      TPRT=0.
      DELT=0.
      DELA=DPRT
      DELIM=DPRT/2**16
      NPTS=0
      ITER=0
      JTER=0
      ITRLIM=10
      DO   I=1,NVSC
		VSLP(I)=0.0
		NVVAL(I)=0
      DO   I=1,NCSC
		CSLP(I)=0.0
		CLSRC(I)=0.0
		NCVAL(I)=0
      DO   I=1,NELT
		PCUR(I)=0.0
      DO   I=1,NNOD
		VOL=V(I)
		V1(I)=VOL
		V2(I)=VOL
		VPI(I)=VOL
		VPPL(I)=VOL
C
C.... PRINT OUTPUT IF TIME IS SPECIFIED

tloop IF (QTIME.LT.TPRT) GO TO 175
      RATIO=(TPRT-TIMP)/(QTIME-TIMP)
      IF (NOUT.EQ.0) GO TO 164
      DO 160 I=1,NOUT
		IF (KOUT(I)) cout,vout,csout
C.... VOLTAGE OUTPUT
vout		N1=NODO(I,1)+1
		N2=NODO(I,2)+1
		N1=NREN(N1)
		N2=NREN(N2)
		OUT1=VPI(N1)-VPI(N2)
		OUT2=V(N1)-V(N2)
		OUPUT(I)=(OUT2-OUT1)*RATIO+OUT1
		loop
C.... CURRENT OUTPUT ACROSS ELEMENT
cout		 N=KOUT(I)
		OUT1=PCUR(N)
		OUT2=BCUR(N)
		OUPUT(I)=((OUT2-OUT1)*RATIO+OUT1)*1.0E3
		loop
C.... CURRENT OUTPUT ACROSS C-SOURCE
csout		N=-KOUT(I)
		OUT1=CLSRC(N)
		OUT2=CSRC(N)
		OUPUT(I)=((OUT2-OUT1)*RATIO+OUT1)*1.0E3
		loop

      TOUT=TPRT*FACTOR
      WRITE(J6,930) TOUT,(OUPUT(I),I=1,NOUT)
C
C.... STORE PLOT DATA
  164 IF (NPLT.EQ.0) GO TO 170
      NPTS=NPTS+1
      IF (NPTS.GT.200) GO TO 170
      DO 169 K=1,NPLT
		N=NPVAL(K)
		DO 168 I=1,N
			IF (.NOT.ICHAR) GO TO 163
			N1=NP(1,I,K)
			PLTP(I,NPTS,K)=VLSRC(N1)
			loop

		163	IF (KPLO(I,K)) 167,165,166

C.... VOLTAGE OUTPUT PLOT
		165	N1=NP(1,I,K)+1
			N2=NP(2,I,K)+1
			N1=NREN(N1)
			N2=NREN(N2)
			OUT1=VPI(N1)-VPI(N2)
			OUT2=V(N1)-V(N2)
			PLTP(I,NPTS,K)=(OUT2-OUT1)*RATIO+OUT1
			loop

C.... CURRENT OUTPUT PLOT
		166	KP=KPLO(I,K)
			OUT1=PCUR(KP)
			OUT2=BCUR(KP)
			PLTP(I,NPTS,K)=((OUT2-OUT1)*RATIO+OUT1)*1.0E3
			loop

C.... CURRENT OUT ACROSS C-SOURCE
		167	KP=-KPLO(I,K)
			OUT1=CLSRC(KP)
			OUT2=CSRC(KP)
			PLTP(I,NPTS,K)=((OUT2-OUT1)*RATIO+OUT1)*1.0E3
			loop
		loop

C
C.... ADVANCE OUTPUT TIME
  170 TPRT=TPRT+DPRT
      IF (TPRT.GT.TMAX) GO TO 550
      GO TO 140
C
C
C.... GET TIME-STEP SIZE
C
C.... ADJUSTMENT MADE DUE TO BREAKPOINTS
  175 IF (DELT.GE.DELA) GO TO 180
      DELT=DPRT
      GO TO 185
C.... CUTS DUE TO NON CONVERGENCE
  180 IF (DELT.LT.DELP) GO TO 185
C.... ADJUST TIME-STEP SIZE
      IF (ICHAR) GO TO 185
      JTER=JTER-1
      IF (JTER.GT.0) GO TO 185
      IF (ITR.GT.6) GO TO 185
      DELT=DELT+DELT
      ITRLIM=10
      IF (ITR.LE.3) DELT=DELT+DELT
      IF (DELT.GT.4*DPRT) DELT=4*DPRT
C
C.... GET NEXT TIME
  185 TIMP=QTIME
      QTIME=QTIME+DELT
      DELP=DELA
      DELA=DELT
C     ITRLIM=15
C     DO 195 I=1,NNOD
C 195 VPI(I)=V(I)
C
C.... ADJUST TIME FOR BREAKPOINTS
  200 IF (NVSC.EQ.0) GO TO 280
      DO 250 I=1,NVSC
      IF (KVOL(I).NE.1) GO TO 250
      N=NVVAL(I)
      IF (TIMP.LT.TVLT(N+1,I)) GO TO 210
      N=N+1
      NVVAL(I)=N
      VSLP(I)=(VVAL(N+1,I)-VVAL(N,I))/(TVLT(N+1,I)-TVLT(N,I))
  210 IF (QTIME.LE.TVLT(N+1,I)) GO TO 250
      QTIME=TVLT(N+1,I)
      DELT=QTIME-TIMP
  250 CONTINUE
C
  280 IF (NCSC.EQ.0) GO TO 400
      DO 330 I=1,NCSC
      IF (KCUR(I).NE.1) GO TO 330
      N=NCVAL(I)
      IF (TIMP.LT.TCUR(N+1,I)) GO TO 300
      N=N+1
      NCVAL(I)=N
      CSLP(I)=(CVAL(N+1,I)-CVAL(N,I))/(TCUR(N+1,I)-TCUR(N,I))
  300 IF (QTIME.LE.TCUR(N+1,I)) GO TO 330
      QTIME=TCUR(N+1,I)
      DELT=QTIME-TIMP
  330 CONTINUE
C
C     UPDATE VOLTAGE VECTORS
C
 400  DO 410 I=1,NNOD
      VTM2=VPI(I)
      VTM1=V(I)
      VPI(I)=VTM1
      VTM1=VTM1+(VTM1-VTM2)*DELT/DELP
      VPPL(I)=VTM2
      V2(I)=VTM1
      V1(I)=VTM1
      V(I)=VTM1
 410  CONTINUE
C
C.... CALCULATE NEW VOLTAGE VALUES
      ITR=0
      CALL TIMSOL(ITRLIM)
      IF (ICONV.EQ.1) GO TO 140
C
C.... NO CONVERGENCE, ADJUST TIME AND RETRY
      DELT=DELA
      IF (DELT.LE.DELIM) GO TO 460
      DELT=DELT/2**3
      JTER=8
      IF (DELT.GT.DELIM) GO TO 440
      DELT=DELIM
      ITRLIM=100
  440 DELA=DELT
      QTIME=TIMP+DELT
      DO 450 I=1,NNOD
      V(I)=VPI(I)
  450 VPI(I)=VPPL(I)
      GO TO 200
C
C.... NO SOLUTION
C
 460  IF (IBUG) GO TO 550
      IBUG=.TRUE.
      WRITE (J6,970)
      GO TO 440
C
550   WRITE (J6,980) ITER
      IBUG=.FALSE.
 999  RETURN
      SUBROUTINE SOLUTN
C
C     .... SOLVES EQUATIONS WITH SPECIAL MATRIX INDICATORS
C
C     ... L*U DECOMPOSITION
      MD1=MDIM-1
      IF (MD1.LE.0) GO TO 101
      KNT=0
      DO 155 I=1,MD1
      L=IORD(I)
      NUS=NUR(I)
      NUE=NUR(I+1)
      NL=NLC(I)
      NLE=NLC(I+1)
135   IF (NL-NLE) 140,155,155
140   TEM=YL(NL)/YD(L)
      YL(NL)=TEM
      NL=NL+1
      NU=NUS
145   IF (NU-NUE) 150,135,135
150   KNT=KNT+1
      K=IPOS(KNT)
      Y(K)=Y(K)-Y(NU)*TEM
      NU=NU+1
      GO TO 145
155   CONTINUE
C
C     SOLVE
C
      ENTRY SOLV
C     PROCESS VOLTAGE SOURCES
101   IF (NVSC.EQ.0) GO TO 120
      DO 115 I=1,NVSC
      IF (VSRC(I).EQ.0.0) GO TO 115
      NL=NVV(I)
      NLE=NVV(I+1)
105   IF (NL.GE.NLE) GO TO 115
110   IR=IV(NL)
      V(IR)=V(IR)-YV(NL)*VSRC(I)
      NL=NL+1
      GO TO 105
115   CONTINUE
      DO 117 I=1,NVSC
      VCUR(I)=V(MDIM+I)
117   V(MDIM+I)=VSRC(I)
C
120   V(NNOD)=0.
      YD(200)=0.
      MD1=MDIM-1
      IF (MD1) 190,125,130
125   V(1)=V(1)/YD(1)
      RETURN
C
C     ... FORWARD SUBSTITUTION
130   DO 170 I=1,MD1
      L=IORD(I)
      IF (V(L).EQ.0.0) GO TO 170
      NL=NLC(I)
      NLE=NLC(I+1)
160   IF (NL-NLE) 165,170,170
165   IR=ILR(NL)
      V(IR)=V(IR)-YL(NL)*V(L)
      NL=NL+1
      GO TO 160
170   CONTINUE
C
C     ... BACK SUBSTITUTION
      L=IORD(MDIM)
      V(L)=V(L)/YD(L)
      DO 185 I=1,MD1
      J=MDIM-I
      L=IORD(J)
      NU=NUR(J)
      NUE=NUR(J+1)
175   IF (NU-NUE) 180,185,185
180   IC=IUC(NU)
      V(L)=V(L)-Y(NU)*V(IC)
      NU=NU+1
      GO TO 175
185   V(L)=V(L)/YD(L)
C
  190 RETURN
C
C     ... CALCULATE CURRENTS THROUGH VOLTAGE SOURCES
C
      ENTRY CCAL
      IF (NVSC.EQ.0) GO TO 290
      DO 280 I=1,NVSC
      TEM=VCUR(I)
      N=NVV(I)
      NE=NVV(I+1)
210   IF (N-NE) 220,230,230
220   IC=IV(N)
      TEM=TEM-YC(N)*V(IC)
      N=N+1
      GO TO 210
230   VCUR(I)=TEM-YD(MDIM+I)*VSRC(I)
280   CONTINUE
290   RETURN
      END
      SUBROUTINE TIMSOL (ITRLIM)
C
C     .... SUBROUTINE TO CALCULATE VOLTAGES AT A GIVEN TIME
C
C     ... ASSIGN SOURCE VALUES FOR NEW TIME
      IF (NVSC.EQ.0) GO TO 370
      DO 360 I=1,NVSC
      IF (KVOL(I)-1) 360,350,345
 345  VSRC(I)=VVAL(1,I)*DSIN(VVAL(2,I)*QTIME+VVAL(3,I))+VVAL(4,I)
      GO TO 360
 350  N=NVVAL(I)
      IF (VSLP(I).EQ.0.0) GO TO 355
      VSRC(I)=VVAL(N,I)+VSLP(I)*(QTIME-TVLT(N,I))
      GO TO 360
 355  VSRC(I)=VVAL(N,I)
 360  CONTINUE
C
 370  IF (NCSC.EQ.0) GO TO 400
      DO 390 I=1,NCSC
      IF (KCUR(I)-1) 390,380,375
 375  CSRC(I)=CVAL(1,I)*DSIN(CVAL(2,I)*QTIME+CVAL(3,I))
      GO TO 390
 380  N=NCVAL(I)
      IF (CSLP(I).EQ.0.0) GO TO 385
      CSRC(I)=CVAL(N,I)+CSLP(I)*(QTIME-TCUR(N,I))
      GO TO 390
 385  CSRC(I)=CVAL(N,I)
 390  CONTINUE
C
C     ... CLEAR Y-MATRIX AND C-VECTOR
400   DO 105 I=1,NUT
105   Y(I)=0.0
      DO 110 I=1,NLT
110   YL(I)=0.0
      DO 115 I=1,NVT
115   YV(I)=0.0
      DO 120 I=1,NNOD
120   YD(I)=0.0
      DO 124 I=1,NNOD
      VV=V(I)
      VV1=V1(I)
      VV2=V2(I)
      DVV=VV-VV1
      AVV=DABS(DVV)
      IF (AVV.LT.TOLER) GO TO 122
      ICONV=0
      IF (AVV.LT.5D-1) GO TO 122
      VV=VV1+5D-1
      IF (DVV.LT.0D0) VV=VV1-5D-1
 122  IF (DABS(VV-VV2).LT.5D-7) VV=(VV+VV1)/2D0
      V2(I)=VV1
      V1(I)=VV
      V(I)=0D0
 124  CONTINUE
C
C     .... ADD R,C,L ELEMENT CONTRIBUTION
      IF (NELT.EQ.0) GO TO 155
      DO 150 N=1,NELT
      N1=ND(N,1)
      N2=ND(N,2)
      N3=ND(N,3)
      N4=ND(N,4)
      DELVP=VPI(N1)-VPI(N2)
      IF (KIND(N)-2) 125,130,135
C     .... RESISTOR
125   G=VALU(N)
      GO TO 145
C     ... CAPACITOR
C     ... TRAPEZOIDAL INTEGRATION
 130  G=VALU(N)/DELT
      CT=G*DELVP+BCUR(N)
C     ... BACKWARD EULER INTEGRATION
C130  G=VALU(N)/(2*DELT)
C     CT=G*DELVP
      GO TO 140
C     ... INDUCTOR
135   G=VALU(N)*DELT
      CT=-G*DELVP-BCUR(N)
140   V(N1)=V(N1)+CT
      V(N2)=V(N2)-CT
145   YD(N1)=YD(N1)+G
      YD(N2)=YD(N2)+G
      Y(N3)=Y(N3)-G
      Y(N4)=Y(N4)-G
150   CONTINUE
C
C     ... ADD TRANSISTORS
155   ICONV=1
      CALL CKTMOD(1)
      CALL DIMOD(1)
C
C     ... ADD CURRENT SOURCES
      IF (NCSC.EQ.0) GO TO 159
      DO 157 I=1,NCSC
      N1=NCS(I,1)
      N2=NCS(I,2)
      V(N1)=V(N1)-CSRC(I)
  157 V(N2)=V(N2)+CSRC(I)
  159 CONTINUE
C
C     .... SOLVE EQUATIONS FOR NEW VOLTAGES
      ITR=ITR+1
      ITER=ITER+1
      CALL SOLUTN
C
C     .... CHECK FOR CONVERGENCE OF NON-LINEAR MODELS
      IF (ITR.LE.1) GO TO 470
      IF (ICONV.EQ.0) GO TO 470
      DO 165 I=1,MDIM
      IF (DABS(V(I)-V1(I)).GT.TOLER) GO TO 470
  165 CONTINUE
C
C     ... CALCULATE BRANCH CURRENTS
      IF (NELT.EQ.0) GO TO 220
      DO 210 N=1,NELT
      N1=ND(N,1)
      N2=ND(N,2)
      DELV=V(N1)-V(N2)
      DELVP=VPI(N1)-VPI(N2)
      IF (KIND(N)-2) 180,190,200
C.... RESISTOR
180   PCUR(N)=BCUR(N)
      BCUR(N)=DELV*VALU(N)
      GO TO 210
C     ... CAPACITOR
 190  G=VALU(N)/DELT
      PCUR(N)=BCUR(N)
      BCUR(N)=G*(DELV-DELVP)-BCUR(N)
      GO TO 210
C     ... INDUCTOR
 200  G=VALU(N)*DELT
      PCUR(N)=BCUR(N)
      BCUR(N)=G*(DELV+DELVP)+BCUR(N)
210   CONTINUE
C     ... GET CURRENT SOURCE CURRENT
220   IF (NCSC.EQ.0) GO TO 465
      DO 230 I=1,NCSC
      CLSRC(I)=CSRC(I)
230   CONTINUE
C     ... GET VOLTAGE SOURCE VALUES
465   RETURN
C
470   ICONV=0
      IF ( ITR-ITRLIM) 400,500,500
500   RETURN
      END
