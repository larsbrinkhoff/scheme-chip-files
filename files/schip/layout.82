;;; -*-LISP-*-

(declare (mapex t) (macros t))
(declare (setq base 10. ibase 10. *nopoint t))
(setq base 10. ibase 10. *nopoint t terpri t)

(declare (special *cifofile* *cifnumber* *indefine* *mllp* *parc*))

(setq *cifofile* nil)
(setq *cifnumber* 195.)
(setq *indefine* nil)
(setq *mllp* nil)
(setq *parc* t)						;for PARC instead of SPEECH

(declare (special *squaresize*))

(declare (special *centimicrons-per-lambda* *implant-margin*))

;;; (call <cellname> . <frobs>)
;;; <frobs> are:  (trans <x> <y>)  (mirror x)  (mirror y)  (rotate <x> <y>)

(defun call fexpr (x)
       (cond (*cifofile*
	      (or (numberp (car x))
		  (get (car x) 'cifnumber)
		  (error '|Undefined Symbol Name| (car x) 'fail-act))
	      (cond ((not *mllp*)
		     (terpri *cifofile*)
;;;		     (and *indefine* (princ '|   | *cifofile*))
		     (princ '|C| *cifofile*)
		     (and *parc* (princ '| | *cifofile*))
		     (prin1 (cond ((numberp (car x)) (car x))
				  (t (get (car x) 'cifnumber)))
			    *cifofile*)
		     (map (function
			   (lambda (v)
				   (let ((frob (car v)))
					(caseq (car frob)
					       ((trans)
						(princ '| T| *cifofile*)
						(and *parc* (princ '| | *cifofile*))
						(prin1 (* (eval (cadr frob))
							  *centimicrons-per-lambda*)
						       *cifofile*)
						(princ '|,| *cifofile*)
						(prin1 (* (eval (caddr frob))
							  *centimicrons-per-lambda*)
						       *cifofile*))
					       ((mirror)
						(princ '| M| *cifofile*)
						(and *parc* (princ '| | *cifofile*))
						(princ (cadr frob) *cifofile*))
					       ((rotate)
						(princ '| R| *cifofile*)
						(and *parc* (princ '| | *cifofile*))
						(prin1 (eval (cadr frob)) *cifofile*)
						(princ '|,| *cifofile*)
						(prin1 (eval (caddr frob)) *cifofile*))
					       (t (error '|Invalid frob - CALL| frob 'fail-act)))
					(COMMENT
					 (or (null (cdr v))
					     (princ '|, then| *cifofile*))))))
			  (cdr x))
		     (princ '|;| *cifofile*)
		     (COMMENT
		      (cond ((not (numberp (car x)))
			     (cond ((> (+ (charpos *cifofile*) (flatc (car x))) 80.)
				    (terpri *cifofile*)
				    (princ '|               | *cifofile*)))
			     (princ '| (| *cifofile*)
			     (prin1 (car x) *cifofile*)
			     (princ '|);| *cifofile*)))))
		    (t
		     (terpri *cifofile*)
		     (princ '|call | *cifofile*)
		     (prin1 (cond ((numberp (car x)) (car x))
				  (t (get (car x) 'cifnumber)))
			    *cifofile*)
		     (map (function
			   (lambda (v)
				   (let ((frob (car v)))
					(caseq (car frob)
					       ((trans)
						(princ '| t | *cifofile*)
						(prin1 (eval (cadr frob))
						       *cifofile*)
						(princ '| | *cifofile*)
						(prin1 (eval (caddr frob))
						       *cifofile*))
					       ((mirror)
						(princ '| m| *cifofile*)
						(princ (cadr frob) *cifofile*))
					       ((rotate)
						(princ '| r | *cifofile*)
						(prin1 (eval (cadr frob)) *cifofile*)
						(princ '| | *cifofile*)
						(prin1 (eval (caddr frob)) *cifofile*))
					       (t (error '|Invalid frob - CALL| frob 'fail-act))))))
			  (cdr x))))))
       (cons 'call x))

(defun define fexpr (x)					;(define <name> . <body>)
       (and (get (car x) 'cifnumber)
	    (error '|Multiply Defined Symbol| (car x) 'fail-act))
       (and (< *cifnumber* 40.) (error '|Too Many Symbols| '? 'fail-act))
       (putprop (car x) (setq *cifnumber* (- *cifnumber* 1)) 'cifnumber)
       (cond (*cifofile*
	      (cond ((not *mllp*)
		     (terpri *cifofile*)
		     (princ '|Define Symbol | *cifofile*)
		     (prin1 (get (car x) 'cifnumber) *cifofile*)
		     (princ '|;  (| *cifofile*)
		     (prin1 (car x) *cifofile*)
		     (princ '|);| *cifofile*)
		     (let ((*indefine* t)) (mapc (function eval) (cdr x)))
		     (terpri *cifofile*)
		     (princ '|DF; (for cell | *cifofile*)
		     (prin1 (get (car x) 'cifnumber) *cifofile*)
		     (princ '| = | *cifofile*)
		     (prin1 (car x) *cifofile*)
		     (princ '|);| *cifofile*)
		     (terpri *cifofile*))
		    (t
		     (terpri *cifofile*)
		     (princ '|symbol | *cifofile*)
		     (prin1 (get (car x) 'cifnumber) *cifofile*)
		     (let ((*indefine* t)) (mapc (function eval) (cdr x)))
		     (terpri *cifofile*)
		     (princ '|endsymbol| *cifofile*)))))
       (cons 'define x))

(defun layout fexpr (x)				;(layout <name> (<x> <y>) <foo> . <body>)
       (putprop (car x) (cdr x) 'layout)
       (and (status feature its)
            (character-layout x)))

(defun character-layout (x)
       (let ((a (*array nil t (caadr x) (cadadr x))))
	    (putprop (car x) a 'layout-array)
	    (mapc (function
		   (lambda (spec)
			   (mapc (function
				  (lambda (rect)
					  (cond ((memq (car spec)
						       '(poly diff metal implant))
						 (fillrect a rect (car spec)))
						((eq (car spec) 'cuts)
						 (fillcut a rect))
						(t (error '|Unknown Layer Type|
							  (car spec)
							  'fail-act)))))
				 (cdr spec))))
		  (cdddr x))
	    (car x)))

(defun fillcut (a rect)
       (fillrect a
		 (cond ((eq (caddr rect) 'S)
			(list (- (car rect) 1) (+ (car rect) 1)
			      (- (cadr rect) 1) (+ (cadr rect) 1)))
		       ((eq (caddr rect) 'H)
			(list (- (car rect) 2) (+ (car rect) 2)
			      (- (cadr rect) 1) (+ (cadr rect) 1)))
		       ((eq (caddr rect) 'V)
			(list (- (car rect) 1) (+ (car rect) 1)
			      (- (cadr rect) 2) (+ (cadr rect) 2)))
		       (t (error '|Unknown Cut Shape| (caddr rect))))
		 'cuts))

(defun fillrect (a rect type)
       (do ((j (car rect) (+ j 1))
	    (jlim (cadr rect))
	    (klim (cadddr rect)))
	   ((= j jlim))
	   (do ((k (caddr rect) (+ k 1)))
	       ((= k klim))
	       (store (arraycall t a j k)
		      (cons type (arraycall t a j k))))))

(defun show fexpr (x)
       (cursorpos 'C)
       (cond ((status feature its) (character-show x))
             (t (stipple-show x))))

(defun character-show (x)
       (let ((a (get (car x) 'layout-array)))
	    (do ((k 0 (+ k 1))
		 (jlim (cadr (arraydims a)))
		 (klim (caddr (arraydims a))))
		((= k klim))
                (and (status feature its) (terpri))
		(do ((j 0 (+ j 1)))
		    ((= j jlim))
		    (showsquare (arraycall t a j k))))))

(defun showsquare (stuff)
       (cond ((null stuff) (tyo 32.))
             (t (map (function (lambda (z) (tyo (get (car z) 'layerchar))
                                       (and (cdr z) (cursorpos 'B))))
                     stuff))))

(defun stipple-show (x)
       (let ((display-x-offset (* *squaresize* (or (cadr x) 0)))
             (display-y-offset (* *squaresize* (or (caddr x) 0))))
       (mapc (function
              (lambda (spec)
                      (mapc (function
                             (lambda (rect)
                                     (cond ((memq (car spec) (cdddr x)))
                                           ((memq (car spec) '(poly diff metal glasscut implant))
                                            (stipple-rect rect
                                                          (car spec)
                                                          display-x-offset
                                                          display-y-offset))
                                           ((eq (car spec) 'cuts)
                                            (stipple-cut rect
                                                         display-x-offset
                                                         display-y-offset))
                                           (t (error '|Unknown Layer Type|
                                                     (car spec)
                                                     'fail-act)))))
                            (cdr spec))))
             (cddr (get (car x) 'layout))))
       (car x))

(setq *squaresize* 14)

(defun stipple-cut (rect display-x-offset display-y-offset)
       (stipple-rect (cond ((eq (caddr rect) 'S)
                            (list (- (car rect) 1) (+ (car rect) 1)
                                  (- (cadr rect) 1) (+ (cadr rect) 1)))
                           ((eq (caddr rect) 'H)
                            (list (- (car rect) 2) (+ (car rect) 2)
                                  (- (cadr rect) 1) (+ (cadr rect) 1)))
                           ((eq (caddr rect) 'V)
                            (list (- (car rect) 1) (+ (car rect) 1)
                                  (- (cadr rect) 2) (+ (cadr rect) 2)))
                           (t (error '|Unknown Cut Shape| (caddr rect))))
                     'cuts
                     display-x-offset
                     display-y-offset))

(defun stipple-rect (rect type display-x-offset display-y-offset)
       (stipple
        (+ (* *squaresize* (car rect))
           (cond ((eq type 'implant) (// (* -3 *squaresize*) 2)) (t 0))
           (+ 50 display-x-offset))
        (+ (* *squaresize* (caddr rect))
           (cond ((eq type 'implant) (// (* -3 *squaresize*) 2)) (t 0))
           (+ 100 display-y-offset))
        (+ (* *squaresize* (cadr rect))
           (cond ((eq type 'implant) (// (* 3 *squaresize*) 2)) (t 0))
           (+ 50 display-x-offset))
        (+ (* *squaresize* (cadddr rect))
           (cond ((eq type 'implant) (// (* 3 *squaresize*) 2)) (t 0))
           (+ 100 display-y-offset))
        (get type 'stipple)))
						       
(cond ((status nofeature its)
       (putprop 'poly poly 'stipple)
       (putprop 'diff diffusion 'stipple)
       (putprop 'metal metal 'stipple)
       (putprop 'cuts contact 'stipple)
       (putprop 'implant s2 'stipple)))

(putprop 'poly (getcharn '/| 1) 'layerchar)
(putprop 'diff (getcharn '/: 1) 'layerchar)
(putprop 'metal (getcharn '/= 1) 'layerchar)
(putprop 'cuts (getcharn '/ 1) 'layerchar)
(putprop 'implant (getcharn '/_ 1) 'layerchar)

(and (status feature its)
     (let ((z (status tty)))
	  (sstatus tty (car z) (cadr z) (boole 7 (* 4 (^ 2 27.)) (caddr z)))))	;sail chars

(defun cif fexpr (x)					;(cif <cell> . <output filename>)
       (let ((name (car x))
	     (filename (cdr x)))
	    (let ((file (open (defaultf (mergef '(_cif_ output) filename))
			      '(ascii out)))
		  (specs (get name 'layout)))
		 (cifcell name specs file)
		 (renamef file (defaultf (mergef filename '((* *) * cif))))
		 (close file)
		 (namestring (truename file)))))

(defun cifile fexpr (x)					;(cifile . <input filename>)
       (let ((filename (defaultf (mergef x '((* *) * >)))))
	    (let ((ifile (open filename '(ascii in))))
		 (let ((ofile (open (mergef '(_cif_ output) ifile) '(ascii out)))
		       (*mllp* nil))
		      (ciftransduce ifile ofile (list nil))
		      (terpri ofile)
		      (princ '|E| ofile)
		      (terpri ofile)
		      (renamef ofile (mergef '((* *) * cif) filename))
		      (close ofile)
		      (namestring (truename ofile))))))

(defun mllfile fexpr (x)				;(mllfile . <input filename>)
       (let ((filename (defaultf (mergef x '((* *) * >)))))
	    (let ((ifile (open filename '(ascii in))))
		 (let ((ofile (open (mergef '(_mllf_ output) ifile) '(ascii out)))
		       (*mllp* t))
		      (ciftransduce ifile ofile (list nil))
		      (terpri ofile)
		      (renamef ofile (mergef '((* *) * mll) filename))
		      (close ofile)
		      (namestring (truename ofile))))))

(defun ciftransduce (ifile ofile eof)
       (cond ((not *mllp*)
	      (terpri ofile)
	      (princ '|(Beginning of file | ofile)
	      (princ (namestring (truename ifile)) ofile)
	      (princ '|);| ofile)
	      (terpri ofile)))
       (do ((z (read ifile eof) (read ifile eof)))
	   ((eq z eof))
	   (cond ((atom z))
		 ((eq (car z) 'layout)
		  (and (< *cifnumber* 40.) (error '|Too Many Symbols| '? 'fail-act))
		  (putprop (cadr z)
			   (setq *cifnumber* (- *cifnumber* 1))
			   'cifnumber)
		  (cifcell (cadr z) (cddr z) ofile))
		 ((and (eq (car z) 'comment) (not *mllp*))
		  (terpri ofile)
		  (prin1 (cdr z) ofile)
		  (princ '|;| ofile)
		  (terpri ofile))
		 ((eq (car z) 'include)
		  (ciftransduce (open (mergef (cadr z) ifile) '(ascii in)) ofile eof))
		 (t (let ((*cifofile* ofile)) (eval z)))))
       (cond ((not *mllp*)
	      (terpri ofile)
	      (princ '|(End of file | ofile)
	      (princ (namestring (truename ifile)) ofile)
	      (princ '|);| ofile)
	      (terpri ofile))))

(defun cifcell (name specs file)
       (cond ((not *mllp*)
	      (terpri file)
	      (princ '|Define Symbol | file)
	      (prin1 (get name 'cifnumber) file)
	      (princ '|;   (| file)
	      (prin1 name file)
	      (princ '|);| file)
	      (COMMENT
	       (terpri file)
	       (princ '|(X size=| file)
	       (prin1 (caar specs) file)
	       (princ '| lambda, Y size=| file)
	       (prin1 (cadar specs) file)
	       (princ '| lambda);| file)))
	     (t (terpri file)
		(princ '|symbol | file)
		(prin1 (get name 'cifnumber) file)))
       (mapc (function
	      (lambda (spec)
		      (ciflayer file (car spec))
		      (mapc (function
			     (lambda (rect)
				     (cond ((memq (car spec)
						  '(poly diff metal glasscut implant))
					    (cifrect file rect (car spec)))
					   ((eq (car spec) 'cuts)
					    (cifcut file rect))
					   (t (error '|Unknown Layer Type|
						     (car spec)
						     'fail-act)))))
			    (cdr spec))))
	     (cddr specs))
       (cond ((not *mllp*)
	      (terpri file)
	      (princ '|DF;   (end of | file)
	      (prin1 name file)
	      (princ '|);| file)
	      (terpri file))
	     (t (terpri file)
		(princ '|endsymbol| file))))

(defun cifcut (file rect)
       (cifrect file
		(cond ((eq (caddr rect) 'S)
		       (list (- (car rect) 1) (+ (car rect) 1)
			     (- (cadr rect) 1) (+ (cadr rect) 1)))
		      ((eq (caddr rect) 'H)
		       (list (- (car rect) 2) (+ (car rect) 2)
			     (- (cadr rect) 1) (+ (cadr rect) 1)))
		      ((eq (caddr rect) 'V)
		       (list (- (car rect) 1) (+ (car rect) 1)
			     (- (cadr rect) 2) (+ (cadr rect) 2)))
		      (t (error '|Unknown Cut Shape| (caddr rect))))
		'cuts))

(setq *centimicrons-per-lambda* 300.)

(setq *implant-margin* (* *centimicrons-per-lambda* 3))

(defun ciflayer (file type)
       (or (get type 'cifname)
	   (error '|Bad layer type| type 'fail-act))
       (terpri file)
       (princ '|L| file)
       (and *parc* (princ '| | file))
       (princ (get type 'cifname) file)
       (princ '|;| file))

(defun cifrect (file rect type)
       (cond ((not *mllp*)
	      (let ((length (- (cadr rect) (car rect)))
		    (width (- (cadddr rect) (caddr rect))))
		   (terpri file)
		   (princ '|B| file)
		   (and *parc* (princ '| | file))
		   (prin1 (+ (* *centimicrons-per-lambda* length)
			     (cond ((not (eq type 'implant)) 0)
				   (t *implant-margin*)))
			  file)
		   (princ '| | file)
		   (prin1 (+ (* *centimicrons-per-lambda* width)
			     (cond ((not (eq type 'implant)) 0)
				   (t *implant-margin*)))
			  file)
		   (princ '| | file)
		   (princ (+ (* *centimicrons-per-lambda* (car rect))
			     (// (* *centimicrons-per-lambda* length) 2))
			  file)
		   (princ '|,| file)
		   (princ (- (+ (* *centimicrons-per-lambda* (caddr rect))
				(// (* *centimicrons-per-lambda* width) 2)))
			  file)
		   (princ '|;| file)))
	     (t (terpri file)
		(princ (get type 'mllname) file)
		(princ '| | file)
		(prin1 (cond ((eq type 'implant)
			      (difference (+ (car rect)) 1.5))
			     (t (car rect))) file)
		(princ '| | file)
		(prin1 (cond ((eq type 'implant)
			      (plus (+ (cadr rect)) 1.5))
			     (t (cadr rect))) file)
		(princ '| | file)
		(prin1 (cond ((eq type 'implant)
			      (difference (- (cadddr rect)) 1.5))
			     (t (- (cadddr rect)))) file)
		(princ '| | file)
		(prin1 (cond ((eq type 'implant)
			      (plus (- (caddr rect)) 1.5))
			     (t (- (caddr rect)))) file))))

(defprop poly |NP| cifname)
(defprop diff |ND| cifname)
(defprop metal |NM| cifname)
(defprop cuts |NC| cifname)
(defprop implant |NI| cifname)
(defprop glasscut |NG| cifname)
(defprop poly |red| mllname)
(defprop diff |green| mllname)
(defprop metal |blue| mllname)
(defprop cuts |black| mllname)
(defprop implant |yellow| mllname)
(defprop glasscut |orange| mllname)

(defun ucode fexpr (x)				;(ucode name (<n> words) ...)
       (do ((z (cddr x) (cdr z))
	    (maxindex 0)
	    (ibase 8)
	    (a (set (car x) (*array nil t (caadr x)))))
	   ((null z)
	    (putprop (car x) maxindex 'maxindex))
	   (cond ((atom (car z)))
		 ((eq (caar z) 'field)
		  (cond ((eq (cadr (caddr (car z))) 'bit)
			 (putprop (caaddr (car z))
				  (cadar z)
				  (car x)))))
		 ((numberp (caar z))
		  (setq maxindex (max maxindex (caar z)))
		  (store (arraycall t a (caar z)) (cadar z)))))
       (car x))