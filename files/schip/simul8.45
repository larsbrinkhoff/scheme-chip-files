;;; -*-LISP-*-

(DECLARE (SPECIALS T) (MAPEX T) (MACROS T) (ALLOC '(LIST 200000)))

(DEFUN UNIQUEPROP (A V N)
       (LET ((Z (GETL A (LIST N))))
	    (AND Z
		 (NOT (EQ (CADR Z) V))
		 (ERROR '|PROPERTY DEFINITION CONFLICT| `(UNIQUEPROP ,A ,V ,N))))
       (PUTPROP A V N))

(DEFUN SIGNALS MACRO (X)
       `(PROGN (SETQ ,(CADR X) ',(CDDR X))
	       ,@(MAPCAR (FUNCTION (LAMBDA (Z) `(UNIQUEPROP ',Z ',(CADR X) 'SIGNAL)))
			 (CDDR X))))

(SIGNALS PHI1
	 VT0 VT1 VT2 VA0 VA1 VA2 VA3 VA4 VA5 VA6 VA7 VA8 VA9	;V REGISTER
	 XT0 XT1 XT2 XA0 XA1 XA2 XA3 XA4 XA5 XA6 XA7 XA8 XA9	;X REGISTER
	 X+T0 X+T1 X+T2 X+A0 X+A1 X+A2 X+A3 X+A4 X+A5 X+A6 X+A7 X+A8 X+A9	;INCREMENTED X
	 XCO0 XCO1 XCO2 XCO3 XCO4 XCO5 XCO6 XCO7 XCO8 XCO9	;X REGISTER CARRIES OUT
	 NT0 NT1 NT2 NA0 NA1 NA2 NA3 NA4 NA5 NA6 NA7 NA8 NA9	;N REGISTER
	 LT0 LT1 LT2 LA0 LA1 LA2 LA3 LA4 LA5 LA6 LA7 LA8 LA9	;L REGISTER
	 CT0 CT1 CT2 CA0 CA1 CA2 CA3 CA4 CA5 CA6 CA7 CA8 CA9	;C REGISTER
	 PT0 PT1 PT2 PA0 PA1 PA2 PA3 PA4 PA5 PA6 PA7 PA8 PA9	;P REGISTER
	 P+T0 P+T1 P+T2 P+A0 P+A1 P+A2 P+A3 P+A4 P+A5 P+A6 P+A7 P+A8 P+A9	;INCREMENTED P
	 PCO0 PCO1 PCO2 PCO3 PCO4 PCO5 PCO6 PCO7 PCO8 PCO9	;P REGISTER CARRIES OUT
	 QT0 QT1 QT2 QA0 QA1 QA2 QA3 QA4 QA5 QA6 QA7 QA8 QA9	;Q REGISTER
	 RT0 RT1 RT2 RA0 RA1 RA2 RA3 RA4 RA5 RA6 RA7 RA8 RA9	;R REGISTER
	 ST0 ST1 ST2 SA0 SA1 SA2 SA3 SA4 SA5 SA6 SA7 SA8 SA9	;S REGISTER
	 ET0 ET1 ET2 EA0 EA1 EA2 EA3 EA4 EA5 EA6 EA7 EA8 EA9	;E BUS
	 GT0 GT1 GT2 GA0 GA1 GA2 GA3 GA4 GA5 GA6 GA7 GA8 GA9	;G BUS
	 PHI1*LDV PHI1*RDV PHI1*LDX PHI1*RDX PHI1*RDX+		;EVAL REG CONTROLS
	 PHI1*LDN PHI1*RDN PHI1*LDL PHI1*RDL PHI1*LDC PHI1*RDC
	 PHI1*EA-LIT PHI1*ET-LIT				;EVAL LIT CONTROLS
	 PHI1*CONN-I PHI1*CONN-EA PHI1*CONN-ET			;GC BUS CONN CONTROLS
	 PHI1*LDP PHI1*RDP PHI1*RDP+ PHI1*LDQ PHI1*RDQ		;GC REG CONTROLS
	 PHI1*LDR PHI1*RDR PHI1*LDS
	 EA-ZERO ET-ZERO EQV GA-ZERO				;RANDOM SIGNALS
	 ESTATE0 ESTATE1 ESTATE2 ESTATE3 ESTATE4 ESTATE5	;EVAL STATE
	 GSTATE0 GSTATE1 GSTATE2 GSTATE3 GSTATE4 GSTATE5	;GC STATE
)

(SIGNALS PHI2
	 VT0$ VT1$ VT2$ VA0$ VA1$ VA2$ VA3$ VA4$ VA5$ VA6$ VA7$ VA8$ VA9$	;V REGISTER
	 XT0$ XT1$ XT2$ XA0$ XA1$ XA2$ XA3$ XA4$ XA5$ XA6$ XA7$ XA8$ XA9$	;X REGISTER
	 NT0$ NT1$ NT2$ NA0$ NA1$ NA2$ NA3$ NA4$ NA5$ NA6$ NA7$ NA8$ NA9$	;N REGISTER
	 LT0$ LT1$ LT2$ LA0$ LA1$ LA2$ LA3$ LA4$ LA5$ LA6$ LA7$ LA8$ LA9$	;L REGISTER
	 CT0$ CT1$ CT2$ CA0$ CA1$ CA2$ CA3$ CA4$ CA5$ CA6$ CA7$ CA8$ CA9$	;C REGISTER
	 PT0$ PT1$ PT2$ PA0$ PA1$ PA2$ PA3$ PA4$ PA5$ PA6$ PA7$ PA8$ PA9$	;P REGISTER
	 QT0$ QT1$ QT2$ QA0$ QA1$ QA2$ QA3$ QA4$ QA5$ QA6$ QA7$ QA8$ QA9$	;Q REGISTER
	 RT0$ RT1$ RT2$ RA0$ RA1$ RA2$ RA3$ RA4$ RA5$ RA6$ RA7$ RA8$ RA9$	;R REGISTER
	 ST0$ ST1$ ST2$ SA0$ SA1$ SA2$ SA3$ SA4$ SA5$ SA6$ SA7$ SA8$ SA9$	;S REGISTER
	 ENSTATE0 ENSTATE1 ENSTATE2 ENSTATE3 ENSTATE4 ENSTATE5	;EVAL NSTATE
	 EOSTATE0 EOSTATE1 EOSTATE2 EOSTATE3 EOSTATE4 EOSTATE5	;EVAL OSTATE
	 LDV LDX LDN LDL LDC RDV RDX RDX+ RDN RDL RDC		;EVAL PLA SIGNALS
	 ET-DISP EAZ-ETZ-EQV-DISP EA-LIT ET-LIT
	 LIT0 LIT1 LIT2 GCOP0 GCOP1 GCOP2 GCOP3
	 GNSTATE0 GNSTATE1 GNSTATE2 GNSTATE3 GNSTATE4 GNSTATE5	;GC NSTATE
	 GOSTATE0 GOSTATE1 GOSTATE2 GOSTATE3 GOSTATE4 GOSTATE5	;GC OSTATE
	 STEP-EVAL CONN-EA CONN-ET CONN-I			;GC PLA SIGNALS
	 LDP LDQ LDR LDS RDP RDP+ RDQ RDR
	 ADR WRITE GCOP-DISP GA-ZERO-DISP
	 PROBE0 PROBE1 PROBE2 PROBE3 PROBE4 PROBE5 PROBE6	;PROBE LINES
	 PROBE7 PROBE8 PROBE9 PROBE10 PROBE11 PROBE12
)

(SIGNALS EXTERNAL
	 IT0 IT1 IT2 IA0 IA1 IA2 IA3 IA4 IA5 IA6 IA7 IA8 IA9	;I BUS
	 PC0 PC1 PC2						;EXTERNAL PROBE CONTROLS
	 PCA PCB PCC PCD PCE -PROBE				;INTERNAL PROBE CONTROLS
	 STUFF FREEZE						;STATE CONTROL
)

(DEFUN RESET ()
       (MAPC (FUNCTION (LAMBDA (V) (SET V 'UNDEF))) PHI1)
       (MAPC (FUNCTION (LAMBDA (V) (SET V 'UNDEF))) PHI2)
       (MAPC (FUNCTION (LAMBDA (V) (SET V NIL))) EXTERNAL)
       (SETQ ONE-SHOT-STUFF T))

(SETQ USER-WANTS-IN NIL)
(SETQ ONE-SHOT-STUFF NIL)
(SETQ ONE-SHOT-RUN NIL)

(DEFUN ^A-INTERRUPT (F C) (SETQ USER-WANTS-IN T)) (SSTATUS TTYINT 1 (FUNCTION ^A-INTERRUPT))
(DEFUN ^N-INTERRUPT (F C) (SETQ ONE-SHOT-RUN T)) (SSTATUS TTYINT 16 (FUNCTION ^N-INTERRUPT))
(DEFUN ^O-INTERRUPT (F C) (SETQ ONE-SHOT-STUFF T)) (SSTATUS TTYINT 17 (FUNCTION ^O-INTERRUPT))

;;; BOTH ARGS GET DUPLICATED

(DEFUN SXOR MACRO (X)
       `(COND ((OR (EQ ,(CADR X) 'UNDEF) (EQ ,(CADDR X) 'UNDEF)) 'UNDEF)
		   ((NOT ,(CADR X)) ,(CADDR X))
		   (T (NOT ,(CADDR X)))))

;;; FIRST ARG SHOULD BE A VARIABLE ONLY -- GETS DUPLICATED

(DEFUN SAND MACRO (X)
       `(COND ((EQ ,(CADR X) 'UNDEF) 'UNDEF)
	      (,(CADR X) ,(CADDR X))
	      (T NIL)))

(DEFUN SOR MACRO (X)
       `(COND (,(CADR X)) (T ,(CADDR X))))

(DEFUN SNOT MACRO (X)
       `(LET ((Y ,(CADR X)))
	     (COND ((EQ Y 'UNDEF) 'UNDEF)
		   (T (NOT Y)))))

(DEFUN SETS MACRO (X)
       `(COND ((EQ ,(CADR X) 'UNDEF)
	       (SETQ ,(CADR X) ,(CADDR X)))
	      (T (BREAK ,(IMPLODE (APPEND (EXPLODEN '|MULTIPLY DEFINED SIGNAL |)
					  (EXPLODEN (CADR X))))))))

(DEFUN PROCESS-USER-FROBNICATIONS ()
       (COND (USER-WANTS-IN
	      (SETQ USER-WANTS-IN NIL)
	      (BREAK |FROBNICATE AWAY!|)))
       (EXTERNAL-DISPLAY)
       (SETQ -PROBE (SOR PC0 (SOR PC1 PC2)))
       (SETQ PCA (SAND (SNOT PC0) (SAND (SNOT PC1) PC2)))
       (SETQ PCB (SAND (SNOT PC0) (SAND PC1 (SNOT PC2))))
       (SETQ PCC (SAND (SNOT PC0) (SAND PC1 PC2)))
       (SETQ PCD (SAND PC0 (SAND (SNOT PC1) (SNOT PC2))))
       (SETQ PCE (SAND PC0 (SAND (SNOT PC1) PC2)))
       (COND ((AND PC0 PC1)
	      (PRINT '(BAD PROBE BITS -- TRY AGAIN))
	      (PROCESS-USER-FROBNICATIONS))))

(DEFUN SIMUL8 ()
       (CURSORPOS 'C)				;CLEAR SCREEN
       (DO () (())				;"() (())" IS SANSKRIT FOR "FOREVER"
	   (COND ((EQ ONE-SHOT-STUFF 'OFF)
		  (SETQ STUFF NIL)
		  (SETQ ONE-SHOT-STUFF NIL))
		 (ONE-SHOT-STUFF
		  (SETQ ONE-SHOT-STUFF 'OFF)
		  (SETQ STUFF T)))
	   (COND ((EQ ONE-SHOT-RUN 'OFF)
		  (SETQ FREEZE T)
		  (SETQ ONE-SHOT-RUN NIL))
		 (ONE-SHOT-RUN
		  (SETQ ONE-SHOT-RUN 'OFF)
		  (SETQ FREEZE NIL)))
	   (PROCESS-USER-FROBNICATIONS)
	   (PHASE1)
	   (PHASE1-DISPLAY)
	   (PROCESS-USER-FROBNICATIONS)
	   (PHASE2)
	   (PHASE2-DISPLAY)))

(DEFUN READREG MACRO (X)			;(READREG <REG> <BUS>)
       `(COND (,(IMPLODE (APPEND '(P H I /1 * R D) (EXPLODEN (CADR X))))
	       ,@(DO ((I 9 (- I 1))
		      (Z NIL (CONS `(SETS ,(IMPLODE (APPEND (EXPLODEN (CADDR X))
							    '(A)
							    (LET ((BASE 10.) (*NOPOINT T))
								 (EXPLODEN I))))
					  (SAND ,(IMPLODE (APPEND '(P H I /1 * R D)
								  (EXPLODEN (CADR X))))
						,(IMPLODE (APPEND (EXPLODEN (CADR X))
								  '(A)
								  (LET ((BASE 10.) (*NOPOINT T))
								       (EXPLODEN I))))))
				   Z)))
		     ((MINUSP I)
		      (DO ((J 2 (- J 1))
			   (Y Z (CONS `(SETS ,(IMPLODE (APPEND (EXPLODEN (CADDR X))
							       '(T)
							       (EXPLODEN J)))
					     (SAND ,(IMPLODE (APPEND '(P H I /1 * R D)
								     (EXPLODEN (CADR X))))
						   ,(IMPLODE (APPEND (EXPLODEN (CADR X))
								     '(T)
								     (EXPLODEN J)))))
				      Y)))
			  ((MINUSP J) Y)))))))

(DEFUN LOADREG MACRO (X)			;(LOADREG <REG> <BUS>)
       `(COND (,(IMPLODE (APPEND '(P H I /1 * L D) (EXPLODEN (CADR X))))
	       ,@(DO ((I 9 (- I 1))
		      (Z NIL (CONS `(SETS ,(IMPLODE (APPEND (EXPLODEN (CADR X))
							    '(A)
							    (LET ((BASE 10.) (*NOPOINT T))
								 (EXPLODEN I))))
					  (SAND ,(IMPLODE (APPEND '(P H I /1 * L D)
								  (EXPLODEN (CADR X))))
						,(IMPLODE (APPEND (EXPLODEN (CADDR X))
								  '(A)
								  (LET ((BASE 10.) (*NOPOINT T))
								       (EXPLODEN I))))))
				   Z)))
		     ((MINUSP I)
		      (DO ((J 2 (- J 1))
			   (Y Z (CONS `(SETS ,(IMPLODE (APPEND (EXPLODEN (CADR X))
							       '(T)
							       (EXPLODEN J)))
					     (SAND ,(IMPLODE (APPEND '(P H I /1 * L D)
								     (EXPLODEN (CADR X))))
						   ,(IMPLODE (APPEND (EXPLODEN (CADDR X))
								     '(T)
								     (EXPLODEN J)))))
				      Y)))
			  ((MINUSP J) Y)))))))

(DEFUN CYCLEREG MACRO (X)			;(CYCLEREG <REG>)
       `(COND ((SNOT ,(IMPLODE (APPEND '(P H I /1 * L D) (EXPLODEN (CADR X)))))
	       ,@(DO ((I 9 (- I 1))
		      (Z NIL (CONS `(SETS ,(IMPLODE (APPEND (EXPLODEN (CADR X))
							    '(A)
							    (LET ((BASE 10.) (*NOPOINT T))
								 (EXPLODEN I))))
					  (SOR ,(IMPLODE (APPEND '(P H I /1 * L D)
								 (EXPLODEN (CADR X))))
					       ,(IMPLODE (APPEND (EXPLODEN (CADR X))
								 '(A)
								 (LET ((BASE 10.) (*NOPOINT T))
								      (EXPLODEN I))
								 '($)))))
				   Z)))
		     ((MINUSP I)
		      (DO ((J 2 (- J 1))
			   (Y Z (CONS `(SETS ,(IMPLODE (APPEND (EXPLODEN (CADR X))
							       '(T)
							       (EXPLODEN J)))
					     (SOR ,(IMPLODE (APPEND '(P H I /1 * L D)
								    (EXPLODEN (CADR X))))
						  ,(IMPLODE (APPEND (EXPLODEN (CADR X))
								    '(T)
								    (EXPLODEN J)
								    '($)))))
				      Y)))
			  ((MINUSP J) Y)))))))

(DEFUN PHASE1 ()
       (MAPC (FUNCTION (LAMBDA (V) (SET V 'UNDEF))) PHI1)
       (PHASE1-CLOCKED-SIGNALS)
       (PHASE1-CYCLEREGS)
       (PHASE1-READREGS)
       (PHASE1-INCREMENT)
       (PHASE1-CONNECT-BUSSES)
       (PHASE1-LOADREGS)
       (PHASE1-RANDOMNESS)
       (PHASE1-STATE-UPDATE))

(DEFUN PHASE1-CLOCKED-SIGNALS ()
       (SETS PHI1*LDV LDV)			;CLOCKED SIGNALS
       (SETS PHI1*RDV RDV)
       (SETS PHI1*LDX LDX)
       (SETS PHI1*RDX RDX)
       (SETS PHI1*RDX+ RDX+)
       (SETS PHI1*LDN LDN)
       (SETS PHI1*RDN RDN)
       (SETS PHI1*LDL LDL)
       (SETS PHI1*RDL RDL)
       (SETS PHI1*LDC LDC)
       (SETS PHI1*RDC RDC)
       (SETS PHI1*EA-LIT EA-LIT)
       (SETS PHI1*ET-LIT ET-LIT)
       (SETS PHI1*CONN-I CONN-I)
       (SETS PHI1*CONN-EA CONN-EA)
       (SETS PHI1*CONN-ET CONN-ET)
       (SETS PHI1*LDP LDP)
       (SETS PHI1*RDP RDP)
       (SETS PHI1*RDP+ RDP+)
       (SETS PHI1*LDQ LDQ)
       (SETS PHI1*RDQ RDQ)
       (SETS PHI1*LDR LDR)
       (SETS PHI1*RDR RDR)
       (SETS PHI1*LDS LDS))

(DEFUN PHASE1-CYCLEREGS ()
       (CYCLEREG V)				;CYCLE REGISTERS WHICH ARE NOT LOADED
       (CYCLEREG X)
       (CYCLEREG N)
       (CYCLEREG L)
       (CYCLEREG C)
       (CYCLEREG P)
       (CYCLEREG Q)
       (CYCLEREG R)
       (CYCLEREG S))

(DEFUN PHASE1-READREGS ()
       (READREG V E)				;READ REGISTERS ONTO BUSSES
       (READREG X E)
       (READREG N E)
       (READREG L E)
       (READREG C E)
       (READREG P G)
       (READREG Q G)
       (READREG R G)
       (READREG S G))

(DEFUN PHASE1-INCREMENT ()
       (SETS X+T0 XT0)				;CALCULATE INCREMENTED X
       (SETS X+T1 XT1)
       (SETS X+T2 XT2)
       (SETS X+A9 (SXOR XA9 T)) (SETS XCO9 XA9)
       (SETS X+A8 (SXOR XA8 XCO9)) (SETS XCO8 (SAND XA8 XCO9))
       (SETS X+A7 (SXOR XA7 XCO8)) (SETS XCO7 (SAND XA7 XCO8))
       (SETS X+A6 (SXOR XA6 XCO7)) (SETS XCO6 (SAND XA6 XCO7))
       (SETS X+A5 (SXOR XA5 XCO6)) (SETS XCO5 (SAND XA5 XCO6))
       (SETS X+A4 (SXOR XA4 XCO5)) (SETS XCO4 (SAND XA4 XCO5))
       (SETS X+A3 (SXOR XA3 XCO4)) (SETS XCO3 (SAND XA3 XCO4))
       (SETS X+A2 (SXOR XA2 XCO3)) (SETS XCO2 (SAND XA2 XCO3))
       (SETS X+A1 (SXOR XA1 XCO2)) (SETS XCO1 (SAND XA1 XCO2))
       (SETS X+A0 (SXOR XA0 XCO1)) (SETS XCO0 (SAND XA0 XCO1))
       (READREG X+ E)
       (SETS P+T0 PT0)				;CALCULATE INCREMENTED P
       (SETS P+T1 PT1)
       (SETS P+T2 PT2)
       (SETS P+A9 (SXOR PA9 T)) (SETS PCO9 PA9)
       (SETS P+A8 (SXOR PA8 PCO9)) (SETS PCO8 (SAND PA8 PCO9))
       (SETS P+A7 (SXOR PA7 PCO8)) (SETS PCO7 (SAND PA7 PCO8))
       (SETS P+A6 (SXOR PA6 PCO7)) (SETS PCO6 (SAND PA6 PCO7))
       (SETS P+A5 (SXOR PA5 PCO6)) (SETS PCO5 (SAND PA5 PCO6))
       (SETS P+A4 (SXOR PA4 PCO5)) (SETS PCO4 (SAND PA4 PCO5))
       (SETS P+A3 (SXOR PA3 PCO4)) (SETS PCO3 (SAND PA3 PCO4))
       (SETS P+A2 (SXOR PA2 PCO3)) (SETS PCO2 (SAND PA2 PCO3))
       (SETS P+A1 (SXOR PA1 PCO2)) (SETS PCO1 (SAND PA1 PCO2))
       (SETS P+A0 (SXOR PA0 PCO1)) (SETS PCO0 (SAND PA0 PCO1))
       (READREG P+ G))

(DEFUN PHASE1-CONNECT-BUSSES ()
       (COND (CONN-I				;CONNECT I BUS
	      (SETS GT0 (SAND CONN-I IT0))
	      (SETS GT1 (SAND CONN-I IT1))
	      (SETS GT2 (SAND CONN-I IT2))
	      (SETS GA0 (SAND CONN-I IA0))
	      (SETS GA1 (SAND CONN-I IA1))
	      (SETS GA2 (SAND CONN-I IA2))
	      (SETS GA3 (SAND CONN-I IA3))
	      (SETS GA4 (SAND CONN-I IA4))
	      (SETS GA5 (SAND CONN-I IA5))
	      (SETS GA6 (SAND CONN-I IA6))
	      (SETS GA7 (SAND CONN-I IA7))
	      (SETS GA8 (SAND CONN-I IA8))
	      (SETS GA9 (SAND CONN-I IA9))))
       (COND (CONN-ET				;CONNECT ET BUS
	      (COND ((EQ GT0 'UNDEF)
		     (SETS GT0 (SAND CONN-ET ET0))
		     (SETS GT1 (SAND CONN-ET ET1))
		     (SETS GT2 (SAND CONN-ET ET2)))
		    ((EQ ET0 'UNDEF)
		     (SETS ET0 (SAND CONN-ET GT0))
		     (SETS ET1 (SAND CONN-ET GT1))
		     (SETS ET2 (SAND CONN-ET GT2)))
		    (T (BREAK |GT AND ET BUSSES BOTH READ ONTO AND CONNECTED|)))))
       (COND (CONN-EA				;CONNECT EA BUS
	      (COND ((EQ GA0 'UNDEF)
		     (SETS GA0 (SAND CONN-EA EA0))
		     (SETS GA1 (SAND CONN-EA EA1))
		     (SETS GA2 (SAND CONN-EA EA2))
		     (SETS GA3 (SAND CONN-EA EA3))
		     (SETS GA4 (SAND CONN-EA EA4))
		     (SETS GA5 (SAND CONN-EA EA5))
		     (SETS GA6 (SAND CONN-EA EA6))
		     (SETS GA7 (SAND CONN-EA EA7))
		     (SETS GA8 (SAND CONN-EA EA8))
		     (SETS GA9 (SAND CONN-EA EA9)))
		    ((EQ EA0 'UNDEF)
		     (SETS EA0 (SAND CONN-EA GA0))
		     (SETS EA1 (SAND CONN-EA GA1))
		     (SETS EA2 (SAND CONN-EA GA2))
		     (SETS EA3 (SAND CONN-EA GA3))
		     (SETS EA4 (SAND CONN-EA GA4))
		     (SETS EA5 (SAND CONN-EA GA5))
		     (SETS EA6 (SAND CONN-EA GA6))
		     (SETS EA7 (SAND CONN-EA GA7))
		     (SETS EA8 (SAND CONN-EA GA8))
		     (SETS EA9 (SAND CONN-EA GA9)))
		    (T (BREAK |GA AND EA BUSSES BOTH READ ONTO AND CONNECTED|))))))

(DEFUN PHASE1-LOADREGS ()
       (LOADREG V E)				;LOAD REGISTERS FROM BUSSES
       (LOADREG X E)
       (LOADREG N E)
       (LOADREG L E)
       (LOADREG C E)
       (LOADREG P G)
       (SETS PT0 NIL)
       (SETS PT1 NIL)
       (SETS PT2 NIL)
       (LOADREG Q G)
       (LOADREG R G))

(DEFUN PHASE1-RANDOMNESS ()
       (LOAD-OUTPUT-PADS)
       (SETS ET-ZERO (SAND ET0 (SAND ET1 ET2)))
       (SETS EA-ZERO
	     (SAND EA0
		   (SAND EA1
			 (SAND EA2
			       (SAND EA3
				     (SAND EA4
					   (SAND EA5
						 (SAND EA6
						       (SAND EA7
							     (SAND EA8 EA9))))))))))
       (SETS EQV
	     (SNOT (SOR (SXOR ET0 VT0)
			(SOR (SXOR ET1 VT1)
			     (SOR (SXOR ET2 VT2)
				  (SOR (SXOR EA0 VA0)
				       (SOR (SXOR EA1 VA1)
					    (SOR (SXOR EA2 VA2)
						 (SOR (SXOR EA3 VA3)
						      (SOR (SXOR EA4 VA4)
							   (SOR (SXOR EA5 VA5)
								(SOR (SXOR EA6 VA6)
								     (SOR (SXOR EA7 VA7)
									  (SOR (SXOR EA8 VA8)
									       (SXOR EA9 VA9)))))))))))))))
       (SETS GA-ZERO
	     (SAND GA0
		   (SAND GA1
			 (SAND GA2
			       (SAND GA3
				     (SAND GA4
					   (SAND GA5
						 (SAND GA6
						       (SAND GA7
							     (SAND GA8 GA9)))))))))))

(DEFUN PHASE1-STATE-UPDATE ()
       (SETS ESTATE0 (STATE-MERGE ENSTATE0 EOSTATE0 IT1))
       (SETS ESTATE1 (STATE-MERGE ENSTATE1 EOSTATE1 IT2))
       (SETS ESTATE2 (STATE-MERGE ENSTATE2 EOSTATE2 IA0))
       (SETS ESTATE3 (STATE-MERGE (STATE-DISPATCH ENSTATE3 ET-DISP ET0 EAZ-ETZ-EQV-DISP EA-ZERO) EOSTATE3 IA1))
       (SETS ESTATE4 (STATE-MERGE (STATE-DISPATCH ENSTATE4 ET-DISP ET1 EAZ-ETZ-EQV-DISP ET-ZERO) EOSTATE4 IA2))
       (SETS ESTATE5 (STATE-MERGE (STATE-DISPATCH ENSTATE5 ET-DISP ET2 EAZ-ETZ-EQV-DISP EQV) EOSTATE5 IA3))
       (SETS GSTATE0 (STATE-MERGE GNSTATE0 GOSTATE0 IA4))
       (SETS GSTATE1 (STATE-MERGE GNSTATE1 GOSTATE1 IA5))
       (SETS GSTATE2 (STATE-MERGE (STATE-DISPATCH GNSTATE2 GCOP-DISP GCOP0 GA-ZERO-DISP NIL) GOSTATE2 IA6))
       (SETS GSTATE3 (STATE-MERGE (STATE-DISPATCH GNSTATE3 GCOP-DISP GCOP1 GA-ZERO-DISP NIL) GOSTATE3 IA7))
       (SETS GSTATE4 (STATE-MERGE (STATE-DISPATCH GNSTATE4 GCOP-DISP GCOP2 GA-ZERO-DISP NIL) GOSTATE4 IA8))
       (SETS GSTATE5 (STATE-MERGE (STATE-DISPATCH GNSTATE5 GCOP-DISP GCOP3 GA-ZERO-DISP GA-ZERO) GOSTATE5 IA9)))

(DEFUN STATE-MERGE (NS OS I)
       (COND (STUFF I) (FREEZE OS) (T NS)))

(DEFUN STATE-DISPATCH (NS P J Q K)
       (SOR NS (SOR (SAND P J) (SAND Q K))))

(DEFUN RECYCLEREG MACRO (X)			;(RECYCLEREG <REG>)
       `(PROGN ,@(DO ((I 9 (- I 1))
		      (Z NIL (CONS `(SETS ,(IMPLODE (APPEND (EXPLODEN (CADR X))
							    '(A)
							    (LET ((BASE 10.) (*NOPOINT T))
								 (EXPLODEN I))
							    '($)))
					  (SOR ,(IMPLODE (APPEND '(P H I /1 * L D)
								 (EXPLODEN (CADR X))))
					       ,(IMPLODE (APPEND (EXPLODEN (CADR X))
								 '(A)
								 (LET ((BASE 10.) (*NOPOINT T))
								      (EXPLODEN I))))))
				   Z)))
		     ((MINUSP I)
		      (DO ((J 2 (- J 1))
			   (Y Z (CONS `(SETS ,(IMPLODE (APPEND (EXPLODEN (CADR X))
							       '(T)
							       (EXPLODEN J)
							       '($)))
					     (SOR ,(IMPLODE (APPEND '(P H I /1 * L D)
								    (EXPLODEN (CADR X))))
						  ,(IMPLODE (APPEND (EXPLODEN (CADR X))
								    '(T)
								    (EXPLODEN J)))))
				      Y)))
			  ((MINUSP J) Y))))))

(DEFUN SETBIT MACRO (X)				;(SETBIT <BIT> <WORD>)
       `(SETS ,(CADR X)
	      (NOT (ZEROP (BOOLE 1 ,(CADDR X)
				 ,(IMPLODE (APPEND (EXPLODEN (CADR X))
						   '(- B I T))))))))
(DEFUN PROBE MACRO (X)				;(PROBE <PROBEBIT> <B1> <B2> <B3> <B4> <B5>)
       `(SETS ,(CADR X)
	      (COND (PCA ,(CADDR X))
		    (PCB ,(CADDDR X))
		    (PCC ,(CAR (CDDDDR X)))
		    (PCD ,(CADR (CDDDDR X)))
		    (PCE ,(CADDR (CDDDDR X)))
		    (T 'UNDEF))))

(DEFUN PHASE2 ()
       (MAPC (FUNCTION (LAMBDA (V) (SET V 'UNDEF))) PHI2)
       (PHASE2-RECYCLEREGS)
       (PHASE2-EVAL-PLA)
       (PHASE2-GC-PLA)
       (PHASE2-PROBE))

(DEFUN PHASE2-RECYCLEREGS ()
       (RECYCLEREG V)				;RECYCLE REGISTERS
       (RECYCLEREG X)
       (RECYCLEREG N)
       (RECYCLEREG L)
       (RECYCLEREG C)
       (RECYCLEREG P)
       (RECYCLEREG Q)
       (RECYCLEREG R)
       (RECYCLEREG S))

(DEFUN PHASE2-EVAL-PLA ()
       (SETQ ESTATE (NUMERATE ESTATE0 ESTATE1 ESTATE2 ESTATE3 ESTATE4 ESTATE5))
       (SETQ EWORD (ARRAYCALL T EVAL ESTATE))
       (SETBIT ENSTATE0 EWORD)
       (SETBIT ENSTATE1 EWORD)
       (SETBIT ENSTATE2 EWORD)
       (SETBIT ENSTATE3 EWORD)
       (SETBIT ENSTATE4 EWORD)
       (SETBIT ENSTATE5 EWORD)
       (SETBIT EOSTATE0 EWORD)
       (SETBIT EOSTATE1 EWORD)
       (SETBIT EOSTATE2 EWORD)
       (SETBIT EOSTATE3 EWORD)
       (SETBIT EOSTATE4 EWORD)
       (SETBIT EOSTATE5 EWORD)
       (SETBIT LDV EWORD)
       (SETBIT LDX EWORD)
       (SETBIT LDN EWORD)
       (SETBIT LDL EWORD)
       (SETBIT LDC EWORD)
       (SETBIT RDV EWORD)
       (SETBIT RDX EWORD)
       (SETBIT RDX+ EWORD)
       (SETBIT RDN EWORD)
       (SETBIT RDL EWORD)
       (SETBIT RDC EWORD)
       (SETBIT ET-DISP EWORD)
       (SETBIT EAZ-ETZ-EQV-DISP EWORD)
       (SETBIT EA-LIT EWORD)
       (SETBIT ET-LIT EWORD)
       (SETBIT LIT0 EWORD)
       (SETBIT LIT1 EWORD)
       (SETBIT LIT2 EWORD)
       (SETBIT GCOP0 EWORD)
       (SETBIT GCOP1 EWORD)
       (SETBIT GCOP2 EWORD)
       (SETBIT GCOP3 EWORD))

(DEFUN PHASE2-GC-PLA ()
       (SETQ GSTATE (NUMERATE GSTATE0 GSTATE1 GSTATE2 GSTATE3 GSTATE4 GSTATE5))
       (SETQ GWORD (ARRAYCALL T EVAL GSTATE))
       (SETBIT GNSTATE0 GWORD)
       (SETBIT GNSTATE1 GWORD)
       (SETBIT GNSTATE2 GWORD)
       (SETBIT GNSTATE3 GWORD)
       (SETBIT GNSTATE4 GWORD)
       (SETBIT GNSTATE5 GWORD)
       (SETBIT GOSTATE0 GWORD)
       (SETBIT GOSTATE1 GWORD)
       (SETBIT GOSTATE2 GWORD)
       (SETBIT GOSTATE3 GWORD)
       (SETBIT GOSTATE4 GWORD)
       (SETBIT GOSTATE5 GWORD)
       (SETBIT STEP-EVAL GWORD)
       (SETBIT CONN-EA GWORD)
       (SETBIT CONN-ET GWORD)
       (SETBIT CONN-I GWORD)
       (SETBIT LDP GWORD)
       (SETBIT LDQ GWORD)
       (SETBIT LDR GWORD)
       (SETBIT LDS GWORD)
       (SETBIT RDP GWORD)
       (SETBIT RDP+ GWORD)
       (SETBIT RDQ GWORD)
       (SETBIT RDR GWORD)
       (SETBIT ADR GWORD)
       (SETBIT WRITE GWORD)
       (SETBIT GCOP-DISP GWORD)
       (SETBIT GA-ZERO-DISP GWORD))

(DEFUN PHASE2-PROBE ()
       (PROBE PROBE0 NIL NIL GCOP0 ET-DISP RDN)
       (PROBE PROBE1 EOSTATE0 ENSTATE0 GCOP1 EAZ-ETZ-EQV-DISP RDL)
       (PROBE PROBE2 EOSTATE1 ENSTATE1 GCOP2 LDV RDC)
       (PROBE PROBE3 EOSTATE2 ENSTATE2 GCOP3 LDX LIT0)
       (PROBE PROBE4 EOSTATE3 ENSTATE3 RDV LDN LIT1)
       (PROBE PROBE5 EOSTATE4 ENSTATE4 RDX LDL LIT2)
       (PROBE PROBE6 EOSTATE5 ENSTATE5 RDX+ LDC ET-LIT)
       (PROBE PROBE7 GOSTATE0 GNSTATE0 RDR NIL EA-LIT)
       (PROBE PROBE8 GOSTATE1 GNSTATE1 RDQ NIL NIL)
       (PROBE PROBE9 GOSTATE2 GNSTATE2 RDP+ LDS STEP-EVAL)
       (PROBE PROBE10 GOSTATE3 GNSTATE3 RDP LDR CONN-ET)
       (PROBE PROBE11 GOSTATE4 GNSTATE4 GA-ZERO-DISP LDQ CONN-EA)
       (PROBE PROBE12 GOSTATE5 GNSTATE5 GCOP-DISP LDP CONN-I)
       (LOAD-OUTPUT-PADS))

(DEFUN NUMERATE (I J K L M N)
       (AND (OR (EQ I 'UNDEF) (EQ J 'UNDEF) (EQ K 'UNDEF) (EQ L 'UNDEF) (EQ M 'UNDEF) (EQ N 'UNDEF))
	    (ERROR '|UNDEFINED STATE BIT(S)| (LIST I J K L M N) 'FAIL-ACT))
       (+ (COND (I 40) (T 0))
	  (COND (J 20) (T 0))
	  (COND (K 10) (T 0))
	  (COND (L 4) (T 0))
	  (COND (M 2) (T 0))
	  (COND (N 1) (T 0))))

(DEFUN LOAD-OUTPUT-PADS ()
       (SETQ OT0 (SOR (SAND -PROBE ST0) (SAND (SNOT -PROBE) PROBE0)))
       (SETQ OT1 (SOR (SAND -PROBE ST1) (SAND (SNOT -PROBE) PROBE1)))
       (SETQ OT2 (SOR (SAND -PROBE ST2) (SAND (SNOT -PROBE) PROBE2)))
       (SETQ OA0 (SOR (SAND -PROBE SA0) (SAND (SNOT -PROBE) PROBE3)))
       (SETQ OA1 (SOR (SAND -PROBE SA1) (SAND (SNOT -PROBE) PROBE4)))
       (SETQ OA2 (SOR (SAND -PROBE SA2) (SAND (SNOT -PROBE) PROBE5)))
       (SETQ OA3 (SOR (SAND -PROBE SA3) (SAND (SNOT -PROBE) PROBE6)))
       (SETQ OA4 (SOR (SAND -PROBE SA4) (SAND (SNOT -PROBE) PROBE7)))
       (SETQ OA5 (SOR (SAND -PROBE SA5) (SAND (SNOT -PROBE) PROBE8)))
       (SETQ OA6 (SOR (SAND -PROBE SA6) (SAND (SNOT -PROBE) PROBE9)))
       (SETQ OA7 (SOR (SAND -PROBE SA7) (SAND (SNOT -PROBE) PROBE10)))
       (SETQ OA8 (SOR (SAND -PROBE SA8) (SAND (SNOT -PROBE) PROBE11)))
       (SETQ OA9 (SOR (SAND -PROBE SA9) (SAND (SNOT -PROBE) PROBE12))))

(DEFUN DISPLAY-REG MACRO (X)			;(DISPLAY-REG <Y> <X> <REG>)
       `(DISPLAY-REG-ROUTINE ,(CADR X)
			     ,(CADDR X)
			     ',(LET ((Z (REVERSE (APPEND '(| | | |) (EXPLODEN (CADDDR X))))))
				    (RPLACD (CDDR Z) NIL)
				    (IMPLODE (NREVERSE Z)))
			     (LIST ,@(DO ((I 2 (- I 1))
					  (Z NIL (CONS (IMPLODE (APPEND (EXPLODEN (CADDDR X))
									'(T)
									(EXPLODEN I)))
						       Z)))
					 ((MINUSP I) Z)))
			     (LIST ,@(DO ((I 9 (- I 1))
					  (Z NIL (CONS (IMPLODE (APPEND (EXPLODEN (CADDDR X))
									'(A)
									(LET ((BASE 10.) (*NOPOINT T))
									     (EXPLODEN I))))
						       Z)))
					 ((MINUSP I) Z)))))

(DEFUN DISPLAY-REG-ROUTINE (Y X NAME TN AN)
       (CURSORPOS Y X)
       (CURSORPOS 'L)
       (PRINC NAME)
       (PRINC '|=|)
       (MAPC (FUNCTION BIT-PRINC) TN)
       (PRINC '/|)
       (MAPC (FUNCTION BIT-PRINC) AN))

(DEFUN BIT-PRINC (X)
       (COND ((EQ X 'UNDEF) (PRINC '|?|))
	     ((NULL X) (PRINC '|0|))
	     (T (PRINC '|1|))))

(DEFUN PHASE1-DISPLAY ()
       (DISPLAY-REG 0 0 E)
       (DISPLAY-REG 1 0 V)
       (DISPLAY-REG 2 0 X)
       (DISPLAY-REG 3 0 X+)
       (DISPLAY-REG 0 24 N)
       (DISPLAY-REG 1 24 L)
       (DISPLAY-REG 2 24 C)
       (DISPLAY-REG 0 50 G)
       (DISPLAY-REG 1 50 P)
       (DISPLAY-REG 2 50 P+)
       (DISPLAY-REG 0 74 Q)
       (DISPLAY-REG 1 74 R)
       (DISPLAY-REG 2 74 S)
       (SAFE-CURSORPOS))

(DEFUN DISPLAY-BIT MACRO (X)			;(DISPLAY-BIT <Y> <X> <NAME>)
       `(DISPLAY-BIT-ROUTINE ,(CADR X) ,(CADDR X) ',(CADDDR X) ,(CADDDR X)))

(DEFUN DISPLAY-BIT-ROUTINE (Y X NAME BIT)
       (CURSORPOS Y X)
       (CURSORPOS 'L)
       (PRINC NAME)
       (PRINC '|=|)
       (BIT-PRINC BIT))

(SETQ PHASE2-DISP-ORIGIN 4)

(DEFUN PHASE2-DISPLAY ()
       (DISPLAY-BIT (+ 1 PHASE2-DISP-ORIGIN) 0 EOSTATE0)
       (DISPLAY-BIT (+ 2 PHASE2-DISP-ORIGIN) 0 EOSTATE1)
       (DISPLAY-BIT (+ 3 PHASE2-DISP-ORIGIN) 0 EOSTATE2)
       (DISPLAY-BIT (+ 4 PHASE2-DISP-ORIGIN) 0 EOSTATE3)
       (DISPLAY-BIT (+ 5 PHASE2-DISP-ORIGIN) 0 EOSTATE4)
       (DISPLAY-BIT (+ 6 PHASE2-DISP-ORIGIN) 0 EOSTATE5)
       (DISPLAY-BIT (+ 7 PHASE2-DISP-ORIGIN) 0 GOSTATE0)
       (DISPLAY-BIT (+ 10 PHASE2-DISP-ORIGIN) 0 GOSTATE1)
       (DISPLAY-BIT (+ 11 PHASE2-DISP-ORIGIN) 0 GOSTATE2)
       (DISPLAY-BIT (+ 12 PHASE2-DISP-ORIGIN) 0 GOSTATE3)
       (DISPLAY-BIT (+ 13 PHASE2-DISP-ORIGIN) 0 GOSTATE4)
       (DISPLAY-BIT (+ 14 PHASE2-DISP-ORIGIN) 0 GOSTATE5)

       (DISPLAY-BIT (+ 1 PHASE2-DISP-ORIGIN) 14 ENSTATE0)
       (DISPLAY-BIT (+ 2 PHASE2-DISP-ORIGIN) 14 ENSTATE1)
       (DISPLAY-BIT (+ 3 PHASE2-DISP-ORIGIN) 14 ENSTATE2)
       (DISPLAY-BIT (+ 4 PHASE2-DISP-ORIGIN) 14 ENSTATE3)
       (DISPLAY-BIT (+ 5 PHASE2-DISP-ORIGIN) 14 ENSTATE4)
       (DISPLAY-BIT (+ 6 PHASE2-DISP-ORIGIN) 14 ENSTATE5)
       (DISPLAY-BIT (+ 7 PHASE2-DISP-ORIGIN) 14 GNSTATE0)
       (DISPLAY-BIT (+ 10 PHASE2-DISP-ORIGIN) 14 GNSTATE1)
       (DISPLAY-BIT (+ 11 PHASE2-DISP-ORIGIN) 14 GNSTATE2)
       (DISPLAY-BIT (+ 12 PHASE2-DISP-ORIGIN) 14 GNSTATE3)
       (DISPLAY-BIT (+ 13 PHASE2-DISP-ORIGIN) 14 GNSTATE4)
       (DISPLAY-BIT (+ 14 PHASE2-DISP-ORIGIN) 14 GNSTATE5)

       (DISPLAY-BIT (+ 0 PHASE2-DISP-ORIGIN) 30 GCOP0)
       (DISPLAY-BIT (+ 1 PHASE2-DISP-ORIGIN) 30 GCOP1)
       (DISPLAY-BIT (+ 2 PHASE2-DISP-ORIGIN) 30 GCOP2)
       (DISPLAY-BIT (+ 3 PHASE2-DISP-ORIGIN) 30 GCOP3)
       (DISPLAY-BIT (+ 4 PHASE2-DISP-ORIGIN) 30 RDV)
       (DISPLAY-BIT (+ 5 PHASE2-DISP-ORIGIN) 30 RDX)
       (DISPLAY-BIT (+ 6 PHASE2-DISP-ORIGIN) 30 RDX+)
       (DISPLAY-BIT (+ 7 PHASE2-DISP-ORIGIN) 30 RDR)
       (DISPLAY-BIT (+ 10 PHASE2-DISP-ORIGIN) 30 RDQ)
       (DISPLAY-BIT (+ 11 PHASE2-DISP-ORIGIN) 30 RDP+)
       (DISPLAY-BIT (+ 12 PHASE2-DISP-ORIGIN) 30 RDP)
       (DISPLAY-BIT (+ 13 PHASE2-DISP-ORIGIN) 30 GA-ZERO-DISP)
       (DISPLAY-BIT (+ 14 PHASE2-DISP-ORIGIN) 30 GCOP-DISP)

       (DISPLAY-BIT (+ 0 PHASE2-DISP-ORIGIN) 50 ET-DISP)
       (DISPLAY-BIT (+ 1 PHASE2-DISP-ORIGIN) 50 EAZ-ETZ-EQV-DISP)
       (DISPLAY-BIT (+ 2 PHASE2-DISP-ORIGIN) 50 LDV)
       (DISPLAY-BIT (+ 3 PHASE2-DISP-ORIGIN) 50 LDX)
       (DISPLAY-BIT (+ 4 PHASE2-DISP-ORIGIN) 50 LDN)
       (DISPLAY-BIT (+ 5 PHASE2-DISP-ORIGIN) 50 LDL)
       (DISPLAY-BIT (+ 6 PHASE2-DISP-ORIGIN) 50 LDC)
       (DISPLAY-BIT (+ 11 PHASE2-DISP-ORIGIN) 50 LDS)
       (DISPLAY-BIT (+ 12 PHASE2-DISP-ORIGIN) 50 LDR)
       (DISPLAY-BIT (+ 13 PHASE2-DISP-ORIGIN) 50 LDQ)
       (DISPLAY-BIT (+ 14 PHASE2-DISP-ORIGIN) 50 LDP)

       (DISPLAY-BIT (+ 0 PHASE2-DISP-ORIGIN) 74 RDN)
       (DISPLAY-BIT (+ 1 PHASE2-DISP-ORIGIN) 74 RDL)
       (DISPLAY-BIT (+ 2 PHASE2-DISP-ORIGIN) 74 RDC)
       (DISPLAY-BIT (+ 3 PHASE2-DISP-ORIGIN) 74 LIT0)
       (DISPLAY-BIT (+ 4 PHASE2-DISP-ORIGIN) 74 LIT1)
       (DISPLAY-BIT (+ 5 PHASE2-DISP-ORIGIN) 74 LIT2)
       (DISPLAY-BIT (+ 6 PHASE2-DISP-ORIGIN) 74 ET-LIT)
       (DISPLAY-BIT (+ 7 PHASE2-DISP-ORIGIN) 74 EA-LIT)
       (DISPLAY-BIT (+ 11 PHASE2-DISP-ORIGIN) 74 STEP-EVAL)
       (DISPLAY-BIT (+ 12 PHASE2-DISP-ORIGIN) 74 CONN-ET)
       (DISPLAY-BIT (+ 13 PHASE2-DISP-ORIGIN) 74 CONN-EA)
       (DISPLAY-BIT (+ 14 PHASE2-DISP-ORIGIN) 74 CONN-I)

       (DISPLAY-BIT (+ 15 PHASE2-DISP-ORIGIN) 10 ADR)
       (DISPLAY-BIT (+ 15 PHASE2-DISP-ORIGIN) 20 WRITE)
       (CURSORPOS (+ 15 PHASE2-DISP-ORIGIN) 34)
       (PRINC '|PROBE=|)
       (MAPC (FUNCTION BIT-PRINC)
	     (LIST PROBE0 PROBE1 PROBE2 PROBE3 PROBE4 PROBE5 PROBE6
		   PROBE7 PROBE8 PROBE9 PROBE10 PROBE11 PROBE12))
       (SAFE-CURSORPOS))

(SETQ EXTERNAL-DISP-ORIGIN (+ PHASE2-DISP-ORIGIN 17))

(DEFUN EXTERNAL-DISPLAY ()
       (DISPLAY-REG (+ 0 EXTERNAL-DISP-ORIGIN) 0 I)
       (DISPLAY-REG (+ 0 EXTERNAL-DISP-ORIGIN) 24 O)
       (DISPLAY-BIT (+ 0 EXTERNAL-DISP-ORIGIN) 54 STUFF)
       (DISPLAY-BIT (+ 0 EXTERNAL-DISP-ORIGIN) 66 FREEZE)
       (DISPLAY-BIT (+ 0 EXTERNAL-DISP-ORIGIN) 100 -PROBE)
       (DISPLAY-BIT (+ 1 EXTERNAL-DISP-ORIGIN) 0 PC0)
       (DISPLAY-BIT (+ 1 EXTERNAL-DISP-ORIGIN) 10 PC1)
       (DISPLAY-BIT (+ 1 EXTERNAL-DISP-ORIGIN) 20 PC2)
       (DISPLAY-BIT (+ 1 EXTERNAL-DISP-ORIGIN) 33 PCA)
       (DISPLAY-BIT (+ 1 EXTERNAL-DISP-ORIGIN) 43 PCB)
       (DISPLAY-BIT (+ 1 EXTERNAL-DISP-ORIGIN) 53 PCC)
       (DISPLAY-BIT (+ 1 EXTERNAL-DISP-ORIGIN) 63 PCD)
       (DISPLAY-BIT (+ 1 EXTERNAL-DISP-ORIGIN) 73 PCE)
       (SAFE-CURSORPOS))

(SETQ SAFE-CURSORPOS-LINE (+ EXTERNAL-DISP-ORIGIN 3))

(DEFUN SAFE-CURSORPOS () (CURSORPOS SAFE-CURSORPOS-LINE 0))

(DEFUN UCODE FEXPR (X)				;(UCODE NAME (<N> WORDS) ...)
       (DO ((Z (CDDR X) (CDR Z))
	    (A (SET (CAR X) (*ARRAY NIL T (CAADR X)))))
	   ((NULL Z))
	   (COND ((ATOM (CAR Z)))
		 ((EQ (CAAR Z) 'FIELD)
		  (COND ((EQ (CADR (CADDR (CAR Z))) 'BIT)
			 (SET (IMPLODE (APPEND (EXPLODEN (CAR (CADDR (CAR Z))))
					       '(- B I T)))
			      (CADAR Z)))))
		 ((NUMBERP (CAAR Z))
		  (STORE (ARRAYCALL T A (CAAR Z)) (CADAR Z)))))
       (CAR X))

(RESET)