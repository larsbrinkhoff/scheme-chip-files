(define eval-state-dispatch
	(call state-dispatch-cell)
	(call state-dispatch-cell (trans 22 0))
	(call eval-state-dispatch-cell-crock (trans 22 0))
	(call state-dispatch-cell (trans 44 0))
	(call eval-state-dispatch-cell-crock (trans 44 0))
	(call null-state-dispatch-cell (trans 58 0)))

(define gc-state-dispatch
	(call state-dispatch-cell)
	(call gc-state-dispatch-cell-crock)
	(call state-dispatch-cell (trans 22 0))
	(call state-dispatch-cell (trans 44 0))
	(call state-dispatch-cell (trans 66 0)))

