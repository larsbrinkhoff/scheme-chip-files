(define rightpads
	(do ((y 0 (+ y 1)))
	    ((= y 12)
	     (do ((y y (+ y 1)))
		 ((= y 15)
		  (call 3 (rotate 0 -1) (trans 0 (* y -80))))	;OUTPUT PAD
		 (call small-input-pad (rotate 0 -1) (trans 0 (+ (* y -80))))))
	    (cond ((< y 6)
		   (call upper-output-pad-metal-hookup
			 (mirror x) (rotate 0 -1) (trans 0 (- (* y -80) 86))))
		  (t (call lower-output-pad-metal-hookup
			   (mirror x) (rotate 0 -1) (trans 0 (- (* y -80) 86)))))
	    (call 3 (mirror x) (rotate 0 -1) (trans 0 (- (* y -80) 86)))))	;12 OUTPUT PADS

(define register
	(do ((y 0 (+ y 1)))
	    ((= y 11)
	     (call regcell-driver (trans 0 (* y -40))))
	    (call regcell (trans 0 (* y -40)))))

(layout regout-hookup (300 40) =
	(diff (32 92 19 25) (78 92 19 51))
	(metal (78 209 45 51))
	(cuts (80 48 V) (85 48 V) (90 48 V)))

(define register-out
	(do ((y 0 (+ y 1)))
	    ((= y 11)
	     (call regout-driver (trans 0 (* y -40))))
	    (call regout-hookup (trans 0 (* y -40)))
	    (call regout (trans 0 (* y -40)))))

(define register-with-inc
	(call reginc-carry-1)
	(do ((y 1 (+ y 1)))
	    ((= y 8))
	    (call reginc (trans 0 (* y -40))))
	(do ((y 8 (+ y 1)))
	    ((= y 11))
	    (call regnoinc (trans 0 (* y -40))))
	(call reginc-driver (trans 0 (* 11 -40))))

(define register-with-zeroinc
	(call reginc-carry-1)
	(do ((y 1 (+ y 1)))
	    ((= y 8))
	    (call reginc (trans 0 (* y -40))))
	(do ((y 8 (+ y 1)))
	    ((= y 11))
	    (call zeroinc (trans 0 (* y -40))))
	(call reginc-driver (trans 0 (* 11 -40))))

(layout upper-evalregs-I-bus (400 4) =
	(metal (-58 250 0 3) (-69 -57 0 4))
	(cuts (-67 2 S) (-63 2 S) (-59 2 S)))

(layout lower-evalregs-I-bus (400 4) =
	(metal (-74 250 0 3) (-85 -73 0 4))
	(cuts (-83 2 S) (-79 2 S) (-75 2 S)))

(layout evalregs-GND (160 40) =
	(metal (-155 4 33 37)))

(layout evalregs-diff-I-bus (0 0) =
	(diff (-175 -156 -5 30) (-175 250 -5 -2)))

(define evalregs
	(call register-with-inc)
	(call evalregs-diff-I-bus)
	(call evalregs-GND)
	(do ((y 1 (+ y 1)))
	    ((= y 11)
	     (call evalregs-GND (trans 0 (+ 33 -15 -22 (* y -40)))))	;for driver
	    (call evalregs-GND (trans 0 (* y -40)))
	    (cond ((< y 5) (call upper-evalregs-I-bus (trans 0 (* y -40))))
		  (t (call lower-evalregs-I-bus (trans 0 (* y -40))))))
	(do ((x 0 (+ x 1)))
	    ((= x 4))
	    (call register (trans (+ 85 (* x 38)) 0))))

(define gcregs
	(call register-with-zeroinc (mirror x) (trans 87 0))
	(call register (trans 83 0))
	(call register (trans (+ 83 38) 0))
	(call register-out (trans (+ 83 (* 2 38)) 0)))

(define eaz-etz-logic
	(do ((y 0 (+ y 1)))
	    ((= y 8)
	     (do ((y y (+ y 1)))
		 ((= y 11)
		  (call eaz-etz-pullups-etc (trans 0 (* y -40))))
		 (call etz-cell (trans 0 (* y -40)))))
	    (call eaz-cell (trans 0 (* y -40)))))

(layout bus-connect-randomness (140 53) =
	(poly (3 5 0 15) (5 22 0 2)				;EA-LIT
	      (37 39 0 15) (30 39 0 2)				;ET-LIT
	      (102 104 0 15) (104 109 0 2)			;CONN-I
	      (115 117 0 8) (115 138 6 8) (136 138 6 15)	;CONN-EA
	      (140 142 0 15) (123 140 0 2)			;CONN-ET
	      (92 94 -85 68))					;GA-ZERO
	(diff (41 43 0 68) (47 49 0 68) (53 55 0 68))		;LIT0, LIT1, LIT2
	(metal (0 134 9 12)					;PHI2
	       (0 134 15 19)					;VDD
	       (0 134 37 41)					;GND
	       (0 134 44 47)					;PHI1
	       (0 134 64 68)))					;VDD

(define full-bus-connect
	(do ((y 0 (+ y 1)))
	    ((= y 11))
	    (call bus-connect (trans 0 (* y -40)))
	    (cond ((zerop y) (call bus-connect-diff-I))
		  (t (call bus-connect-metal-I (trans 0 (* y -40)))))
	    (cond ((< y 8) (call bus-connect-a (trans 0 (* y -40))))
		  (t (and (= y 8) (call bus-connect-t-once (trans 0 (* y -40))))
		     (call bus-connect-t (trans 0 (* y -40)))))
	    (caseq y
		   ((0 4 5 6 7) (call bus-connect-lit-gnd (trans 0 (* y -40))))
		   ((1 8) (call bus-connect-lit2 (trans 0 (* y -40))))
		   ((2 9) (call bus-connect-lit1 (trans 0 (* y -40))))
		   ((3 10) (call bus-connect-lit0 (trans 0 (* y -40))))
		   (t (error '|??? full-bus-connect| y 'fail-act))))
	(call clocked-phase1-driver (trans 2 (+ -15 (* 11 -40))))
	(call clocked-phase1-driver (mirror x) (trans 40 (+ -15 (* 11 -40))))
	(call clocked-phase1-driver (trans 101 (+ -15 (* 11 -40))))
	(call clocked-phase1-driver (mirror x) (trans 139 (+ -15 (* 11 -40))))
	(call clocked-phase1-driver (trans 139 (+ -15 (* 11 -40))))
	(call bus-connect-randomness (trans 0 (* 11 -40))))

(define allregs
	(call eaz-etz-logic)
	(call evalregs (trans 18 0))
	(call full-bus-connect (trans (+ 18 85 (* 4 38)) 0))
	(call gcregs (trans (+ 18 85 (* 4 38) 130) 0)))

