	      (20 22 53 88) (15 20 53 55))
	(diff (15 17 19 40) (11 15 38 40) (11 13 40 58)
	      (13 17 56 58) (17 23 43 45) (17 19 45 88)
	      (16 20 48 52) (15 17 86 88))
	(cuts (18 50 S)))

(define eval-probe-mux
	(do ((x0 0 (+ x0 1)))
	    ((= x0 3))
	    (do ((x1 0 (+ x1 1)))
		((= x1 3))
		(cond ((and (= x0 2) (= x1 2))
		       (call probe-mux-column-left (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		      (t (call probe-mux-column (trans (+ (* x0 (* 14 6)) (* x1 28)) 0))))
		(caseq x0
		       ((0) (call probe-mux-ab-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		       ((1) (call probe-mux-cd-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		       ((2) (call probe-mux-e-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0))
			    (or (= x1 2)
				(call probe-mux-f-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))))
		(caseq x1
		       ((0) (call probe-mux-12-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		       ((1) (call probe-mux-34-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		       ((2) (call probe-mux-5-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0))
			    (or (= x0 2)
				(call probe-mux-6-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0))))))))

(define gc-probe-mux
	(do ((x0 0 (+ x0 1)))
	    ((= x0 3))
	    (do ((x1 0 (+ x1 1)))
		((or (= x1 3) (and (= x1 1) (= x0 2))))
		(call probe-mux-column (trans (+ (* x0 (* 14 6)) (* x1 28)) 0))
		(caseq x0
		       ((0) (call probe-mux-ab-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		       ((1) (call probe-mux-cd-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		       ((2) (call probe-mux-e-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0))
			    (call probe-mux-f-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0))))
		(caseq x1
		       ((0) (call probe-mux-12-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		       ((1) (call probe-mux-34-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))
		       ((2) (call probe-mux-5-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0))
			    (call probe-mux-6-ctl (trans (+ (* x0 (* 14 6)) (* x1 28)) 0)))))))

(layout eval-pla-random-metal (0 0) =
	(diff (372 396 29 365))
	(metal (9 17 9 464) (17 377 9 17) (17 114 458 464)	;VDD left...
	       (10 30 -25 9) (100 120 -25 9)
	       (377 385 9 503)	;VDD right...
	       (129 377 472 481) (129 377 494 503) (375 385 -25 9)
	       (388 406 9 740)				;GND right for tying through diff
	       (113 126 22 26) (122 126 26 29)		;GND top middle
	       (370 374 435 460) (126 370 452 459)	;GND lower right
	       (122 126 435 438) (117 126 438 483)	;GND lower middle...
	       (113 119 438 442) (0 119 476 483)))

(layout pla-gnd-cuts-cell (0 14) =
	(cuts (2 2 S) (6 2 S) (2 9 S) (6 9 S) (2 16 S) (6 16 S) (2 23 S) (6 23 S)))

(define pla-gnd-cuts
	(do ((y 0 (+ y 2)))
	    ((= y 24))
	    (call pla-gnd-cuts-cell (trans 0 (+ -29 (* y -14))))))

(layout pla-flash (4 4) = (diff (0 4 0 4)))

(define eval-pla-and-column-cell
	(call 199 (mirror y) (trans 0 -29))		;SteelePlaGround
	(do ((y 0 (+ y 1))
	     (maxy (// (+ 2 (get 'eval 'maxindex)) 2)))
	    ((= y maxy)
	     (call 14 (trans 0 (+ -29 (* -14 maxy)))))	;PlaGround
	    (call 11 (trans 0 (+ -29 (* y -14))))))	;PlaCellPair

(defun eval-pla-and-column (bitname parity xorg yorg)	;parity = nil for left of PlaInPair
       (call eval-pla-and-column-cell (trans xorg yorg))
       (do ((y 0 (+ y 1))
	    (bitfield (get bitname 'eval))
	    (maxy (// (+ 2 (get 'eval 'maxindex)) 2)))
	   ((= y maxy))
	   (let ((bit0 (not (zerop (boole 1 bitfield (arraycall t eval (* y 2))))))
		 (bit1 (not (zerop (boole 1 bitfield (arraycall t eval (+ (* y 2) 1)))))))
		(cond ((or (and bit0 parity) (and (not bit0) (not parity)))
		       (call pla-flash (trans (+ xorg 4)
					      (+ yorg -29 (* y -14) -9))))
		      (t (call pla-flash (trans (+ xorg 10)
						(+ yorg -29 (* y -14) -9)))))
		(cond ((or (and bit1 parity) (and (not bit1) (not parity)))
		       (call pla-flash (trans (+ xorg 4)
					      (+ yorg -29 (* y -14) -2))))
		      (t (call pla-flash (trans (+ xorg 10)
						(+ yorg -29 (* y -14) -2))))))))

(layout pla-or-0001-flash (14 14) = (diff (8 12 4 8)))
(layout pla-or-0010-flash (14 14) = (diff (8 12 10 14)))
(layout pla-or-0011-flash (14 14) = (diff (8 12 10 14) (8 12 4 8)))
(layout pla-or-0100-flash (14 14) = (diff (1 5 4 8)))
(layout pla-or-0101-flash (14 14) = (diff (1 5 4 8) (8 12 4 8)))
(layout pla-or-0110-flash (14 14) = (diff (1 5 4 8) (8 12 10 14)))
(layout pla-or-0111-flash (14 14) = (diff  (1 5 4 8) (8 12 10 14) (8 12 4 8)))
(layout pla-or-1000-flash (14 14) = (diff (1 5 10 14)))
(layout pla-or-1001-flash (14 14) = (diff (1 5 10 14) (8 12 4 8)))
(layout pla-or-1010-flash (14 14) = (diff (1 5 10 14) (8 12 10 14)))
(layout pla-or-1011-flash (14 14) = (diff (1 5 10 14) (8 12 10 14) (8 12 4 8)))
(layout pla-or-1100-flash (14 14) = (diff (1 5 10 14) (1 5 4 8)))
(layout pla-or-1101-flash (14 14) = (diff (1 5 10 14) (1 5 4 8) (8 12 4 8)))
(layout pla-or-1110-flash (14 14) = (diff (1 5 10 14) (1 5 4 8) (8 12 10 14)))
(layout pla-or-1111-flash (14 14) = (diff (1 5 10 14) (1 5 4 8) (8 12 10 14) (8 12 4 8)))

(define eval-pla-or-column-cell
	(call 12 (rotate 0 -1) (trans 14 0))		;PullupPair
	(do ((y 0 (+ y 1))
	     (maxy (// (+ 2 (get 'eval 'maxindex)) 2)))
	    ((= y maxy)
	     (call 17 (trans 0 (+ -29 (* -14 maxy)))))	;PlaOut
	    (call 11 (rotate 0 -1)
		  (trans 14 (+ -29 (* y -14))))))	;PlaCellPair

(defun eval-pla-or-column (bitname0 bitname1 xorg yorg)
       (call eval-pla-or-column-cell (trans xorg yorg))
       (do ((y 0 (+ y 1))
	    (bitfield0 (get (mostcar bitname0) 'eval))
	    (bitfield1 (get (mostcar bitname1) 'eval))
	    (maxy (// (+ 2 (get 'eval 'maxindex)) 2)))
	   ((= y maxy))
	   (let ((bit00 (xor (atom bitname0)
			     (zerop (boole 1 bitfield0 (arraycall t eval (* y 2))))))
		 (bit01 (xor (atom bitname0)
			     (zerop (boole 1 bitfield0 (arraycall t eval (+ (* y 2) 1))))))
		 (bit10 (xor (atom bitname0)
			     (zerop (boole 1 bitfield1 (arraycall t eval (* y 2))))))
		 (bit11 (xor (atom bitname0)
			     (zerop (boole 1 bitfield1 (arraycall t eval (+ (* y 2) 1)))))))
		(and (not bit00) (not bit01) (not bit10) bit11 
		     (call pla-or-0001-flash (trans xorg (+ yorg (* y -14) -29))))
		(and (not bit00) (not bit01) bit10 (not bit11) 
		     (call pla-or-0010-flash (trans xorg (+ yorg (* y -14) -29))))
		(and (not bit00) (not bit01) bit10 bit11 
		     (call pla-or-0011-flash (trans xorg (+ yorg (* y -14) -29))))
		(and (not bit00) bit01 (not bit10) (not bit11) 
		     (call pla-or-0100-flash (trans xorg (+ yorg (* y -14) -29))))
		(and (not bit00) bit01 (not bit10) bit11 
		     (call pla-or-0101-flash (trans xorg (+ yorg (* y -14) -29))))
		(and (not bit00) bit01 bit10 (not bit11) 
		     (call pla-or-0110-flash (trans xorg (+ yorg (* y -14) -29))))
		(and (not bit00) bit01 bit10 bit11 
		     (call pla-or-0111-flash (trans xorg (+ yorg (* y -14) -29))))
		(and bit00 (not bit01) (not bit10) (not bit11) 
		     (call pla-or-1000-flash (trans xorg (+ yorg (* y -14) -29))))
		(and bit00 (not bit01) (not bit10) bit11 
		     (call pla-or-1001-flash (trans xorg (+ yorg (* y -14) -29))))
		(and bit00 (not bit01) bit10 (not bit11) 
		     (call pla-or-1010-flash (trans xorg (+ yorg (* y -14) -29))))
		(and bit00 (not bit01) bit10 bit11 
		     (call pla-or-1011-flash (trans xorg (+ yorg (* y -14) -29))))
		(and bit00 bit01 (not bit10) (not bit11) 
		     (call pla-or-1100-flash (trans xorg (+ yorg (* y -14) -29))))
		(and bit00 bit01 (not bit10) bit11 
		     (call pla-or-1101-flash (trans xorg (+ yorg (* y -14) -29))))
		(and bit00 bit01 bit10 (not bit11) 
		     (call pla-or-1110-flash (trans xorg (+ yorg (* y -14) -29))))
		(and bit00 bit01 bit10 bit11
		     (call pla-or-1111-flash (trans xorg (+ yorg (* y -14) -29)))))))

(define eval-pla
	(let ((maxy (// (+ 2 (get 'eval 'maxindex)) 2)))
	     (call eval-probe-mux
		   (mirror y)
		   (trans (+ 29 (* 14 6) 16)
			  (+ -29 (* maxy -14) -68 -121)))
	     (call eval-pla-random-metal)
	     (call pla-gnd-cuts (trans 388 0))
	     (call eval-state-dispatch (mirror y)
		   (trans 16 (+ -29 (* maxy -14) -10 -53 -222 29)))
	     (call state-merge (mirror y) (trans 2 (+ -29 (* maxy -14) -10 -53 -222)))
	     (call eval-state-merge-randomness
		   (mirror y) (trans 2 (+ -29 (* maxy -14) -10 -53 -222)))
	     (do ((y 0 (+ y 1)))
		 ((= y maxy))
		 (call 12 (trans 0 (+ -29 (* y -14)))))	;AND PullupPairs
	     (do ((x 0 (+ x 1))
		  (z '(eostate5 eostate4 eostate3 eostate2 eostate1 eostate0) (cdr z)))
		 ((= x 6))
		 (eval-pla-and-column (car z) (oddp x) (+ 29 (* x 14)) 0))
	     (do ((x 0 (+ x 2)))
		 ((= x 6))
		 (call 16 (trans (+ 44 (* x 14)) (+ -29 -10 (* -14 maxy)))))	;PlaInPair
	     (do ((y 0 (+ y 1)))
		 ((= y maxy))
		 (call 13 (trans (+ 29 (* 14 6)) (+ -29 (* y -14)))))	;PlaConnect
	     (do ((x 0 (+ x 1))
		  (z '(enstate0 eostate0 enstate1 eostate1 enstate2 eostate2
				(enstate3) eostate3 (enstate4) eostate4 (enstate5) eostate5
				et-disp eaz-etz-eqv-disp ldx rdx rdx+ ldv rdv
				ldn rdn ldl rdl ldc rdc ea-lit et-lit lit0 lit1 lit2
				gcop0 gcop1 gcop2 gcop3)
		     (cddr z)))
		 ((= x 17))
		 (eval-pla-or-column (car z) (cadr z) (+ 29 (* 14 6) 16 (* x 14)) 0))
	     (do ((y 0 (+ y 1)))
		 ((= y maxy))
		 (call 199 (mirror y) (rotate 0 -1)
		       (trans (+ 29 (* 14 6) 16 (* 17 14))
			      (+ -29 (* y -14)))))))		;SteelePlaGround

