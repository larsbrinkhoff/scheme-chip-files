(define probe-control
	(call probe-control-randomness)
	(call probe-control-pullup-set (trans 920 -1230))
	(do ((y 0 (+ y 1)))
	    ((= y 3))
	    (call probe-control-inverter-vdd (trans (- 1002 15) (+ -978 (* y -80)))))
	(call probe-control-inverter (trans (- 1002 15) -988))
	(call probe-control-inverter (trans (- 1002 15) -1060))
	(call probe-control-inverter (trans (- 1002 15) -1140))
	(call probe-control-prog-flash (mirror x) (trans 936 -1034))
	(call probe-control-prog-flash (trans 936 -1018))
	(call probe-control-prog-flash (mirror x) (trans 955 -1034))
	(call probe-control-prog-flash (trans 955 -1018))
