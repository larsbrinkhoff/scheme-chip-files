(define leftpads
	(call leftpads-connect (trans 124 18))
	(call small-gnd-pad (trans 34 0))
	(do ((y 0 (+ y 1)))
	    ((= y 15)
	     (call small-vdd-pad (rotate 0 1) (trans 0 (- (* y -80) 86))))
	    (call small-input-pad (rotate 0 1) (trans 0 (- (* y -80) 86)))))

(comment origin of rightpads is at upper *right*)

