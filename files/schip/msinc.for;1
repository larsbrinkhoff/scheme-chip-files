C
C     PROGRAM MSINC  Version A4
C	Provided by Dan Cohen (ISIB) on 11/17/77
C
C     .... A MODULAR SIMULATOR FOR INTEGRATED NONLINEAR CIRCUITS
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      COMMON /STORE/ LQ(100,4),LD(100,2),LC(10,2),XALU(100),LCL(10),
     1 LVL(10),LDI(100,2),TC1(100),TC2(100),TEMPE(10),NTMP,KTMP
      COMMON /PLOTS/ PMIN(6),PMAX(6),FSTR,FSTP,
     1 NP(2,4,6),NPLT,NPTS,NHAR,KPLO(4,6),NPVAL(6),NAMP(4,6)
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,ICONV,
     1 ICHAR,QQDUM
      COMMON /JOBCNT/ TITLE(9),PRGVER,NALTR,IREQ,ISTOP
      LOGICAL ICHAR,IREQ,ISTOP,MFLG,NEND,INEW
      REAL*4 DAY(3)
      DATA PRGVR/3HA4 /
      PRGVER=PRGVR
C ****************************************************************
C	Following modifications were made to let file names come
C	from the user.  User should type 5-char
C	main name only.  Extension will always be .DAT
      I5=20
      J6=21
	TYPE 920
	ACCEPT 930,IIFILE
	TYPE 921
	ACCEPT 930,IOFILE
	CALL OFILE(J6, IOFILE)
	CALL IFILE(I5, IIFILE)
920	FORMAT(' Input file name: ')
921	FORMAT(' Output file name: ')
930	FORMAT(A5)
C ****************************************************************
C
C.... PRESET ALTER COUNT AND FLAG
      NALTR=0
C
C.... GET PROGRAM STARTING TIME
 100  IF (NALTR.NE.0) GO TO 120
      CALL CLKST(INIT)
      ISTOP=.FALSE.
C
C.... READ AND PRINT TITLE
105   READ(I5,900,END=800) TITLE
C.... STANFORD CLOCK ROUTINE
110	CALL DATE(QDATE)
	CALL TIME(QTIME)
      WRITE (J6,905) PRGVER,QDATE,QTIME,DAY,TITLE
C
C     ... READ CIRCUIT DATA
120   ISTOP=.FALSE.
      CALL READIN
      IF (.NOT.ISTOP) GO TO 200
      WRITE (J6,1130)
      GO TO 999
C
C     ... INITIALIZE CIRCUIT
 200  IF (NALTR.GT.3) GO TO 999
      CALL CLKRD(INIT)
      CALL INITL
      IF (ISTOP) GO TO 999
C
C     ... PERFORM CIRCUIT ANALYSIS
250   DO 260 KTMP=1,NTMP
      CALL CLKRD(INIT)
      IF (TEMPE(KTMP).LT.100.) GO TO 260
C
C     ... CALCULATE DC SOLUTION
      CALL DCSOL
      IF (ISTOP) GO TO 260
      IF (TMAX.EQ.0.) GO TO 260
      CALL CLKRD(INIT)
C
C     ... PERFORM TRANSIENT ANALYSIS
      CALL CONTL
C
C     ... PRINT PLOTS IF REQUESTED
      IF (NPLT.EQ.0) GO TO 260
      CALL CLKRD(INIT)
      CALL PLOT
260   CONTINUE
C
C.... CALCULATE AND PRINT RUN TIME
 999  CALL CLKRD(INIT)
      GO TO 100
  800 CONTINUE
      RETURN
C
900   FORMAT (9A8)
901   FORMAT (8A1)
 905  FORMAT (1H1/1H1,13H- M S I N C -,2X,5HVER. ,A3,3X,A9,2X,A5,3X,3A4,
     1 ///1X9A8///1X,90(1HX)//)
 1130 FORMAT (1X,28H****DATA ERROR - JOB ABORTED)
      END
      SUBROUTINE CONTL
C
C     .... SUBROUTINE TO CONTROL TRANSIENT CIRCUIT ANALYSIS
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON Y(600),YL(600),YV(200),YC(200),YD(250),V(250),VCUR(10),
     1   V1(250),VPI(250),
     1 VGS(100),VDS(100),VSB(100),CDS(100),VPPL(250),V2(250)
      COMMON/PRINT/PLTP(4,200,6),BCUR(100),PCUR(100),OUPUT(10),VSLP(10),
     1 CSLP(10)
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1 ITR,IND,IBUG
      COMMON /NODES/ NREN(100),LNOD,NX,MDIM,NNOD,NUT,NLT,NVT
      COMMON /ELMTS/ KIND(100),ND(100,4),VALU(100),NELT
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1 VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
      COMMON /CSRCE/ CSRC(10),CLSRC(10),NAMC(10),TCUR(10,10),
     1 CVAL(10,10),NCVAL(10),KCUR(10),NCS(10,2),NCSC
      COMMON /PLOTS/ PMIN(6),PMAX(6),FSTR,FSTP,
     1 NP(2,4,6),NPLT,NPTS,NHAR,KPLO(4,6),NPVAL(6),NAMP(4,6)
      COMMON /OUTPT/ KOUT(10),NAMO(10),NODO(10,2),NOUT
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,ICONV,
     1   ICHAR,JTER
      COMMON /JOBCNT/ TITLE(9),PRGVER,NALTR,IREQ,ISTOP
      LOGICAL IBUG,ICHAR,IREQ,ISTOP
      DIMENSION SCAL(5)
      DATA SCAL/8H        ,8HMILLI   ,8HMICRO   ,8HNANO     ,8HPICO    /
C
C     ... START TRANSIENT ANALYSIS
      IF (NOUT.EQ.0) GO TO 130
      WRITE (J6,900) TITLE,PRGVER
C
C.... GET SCALING FACTOR FOR TIME
      IEXP=-(DLOG10(TMAX)+0.0001)
      IEXP=(IEXP+6)/3
      IF  (TMAX.GE.1.) IEXP=1
      IF (IEXP.GT.5) IEXP=5
      FACTOR=1000.**(IEXP-1)
      WRITE (J6,905) SCAL(IEXP)
      WRITE (J6,910) (NAMO(I),I=1,NOUT)
C     WRITE (J6,920) ((NODO(I,J),J=1,2),I=1,NOUT)
      WRITE (J6,930)
C
C.... INITIALIZE TIME VALUES
  130 QTIME=0.
      TIMP=-DPRT
      TPRT=0.
      DELT=0.
      DELA=DPRT
      DELIM=DPRT/2**16
      NPTS=0
      ITER=0
      JTER=0
      ITRLIM=10
      DO 132 I=1,NVSC
      VSLP(I)=0.0
  132 NVVAL(I)=0
      DO 135 I=1,NCSC
      CSLP(I)=0.0
      CLSRC(I)=0.0
  135 NCVAL(I)=0
      DO 136 I=1,NELT
  136 PCUR(I)=0.0
      DO 137 I=1,NNOD
      VOL=V(I)
      V1(I)=VOL
      V2(I)=VOL
      VPI(I)=VOL
      VPPL(I)=VOL
 137  CONTINUE
C
C.... PRINT OUTPUT IF TIME IS SPECIFIED
  140 IF (QTIME.LT.TPRT) GO TO 175
      RATIO=(TPRT-TIMP)/(QTIME-TIMP)
      IF (NOUT.EQ.0) GO TO 164
      DO 160 I=1,NOUT
      IF (KOUT(I)) 155,145,150
C.... VOLTAGE OUTPUT
  145 N1=NODO(I,1)+1
      N2=NODO(I,2)+1
      N1=NREN(N1)
      N2=NREN(N2)
      OUT1=VPI(N1)-VPI(N2)
      OUT2=V(N1)-V(N2)
      OUPUT(I)=(OUT2-OUT1)*RATIO+OUT1
      GO TO 160
C.... CURRENT OUTPUT ACROSS ELEMENT
  150 N=KOUT(I)
      OUT1=PCUR(N)
      OUT2=BCUR(N)
      OUPUT(I)=((OUT2-OUT1)*RATIO+OUT1)*1.0E3
      GO TO 160
C.... CURRENT OUTPUT ACROSS C-SOURCE
  155 N=-KOUT(I)
      OUT1=CLSRC(N)
      OUT2=CSRC(N)
      OUPUT(I)=((OUT2-OUT1)*RATIO+OUT1)*1.0E3
  160 CONTINUE
      TOUT=TPRT*FACTOR
      WRITE(J6,930) TOUT,(OUPUT(I),I=1,NOUT)
C
C.... STORE PLOT DATA
  164 IF (NPLT.EQ.0) GO TO 170
      NPTS=NPTS+1
      IF (NPTS.GT.200) GO TO 170
      DO 169 K=1,NPLT
      N=NPVAL(K)
      DO 168 I=1,N
      IF (.NOT.ICHAR) GO TO 163
      N1=NP(1,I,K)
      PLTP(I,NPTS,K)=VLSRC(N1)
      GO TO 168
  163 IF (KPLO(I,K)) 167,165,166
C.... VOLTAGE OUTPUT PLOT
  165 N1=NP(1,I,K)+1
      N2=NP(2,I,K)+1
      N1=NREN(N1)
      N2=NREN(N2)
      OUT1=VPI(N1)-VPI(N2)
      OUT2=V(N1)-V(N2)
      PLTP(I,NPTS,K)=(OUT2-OUT1)*RATIO+OUT1
      GO TO 168
C.... CURRENT OUTPUT PLOT
  166 KP=KPLO(I,K)
      OUT1=PCUR(KP)
      OUT2=BCUR(KP)
      PLTP(I,NPTS,K)=((OUT2-OUT1)*RATIO+OUT1)*1.0E3
      GO TO 168
C.... CURRENT OUT ACROSS C-SOURCE
  167 KP=-KPLO(I,K)
      OUT1=CLSRC(KP)
      OUT2=CSRC(KP)
      PLTP(I,NPTS,K)=((OUT2-OUT1)*RATIO+OUT1)*1.0E3
  168 CONTINUE
  169 CONTINUE
C
C.... ADVANCE OUTPUT TIME
  170 TPRT=TPRT+DPRT
      IF (TPRT.GT.TMAX) GO TO 550
      GO TO 140
C
C
C.... GET TIME-STEP SIZE
C
C.... ADJUSTMENT MADE DUE TO BREAKPOINTS
  175 IF (DELT.GE.DELA) GO TO 180
      DELT=DPRT
      GO TO 185
C.... CUTS DUE TO NON CONVERGENCE
  180 IF (DELT.LT.DELP) GO TO 185
C.... ADJUST TIME-STEP SIZE
      IF (ICHAR) GO TO 185
      JTER=JTER-1
      IF (JTER.GT.0) GO TO 185
      IF (ITR.GT.6) GO TO 185
      DELT=DELT+DELT
      ITRLIM=10
      IF (ITR.LE.3) DELT=DELT+DELT
      IF (DELT.GT.4*DPRT) DELT=4*DPRT
C
C.... GET NEXT TIME
  185 TIMP=QTIME
      QTIME=QTIME+DELT
      DELP=DELA
      DELA=DELT
C     ITRLIM=15
C     DO 195 I=1,NNOD
C 195 VPI(I)=V(I)
C
C.... ADJUST TIME FOR BREAKPOINTS
  200 IF (NVSC.EQ.0) GO TO 280
      DO 250 I=1,NVSC
      IF (KVOL(I).NE.1) GO TO 250
      N=NVVAL(I)
      IF (TIMP.LT.TVLT(N+1,I)) GO TO 210
      N=N+1
      NVVAL(I)=N
      VSLP(I)=(VVAL(N+1,I)-VVAL(N,I))/(TVLT(N+1,I)-TVLT(N,I))
  210 IF (QTIME.LE.TVLT(N+1,I)) GO TO 250
      QTIME=TVLT(N+1,I)
      DELT=QTIME-TIMP
  250 CONTINUE
C
  280 IF (NCSC.EQ.0) GO TO 400
      DO 330 I=1,NCSC
      IF (KCUR(I).NE.1) GO TO 330
      N=NCVAL(I)
      IF (TIMP.LT.TCUR(N+1,I)) GO TO 300
      N=N+1
      NCVAL(I)=N
      CSLP(I)=(CVAL(N+1,I)-CVAL(N,I))/(TCUR(N+1,I)-TCUR(N,I))
  300 IF (QTIME.LE.TCUR(N+1,I)) GO TO 330
      QTIME=TCUR(N+1,I)
      DELT=QTIME-TIMP
  330 CONTINUE
C
C     UPDATE VOLTAGE VECTORS
C
 400  DO 410 I=1,NNOD
      VTM2=VPI(I)
      VTM1=V(I)
      VPI(I)=VTM1
      VTM1=VTM1+(VTM1-VTM2)*DELT/DELP
      VPPL(I)=VTM2
      V2(I)=VTM1
      V1(I)=VTM1
      V(I)=VTM1
 410  CONTINUE
C
C.... CALCULATE NEW VOLTAGE VALUES
      ITR=0
      CALL TIMSOL(ITRLIM)
      IF (ICONV.EQ.1) GO TO 140
C
C.... NO CONVERGENCE, ADJUST TIME AND RETRY
      DELT=DELA
      IF (DELT.LE.DELIM) GO TO 460
      DELT=DELT/2**3
      JTER=8
      IF (DELT.GT.DELIM) GO TO 440
      DELT=DELIM
      ITRLIM=100
  440 DELA=DELT
      QTIME=TIMP+DELT
      DO 450 I=1,NNOD
      V(I)=VPI(I)
  450 VPI(I)=VPPL(I)
      GO TO 200
C
C.... NO SOLUTION
C
 460  IF (IBUG) GO TO 550
      IBUG=.TRUE.
      WRITE (J6,970)
      GO TO 440
C
550   WRITE (J6,980) ITER
      IBUG=.FALSE.
 999  RETURN
C
 900  FORMAT (1H1,9A8,8X,6HMSINC-,A3/)
  905 FORMAT (/' TIME IN ',A5,'-SECONDS')
910   FORMAT (/5X,4HTIME,1X,9(9X,A4))
920   FORMAT (10X,9(7X,2I3))
930   FORMAT (1X,F11.3,1X,9F13.3)
940   FORMAT (//1X,36H****UNSTABLE SOLUTION - RECHECK DATA/)
950   FORMAT (1X,20H**SOLUTION NOT EXACT)
 970  FORMAT (//1X,29H****UNSTABLE SOLUTION - ABORT/)
980   FORMAT(//1X,'TOTAL NEWTON ITER.=',I5/)
      END
      SUBROUTINE DCSOL
C
C     .... SUBROUTINE TO CALCULATE THE DC OPERATING POINT
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON Y(600),YL(600),YV(200),YC(200),YD(250),V(250),VCUR(10),
     1 V1(250),VPI(250),
     1 VGS(100),VDS(100),VSB(100),CDS(100),VPPL(250),V2(250)
      COMMON/PRINT/PLTP(4,200,6),BCUR(100),PCUR(100),OUPUT(10),VSLP(10),
     1 CSLP(10)
      COMMON /NODES/ NREN(100),LNOD,NX,MDIM,NNOD,NUT,NLT,NVT
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1 ITR,IND,IBUG
      COMMON /ELMTS/ KIND(100),ND(100,4),VALU(100),NELT
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1 VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
      COMMON /CSRCE/ CSRC(10),CLSRC(10),NAMC(10),TCUR(10,10),
     1 CVAL(10,10),NCVAL(10),KCUR(10),NCS(10,2),NCSC
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,ICONV,ICHAR
      COMMON /NAMES/ NAME(100),NAMQ(100),MODN(100),NAMB(30),NMOD
      COMMON /STORE/ LQ(100,4),LD(100,2),LC(10,2),XALU(100),LCL(10),
     1 LVL(10),LDI(100,2),TC1(100),TC2(100),TEMPE(10),NTMP,KTMP
      COMMON /DIODE/ NAMD(100),VALD(100,4),NDI(100,4),VDIO(100),
     1   CDIO(100),NDIOD,DUMMY(9)
      COMMON /GAIN/ K1,K2,K3,K4,K10
      COMMON /JOBCNT/ TITLE(9),PRGVER,KBREF,IREQ,ISTOP
      COMMON /START/ VVOL(100),INI,IDC
      LOGICAL IBUG,ICHAR,IREQ,ISTOP,INI,IDC
      DIMENSION NDM(4),VDM(4)
      DATA LPAR /1H(/
      DATA KBL,KPP /1HN,1HP/
C
      IF (NELT.EQ.0) GO TO 125
      DO 120 I=1,NELT
      DT=TEMPE(KTMP)-TEMPE(1)
      TEMF=1.+DT*(TC1(I)+DT*TC2(I))
      IF (KIND(I)-2) 105,110,115
105   VALU(I)=1./(XALU(I)*TEMF)
      GO TO 120
110   VALU(I)=(XALU(I)+XALU(I))*TEMF
      GO TO 120
115   VALU(I)=.5/(XALU(I)*TEMF)
120   CONTINUE
125   N1=LNOD+1
      DO 130 I=1,N1
      J=NREN(I)
      IF (J.EQ.0) GO TO 130
      VV=VVOL(I)
      V1(J)=VV
      V2(J)=VV
      V (J)=VV
130   CONTINUE
      IF (NVSC.EQ.0) GO TO 145
      DO 140 I=1,NVSC
      IF (KVOL(I).EQ.2) GO TO 135
      VV=VVAL(1,I)
      GO TO 137
135   VV=VVAL(1,I)*DSIN(VVAL(3,I))+VVAL(4,I)
137   VSRC(I)=VV
      V(MDIM+I)=VV
      V1(MDIM+I)=VV
      V2(MDIM+I)=VV
140   CONTINUE
145   IF (NCSC.EQ.0) GO TO 160
      DO 155 I=1,NCSC
      IF (KCUR(I).EQ.2) GO TO 150
      CSRC(I)=CVAL(1,I)
      GO TO 155
150   CSRC(I)=CVAL(1,I)*DSIN(CVAL(3,I))
155   CONTINUE
160   ICONV=1
      IND=0
      IF (IDC) GO TO 235
C
C     .... ITERATE TO SOLUTION
      DO 225 ITER=1,100
      ITR=ITER-1
C
C     ... CLEAR MATRIX AND UPDATE VOLTAGES
      DO 175 I=1,NUT
175   Y(I)=0.0
      DO 180 I=1,NLT
180   YL(I)=0.0
      DO 185 I=1,NVT
      YC(I)=0.0
185   YV(I)=0.0
      DO 190 I=1,NNOD
190   YD(I)=0.0
C
      DO 194 I=1,NNOD
      VV=V(I)
      VV1=V1(I)
      VV2=V2(I)
      DVV=VV-VV1
      AVV=DABS(DVV)
      IF (AVV.LT.TOLER) GO TO 192
      ICONV=0
      IF (AVV.LT.2D0) GO TO 192
      VV=VV1+2D0
      IF (DVV.LT.0D0) VV=VV1-2D0
 192  IF (DABS(VV-VV2).LT.5D-7) VV=(VV+VV1)/2D0
      V2(I)=VV1
      V1(I)=VV
      V(I)=0D0
 194  CONTINUE
C
C     .... ADD RESISTORS AND INDUCTORS TO MATRIX
      IF (NELT.EQ.0) GO TO 210
      DO 205 I=1,NELT
      IF (KIND(I).EQ.2) GO TO 205
      N1=ND(I,1)
      N2=ND(I,2)
      N3=ND(I,3)
      N4=ND(I,4)
      IF (KIND(I).EQ.1) GO TO 195
C     ... INDUCTOR - 1 OHM RESISTANCE
      G=1.0
      GO TO 200
C     ... RESISTOR
195   G=VALU(I)
200   YD(N1)=YD(N1)+G
      YD(N2)=YD(N2)+G
      Y(N3)=Y(N3)-G
      Y(N4)=Y(N4)-G
205   CONTINUE
C
C     ... ADD TRANSISTORS
210   CALL CKTMOD (0)
      CALL DIMOD(0)
      IND=1
      IF (NCSC.EQ.0) GO TO 214
      DO 212 I=1,NCSC
      N1=NCS(I,1)
      N2=NCS(I,2)
      V(N1)=V(N1)-CSRC(I)
  212 V(N2)=V(N2)+CSRC(I)
  214 CONTINUE
C
C     .... SOLVE FOR NEW VOLTAGES
      CALL SOLUTN
C
C     .... CHECK FOR CONVERGENCE
      IF (ICONV.EQ.0) GO TO 220
      IF (ITR.EQ.0) GO TO 220
      DO 215 I=1,MDIM
      IF(DABS(V(I)-V1(I)).GT.TOLER) GO TO 220
215   CONTINUE
      ICONV=ICONV+1
      IF (ICONV-2) 225,225,235
220   ICONV=1
225   CONTINUE
C
C     .... ITERATION LIMIT EXCEEDED - PRINT FINAL VALUES
      WRITE (J6,260)
      DO 232 N=2,LNOD
      N1=N-1
      I=NREN(N)
      IF (I.EQ.0) GO TO 232
      PCTERR=0.
      IF (V(I).EQ.0.) GO TO 230
      PCTERR=DABS((V1(I)-V(I))/V(I))*100.
230   WRITE (J6,265) N1,V(I),PCTERR
232   CONTINUE
      ISTOP=.TRUE.
      RETURN
C
C     .... CONVERGENCE OBTAINED - CALCULATE BRANCH CURRENTS
235   IF (NELT.EQ.0) GO TO 255
      DO 250 I=1,NELT
      IF (KIND(I).EQ.2) GO TO 245
      N1=ND(I,1)
      N2=ND(I,2)
      IF (KIND(I).EQ.1) GO TO 240
C     ... OBTAIN INDUCTOR CURRENT
      BCUR(I)=V(N1)-V(N2)
      GO TO 250
C     .... CALCULATE RESISTOR CURRENT
240   BCUR(I)=(V(N1)-V(N2))*VALU(I)
      GO TO 250
C     .... ZERO CAPACITOR CURRENT
245   BCUR(I)=0.
250   CONTINUE
C
C     ... PRINT NODE VOLTAGES
255   N=0
      WRITE (J6,270) TITLE,PRGVER
      WRITE (J6,275) TEMPE(KTMP),ITER
300   DO 310 K=1,4
305   N=N+1
      IF (N.GT.LNOD) GO TO 315
      I=NREN(N)
      IF (I.EQ.0) GO TO 305
      NDM(K)=N-1
      VDM(K)=V(I)
310   CONTINUE
      K=5
315   K1=K-1
      IF (K1.EQ.0) GO TO 350
      WRITE (J6,280) (LPAR,NDM(K),VDM(K),K=1,K1)
      IF (N.LT.LNOD) GO TO 300
C
C     ... PRINT TRANSISTOR AND RESISTOR CURRENTS
350   IF (NXTR.EQ.0) GO TO 370
      WRITE (J6,940)
      DO 365 N=1,NXTR
      PGS=VGS(N)
      PDS=VDS(N)
      PSB=VSB(N)
      CC =CDS(N)
      NTP=KBL
      IF (NQ(N,23).NE.0) GO TO 360
      PGS=-PGS
      PDS=-PDS
      PSB=-PSB
      NTP=KPP
360   WRITE (J6,945) NAMQ(N),NTP,PGS,PDS,PSB,CC
365   CONTINUE
C
C     ... CALCULATE CURRENTS AN POWER
C
370   IF (NELT.EQ.0) GO TO 390
      DO 373 N=1,NELT
      IF (KIND(N).NE.2) GO TO 377
  373 CONTINUE
      GO TO 390
  377 WRITE (J6,950)
      DO 380 N=1,NELT
      IF (KIND(N).EQ.2) GO TO 380
      N1=ND(N,1)
      N2=ND(N,2)
      CURR=BCUR(N)*1.E3
      RPW=CURR*(V(N1)-V(N2))
      WRITE (J6,955) NAME(N),CURR,RPW
380   CONTINUE
390   IF (NDIOD.EQ.0) GO TO 400
      WRITE (J6,960)
      DO 395 N=1,NDIOD
      N1=NDI(N,1)
      N2=NDI(N,2)
      CURR=CDIO(N)*1.E3
      DPW=CURR*(V(N1)-V(N2))
      WRITE (J6,955) NAMD(N),CURR,DPW
395   CONTINUE
C
400   PWR=0.0
      IF (NVSC.EQ.0) GO TO 440
      CALL CCAL
      WRITE (J6,970)
      DO 430 I=1,NVSC
      CURR=VCUR(I)*1.E3
      WRITE (J6,955) NAMV(I),CURR
      PWR=PWR-CURR*VSRC(I)
430   CONTINUE
440   IF (NCSC.EQ.0) GO TO 460
      DO 450 N=1,NCSC
      N1=NCS(N,1)
      N2=NCS(N,2)
      PWR=PWR-CSRC(N)*1.E3*(V(N1)-V(N2))
450   CONTINUE
460   WRITE (J6,975) PWR
C
C     ... PERFORM SMAL SIGNAL ANALYSIS
      IF (K10.LT.0) RETURN
      DO 505 I=1,NNOD
      V1(I)=V(I)
505   V(I)=0.0
      N1=NREN(K1+1)
      N2=NREN(K2+1)
      N3=NREN(K3+1)
      N4=NREN(K4+1)
      IF (NVSC.EQ.0) GO TO 540
      DO 520 N=1,NVSC
      VSLP(N)=VSRC(N)
      VSRC(N)=0.0
      IF (NV(N,1).EQ.K2) GO TO 510
      IF (NV(N,1).NE.K1) GO TO 520
      VSRC(N)=1.0
      GO TO 515
510   VSRC(N)=-1.0
515   K10=K10+1
520   CONTINUE
      IF (K10.EQ.0) GO TO 540
      CALL SOLV
      CALL CCAL
      RIN=0.0
      DO 530 N=1,NVSC
      IF (VSRC(N).EQ.0.0) GO TO 530
      RIN=RIN-VSRC(N)/VCUR(N)
530   VSRC(N)=VSLP(N)
      AV=(V(N3)-V(N4))/(V(N1)-V(N2))
      RM=AV*RIN
      GO TO 550
540   V(N1)=1.0
      V(N2)=-1.0
      NSAVE=NVSC
      NVSC=0
      CALL SOLV
      NVSC=NSAVE
      RIN=V(N1)-V(N2)
      RM=V(N3)-V(N4)
      AV=RM/RIN
      IF (NVSC.EQ.0) GO TO 550
      DO 545 N=1,NVSC
545   VSRC(N)=VSLP(N)
550   WRITE (J6,980) K1,K2,K3,K4,K10
      WRITE (J6,985) RIN,RM,AV
      DO 560 I=1,NNOD
560   V(I)=V1(I)
      RETURN
C
C
260   FORMAT (/1X,35HNO CONVERGENCE AFTER 100 ITERATIONS/1X,35(1H*)//
     1 1X,4HNODE,8X,7HVOLTAGE,4X,14HPER CENT ERROR/)
265   FORMAT (1X,I3,F16.9,F15.7)
270   FORMAT (1H1,9A8,8X,6HMSINC-,A3)
275   FORMAT (/1X,6HTEMP =,F9.2//1X,14HNO. OF ITER. =,I4//1X,
     1 16HNODE VOLTAGES --)
280   FORMAT (2X,4(A1,I2,1H),F11.4,4X))
940   FORMAT (//1X,21HTRANSISTOR OP. PT. --/1X,7HNAME TP,7X,7HVGS    ,
     1 10X,3HVDS,14X,3HVSB,14X,7HIDS(MA))
945   FORMAT (1X,A5,A2,1X,4F17.4)
950   FORMAT (//1X,20HRESISTOR CURRENTS --/1X,4HNAME,4X,12HCURRENT (MA),
     1 6X,10HPOWER (MW))
955   FORMAT (1X,A5,2X,F15.9,F17.8)
960   FORMAT(//1X,17HDIODE CURRENTS --/1X,4HNAME,4X,12HCURRENT (MA),
     1 6X,10HPOWER (MW))
970   FORMAT (//,' VOLTAGE SOURCE CURRENTS --'/' NAME',4X,
     1 'CURRENT(MA)')
975   FORMAT (//,' TOTAL POWER (MW) =',F12.4/)
980   FORMAT (//,' SMALL-SIGNAL GAIN **',4I4,I6)
985   FORMAT (/' RIN =',1PE12.4,3X,'RM =',1PE12.4,3X,'AV =',1PE12.4//)
      END
      SUBROUTINE DIMOD(MODE)
C
C.... SET UP THE EQUIVALENT CIRCUIT FOR DIODE MODEL
C
      IMPLICIT REAL*8(A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON Y(600),YL(600),YV(200),YC(200),YD(250),V(250),VCUR(10),
     1   V1(250),VPI(250),
     1   VGS(100),VDS(100),VSB(100),CDS(100)
      COMMON /DIODE/ NAMD(100),VALD(100,4),NDI(100,4),VDIO(100),
     1   CDIO(100),NDIOD
     1   ,NDUM,VT2,VT10,FACTOR
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,
     1   NXTR,ITR,IND,IBUG
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,
     1   ICONV,ICHAR
      COMMON /STORE/ LQ(100,4),LD(100,2),LC(10,2),XALU(100),LCL(10),
     1   LVL(10),LDI(100,2),TC1(100),TC2(100),TEMPE(10),NTMP,KTMP
      LOGICAL IBUG,ICHAR
C
C...  INITIAL CHECK
C
C... MODE = 0 => DC DIODE MODEL IS NEEDED
C         = 1 => TRANSIENCT MODEL IS NEEDED
C...  IND = 0 => INTERNAL PARAMETER VALUE HAVE TO BE OBTAINED
C
      IF (NDIOD.EQ.0) RETURN
      FACTOR=1.
      IF (IND.NE.0) GO TO 200
      TEMPER=TEMPE(KTMP)
      VT=8.6164E-5*TEMPER
      VT10=10.*VT
      VT2=2.3*VT
      IF (TEMPER.EQ.300.) GO TO 200
      RATIO=TEMPER/300.
      FACTOR=RATIO**3*DEXP(1.1/8.6164E-5*(1./300.-1./TEMPER))
  200 DO 990 K=1,NDIOD
      N1=NDI(K,1)
      N2=NDI(K,2)
C
C...  GET NEXT VOLTAGE FOR ANALYSIS
C
      IF (IND.NE.0) GO TO 210
      PDIO=VDIO(K)
      GO TO 240
210   PDIO=V1(N1)-V1(N2)
C...  FOR FIRST ITERATION OF DC OR TRANSIENT ANALYSIS, NO ADJUSTMENT
      IF (ITR.EQ.0)  GO TO 240
      BVT=PDIO-VDIO(K)
      IF (DABS(BVT).LE.TOLER) GO TO 240
      ICONV=0
      IF (DABS(BVT).LE.VT2) GO TO 240
      IF (VDIO(K).LE.VT10) GO TO 230
      PDIO=VDIO(K)-VT2
      IF (BVT.GT.0.) PDIO=PDIO+VT2+VT2
      GO TO 240
  230 IF (BVT.GT.0.0) GO TO 235
      IF (BVT.LT.-2.0) PDIO=VDIO(K)-2.0
      GO TO 240
  235 IF (BVT.GT.2.0) PDIO=VDIO(K)+2.0
      IF (PDIO.GT.VT10) PDIO=VT10
  240 VDIO(K)=PDIO
C
      CSS=VALD(K,1)*FACTOR
C
C...  DC MODEL
C
      IF (PDIO.GT.0.) GO TO 320
      EVD=1.0
      GEQ=CSS/VT
      IF (-PDIO.LE.DVT) GO TO 310
      CD=-CSS
      CDEQ=CD-GEQ*PDIO
      GO TO 340
310   CD=GEQ*PDIO
      CDEQ=0.0
      GO TO 340
  320 EVD=DEXP(PDIO/VT)
      GEQ=CSS*EVD/VT
      CD=CSS*(EVD-1.0)
      CDEQ=CD-GEQ*PDIO
  340 CDIO(K)=CD
      IF (MODE.EQ.0) GO TO 900
C
C...  TRANSIENT MODEL
C
      CJO=VALD(K,2)
      TAU=VALD(K,3)
      PHI=VALD(K,4)
C
C...  CALCULATE CAPACITANCES
C
      IF (PDIO.GE.0.) GO TO 360
      SARG=DSQRT(1.0-PDIO/PHI)
      CAPD=TAU*CSS/VT+CJO/SARG
      GO TO 380
  360 CAPD=TAU*CSS*EVD/VT+CJO*(1.+PDIO/(2.0*PHI))
C
C...  LINEARIZE THE CAPACITANCES
C
  380 ODIO=VPI(N1)-VPI(N2)
      GTEMP=CAPD/DELT
      GEQ=GEQ+GTEMP
      CDEQ=CDEQ-GTEMP*ODIO
C
C...  ADD CONDUCTANCES AND CURRENT VECTORS TO MATRIX
C
  900 YD(N1)=YD(N1)+GEQ
      YD(N2)=YD(N2)+GEQ
      Y(NDI(K,3))=Y(NDI(K,3))-GEQ
      Y(NDI(K,4))=Y(NDI(K,4))-GEQ
      V(N1)=V(N1)-CDEQ
      V(N2)=V(N2)+CDEQ
  990 CONTINUE
      RETURN
      END
      SUBROUTINE SOLUTN
C
C     .... SOLVES EQUATIONS WITH SPECIAL MATRIX INDICATORS
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON Y(600),YL(600),YV(200),YC(200),YD(250),V(250),VCUR(10),
     1 V1(250),VPI(250)
      COMMON /SPARSE/ IORD(300),NUR(300),NVV(16),IPOS(1600),IUC(600),
     1 IV(200)
      DIMENSION NLC(300),ILR(600)
      EQUIVALENCE (NUR(1),NLC(1)),(IUC(1),ILR(1))
      COMMON /NODES/ NREN(100),LNOD,NX,MDIM,NNOD,NUT,NLT,NVT
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1 VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
C
C     ... L*U DECOMPOSITION
      MD1=MDIM-1
      IF (MD1.LE.0) GO TO 101
      KNT=0
      DO 155 I=1,MD1
      L=IORD(I)
      NUS=NUR(I)
      NUE=NUR(I+1)
      NL=NLC(I)
      NLE=NLC(I+1)
135   IF (NL-NLE) 140,155,155
140   TEM=YL(NL)/YD(L)
      YL(NL)=TEM
      NL=NL+1
      NU=NUS
145   IF (NU-NUE) 150,135,135
150   KNT=KNT+1
      K=IPOS(KNT)
      Y(K)=Y(K)-Y(NU)*TEM
      NU=NU+1
      GO TO 145
155   CONTINUE
C
C     SOLVE
C
      ENTRY SOLV
C     PROCESS VOLTAGE SOURCES
101   IF (NVSC.EQ.0) GO TO 120
      DO 115 I=1,NVSC
      IF (VSRC(I).EQ.0.0) GO TO 115
      NL=NVV(I)
      NLE=NVV(I+1)
105   IF (NL.GE.NLE) GO TO 115
110   IR=IV(NL)
      V(IR)=V(IR)-YV(NL)*VSRC(I)
      NL=NL+1
      GO TO 105
115   CONTINUE
      DO 117 I=1,NVSC
      VCUR(I)=V(MDIM+I)
117   V(MDIM+I)=VSRC(I)
C
120   V(NNOD)=0.
      YD(200)=0.
      MD1=MDIM-1
      IF (MD1) 190,125,130
125   V(1)=V(1)/YD(1)
      RETURN
C
C     ... FORWARD SUBSTITUTION
130   DO 170 I=1,MD1
      L=IORD(I)
      IF (V(L).EQ.0.0) GO TO 170
      NL=NLC(I)
      NLE=NLC(I+1)
160   IF (NL-NLE) 165,170,170
165   IR=ILR(NL)
      V(IR)=V(IR)-YL(NL)*V(L)
      NL=NL+1
      GO TO 160
170   CONTINUE
C
C     ... BACK SUBSTITUTION
      L=IORD(MDIM)
      V(L)=V(L)/YD(L)
      DO 185 I=1,MD1
      J=MDIM-I
      L=IORD(J)
      NU=NUR(J)
      NUE=NUR(J+1)
175   IF (NU-NUE) 180,185,185
180   IC=IUC(NU)
      V(L)=V(L)-Y(NU)*V(IC)
      NU=NU+1
      GO TO 175
185   V(L)=V(L)/YD(L)
C
  190 RETURN
C
C     ... CALCULATE CURRENTS THROUGH VOLTAGE SOURCES
C
      ENTRY CCAL
      IF (NVSC.EQ.0) GO TO 290
      DO 280 I=1,NVSC
      TEM=VCUR(I)
      N=NVV(I)
      NE=NVV(I+1)
210   IF (N-NE) 220,230,230
220   IC=IV(N)
      TEM=TEM-YC(N)*V(IC)
      N=N+1
      GO TO 210
230   VCUR(I)=TEM-YD(MDIM+I)*VSRC(I)
280   CONTINUE
290   RETURN
      END
      SUBROUTINE READIN
C
C.... SUBROUTINE TO READ AND PROCESS CIRCUIT DATA
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1 ITR,IND,IBUG
      COMMON /ELMTS/ KIND(100),ND(100,4),VALU(100),NELT
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1 VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
      COMMON /CSRCE/ CSRC(10),CLSRC(10),NAMC(10),TCUR(10,10),
     1 CVAL(10,10),NCVAL(10),KCUR(10),NC(10,2),NCSC
      COMMON /PLOTS/ PMIN(6),PMAX(6),FSTR,FSTP,
     1 NP(2,4,6),NPLT,NPTS,NHAR,KPLO(4,6),NPVAL(6),NAMP(4,6)
      COMMON /OUTPT/ KOUT(10),NAMO(10),NODO(10,2),NOUT
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,ICONV,ICHAR
      COMMON /NAMES/ NAME(100),NAMQ(100),MODN(100),NAMB(30),NMOD
      COMMON /STORE/ LQ(100,4),LD(100,2),LC(10,2),XALU(100),LCL(10),
     1 LVL(10),LDI(100,2),TC1(100),TC2(100),TEMPE(10),NTMP,KTMP
      COMMON /DIODE/ NAMD(100),VALD(100,4),NDI(100,4),VDIO(100),
     1   CDIO(100),NDIOD
      COMMON /GAIN/ K1,K2,K3,K4,K10
      COMMON /START/VVOL(100),INI,IDC
      COMMON /JOBCNT/ TITLE(9),PRGVER,NALTR,IREQ,ISTOP
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      LOGICAL IBUG,ICHAR,IREQ,ISTOP,MFLG,NEND,INEW,INI,IDC
      DIMENSION LETR(12),LET(10)
      DATA LET /1HR,1HC,1HL,1HD,1HQ,1HM,1HB,1HV,1HI,1H*/
      DATA LETR /2HPR,2HPL,2HTI,2HTO,2HFO,2HTE,2HSH,2HGA,2HST,2HDC,
     1   2HAL,2HEN /
      DATA IHI,IHN,ISN/1HI,1HN,1H^/
      DATA KBL/1H /
C
C.... RETRIEVE ALL DATA READ PREVIOUSLY, ALTER IS ENABLED
      IF (NALTR.EQ.0) GO TO 60
      WRITE (J6,10) TITLE,PRGVER
 10   FORMAT (1H1,9A8,8X,5HSINC-,A3///,2X,20HCONTINUATION OF DATA //)
      DO 20 I=1,NXTR
      NQ(I,1)=LQ(I,1)
      NQ(I,2)=LQ(I,2)
      NQ(I,3)=LQ(I,3)
20    NQ(I,4)=LQ(I,4)
      DO 30 I=1,NELT
      ND(I,1)=LD(I,1)
30    ND(I,2)=LD(I,2)
      DO 32 I=1,NDIOD
      NDI(I,1)=LDI(I,1)
   32 NDI(I,2)=LDI(I,2)
      IF (NCSC.EQ.0) GO TO 45
      DO 40 I=1,NCSC
      NCVAL(I)=LCL(I)
      IF (KCUR(I).NE.2) GO TO 35
      CVAL(2,I)=CVAL(5,I)
      CVAL(3,I)=CVAL(6,I)
35    NC(I,1)=LC(I,1)
40    NC(I,2)=LC(I,2)
45    IF (NVSC.EQ.0) GO TO 100
      DO 50 I=1,NVSC
      NVVAL(I)=LVL(I)
      IF (KVOL(I).NE.2) GO TO 50
      VVAL(2,I)=VVAL(5,I)
      VVAL(3,I)=VVAL(6,I)
50    CONTINUE
      GO TO 100
C
C     ... INITIALIZE
60    NMOD=0
      NXTR=0
      NELT=0
      NDIOD=0
      NVSC=0
      NCSC=0
      NSRC=0
      NDSIN=0
      NOUT=0
      NPLT=0
      IREQ=.FALSE.
      NTMP=0
      ICHAR=.FALSE.
      IND=0
      IBUG=.FALSE.
      TMAX=0.
      TOLER=1.E-5
      DPRT=1.
      DO 70 I=1,80
70    IPNT(I)=KBL
      DO 80 I=1,100
80    VVOL(I)=0.
      K10=-1
      MFLG=.FALSE.
      NEND=.FALSE.
      NERR=0
      INI=.FALSE.
      IDC=.FALSE.
C
C     READ AND TEST TYPE
C
100   INEW=.TRUE.
110   CALL LINE
      IF (.NOT.NEND) GO TO 100
      MFLG=.FALSE.
      NEND=.FALSE.
      INEW=.FALSE.
C
C
C
C     GET TYPE
C
C
C
      CALL NVAL(4)
      DO 140 KODE=1,12
      IF (NAM2.EQ.LETR(KODE)) GO TO 165
140   CONTINUE
      DO 150 KODE=1,10
      IF (KARD(KPT).EQ.LET(KODE)) GO TO 160
150   CONTINUE
      GO TO 810
160   GO TO (290,290,290,560,300,330,330,170,230,100),KODE
165   GO TO (410,460,400,510,520,530,550,570,580,575,640,590),KODE
C
C.... VOLTAGE SOURCE LINE
170   IF (NALTR.EQ.0) GO TO 174
      DO 172 L=1,NVSC
      IF (NAM.EQ.NAMV(L)) GO TO 176
172   CONTINUE
174   IF (NVSC.GE.10) GO TO 840
      NVSC=NVSC+1
      L=NVSC
      NAMV(L)=NAM
176   NV(L,1)=VALUE(0)
      NV(L,2)=VALUE(0)
C
C.... CHECK FOR TYPE OF V-SOURCE
      IF (KARD(KPT+2).EQ.IHI.AND.KARD(KPT+3).EQ.IHN) GO TO 200
C.... CONVENTIONAL V-SOURCE
      KVOL(L)=1
      NSRC=NSRC+1
      NAM=0
      DO 180 I=1,9
      VVAL(I,L)=VALUE(3)
      TVLT(I,L)=VALUE(3)
      IF (NAM.NE.0) GO TO 185
180   CONTINUE
      I=10
185   NVV=I-1
      IF (NVV.GE.1) GO TO 190
      KVOL(L)=0
      NVV=1
190   NVVAL(L)=NVV
      TVLT(NVV+1,L)=1.E10
      VVAL(NVV+1,L)=VVAL(NVV,L)
      GO TO 220
C.... SINUSOIDAL V-SOURCE
200   NDSIN=NDSIN+1
      KVOL(L)=2
      DO 210 I=1,4
 210  VVAL(I,L)=VALUE(3)
220   IF (NV(L,2).NE.0) GO TO 860
      GO TO 800
C
C.... CURRENT SOURCE LINE
230   IF (NALTR.EQ.0) GO TO 234
      DO 232 L=1,NCSC
      IF (NAM.EQ.NAMC(L)) GO TO 236
232   CONTINUE
234   IF (NCSC.GE.10) GO TO 840
      NCSC=NCSC+1
      L=NCSC
      NAMC(L)=NAM
236   NC(L,1)=VALUE(0)
      NC(L,2)=VALUE(0)
C
C.... CHECK FOR TYPE OF C-SOURCE
      IF (KARD(KPT+2).EQ.IHI.AND.KARD(KPT+3).EQ.IHN) GO TO 260
C.... CONVENTIONAL C-SOURCE
      KCUR(L)=1
      NSRC=NSRC+1
      NAM=0
      DO 240 I=1,9
      CVAL(I,L)=VALUE(3)
      TCUR(I,L)=VALUE(3)
      IF (NAM.NE.0) GO TO 245
240   CONTINUE
      I=10
245   NCV=I-1
      IF (NCV.GE.1) GO TO 250
      KCUR(L)=0
      NCV=1
250   NCVAL(L)=NCV
      TCUR(NCV+1,L)=1.E10
      CVAL(NCV+1,L)=CVAL(NCV,L)
      GO TO 800
C.... SINUSOIDAL C-SOURCE
260   NDSIN=NDSIN+1
      KCUR(L)=2
      DO 270 I=1,3
270   CVAL(I,L)=VALUE(3)
      GO TO 800
C
C.... PROCESS R, C OR L ELEMENT
290   IF (NALTR.EQ.0) GO TO 294
      DO 292 L=1,NELT
      IF (NAM.EQ.NAME(L)) GO TO 296
292   CONTINUE
294   IF (NELT.GE.100) GO TO 840
      NELT=NELT+1
      L=NELT
      NAME(L)=NAM
      KIND(L)=KODE
296   ND(L,1)=VALUE(0)
      ND(L,2)=VALUE(0)
      XALU(L)=VALUE(3)
      TC1(L)=VALUE(3)
      TC2(L)=VALUE(3)
      IF (XALU(L).LE.0) GO TO 850
      GO TO 800
C
C.... PROCESS TRANSISTOR
300   IF (NALTR.EQ.0) GO TO 304
      DO 302 L=1,NXTR
      IF (NAM.EQ.NAMQ(L)) GO TO 306
302   CONTINUE
304   IF (NXTR.GE.100) GO TO 840
      NXTR=NXTR+1
      L=NXTR
      NAMQ(L)=NAM
306   CALL NVAL(4)
      MODN(L)=NAM
      DO 312 I=1,4
      NQ(L,I)=VALUE(0)
312   CONTINUE
313   DO 314 I=1,6
314   XPARA(L,I)=VALUE(3)
      GO TO 800
C
C     ...  TRANSISTOR MODEL
330   CALL MODEL
      GO TO 100
C
C.... READ TIME SPECIFICATION
400   DPRT=VALUE(3)
      TMAX=VALUE(3)
      GO TO 100
C
C.... READ OUTPUT SPECIFICATION
C
410   IF (NOUT.GE.9) GO TO 845
      NOUT=NOUT+1
      CALL NVAL(4)
      NAMO(NOUT)=NAM
      NAM=0
      VAL=VALUE(1)
      IF (NAM.EQ.0) GO TO 415
      NODO(NOUT,1)=NAM
      KOUT(NOUT)=1
      GO TO 420
415   NODO(NOUT,1)=VAL
      NODO(NOUT,2)=VALUE(0)
      KOUT(NOUT)=0
420   IF (MFLG) NOUT=NOUT-1
      GO TO 100
C
C
C     READ PLOT SPECIFICATION
C
C
460   IF (NPLT.GE.6) GO TO 845
      NPLT=NPLT+1
      NVL=0
      PMIN(NPLT)=0.
      PMAX(NPLT)=0.
C
      NAM=0
      VAL=VALUE(2)
      IF (NAM.NE.0) GO TO 475
      PMIN(NPLT)=VAL
      PMAX(NPLT)=VALUE(3)
      CALL NVAL(4)
475   NVL=NVL+1
      IF (NVL.GT.4) GO TO 100
      NPVAL(NPLT)=NVL
      NAMP(NVL,NPLT)=NAM
C
      NAM=0
      VAL=VALUE(1)
      IF (NAM.NE.0) GO TO 480
      NP(1,NVL,NPLT)=VAL
      NP(2,NVL,NPLT)=VALUE(0)
      KPLO(NVL,NPLT)=0
      GO TO 485
C
480   NP(1,NVL,NPLT)=NAM
      KPLO(NVL,NPLT)=1
C
485   NAM=0
      CALL VALUE(2)
      IF (NAM.EQ.1) GO TO 490
      IF (NAM.EQ.0) GO TO 830
      GO TO 475
C
490   IF (MFLG.OR.NVL.LT.1) NPLT=NPLT-1
      GO TO 100
C
C.... PROCESS TOLER STATEMENT
510   VAL=VALUE(3)
      IF (VAL.GT.0.0) TOLER=VAL
      GO TO 100
C
C     ... PROCESS FOURIER ANALYSIS CARD
520   FSTR=VALUE(3)
      FSTP=VALUE(3)
      NHAR=VALUE(3)
      IF (NHAR.LE.0) NHAR=3
      IREQ=.NOT.MFLG
      GO TO 100
C
C     ... READ TEMPERATURE CARD
530   NTMP=1
      NAM=0
      DO 540 I=1,5
      TEMPE(I)=VALUE(3)
      IF (NAM.NE.0) GO TO 545
540   CONTINUE
      I=6
545   NTMP=I-1
      GO TO 100
C
C.... CHARACTERISTICS CARD
550   ICHAR=.TRUE.
      GO TO 100
C
C.... PROCESS DIODE
  560 IF (NALTR.EQ.0) GO TO 564
      DO 562 L=1,NDIOD
      IF (NAM.EQ.NAMD(L)) GO TO 566
  562 CONTINUE
564   IF (NDIOD.GE.100) GO TO 840
      NDIOD=NDIOD+1
      L=NDIOD
      NAMD(L)=NAM
  566 NDI(L,1)=VALUE(0)
      NDI(L,2)=VALUE(0)
      DO 568 I=1,4
  568 VALD(L,I)=VALUE(3)
      IF (VALD(L,1).LE.0.) VALD(L,1)=1.E-14
      IF (VALD(L,4).LE.0.) VALD(L,4)=0.6
      GO TO 800
C
C     GAIN CARD
C
570   K1=VALUE(0)
      K2=VALUE(0)
      K3=VALUE(0)
      K4=VALUE(0)
      IF (.NOT.MFLG) K10=0
      GO TO 100
C
C     DC VOLTAGE SPECIFICATION
C
575   IDC=.TRUE.
      GO TO 580
C
C     STARTING VOLTAGES SPECIFICATION
C
580   INI=.TRUE.
      NAM=0
585   N1=VALUE(-1)+1
      IF (NAM.NE.0) GO TO 100
      VVOL(N1)=VALUE(3)
      GO TO 585
C
C     END
C
590   NALTR=0
      GO TO 1000
C
C     ALTER
C
640   NALTR=NALTR+1
      DO 642 I=1,NXTR
      LQ(I,1)=NQ(I,1)
      LQ(I,2)=NQ(I,2)
      LQ(I,3)=NQ(I,3)
642   LQ(I,4)=NQ(I,4)
      DO 644 I=1,NELT
      LD(I,1)=ND(I,1)
644   LD(I,2)=ND(I,2)
      DO 645 I=1,NDIOD
      LDI(I,1)=NDI(I,1)
  645 LDI(I,2)=NDI(I,2)
      IF (NCSC.EQ.0) GO TO 655
      DO 650 I=1,NCSC
      LCL(I)=NCVAL(I)
      IF (KCUR(I).NE.2) GO TO 646
      CVAL(5,I)=CVAL(2,I)
      CVAL(6,I)=CVAL(3,I)
646   LC(I,1)=NC(I,1)
650   LC(I,2)=NC(I,2)
655   IF (NVSC.EQ.0) GO TO 1000
      DO 660 I=1,NVSC
      LVL(I)=NVVAL(I)
      IF (KVOL(I).NE.2) GO TO 660
      VVAL(5,I)=VVAL(2,I)
      VVAL(6,I)=VVAL(3,I)
660   CONTINUE
C
C
C
800   ISTOP=MFLG
      GO TO 100
810   NERRM=1
      GO TO 880
820   NERRM=7
      GO TO 880
830   NERRM=10
      GO TO 890
840   NERRM=11
      GO TO 880
845   NERRM=11
      GO TO 890
850   NERRM=12
      GO TO 890
860   NERRM=13
880   ISTOP=.TRUE.
890   IPNT(IPT-1)=ISN
      NERR=NERR+1
      LABL(NERR)=NERRM
      MFLG=.TRUE.
      GO TO 100
920   WRITE (J6,930)
930   FORMAT ('0 ** END OF INPUT DATA **')
1000  CALL CHEKIN (NSRC,NDSIN)
      RETURN
      END
      SUBROUTINE CHEKIN (NSRC,NDSIN)
C
C     .... PROCESSES AND PRINTS OUT CIRCUIT DATA
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1 ITR,IND,IBUG
      COMMON /ELMTS/ KIND(100),ND(100,4),VALU(100),NELT
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1 VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
      COMMON /CSRCE/ CSRC(10),CLSRC(10),NAMC(10),TCUR(10,10),
     1 CVAL(10,10),NCVAL(10),KCUR(10),NC(10,2),NCSC
      COMMON /PLOTS/ PMIN(6),PMAX(6),FSTR,FSTP,
     1 NP(2,4,6),NPLT,NPTS,NHAR,KPLO(4,6),NPVAL(6),NAMP(4,6)
      COMMON /OUTPT/ KOUT(10),NAMO(10),NODO(10,2),NOUT
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,ICONV,ICHAR
      COMMON /NAMES/ NAME(100),NAMQ(100),MODN(100),NAMB(30),NMOD
      COMMON /STORE/ LQ(100,4),LD(100,2),LC(10,2),XALU(100),LCL(10),
     1 LVL(10),LDI(100,2),TC1(100),TC2(100),TEMPE(10),NTMP,KTMP
      COMMON /DIODE/ NAMD(100),VALD(100,4),NDI(100,4),VDIO(100),
     1   CDIO(100),NDIOD
      COMMON /GAIN/ K1,K2,K3,K4,K10
      COMMON /JOBCNT/ TITLE(9),PRGVER,NALTR,IREQ,ISTOP
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      COMMON /START/ VVOL(100),INI,IDC
      LOGICAL IBUG,ICHAR,IREQ,ISTOP,INI,IDC
      DATA IVOU /4HVOUT/
C
C     PUT VOLTAGE SOURCE VALUES INTO VVOL ARRAY
C
      IF (.NOT.INI) GO TO 500
      DO 400 J=1,NVSC
      N1=NV(J,1)+1
      IF (KVOL(J).EQ.2) GO TO 390
      VVOL(N1)=VVAL(1,J)
      GO TO 400
390   VVOL(N1)=VVAL(1,J)*DSIN(VVAL(3,J))+VVAL(4,J)
400   CONTINUE
500   CONTINUE
C
C     ... PRINT TITLE
      WRITE (J6,925) TITLE,PRGVER
C
C     ... CHARACTERISTICS
      IF (ICHAR) WRITE (J6,900)
C
C     ... PRINT TEMPERATURE SPECIFICATION
600   IF (NTMP.EQ.0) GO TO 610
      WRITE (J6,910) (TEMPE(I),I=1,NTMP)
      GO TO 620
610   NTMP=1
      TEMPE(1)=300.
C
C.... PRINT TOLERANCE IF CHANGED
620   IF (TOLER.EQ.1.E-5) GO TO 640
      WRITE (J6,930) TOLER
C
C.... PRINT TIME DATA
640   IF (TMAX.EQ.0.) GO TO 645
      WRITE (J6,935) DPRT,TMAX
C
C.... PRINT GAIN FACTOR
645   IF (K10.EQ.0) WRITE (J6,920) K1,K2,K3,K4
C
C.... PRINT AND PROCESS OUTPUT SPECIFICATION
650   IF (NOUT.EQ.0) GO TO 700
      WRITE (J6,940)
660   DO 690 I=1,NOUT
662   NO1=NODO(I,1)
      NO2=NODO(I,2)
665   IF (KOUT(I).EQ.0) GO TO 690
      WRITE (J6,947) NAMO(I),NO1
C
C.... SEARCH FOR CURRENT OUTPUT ELEMENT
      DO 670 K=1,NELT
      IF (NO1.EQ.NAME(K)) GO TO 685
670   CONTINUE
C.... SEARCH FOR OUTPUT ACROSS C-SOURCE
      IF (NCSC.EQ.0) GO TO 680
      DO 675 J=1,NCSC
      K=-J
      IF (NO1.EQ.NAMC(J)) GO TO 685
675   CONTINUE
680   WRITE (J6,1040) NO1,NO2
      KOUT(I)=0
      NODO(I,1)=0
      NODO(I,2)=0
      GO TO 690
685   KOUT(I)=K
      GO TO 690
687   WRITE (J6,945) NAMO(I),NO1,NO2
690   CONTINUE
C
C.... PRINT AND PROCESS PLOT DATA
700   IF (NPLT.GT.0) GO TO 705
      IF (NOUT.GT.0) GO TO 740
      IF (TMAX.EQ.0.) GO TO 740
      WRITE (J6,1030)
      TMAX=0.
      GO TO 740
 705  WRITE (J6,990)
710   DO 735 N=1,NPLT
711   NVL=NPVAL(N)
      WRITE (J6,995) PMIN(N),PMAX(N)
C.... SEARCH FOR OUTPUT NODES
712   DO 732 I=1,NVL
      IF (KPLO(I,N).EQ.0) GO TO 732
      NP1=NP(1,I,N)
      WRITE (J6,996) NAMP(I,N),NP1
      IF (NELT.EQ.0) GO TO 717
      DO 715 K=1,NELT
      IF (NP1.EQ.NAME(K)) GO TO 730
715   CONTINUE
717   IF (NCSC.EQ.0) GO TO 725
      DO 720 J=1,NCSC
      K=-J
      IF (NP1.EQ.NAMC(J)) GO TO 730
720   CONTINUE
725   WRITE (J6,1040) NP1
      K=0
      NAMP(I,N)=IVOU
730   KPLO(I,N)=K
      GO TO 732
731   WRITE (J6,997) NAMP(I,N),NP(1,I,N),NP(2,I,N)
732   CONTINUE
735   CONTINUE
C
C.... PRINT ELEMENT DATA
740   IF (NELT.EQ.0) GO TO 752
      WRITE (J6,950)
      DO 750 I=1,NELT
745   WRITE (J6,948) NAME(I),ND(I,1),ND(I,2),XALU(I),TC1(I),TC2(I)
750   CONTINUE
C
C.... PRINT DIODES
  752 IF (NDIOD.EQ.0) GO TO 760
      WRITE (J6,955)
      DO 758 I=1,NDIOD
      N1=NDI(I,1)
      N2=NDI(I,2)
      VDIO(I)=0.4
      IF (INI) VDIO(I)=(VVOL(N1+1)-VVOL(N2+1))
  756 WRITE (J6,948) NAMD(I),N1,N2,(VALD(I,J),J=1,4),VDIO(I)
  758 CONTINUE
C
C.... PRINT CONVENTIONAL SOURCE DATA
760   IF (NSRC.EQ.0) GO TO 800
      WRITE (J6,960)
      IF (NVSC.EQ.0) GO TO 780
      DO 770 I=1,NVSC
765   IF (KVOL(I).GT.1) GO TO 770
      N=NVVAL(I)
      IF (N.EQ.1) GO TO 767
      TVLT(1,I)=0.
      IF (TMAX.EQ.0.) GO TO 767
      DO 766 J=1,N
      TST=TVLT(J,I)+DPRT
      IF (TVLT(J+1,I).GE.TST) GO TO 766
      TVLT(J+1,I)=TST
 766  CONTINUE
767   WRITE (J6,945) NAMV(I),NV(I,1),NV(I,2),(VVAL(J,I),TVLT(J,I),J=1,N)
770   CONTINUE
780   IF (NCSC.EQ.0) GO TO 800
      DO 790 I=1,NCSC
785   IF (KCUR(I).GT.1) GO TO 790
      N=NCVAL(I)
      IF (N.EQ.1) GO TO 787
      TCUR(1,I)=0.
      IF (TMAX.EQ.0.) GO TO 787
      DO 786 J=1,N
      TST=TCUR(J,I)+DPRT
      IF (TCUR(J+1,I).GE.TST) GO TO 786
      TCUR(J+1,I)=TST
 786  CONTINUE
787   WRITE (J6,945) NAMC(I),NC(I,1),NC(I,2),(CVAL(J,I),TCUR(J,I),J=1,N)
790   CONTINUE
C
C.... PRINT AND PROCESS SINUSOIDAL SOURCE DATA
800   IF (NDSIN.EQ.0) GO TO 835
      WRITE (J6,970)
803   IF (NVSC.EQ.0) GO TO 820
      DO 810 I=1,NVSC
      IF (KVOL(I).LT.2) GO TO 810
      WRITE (J6,975) NAMV(I),(NV(I,J),J=1,2),(VVAL(J,I),J=1,4)
805   VVAL(2,I)=VVAL(2,I)*6.2831853072
      VVAL(3,I)=VVAL(3,I)/57.2957795128
810   CONTINUE
820   IF (NCSC.EQ.0) GO TO 835
      DO 830 I=1,NCSC
      IF (KCUR(I).LT.2) GO TO 830
      WRITE (J6,975) NAMC(I),NC(I,1),NC(I,2),(CVAL(J,I),J=1,3)
825   CVAL(2,I)=CVAL(2,I)*6.2831853072
      CVAL(3,I)=CVAL(3,I)/57.2957795128
830   CONTINUE
C
C     ... PRINT TRANSISTORS
835   IF (NXTR.EQ.0) GO TO 865
      WRITE (J6,985)
      DO 860 I=1,NXTR
      NAM=MODN(I)
      NQ(I,5)=0
      IF (XPARA(I,3).NE.0.) NQ(I,5)=1
      NQ(I,6)=0
      IF (XPARA(I,4).NE.0.) NQ(I,6)=1
      WRITE  (J6,987) NAMQ(I),(NQ(I,J),J=1,4),NAM,(XPARA(I,J),J=1,6)
      DO 840 K=1,NMOD
      IF (NAM.NE.NAMB(K)) GO TO 840
      MREF(I)=K
      GO TO 860
840   CONTINUE
      WRITE (J6,988)
      ISTOP=.TRUE.
860   CONTINUE
C
C     ... PRINT TRANSISTOR MODELS
865   CALL MDLPR
C
C     ... PRINT FOURIER ANALYSIS DATA
870   IF (IREQ) WRITE (J6,1000) FSTR,FSTP,NHAR
C
C     STARTING VOLTAGE SPECIFICATION
C
880   IF (.NOT.INI) GO TO 890
      DO 882 I=1,100
      IF (VVOL(I).NE.0.) GO TO 883
882   CONTINUE
      GO TO 890
883   IF (IDC) WRITE (J6,1005)
      WRITE (J6,1010)
      DO 885 I=1,99
      VAL=VVOL(I+1)
      IF (VAL.NE.0.) WRITE (J6,1020) I,VAL
885   CONTINUE
C
890   RETURN
C
900   FORMAT (/1X,26HTRANSISTOR CHARACTERISTICS)
910   FORMAT (/1X,20HTEMPERATURES(DEG K)-/1X,5F10.2)
920   FORMAT (/' GAIN -'/7X,'IN :',2I6,5X,'OUT :',2I6)
 925  FORMAT (1H1,9A8,8X,6HMSINC-,A3)
 935  FORMAT (/,1X,5HTIME-/,1X,6HDELTA=,1PE10.3,3X,6HFINAL=,E10.3)
930   FORMAT (/1X,20HSOLUTION TOLERANCE =,E15.3,6H VOLTS)
940   FORMAT (/,1X,8HOUTPUTS-)
945   FORMAT (1X,A5,1X,2I3,3X,4(1PE12.3,E11.3)/16X,4(1PE12.3,E11.3),
     1       /16X,4(1PE12.3,E11.3))
947   FORMAT (1X,A5,2X,A4)
948   FORMAT (1X,A5,1X,2I3,3X,1P5E12.3)
950   FORMAT (/1X,9HELEMENTS-/1X,4HNAME,3X,5HNODES,8X,5HVALUE,7X,3HTC1,
     1 9X,3HTC2)
955   FORMAT (/1X,7HDIODES-/1X,4HNAME,3X,5HNODES,8X,3HISS,12X,3HCJO,
     1 13X,2HTT,12X,3HPHI)
960   FORMAT (/,1X,8HSOURCES-,/1X,4HNAME,3X,5HNODES,4(8X,5HVALUE,6X,
     1 4HTIME))
970   FORMAT (/,1X,19HSINUSOIDAL SOURCES-/,1X,4HNAME,3X,5HNODES,4X,
     1 9HMAGNITUDE,4X,9HFREQUENCY,4X,5HPHASE,4X,8HDC LEVEL)
 975  FORMAT (1X,A5,1X,2I3,1P2E13.3,0PF9.2,1PE13.3)
985   FORMAT (/,1X,12HTRANSISTORS-/,1X,4HNAME,5X,13HD   G   S   B,
     1 6X,5HMODEL,5X,5HWIDTH,5X,6HLENGTH,7X,2HRD,8X,2HRS,6X,4HCJDO,
     2 6X,4HCJSO  )
987   FORMAT (1X,A5,2X,4I4,5X,A5,3X,9(E10.3))
988   FORMAT (1X,25H****MODEL CANNOT BE FOUND/)
990   FORMAT (/,1X,6HPLOTS-)
995   FORMAT (1X,4HPLOT,2F9.3)
996   FORMAT (23X,A4,2X,A4)
997   FORMAT (23X,A4,2X,2I3)
1000  FORMAT (/1X,17HFOURIER ANALYSIS-,/1X,12HSTART TIME =,1PE11.4,3X,
     1 11HSTOP TIME =,E11.4,4X,18HNO. OF HARMONICS =,I4)
1005  FORMAT (/,' DC VOLTAGE SPECIFIED',/)
1010  FORMAT (/' NONZERO STARTING VOLTAGE SPECIFICATION',/,
     1   5X,'NODE',3X,'VOLTAGE')
1020  FORMAT (6X,I2,F10.3)
1030  FORMAT (//1X,27H****NO OUTPUT SPECIFICATION/)
1040  FORMAT (' ** NO ELEMENT OR SOURCE WITH NAME ',A4,/,
     1   '  IGNORE')
      END
      INTEGER FUNCTION MTYP(NDUM)
C
C     SUBROUTINE TO CHECK DELIMITERS
C
C     MTYP =  -1 => '/'
C          =   0 => NORMAL CHARACTER
C          =   1 => SPECIAL CHARACTER
C
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      LOGICAL MFLG,NEND,INEW
      DIMENSION IDEL(5)
      DATA IDEL /1H ,1H,,1H=,1H(,1H)/
      DATA MSL /1H//
C
C     CHARACTER POINTED BY IPT IS CHECKED
C     IPT IS NOT CHANGED
C
      KHAR=KARD(IPT)
      IF (KHAR.NE.MSL) GO TO 100
      MTYP=-1
      RETURN
C
100   DO 110 I=1,5
      IF (KHAR.EQ.IDEL(I)) GO TO 120
110   CONTINUE
      MTYP=0
      RETURN
C
120   MTYP=1
      RETURN
      END
      SUBROUTINE LINE
C
C     GET A LINE AND CHECK IF CONTINUATION
C
      COMMON /IO/I5,J6
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      LOGICAL MFLG,NEND,INEW
      DATA IBL,IPE,IPL,IHE,IHN,IHD/1H ,1H.,1H+,1HE,1HN,1HD/
C
      IF (NEND) GO TO 90
C
C     GET ANOTHER LINE, IGNORE LEADING BLANKS
C
10    READ (I5,1010,END=400) KARD
      DO 20 KPT=1,72
      IF (KARD(KPT).NE.IBL) GO TO 30
20    CONTINUE
      WRITE (J6,1020)
      GO TO 10
30    IF (KARD(KPT).EQ.IPE) KPT=KPT+1
C
C     GET LAST NONBLANK COLUMN
C
      DO 40 I=1,72
      NCARD=73-I
      IF (KARD(NCARD).NE.IBL) GO TO 50
40    CONTINUE
C
C     CHECK FOR CONTINUATION LINE
C
50    IF (KARD(KPT).NE.IPL) GO TO 60
      KPT=KPT+1
      GO TO 90
60    NEND=.TRUE.
      IF (.NOT.INEW) GO TO 320
90    IF (NERR.EQ.0) GO TO 310
C
C     PRINT ERROR POINTERS
C
      WRITE (J6,800) (IPNT(I),I=1,72)
      DO 100 I=1,72
      IPNT(I)=IBL
100   CONTINUE
C
C     PRINT ERROR MESSAGES
C
      DO 300 I=1,NERR
      J=LABL(I)
      GO TO (110,120,130,140,150,160,170,180,190,200,210,220,230),J
110   WRITE (J6,810)
      GO TO 300
120   WRITE (J6,820)
      GO TO 300
130   WRITE (J6,830)
      GO TO 300
140   WRITE (J6,840)
      GO TO 300
150   WRITE (J6,850)
      GO TO 300
160   WRITE (J6,860)
      GO TO 300
170   WRITE (J6,870)
      GO TO 300
180   WRITE (J6,880)
      GO TO 300
190   WRITE (J6,890)
      GO TO 300
200   WRITE (J6,900)
      GO TO 300
210   WRITE (J6,910)
      GO TO 300
220   WRITE (J6,920)
      GO TO 300
230   WRITE (J6,930)
300   CONTINUE
      NERR=0
C
310   WRITE (J6,800) (KARD(I),I=1,NCARD)
320   IPT=KPT
      RETURN
C
400   WRITE (J6,940)
      KARD(1)=IHE
      KARD(2)=IHN
      KARD(3)=IHD
      KPT=1
      NCARD=4
      GO TO 60
C
800   FORMAT (1X,80A1)
810   FORMAT (' **** ERROR : UNRECOGNIZABLE CARD')
820   FORMAT (' **** ERROR : NODE NUMBER MUST BE POSITIVE INTEGER<100',
     1/'              (NODE NUMBER SET TO ZERO)')
830   FORMAT (' **** ERROR : MODEL NAME MUST BEGIN WITH LETTER M')
840   FORMAT (' **** ERROR : ILLEGAL CHARACTER IN VALUE')
850   FORMAT (' **** ERROR : ILLEGAL CHARACTER IN EXPONENT FIELD')
860   FORMAT (' **** ERROR : MAGNITUDE OF EXPONENT EXCEEDS 30')
870   FORMAT (' **** ERROR : UNRECOGNIZABLE TYPE IN SOURCE')
880   FORMAT (' **** ERROR : NAME FIELD CANNOT BE FOUND')
890   FORMAT (' ** WARNING : NAME OF MODEL VARIABLE UNRECOGNIZABLE')
900   FORMAT (' ** WARNING : ILLEGAL FIELD IN PLOTOUT CARD')
910   FORMAT (' **** ERROR : STORAGE EXCEEDED')
920   FORMAT (' ** WARNING : VALUE NOT GREATER THAN 0')
930   FORMAT (' **** ERROR : VOLTAGE SOURCE NOT GROUNDED')
940   FORMAT (' ** WARNING : END OF FILE ENCOUNTERED')
1010  FORMAT (80A1)
1020  FORMAT (1H )
      END
      SUBROUTINE NVAL(LNTH)
C
C     OBTAIN CHARACTERS OF A NAME
C
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      DIMENSION NAME(4)
      LOGICAL MFLG,NEND,INEW
      DATA IBL /1H /
C
C     LNTH => MAXIMUM LENGTH OF NAME TO BE READ
C
C     VALUE IS RETURNED IN NAM
C
120   IF (NEND) GO TO 400
C
C     SKIP INITIAL BLANKS
C
C
C     IST => STARTING LOCATION OF NAME
C
C     ISP => STOPPING LOCATION OF NAME
C
C     ISS => STOPPING LOCATION SET BY LNTH
C
130   IF (IPT.GT.NCARD) GO TO 310
      IF (MTYP(0).EQ.0) GO TO 140
      IPT=IPT+1
      GO TO 130
140   IST=IPT
C
150   IPT=IPT+1
      IF (IPT.GT.NCARD) GO TO 160
      IF (MTYP(0).NE.0) GO TO 160
      GO TO 150
160   ISP=IPT-1
      ISS=IST+LNTH-1
      IF (ISP.GT.ISS) ISP=ISS
C
C     PUT NAME IN NAM
C
      DO 225 I=1,4
225   NAME(I)=IBL
      DO 230 I=IST,ISP
      N=I-IST+1
230   NAME(N)=KARD(I)
	NAM=IPACK(NAME(1),NAME(2),NAME(3),NAME(4))
	NAM2=IPACK(NAME(1),NAME(2),IBL,IBL)
      RETURN
C
C     GET ANOTHER LINE
C
310   CALL LINE
      GO TO 120
C
400   IPNT(72)=IBL
      NERR=NERR+1
      MFLG=.TRUE.
      LABL(NERR)=8
      RETURN
      END
      FUNCTION NCHA(NDUM)
C
C     OBTAIN CHARACTER NUMBER FOR THE NEXT COLUMN
C
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      LOGICAL MFLG,NEND,INEW
      DIMENSION NUM(21)
      DATA NUM /1H0,1H1,1H2,1H3,1H4,1H5,1H6,1H7,1H8,1H9,1H ,1H.,
     1   1H+,1H-,1HE,1HP,1HN,1HU,1HK,1HG,1HM/
C
C     IPT IS INCREMENTED TO NEXT COLUMN
C
      IF (IPT.LT.NCARD) GO TO 100
      IPT=IPT+1
      NCHA=10
      RETURN
C
100   IPT=IPT+1
      KHAR=KARD(IPT)
      DO 110 I=1,21
      IF (KHAR.EQ.NUM(I)) GO TO 120
110   CONTINUE
      I=22
120   NCHA=I-1
      RETURN
      END
      FUNCTION VALUE(NTYP)
C
C     INTERPRETS A NUMBER READ UNDER 80A1 FORMAT
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      LOGICAL MFLG,NEND,INEW
      DIMENSION SCAF(5)
      DATA SCAF /1.E-12,1.E-9,1.E-6,1.E+3,1.E9/
      DATA LTE,LTU,LTI,ISN /1HE,1HU,1HI,1H^/
C
C     NTYP INPUT = -1 => POSITIVE INTEGER OR END
C                =  0 => POSITIVE INTEGER ONLY
C                =  1 => NAME OR NODE NUMBER
C                =  2 => NAME OR REAL NUMBER
C                =  3 => REAL VALUE
C
C     VALUE IS RETURNED
C
C     NAM = 0 => DEFAULT IS TO BE ASSUMED
C         = 1 => END OF CARD ENCOUNTERED
C         = NAME IF ALPHABETS ARE READ
C         = SAME FOR NUMERIC VALUE
C
      VALUE=0.0
      ISGN=1
C
C     END OF CARD ?
C
90    IF (NEND) GO TO 790
C
C     SKIP LEADING BLANKS
C
100   IF (IPT.GT.NCARD) GO TO 780
      IF (MTYP(0)) 120,130,110
110   IPT=IPT+1
      GO TO 100
C
C     DEFAULT
C
120   IPT=IPT+1
      NAM=0
      GO TO 800
C
C     CHECK IF LEAD BY CHARACTER
C
130   IPT=IPT-1
      N=NCHA(0)
      IF (N-13) 150,170,160
150   IF (N-11) 210,220,180
C     LEADING CHARACTER IS AN ALPHABET
160   CALL NVAL(4)
      IF (NTYP.LE.0) GO TO 810
      IF (NTYP.EQ.3) GO TO 820
      RETURN
C     LEADING CHARACTER IS A MINUS SIGN
170   IF (NTYP.LE.1) GO TO 810
      ISGN=0
C
C     GET INTEGER PART
C
180   N=NCHA(0)
190   IF (N-10) 210,410,200
200   IF (MTYP(0).NE.0) GO TO 410
      IF (N-12) 220,820,350
210   VALUE=VALUE*10.0+N
      GO TO 180
C
C     GET FRACTION PART
C
220   IF (NTYP.LE.1) GO TO 810
      CNT=1.0
230   N=NCHA(0)
      IF (N-10) 250,410,240
240   IF (MTYP(0).NE.0) GO TO 410
      IF (N-14) 820,270,350
250   CNT=CNT*0.1
      VALUE=VALUE+CNT*N
      GO TO 230
C
C     GET EXPONENT PART
C
270   IDEXP=0
      IXS=1
      N=NCHA(0)
      IF (N-13) 280,290,830
280   IF (N-11) 310,830,300
290   IXS=0
300   N=NCHA(0)
310   IF (N-10) 320,330,340
320   IDEXP=IDEXP*10+N
      IF (IABS(IDEXP).GT.30) GO TO 840
      GO TO 300
330   IF (IXS.EQ.0) IDEXP=-IDEXP
      VALUE=VALUE*10.0**IDEXP
      GO TO 410
340   IF (MTYP(0)) 330,830,330
C
C     EVALUATE SCALE FACTORS
C
350   IF (NTYP.LE.1) GO TO 810
      IF (N-14) 820,270,360
360   IF (N-20) 370,375,400
370   VALUE=VALUE*SCAF(N-14)
      GO TO 400
375   N=KARD(IPT+1)
      IF (N.EQ.LTE) GO TO 380
      IF (N.EQ.LTU) GO TO 385
      IF (N.EQ.LTI) GO TO 390
      VALUE=VALUE*1.E-3
      GO TO 400
380   VALUE=VALUE*1.E6
      GO TO 400
385   VALUE=VALUE*1.E-4
      GO TO 400
390   VALUE=VALUE*25.4E-4
C
C     SKIP EXTRA CHARACTERS
C
400   IPT=IPT+1
      IF (IPT.GT.NCARD) GO TO 410
      IF (MTYP(0).EQ.0) GO TO 400
C
C     EXIT
C
410   IF (ISGN.EQ.0) VALUE=-VALUE
      IF (NTYP.LE.1.AND.VALUE.GT.100) GO TO 810
420   RETURN
C
C     GET ANOTHER LINE
C
780   CALL LINE
      GO TO 90
C
C     END OF CARD
C
790   NAM=1
800   IF (NTYP.NE.0.AND.NTYP.NE.1) RETURN
      NPT=72
      NERRM=2
      GO TO 910
C
C     ERROR MESSAGE
C
810   NERRM=2
	VALUE=0
      GO TO 900
820   NERRM=4
      GO TO 900
830   NERRM=5
      GO TO 900
840   NERRM=6
      GO TO 900
C
C     ERROR EXIT
C
900   NPT=IPT-1
910   NERR=NERR+1
      MFLG=.TRUE.
      LABL(NERR)=NERRM
      IPNT(NPT)=ISN
      GO TO 400
950   RETURN
      END
      SUBROUTINE MODEL
C
C     READ TRANSISTOR MODEL CARD
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      DIMENSION NDUM(5)
      COMMON /NAMES/ NAME(100),NAMQ(100),MODN(100),NAMB(30),NMOD
      COMMON /JOBCNT/ TITLE(9),PRGVER,NALTR,IREQ,ISTOP
      COMMON /CARD/ KARD(80),IPNT(80),LABL(10),IPT,NERR,NAM,MFLG,
     1   NEND,INEW,NCARD,KPT,NAM2
      COMMON /START/ VVOL(100),INI,IDC
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1   ITR,IND,IBUG
      COMMON /MODELS/ VTO(30,1),UB(30,5),COX(30,1),DNB(30,1),
     1   CJUN(30,1),XJD(30,1),XJS(30,1),XJN(30,1),GDS(30,3),CSS(30,1),
     1   TEMP(30,1)
      COMMON /MODPR/ BETA(100),PHI(30),VFB(30),VCRIT(30),GAMA(30),
     1   CIS(30),NTYP(30),E40
      LOGICAL IBUG,IREQ,ISTOP,MFLG,NEND,INEW,INI,IDC
      REAL*8 NAMP(17)
      DIMENSION LOCAT(12)
      DIMENSION MPL(13),DFVAL(17)
      DATA LOCAT /1,2,7,8,9,10,11,12,13,16,17,18/
      DATA MPL /2HNM,2HPM,2HVT,2HUB,2HCO,2HDN,2HCJ,2HXD,2HXS,2HXN,
     1   2HGD,2HCS,2HTE/
      DATA DFVAL /0.,250.,4*0.,3.E-8,1.E15,1.,4*0.,0.2,0.6,
     1   1.E-14,300./
      DATA NAMP /3HVTO,2HMU,6H EQ # ,8H 1ST FD ,8H 2ND FD ,6HEVSAT ,
     1   3HCOX,6HDOPING,6HCJUN  ,8HOVERLAPD,8HOVERLAPS,8HLAT DIFF,
     1   8HGDS EQ #,8H 1ST ARG,8H 2ND ARG,4HCSS ,4HTEMP /
      DATA KBL,KSN /1H ,1H^/
      LOCAD=12
      MPLD=13
      MDFVD=17
C
C     CHECK IF THIS IS AN ALTERING STETEMENT
C
      IF (NALTR.EQ.0) GO TO 230
      DO 225 I=1,NMOD
      IF (NAM.EQ.NAMB(I)) GO TO 250
225   CONTINUE
230   NMOD=NMOD+1
      IF (NMOD.GT.30.) GO TO 480
      I=NMOD
      NAMB(I)=NAM
C
C     INITIALIZE ALL MODEL PARAMETERS TO ZERO
C
      VTO(I,1)=0.
      DO 245 J=2,MDFVD
245   VTO(I,J)=-1.
      NTYP(I)=0
C
C     READ A NAME FROM THE CARD
C
250   N=0
265   N=N+1
267   NAM=KBL
270   VAL=VALUE(2)
      IF (NAM.EQ.0) GO TO 265
      IF (NAM.EQ.1) GO TO 460
      IF (NAM.EQ.KBL) GO TO 332
C
C     IDENTIFY THE NAME JUST READ
C
300   DO 310 J=1,MPLD
      IF (NAM2.EQ.MPL(J)) GO TO 320
310   CONTINUE
      NERR=NERR+1
      MFLG=.TRUE.
      LABL(NERR)=9
      IPNT(IPT-1)=KSN
      GO TO 267
C
C     CHECK FOR MODEL TYPE
C
C     NTYP(I) = 0 => PMO TRANSISTOR MODEL
C             = 1 => NMO TRANSISTOR MODEL
C
320   KODE=J-2
      IF (KODE.GT.0) GO TO 323
      NTYP(I)=-KODE
      GO TO 265
C
323   VAL=VALUE(3)
C
C	PATCH TO RECOMPUTE CJUN IF DNB SPECIFIED
C
	IF (KODE.EQ.4)VTO(I,LOCAT(5))=12D-9*DSQRT(VAL/10D15)
C
C     PUT IN VALUE
C
      N=LOCAT(KODE)
332   IF (N.LE.MDFVD) VTO(I,N)=VAL
      GO TO 265
C
C     ASSIGN DEFAULT VALUES
C
460   DO 470 N=2,MDFVD
      IF (VTO(I,N).LT.0.) VTO(I,N)=DFVAL(N)
470   CONTINUE
      IF (TEMP(I,1).LT.100.) TEMP(I,1)=DFVAL(MDFVD)
      GO TO 600
C
480   NERR=NERR+1
      MFLG=.TRUE.
      LABL(NERR)=11
      IPNT(IPT-1)=KSN
600   RETURN
C
C
C...  PRINT MODEL PARAMETERS
C
      ENTRY MDLPR
      IF (NXTR.EQ.0) GO TO 608
      DO 606 I=1,NXTR
      K=MREF(I)
      NQ(I,23)=NTYP(K)
606   CONTINUE
C
608   IF (NMOD.EQ.0) GO TO 850
C
C...  PRINT TITLE
C
      WRITE (J6,980)
      NE=0
610   NS=NE+1
      NE=NS+4
      IF (NE.GT.NMOD) NE=NMOD
      IF (NE.GT.30) GO TO 635
      IF (NS.GT.NE) GO TO 850
      WRITE (J6,985) (NAMB(J),J=NS,NE)
      N=0
      DO 620 K=NS,NE
      N=N+1
      IF (NTYP(N).NE.0) GO TO 615
      NDUM(N)=MPL(2)
      GO TO 620
615   NDUM(N)=MPL(1)
620   CONTINUE
      WRITE (J6,990) (NDUM(J),J=1,N)
C
C...  PRINT THE INPUT PARAMETERS
C
      KN=LOCAD-1
      DO 625 KODE=1,KN
      KS=LOCAT(KODE)
      KE=LOCAT(KODE+1)
      N=KS
621   DO 622 J=NS,NE
      IF (VTO(J,N).NE.0.) GO TO 623
622   CONTINUE
      IF (N-KS) 625,625,624
623   WRITE (J6,995) NAMP(N),(VTO(J,N),J=NS,NE)
624   N=N+1
      IF (N-KE) 621,625,625
625   CONTINUE
      WRITE (J6,995)
      GO TO 610
635   ISTOP=.TRUE.
      WRITE (J6,1080)
850   RETURN
905   FORMAT(80A1)
920   FORMAT(3X,80A1)
925   FORMAT(1X,2H**,I3,23H ERROR(S) ON ABOVE CARD   )
980   FORMAT(/,1X,11HMOS MODELS-/,1X,9HPARAMETER,4X,5HVALUE)
985   FORMAT(/1X,4HNAME,4X,5(4X,A5,3X))
990   FORMAT(1X,4HTYPE,4X,5(4X,A3,5X))
995   FORMAT(1X,A8,1P5E12.3)
975   FORMAT (' **** MODEL CANNOT BE FOUND FOR ',A4)
1080  FORMAT(/,1X,28H****PROGRAM STORAGE EXCEEDED/ )
      END
      SUBROUTINE INITL
C
C     .... RENUMBER NODES AND SET UP SPARSE MATRIX INDICATORS
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON NROW(300),NCON(300),NSR(300),ISC(1600),NLC(300),ILR(600)
      COMMON /SPARSE/ IORD(300),NUR(300),NVV(16),IPOS(1600),IUC(600),
     1 IV(200)
      COMMON /NODES/ NREN(100),LNOD,NX,MDIM,NNOD,NUT,NLT,NVT
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1 ITR,IND,IBUG
      COMMON /ELMTS/ KIND(100),ND(100,4),VALU(100),NELT
      COMMON /DIODE/ NAMD(100),VALD(100,4),NDI(100,4),VDIO(100),
     1   CDIO(100),NDIOD
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1 VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
      COMMON /CSRCE/ CSRC(10),CLSRC(10),NAMC(10),TCUR(10,10),
     1 CVAL(10,10),NCVAL(10),KCUR(10),NCS(10,2),NCSC
      COMMON /JOBCNT/ TITLE(9),PRGVER,NALTR,IREQ,ISTOP
      LOGICAL IBUG,IREQ,ISTOP
      DIMENSION IFM(3)
C
C     .... SET UP NODE CHECKING AND RENUMBERING ARRAYS
C     .... LNOD IS THE INDICATOR FOR THE LARGEST NODE NUMBER
C     .... NREN(J)  =1 => VOLTAGE SOURCE HAS BEEN CONNECTED TO JTH NODE
C                   =0 => NO VOLTAGE SOURCE CONNECTED TO JTH NODE YET
C     .... NCON(J)=NUMBER OF ELEMENTS CONNECTED TO NODE J
      LNOD=0
      DO 105 I=1,100
      NREN(I)=0
105   NCON(I)=0
C     .... SET UP NODE CONNECTION DENSITY FOR GROUND AND V-SOURCES
      NREN(1)=1
      IF (NVSC.EQ.0) GO TO 115
      DO 110 I=1,NVSC
      N1=NV(I,1)+1
      NCON(N1)=NCON(N1)+1
      NCON(1)=NCON(1)+1
      IF (NREN(N1).EQ.0) GO TO 110
      WRITE (J6,420) NV(I,1)
      ISTOP=.TRUE.
110   NREN(N1)=1
C     .... SET UP CONNECTION DENSITY FOR CURRENT SOURCES
115   IF (NCSC.EQ.0) GO TO 125
      DO 120 I=1,NCSC
      N1=NCS(I,1)+1
      N2=NCS(I,2)+1
      NCON(N1)=NCON(N1)+1
      NCON(N2)=NCON(N2)+1
120   LNOD=MAX0(LNOD,N1,N2)
C     .... SET UP CONNECTION DENSITY  FOR ELEMENTS
125   IF (NELT.EQ.0) GO TO 132
      DO 130 I=1,NELT
      N1=ND(I,1)+1
      N2=ND(I,2)+1
      NCON(N1)=NCON(N1)+1
      NCON(N2)=NCON(N2)+1
130   LNOD=MAX0(LNOD,N1,N2)
C     .... SET UP CONNECTION DENSITY FOR DIODES
132   IF (NDIOD.EQ.0) GO TO 135
      DO 134 I=1,NDIOD
      N1=NDI(I,1)+1
      N2=NDI(I,2)+1
      NCON(N1)=NCON(N1)+1
      NCON(N2)=NCON(N2)+1
134   LNOD=MAX0(LNOD,N1,N2)
C     .... SET UP CONNECTION DENSITY  FOR TRANSISTORS
135   IF (NXTR.EQ.0) GO TO 145
      DO 140 I=1,NXTR
      N1=NQ(I,1)+1
      N2=NQ(I,2)+1
      N3=NQ(I,3)+1
      N4=NQ(I,4)+1
      NCON(N1)=NCON(N1)+1
      NCON(N2)=NCON(N2)+1
      NCON(N3)=NCON(N3)+1
      NCON(N4)=NCON(N4)+1
140   LNOD=MAX0(LNOD,N1,N2,N3,N4)
C
C     ... ESTABLISH COMPACT NODE NUMBERS BY ELIMINATING UNDEFINED NODE
C         NUMBERS, ALSO REORDER NODE NUMBERS  IN ASCENDING ORDER
C         I) USER DEFINED NODES NOT CONNECTED TO VOLTAGE SOURCE
C         II) INTERNAL NODES DUE TO DRAIN/SOURCE PARASITIC RESISTORS
C         III) NODES CONNECTED TO VOLTAGE SOURCE AND GROUND
C      .. MDIM REGISTERS THE NEXT REORDERED NODE NUMBER TO BE ASSIGNED
C      .. NREN(J) NOW REGISTER THE REORDERED NODE NUMBER CORRESPONDING
C         TO JTH INPUT DATA NODE
145   MDIM=0
      IF (NCON(1).LE.1) GO TO 390
      DO 160 I=2,LNOD
      IF (NREN(I).NE.0) GO TO 160
      IF (NCON(I)-1) 160,150,155
150   J=I-1
      WRITE (J6,410) J
      ISTOP=.TRUE.
155   MDIM=MDIM+1
      NREN(I)=MDIM
160   CONTINUE
C     ... CREATE TRANSISTOR INTERNAL NODES CORRESPONDING TO PARASITIC
C         DRAIN AND SOURCE NODES OF THE TRANSISTOR
C     ... NQ(J,5) IS THE INTERNAL NODE OF DRAIN  PARASITIC RESISTOR
C     ... NQ(J,6) IS THE INTERNAL NODE OF SOURCE PARASITC RESISTOR
C     ... NX IS MAXIMUM NUMBER OF NODES ASSIGNED
      NX=MDIM
      IF (NXTR.EQ.0) GO TO 185
      DO 180 I=1,NXTR
      IF (NQ(I,5).EQ.0) GO TO 170
      MDIM=MDIM+1
      NQ(I,5)=MDIM
170   IF (NQ(I,6).EQ.0) GO TO 180
      MDIM=MDIM+1
      NQ(I,6)=MDIM
180   CONTINUE
C
C     ... VOLTAGE SOURCE NODES WITH FIXED VOLTAGES
C         MDIM REGISTERS THE MAXIMUM NUMBER OF NODES WHICH VOLTAGES ARE
C          TO BE EVALUATED
C         NNOD REGISTERS THE TOTAL NUMBER OF NODES, INCLUDING PARASITIC
C          RESISTORS AND GROUND
185   NNOD=MDIM
      IF (NVSC.EQ.0) GO TO 195
      DO 190 I=1,NVSC
      N1=NV(I,1)+1
      NNOD=NNOD+1
190   NREN(N1)=NNOD
C     ... GROUND NODE
195   NNOD=NNOD+1
      NREN(1)=NNOD
      IF (NNOD.GT.250) GO TO 395
C
C     ... RENUMBER NODES TO THE REORDERED NODE NUMBERS
      IF (NELT.EQ.0) GO TO 202
      DO 200 I=1,NELT
      N1=ND(I,1)+1
      N2=ND(I,2)+1
      ND(I,1)=NREN(N1)
      ND(I,2)=NREN(N2)
200   CONTINUE
202   IF (NDIOD.EQ.0) GO TO 205
      DO 204 I=1,NDIOD
      N1=NDI(I,1)+1
      N2=NDI(I,2)+1
      NDI(I,1)=NREN(N1)
      NDI(I,2)=NREN(N2)
204   CONTINUE
205   IF (NXTR.EQ.0) GO TO 220
      DO 215 I=1,NXTR
      N1=NQ(I,1)+1
      N2=NQ(I,2)+1
      N3=NQ(I,3)+1
      N4=NQ(I,4)+1
      NQ(I,1)=NREN(N1)
      NQ(I,2)=NREN(N2)
      NQ(I,3)=NREN(N3)
      NQ(I,4)=NREN(N4)
      IF (NQ(I,5).EQ.0) NQ(I,5)=NQ(I,1)
210   IF (NQ(I,6).EQ.0) NQ(I,6)=NQ(I,3)
215   CONTINUE
220   IF (NCSC.EQ.0) GO TO 230
      DO 225 I=1,NCSC
      N1=NCS(I,1)+1
      N2=NCS(I,2)+1
      NCS(I,1)=NREN(N1)
225   NCS(I,2)=NREN(N2)
C
C     ... SET UP MATRIX STRUCTURE INDICATORS
C     ... NSR(I) REPRESENTS THE STARTING LOCATION IN THE SECOND POINTER
C         ARRAY, ISC OF TERMS ASSOCIATED WITH ROW I OF THE Y MATRIX
C     ... ISC(J) REPRESENTS THE COLUMN LOCATION OF THE JTH NONZERO
C         OFF-DIAGONAL TERMS IN EACH ROW OF THE ORIGINAL Y-MATRIX
C     ... NR IS THE INDICATOR FOR OFF DIAGONAL ELEMENTS
230   NE=MDIM+1
      DO 235 I=1,NE
235   NSR(I)=1
C
C     V-SOURCE MATRIX INDICATORS
C     NVV(I) STARTS AT ONE; NVV(I) REPRESENTS THE STARTING LOCATION
C     IN THE SECOND POINTER ARRAY, IV, OF TERMS ASSOCIATED WITH
C     THE ITHE VOLTAGE SOURCE OF THE ADMITTANCE MATRIX
C
C     IV(J) REPRESENTS THE COLUMN LOCATION OF THE JTH NON-ZERO
C     OFF DIAGONAL TERM IN EACH ROW, ASSOCIATED WITH VOLTAGE SUPPLY
C
      NE=NVSC+1
      DO 240 I=1,NE
240   NVV(I)=1
C
C     RESERVE SPACE FOR PASSIVE ELEMENTS
C
      IF (NELT.EQ.0) GO TO 270
      DO 250 I=1,NELT
      CALL RESV(ND(I,1),ND(I,2))
250   CONTINUE
C
C     RESERVE SPACE FOR DIODES
C
270   IF (NDIOD.EQ.0) GO TO 290
      DO 280 I=1,NDIOD
      CALL RESV(NDI(I,1),NDI(I,2))
280   CONTINUE
C
C     RESERVE SPACE FOR TRANSISTORS
C
290   IF (NXTR.EQ.0) GO TO 365
      DO 360 I=1,NXTR
      NXD=NQ(I,1)
      NG=NQ(I,2)
      NXS=NQ(I,3)
      NB=NQ(I,4)
      NID=NQ(I,5)
      NIS=NQ(I,6)
      CALL RESV(NXD,NID)
      CALL RESV(NXS,NIS)
      CALL RESV(NG,NB)
      CALL RESV(NG,NID)
      CALL RESV(NG,NIS)
      CALL RESV(NB,NID)
      CALL RESV(NB,NIS)
      CALL RESV(NID,NIS)
360   CONTINUE
C     WRITE (J6,366) (NSR(I),I=1,100),(ISC(I),I=1,300),
C    1 (NVV(I),I=1,16),(IV(I),I=1,100)
C366  FORMAT (' NSR='/5(20I5/)/' ISC='/15(20I5/)/
C    1 ' NVV=',16I5/' IV='/5(20I5/))
365   CONTINUE
C     NSR(NNOD)=NR+1
C
C     ... DETERMINE INDICATORS FOR MATRIX REDUCTION
      CALL INDMT (ISTOP)
      IF (ISTOP) GO TO 405
C
C     ... ASSIGN MATRIX LOCATION NUMBERS
      IF (NELT.EQ.0) GO TO 372
      DO 370 I=1,NELT
      N1=ND(I,1)
      N2=ND(I,2)
      ND(I,3)=INDX(N1,N2)
      ND(I,4)=INDX(N2,N1)
370   CONTINUE
372   IF (NDIOD.EQ.0) GO TO 375
      DO 374 I=1,NDIOD
      N1=NDI(I,1)
      N2=NDI(I,2)
      NDI(I,3)=INDX(N1,N2)
      NDI(I,4)=INDX(N2,N1)
374   CONTINUE
375   IF (NXTR.EQ.0) GO TO 385
      DO 380 I=1,NXTR
C     ... INTRINSIC XTR
      N2=NQ(I,2)
      N5=NQ(I,5)
      N4=NQ(I,4)
      N6=NQ(I,6)
      NQ(I,7)=INDX(N2,N4)
      NQ(I,8)=INDX(N2,N5)
      NQ(I,9)=INDX(N2,N6)
      NQ(I,10)=INDX(N4,N2)
      NQ(I,11)=INDX(N4,N5)
      NQ(I,12)=INDX(N4,N6)
      NQ(I,13)=INDX(N5,N2)
      NQ(I,14)=INDX(N5,N4)
      NQ(I,15)=INDX(N5,N6)
      NQ(I,16)=INDX(N6,N2)
      NQ(I,17)=INDX(N6,N4)
      NQ(I,18)=INDX(N6,N5)
C     ... RESISTANCES
      N1=NQ(I,1)
      N3=NQ(I,3)
      NQ(I,19)=INDX(N1,N5)
      NQ(I,20)=INDX(N5,N1)
      NQ(I,21)=INDX(N3,N6)
      NQ(I,22)=INDX(N6,N3)
C     WRITE (J6,376) I,(NQ(I,J),J=1,22)
C376  FORMAT (' XTR # ',I5,' NQ =',22I4)
380   CONTINUE
385   RETURN
C
390   WRITE (J6,415)
      GO TO 400
395   WRITE (J6,425)
400   ISTOP=.TRUE.
405   RETURN
C
410   FORMAT (/1X,8H****NODE,I3,12H IS SINGULAR/)
415   FORMAT (/1X,28H****CIRCUIT NOT GROUNDED****/)
420   FORMAT (/1X,30H****MULTIPLE V-SOURCES AT NODE,I3/)
425   FORMAT (/1X,31H****NUMBER OF NODES EXCEEDS 250/)
      END
      SUBROUTINE INDMT (ISTOP)
C
C     .... ESTABLISH MATRIX REDUCTION INDICATORS FOR OPTIMUM STRUCTURE
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON NROW(300),NCON(300),NSR(300),ISC(1600),NLC(300),ILR(600)
      COMMON /SPARSE/ IORD(300),NUR(300),NVV(16),IPOS(1600),IUC(600),
     1 IV(200)
      COMMON /NODES/ NREN(100),LNOD,NX,MDIM,NNOD,NUT,NLT,NVT
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1 ITR,IND,IBUG
      COMMON /ELMTS/ KIND(100),ND(100,4),VALU(100),NELT
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1 VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
      LOGICAL IBUG,ISTOP
C
C     ... SET UP INDICATORS FOR V-SOURCES
C     ... NL IS THE NUMBER OF NON-ZERO OFF-DIAGONAL MATRIX ELEMENTS
C         NOT CONNECTED TO VOLTAGE SOURCE AT EITHER TERMINAL
C     ... NU IS THE NUMBER OF FIXED VOLTAGE NODES,INCLUDING GROUND
C     ... NVT COUNTS THE NUMBER OF OFF-DIAGONAL TERMS CONNECTED TO
C         VOLTAGES SOURCES IN THE LOWER TRIANGULAR MATRIX
C     ... NVV AND IV WORK JUST THE SAME AS NSR AND ISC; THEY ARE FOR
C         ELEMENTS CONNECTED TO VOLTAGE SOURCE AT EITHER TERMINAL
C     ... NVV(1) STARTS AT ONE; NVV(I) REPRESENTS THE STARTING LOCATION
C         IN THE SECOND POINTER ARRAY,IV, OF TERMS ASSOCIATED WITH THE
C         ITH VOLTAGE SOURCE OF THE ADMITTANCE MATRIX
C     ... IV(J) REPRESENTS THE COLUMN LOCATION OF THE JTH NON-ZERO
C         OFF-DIAGONAL TERMS IN EACH ROW,ASSOCIATED WITH VOLTAGE SUPPLY
C     NVT=0
C     IF (NVSC.EQ.0) GO TO 120
C     NL=NSR(MDIM+1)-1
C     NU=NVSC+1
C     DO 105 I=1,NU
C105  NVV(I)=NSR(MDIM+I)-NL
C     N=NL+1
C     NLE=NSR(NNOD)-1
C110  IF (N-NLE) 115,115,120
C115  NVT=NVT+1
C     IV(NVT)=ISC(N)
C     N=N+1
C     GO TO 110
C
C      NU AND NL ARE COUNTERS FOR IUC AND ILR RESPECTIVELY
C
      NU=1
      NL=1
      NPS=0
      MP1=MDIM+1
      MD1=MDIM-1
      IF (MDIM.LE.0) GO TO 217
C
C     ... COUNT OFF DIAGONAL ELEMENTS
C     ... NROW(J) IS THE NUMBER OF ELEMENTS IN THE ITH ROW
120   DO 125 I=1,MDIM
      IORD(I)=I
      NCON(I)=I
      NROW(I)=NSR(I+1)-NSR(I)
125   CONTINUE
C
C     ... COLUMN AND ROW RENUMBERING AND INDICATOR SET-UP
C         (REFER TO BERRY'S PAPER, IEEE TRANSACTIONS ON CIRCUIT THEORY,
C          JANUARY 1971)
C     ... NROW(J) IS THE ARRAY INDICATING THE EFFECTIVE NUMBER OF
C         NONZERO OFF-DIAGONAL TERMS LEFT IN ROW J AT ANY SIMULATED
C         STAGE OF THE DECOMPOSITION; THE J IS THE ORIGINAL NODE NUMBER
C     ... NUR(J) IS THE ARRAY INDICATING THE STARTING LOCATION OF TERMS
C         IN IUC(K) ASSOCIATED WITH ROW J OF THE UPPER TRIANGULAR MATRIX
C         IUC(I) IS THE ARRAY INDICATING THE COLUMN LOCATION OF THE
C         TERMS IN UPPER TRIANGULAR MATRIX, ARRANGED BY ROW
C     ... NLC(J) IS THE ARRAY INDICATING THE STARTING LOCATION OF TERMS
C         IN ILR(K) ASSOCIATED WITH COLUMN J OF THE LOWER TRIAN. MATRIX
C         ILR(K) IS THE ARRAY INDICATING THE ROW LOCATION OF THE TERMS
C         IN LOWER TRIANGULAR MATRIX, ARRANGED BY COLUMN
      IF (MD1.LE.0) GO TO 215
      DO 210 I=1,MD1
      NUR(I)=NU
      NLC(I)=NL
      JS=I+1
      L=IORD(I)
C     ... SEARCH FOR MINIMUM  NROW
C     ... IORD(J) AND NCON(K) INDICATED THE REORDERED NODE NUMBER FOR
C         ROWS AND COLUMNS FOR ANALYSIS OF JTH ROW OR COLUMN
      DO 135 J=JS,MDIM
      IR=IORD(J)
      IF (NROW(IR).GE.NROW(L)) GO TO 135
      IORD(J)=L
      NCON(L)=J
      IORD(I)=IR
      NCON(IR)=I
      L=IR
135   CONTINUE
      NPAS=0
C     ... PART I OF THE ALGORITHM
      DO 205 J=JS,MDIM
      IR=IORD(J)
      IF (LOC(IR,L).EQ.0) GO TO 205
C     ... FOR LOWER TRIANGULAR MATRIX, NONZERO OFF-DIAGONAL ELEMENT
C         FOUND, DO THE BOOKKEEPING AND ADJUST NROW
      ILR(NL)=IR
      NROW(IR)=NROW(IR)-1
      NL=NL+1
      IF (NPAS.NE.0) GO TO 165
      DO 160 K=JS,MDIM
      IC=IORD(K)
      IF (LOC(L,IC).EQ.0) GO TO 160
C     ... FOR UPPER TRIANGULAR MATRIX, NONZERO OFF-DIAGONAL ELEMENT
C         FOUND, DO THE BOOKKEEPING
      IUC(NU)=IC
C     ... CHECK IF NEW NON-ZERO OFF-DIAGONAL ELEMENT IS GENERATED
      IF (IR.EQ.IC) GO TO 155
      IF (LOC(IR,IC).NE.0) GO TO 155
C     ... ADJUST NROW
      NROW(IR)=NROW(IR)+1
C     ... ADJUST THE ORIGINAL BOOKKEEPING FOR THE ADDITION OF ONE MORE
C         NON-ZERO OFF-DIAGONAL ELEMENT
      IRS=IR+1
      DO 140 IT=IRS,MP1
140   NSR(IT)=NSR(IT)+1
      NS=NSR(IRS)
      N=NSR(MP1)
143   N=N-1
      IF (N.LT.NS) GO TO 150
145   ISC(N)=ISC(N-1)
      GO TO 143
150   ISC(N)=IC
155   NU=NU+1
      NPS=NPS+1
160   CONTINUE
      NPAS=1
      GO TO 205
165   NCT=NUR(I)
170   IF (NCT.GE.NU) GO TO 205
      IC=IUC(NCT)
C     ... CHECK IF NEW NON-ZERO OFF-DIAGONAL ELEMENT IS GENERATED
      IF (IR.EQ.IC) GO TO 200
      IF (LOC(IR,IC).NE.0) GO TO 200
C     ... ADJUST NROW
      NROW(IR)=NROW(IR)+1
C     ... ADJUST THE ORIGINAL BOOKEEEPING FOR THE ADDITION OF ONE MORE
C         NON-ZERO OFF-DIAGONAL ELEMENT
      IRS=IR+1
C     MP1=MDIM+1
      DO 180 IT=IRS,MP1
180   NSR(IT)=NSR(IT)+1
      NS=NSR(IRS)
      N=NSR(MP1)
185   N=N-1
      IF (N.LT.NS) GO TO 195
      ISC(N)=ISC(N-1)
      GO TO 185
195   ISC(N)=IC
200   NCT=NCT+1
      NPS=NPS+1
      GO TO 170
205   CONTINUE
210   CONTINUE
C
215   NLC(MDIM)=NL
      NUR(MDIM)=NU
 217  NUT=NU-1
      NLT=NL-1
      NVT=NVV(NVSC+1)-1
      WRITE (J6,260) NUT,NLT,NVT,NPS
      IF (NVT.GT.200) GO TO 250
      IF (NUT.GT.600) GO TO 250
      IF (NPS.GT.1600) GO TO 250
C
C     ... ASSIGN OPERATION NUMBERS
      IF (MD1.LE.0) GO TO 245
      NPS=0
      DO 240 I=1,MD1
      NUS=NUR(I)
      NUE=NUR(I+1)
      NL=NLC(I)
      NLE=NLC(I+1)
220   IF (NL-NLE) 225,240,240
225   IR=ILR(NL)
      NL=NL+1
      NU=NUS
230   IF (NU-NUE) 235,220,220
235   IC=IUC(NU)
      NPS=NPS+1
      IPOS(NPS)=INDX(IR,IC)
      NU=NU+1
      GO TO 230
240   CONTINUE
245   RETURN
C
250   WRITE (J6,255)
      ISTOP=.TRUE.
      RETURN
C
C
255   FORMAT (/1X,24H****MATRIX TOO DENSE****/)
260   FORMAT (/1X,4HNU =,I4,6H  NL =,I4,7H   NV =,I4,7H  NPS =,I5/)
      END
      SUBROUTINE RESV(N1,N2)
C
C     SET UP MATRIX STRUCTURE INDICATORS
C
      IMPLICIT REAL*8(A-H,O-Z)
      COMMON NROW(300),NCON(300),NSR(300),ISC(1600)
      COMMON /SPARSE/ IORD(300),NUR(300),NVV(16),IPOS(1600),IUC(600),
     1   IV(200)
      COMMON /NODES/ NREN(100),LNOD,NX,MDIM,NNOD,NUT,NLT,NVT
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1   VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
C
C     CHECK FOR DIAGONAL ELEMENT, ETC
C
      IF (N1-N2) 10,290,20
10    IR=N1
      IC=N2
      GO TO 30
20    IR=N2
      IC=N1
30    IF (IC-MDIM) 100,100,40
40    IF (IC.EQ.NNOD) GO TO 290
C
C     VOLTAGE SOURCE TERMS
C
      IC=IC-MDIM
      N=NVV(IC)
      NX=NVV(IC+1)
45    IF (N-NX) 50,60,60
50    IF (IR.EQ.IV(N)) GO TO 290
      N=N+1
      GO TO 45
60    IC=IC+1
      IE=NVSC+1
      DO 65 I=IC,IE
65    NVV(I)=NVV(I)+1
      NX=NVV(IC)
      N=NVV(IE)
70    N=N-1
      IF (N-NX) 80,75,75
75    IV(N)=IV(N-1)
      GO TO 70
80    IV(N)=IR
      RETURN
C
C     REGULAR TERMS
C
100   N=NSR(IR)
      NX=NSR(IR+1)
110   IF (N-NX) 115,120,120
115   IF (IC.EQ.ISC(N)) GO TO 290
      N=N+1
      GO TO 110
120   IS=IC+1
      IE=MDIM+1
      DO 125 I=IS,IE
125   NSR(I)=NSR(I)+1
      NX=NSR(IS)
      N=NSR(IE)
130   N=N-1
      IF (N-NX) 140,135,135
135   ISC(N)=ISC(N-1)
      GO TO 130
140   ISC(N)=IR
      IS=IR+1
      DO 145 I=IS,IE
145   NSR(I)=NSR(I)+1
      NX=NSR(IS)
      N=NSR(IE)
150   N=N-1
      IF (N-NX) 160,155,155
155   ISC(N)=ISC(N-1)
      GO TO 150
160   ISC(N)=IC
C
290   RETURN
      END
      FUNCTION INDX (IR,IC)
C
C     .... OBTAINS MATRIX LOCATIONS
C
      COMMON NROW(300),NCON(300),NSR(300),ISC(1600),NLC(300),ILR(600)
      COMMON /SPARSE/ IORD(300),NUR(300),NVV(16),IPOS(1600),IUC(600),
     1 IV(200)
      COMMON /NODES/ NREN(100),LNOD,NX,MDIM,NNOD,NUT,NLT,NVT
C
      IF (IR.EQ.IC) GO TO 175
      IF (IR.GT.MDIM) GO TO 150
C     IF (IC.GE.NNOD) GO TO 180
      IF (IC.GT.MDIM) GO TO 155
      IS=NCON(IR)
      JS=NCON(IC)
      IF (JS.GE.IS) GO TO 120
C     ... LOWER TRIANGLE
      N=NLC(JS)
      NE=NLC(JS+1)
100   IF (N.GE.NE) GO TO 180
      IF (IR.EQ.ILR(N)) GO TO 110
      N=N+1
      GO TO 100
110   INDX=600+N
      RETURN
C     ... UPPER TRIANGLE
120   N=NUR(IS)
      NE=NUR(IS+1)
130   IF (N.GE.NE) GO TO 180
      IF (IC.EQ.IUC(N)) GO TO 140
      N=N+1
      GO TO 130
140   INDX=N
      RETURN
C     ... VOLTAGE SOURCE NODES
150   IF (IC.GT.IR) GO TO 155
      NS=1400
      IS=IC
      JS=IR
      GO TO 160
155   NS=1200
      IS=IR
      JS=IC
160   IF (JS.EQ.NNOD) GO TO 180
      JS=JS-MDIM
      N=NVV(JS)
      NE=NVV(JS+1)
165   IF (N.GE.NE) GO TO 180
      IF (IS.EQ.IV(N)) GO TO 170
      N=N+1
      GO TO 165
170   INDX=NS+N
      RETURN
C     ... DIAGONAL ELEMENT
175   INDX=1600+IR
      RETURN
C     ... UNUSED LOCATION
180   INDX=1600+NNOD
      RETURN
      END
      FUNCTION LOC(IR,IC)
C
C     ... TEST FOR NON-ZERO MATRIX ELEMENT
C     ... RETURN 0 FOR NO ELEMENT,RETURN ONE  OTHERWISE
C
      COMMON NROW(300),NCON(300),NSR(300),ISC(1600)
      N=NSR(IR)
      NE=NSR(IR+1)
200   IF (N.GE.NE) GO TO 220
      IF (IC.EQ.ISC(N)) GO TO 290
      N=N+1
      GO TO 200
220   LOC=0
      RETURN
290   LOC=1
      RETURN
      END
      SUBROUTINE CKTMOD(MODE)
C
C...  SET UP THE EQUIVALENT CIRCUIT FOR TRANSISTOR MODEL
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON Y(600),YL(600),YV(200),YC(200),YD(250),V(250),VCUR(10),
     1   V1(250),VPI(250),
     1   VGS(100),VDS(100),VSB(100),CDS(100)
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1   ITR,IND,IBUG
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,ICONV,ICHAR
      COMMON /NAMES/ NAME(100),NAMQ(100),MODN(100),NAMB(30),NMOD
      COMMON /STORE/ LQ(100,4),LD(100,2),LC(10,2),XALU(100),LCL(10),
     1   LVL(10),LDI(100,2),TC1(100),TC2(100),TEMPE(10),NTMP,KTMP
      COMMON /MODELS/ VTO(30,1),UB(30,5),COX(30,1),
     1   DNB(30,1),CJUN(30,1),XJD(30,1),XJS(30,1),XJN(30,1),GDS(30,3),
     1   CSS(30,1),TEMP(30,1)
      COMMON /MODPR/ BETA(100),PHI(30),VFB(30),VCRIT(30),GAMA(30),
     1   CIS(30),NTYP(30),E40
      COMMON /VSRCE/VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1   VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
      COMMON /JOBCNT/ TITLE(9),PRGVER,NALTR,IREQ,ISTOP
      LOGICAL IBUG,ICHAR,IREQ,ISTOP
      EQUIVALENCE (VLSRC(1),CIDS),(VLSRC(2),GM),(VLSRC(3),GG),
     1            (VLSRC(4),GMB),(VLSRC(5),VDSAT),(VLSRC(6),CJDB),
     2            (VLSRC(7),CJSB),(VLSRC(8),CGB),(VLSRC(9),CGD),
     3            (VLSRC(10),CGS)
C
C...  INITIAL CHECK
C
C...  MODE = 0 => DC TRANSISTOR MODEL IS NEEDED
C          = 1 => TRANSIENT TRANSISTOR MODEL IS NEEDED
C...  IND  = 0 => INTERNAL PARAMETER VALUES HAVE TO BE OBTAINED
C     IBUG = .TRUE => DEBUG OPTION ENABLED
C
C     IBUG=.FALSE.
      IF (NXTR.EQ.0) RETURN
      IF (IND.NE.0) GO TO 200
      TEMPER=TEMPE(KTMP)
      VT=8.6164E-5*TEMPER
      RATIO=(TEMPER/300.)**1.5
      FACTOR=RATIO*DEXP(1.1/(2*8.6164E-5)*(1/300.-1/TEMPER))
      DNI=1.45E10*FACTOR
      E40=DEXP(4D1)
      WRITE (J6,100)
  100 FORMAT ('1MODEL AND TRANSISTOR PARAMETERS')
      DO 125 I=1,NMOD
C
C...  CALCULATE INVERSION POTENTIAL
C
      PHI(I)=2*VT*DLOG(DNB(I,1)/DNI)
      IF (KTMP.GT.1) GO TO 105
C
C...  CALCULATE BODY EFFECT COEFFICIENT
C
      GAMA(I)=5.76E-16*DSQRT(DNB(I,1))/COX(I,1)
C
C...  CALCULATE FLATBAND VOLTAGE
C
      X1=GAMA(I)*DSQRT(PHI(I))
      IF (NTYP(I).EQ.0) VFB(I)=VTO(I,1)+X1
      IF (NTYP(I).NE.0) VFB(I)=VTO(I,1)-X1
C
C...  CALCULATER CRITICAL VOLTAGE FOR MOBILITY VARIATION
C
      VCRIT(I)=UB(I,3)*0.346E-12/COX(I,1)
C
C...  GET REVERSE SATURATION CURRENT FOR DIODES
C
      CIS(I)=CSS(I,1)
C     GO TO 110
C
C...  PUT IN TEMPERATURE EFFECTS
C
C...  REVERSE SATURATION CURRENT IS MODIFIED
C
  105 RATIO=TEMPER/TEMP(I,1)
      FACTOR=RATIO**3*DEXP(1.1/8.6164E-5*(1/TEMP(I,1)-1/TEMPER))
      CIS(I)=CSS(I,1)*FACTOR
  110 CONTINUE
       WRITE (J6,115) NAMB(I),PHI(I),GAMA(I),VFB(I),VCRIT(I),
     1   CIS(I)
  115 FORMAT (' MODEL ',A4,' PHI GAMMA VFB VCRIT CIS ',5E15.5)
  125 CONTINUE
      DO 195 K=1,NXTR
      I=MREF(K)
C     IF (KTMP.GT.1) GO TO 140
C
C...  CALCULATE BETA AT LOW GATE VOLTAGE
C
      XLENG=XPARA(K,2)-2.*XJN(I,1)
      IF (XLENG.GT.0.) GO TO 135
      WRITE (J6,130) NAMQ(K)
130   FORMAT ('0 **** ERROR : CHANNEL LENGTH OF ',A4,'  < 0')
      ISTOP=.TRUE.
135   CONTINUE
      BETA(K)=XPARA(K,1)*UB(I,1)*COX(I,1)/XLENG
C     GO TO 145
      RATIO=TEMPER/TEMP(I,1)
  140 BETA(K)=BETA(K)*RATIO**(-2.5)
  145  WRITE (J6,150) NAMQ(K),XPARA(K,1),XPARA(K,2),BETA(K)
  150 FORMAT (' TRANSISTOR ',A4,' Z L BETA ',3E15.5)
  155 CONTINUE
  195 CONTINUE
C
C...  REFER TO COMMON BLOCK VARIABLE FUNCTIONS FOR NQ'S
C
  200 DO 990 K=1,NXTR
      I=MREF(K)
      NT=NQ(K,23)
      N1=NQ(K,1)
      NG=NQ(K,2)
      N3=NQ(K,3)
      NB=NQ(K,4)
      ND=NQ(K,5)
      NS=NQ(K,6)
      N7=NQ(K,7)
      N8=NQ(K,8)
      N9=NQ(K,9)
      N10=NQ(K,10)
      N11=NQ(K,11)
      N12=NQ(K,12)
      N13=NQ(K,13)
      N14=NQ(K,14)
      N15=NQ(K,15)
      N16=NQ(K,16)
      N17=NQ(K,17)
      N18=NQ(K,18)
      N19=NQ(K,19)
      N20=NQ(K,20)
      N21=NQ(K,21)
      N22=NQ(K,22)
C
C...  GET NEXT VOLTAGE FOR ANALYSIS
C
  210 PGS=V1(NG)-V1(NS)
      PDS=V1(ND)-V1(NS)
      PSB=V1(NS)-V1(NB)
      IF (NT.NE.0) GO TO 220
      PGS=-PGS
      PDS=-PDS
      PSB=-PSB
  220 PFB=VFB(I)
      PHIL=PHI(I)
      IF (NT.EQ.0) PFB=-PFB
      IF (IBUG) WRITE (J6,224) K,PGS,PDS,PSB
 224  FORMAT (' K VGS VDS VSB ',I5,2X,3F7.3)
  280 PGD=PGS-PDS
      PDB=PSB+PDS
  340 VGS(K)=PGS
      VDS(K)=PDS
      VSB(K)=PSB
      IF (IBUG) WRITE (J6,345) K,PGS,PDS,PSB
  345 FORMAT (1H+,50X,I5,2X,3F7.3)
C
C...  CHECK IF THE TRANSISTOR IS OPERATING IN INVERSION MODE
C...  INV = 1 => INVERSE REGION OPERATION
C...  EXCHANGE DRAIN AND SOURCE FOR DC MODEL IF INVERSE MODE OPERATION
C
  350 INV=0
      IF (PDS.GE.0.0) GO TO 355
      X1=PGD
      PGD=PGS
      PGS=X1
      X1=PDB
      PDB=PSB
      PSB=X1
      PDS=-PDS
      INV=1
C
C...  DEFINE VARIABLES FOR CHECKING CUT-OFF REGION
C
  355 WIDTH=XPARA(K,1)
      XLENG=XPARA(K,2)-2.*XJN(I,1)
      VGST=PGS-PFB
      VSBF=PSB+PHIL
      IF (VSBF.LT.0.0) VSBF=0.0
      VSBFRT=DSQRT(VSBF)
      GAM=GAMA(I)
      GAMSQ=GAM*GAM
C
C...  CHECK FOR CUT-OFF REGION
C
      IF (VGST.LE.GAM*VSBFRT) GO TO 370
C
C...  DEFINE VARIABLES FOR CHECKING SATURATION REGION AND VARIABLES
C            USED FOR BOTH REGIONS
C
      ARG=DSQRT(1+4*(VGST+VSBF)/GAMSQ)
      SARG=(1-1/ARG)
      VDSAT=VGST+GAMSQ*(1-ARG)/2
C
C     CHECK FOR VELOCITY SATURATION
C
      IF (UB(I,5).EQ.0.) GO TO 356
      VC=UB(I,5)*XLENG
      VD=DSQRT(VDSAT*VDSAT+VC*VC)
      ARGS=1+VDSAT/VD
      VDSAT=VDSAT+VC-VD
C
      SARG=SARG*ARGS
      ARG=ARG/ARGS
  356 CONTINUE
C...  MOBILITY VARIATION DUE TO GATE VOLTAGE
      XBETA=BETA(K)
      IUB=UB(I,2)+0.5
      IF (IUB.EQ.0) GO TO 359
      X1=PDS
      IF (PDS.GT.VDSAT) X1=VDSAT
      X1=VGST-0.5*X1
      IF (IUB.NE.2) GO TO 357
      IF (UB(I,4).EQ.0.) GO TO 359
      IF (X1.GT.VCRIT(I)) XBETA=XBETA*(VCRIT(I)/X1)**UB(I,4)
      GO TO 359
357   IF (IUB.NE.1) GO TO 359
      IF (X1.GT.0D0) XBETA=XBETA/(1D0+UB(I,3)*X1)
359   CONTINUE
C
C...  CHECK FOR SATURATION REGION
C
      IF (PDS.GT.VDSAT) GO TO 400
C
C...  LINEAR REGION
C
      VDBF=PDB+PHIL
      IF (VDBF.LT.0.0) VDBF=0.0
      VDBFRT=DSQRT(VDBF)
      IF (IBUG) WRITE (J6,360)
  360 FORMAT (' TRIODE REGION')
      CIDS=XBETA*((VGST-0.5*PDS)*PDS-2*GAM*(VDBF*VDBFRT-
     1   VSBF*VSBFRT)/3)
      GM=XBETA*PDS
      GG=XBETA*(VGST-PDS-GAM*VDBFRT)
      GMB=-XBETA*GAM*(VDBFRT-VSBFRT)
      GO TO 450
C
C...  CUTOFF REGION
C
  370 CONTINUE
      IF (IBUG) WRITE (J6,375)
  375 FORMAT (' CUTOFF REGION')
      GM=0D0
      GG=1D-12
      GMB=0D0
      CIDS=GG*PDS
      GO TO 450
C
C...  SATURATED REGION
C
  400 IF (IBUG) WRITE (J6,405)
  405 FORMAT (' SAT REGION')
C
C...  DEFINE USEFUL PARAMETERS FOR SATURATED REGION
C...  CURRENT JUST AT SATURATION IS CALCULATED
C
      VDBF=VSBF+VDSAT
      IF (VDBF.LT.0.0) VDBF=0.0
      VDBFRT=DSQRT(VDBF)
      CIDS=XBETA*((VGST-VDSAT/2)*VDSAT-2*GAM*(VDBF*VDBFRT-
     1   VSBF*VSBFRT)/3)
C
C...  GET CONDUCTANCE AND TRANSCONDUCTANCES AT SATURATION POINT
C
      GG=1.D-12
      GM=XBETA*(VDSAT+(VGST-VDSAT-GAM*VDBFRT)*SARG)
      GMB=-XBETA*((VGST-VDSAT-GAM*VDBFRT)/ARG+GAM*(VDBFRT-VSBFRT))
C
C...  CHECK FOR CHANNEL LENGTH DEPLETION EQUATION
C
C...  NO CHANNEL LENGTH DEPLETION
C
  410 IF (GDS(I,1).EQ.0) GO TO 450
C
C...  FRINGING FIELD EQUATION AS SUFFESTED BY FROHMAN
C
      IF (GDS(I,1).EQ.2.) GO TO 425
C
C...  DEPLETION LAYER SQUARE ROOT DEPENDENCE
C
  420 XK=DSQRT(1.3E7/DNB(I,1))
      DVDS=DSQRT(PDS-VDSAT)
      DEPL=XK*DVDS
      FACTOR=(1-DEPL/XLENG)
      CIDS=CIDS/FACTOR
      GG=XK*CIDS/(2*XLENG*FACTOR*DVDS)
      GM=GM/FACTOR-GG*SARG
      GMB=GMB/FACTOR+GG/ARG
      GO TO 450
C
C...  EQUATION AS SUGGESTED BY FROHMAN, MODIFIED
C
  425 ARG1=GDS(I,2)
      ARG2=GDS(I,3)
      DEPL=1.04E-12/(COX(I,1)*XLENG)
      FDEP=ARG1*(PDS-VGST)+ARG2*(VGST-VDSAT)
      FACTOR=1-DEPL*(PDS-VDSAT)/FDEP
      CIDS=CIDS/FACTOR
      DEPL=DEPL*CIDS/(FDEP*FDEP)
      GG=DEPL*(ARG2-ARG1)*(VGST-VDSAT)/FACTOR
      GM=(GM-DEPL*(FDEP*SARG+(PDS-VDSAT)*(ARG2/ARG-ARG1)))/FACTOR
      GMB=(GMB+DEPL*(ARG1-ARG2)*(PDS-VGST)/ARG)/FACTOR
  450 CDSO=CIDS-GM*PGS-GG*PDS-GMB*PSB
      IF (IBUG) WRITE (J6,451) GM,GG,GMB,CDSO,CIDS
  451 FORMAT ('  GM,GG,GMB,CDSO,CIDS',5E15.5)
C
C...  CONVERT BACKWARDS FOR INVERSE REGION OPERATION
C
      GMI=0.0
      GMBI=0.0
      IF (INV.NE.1) GO TO 500
      GMI=GM
      GM=0.0
      GMBI=GMB
      GMB=0.0
      CIDS=-CIDS
      CDSO=-CDSO
  500 CONTINUE
C
C...  LINEARIZATION FOR D-B AND S-B DIODE MODELS
C
      IF (INV.NE.1) GO TO 550
      X1=PSB
      PSB=PDB
      PDB=X1
  550 CC=CIS(I)
      IF (PDB.GE.0.) GO TO 555
      IF (PDB.LE.-40*VT) GO TO 553
      CD=CC*(DEXP(-PDB/VT)-1.)
      GDB=(CD+CC)/VT
      CD=CD+GDB*PDB
      GO TO 560
 553  GDB=CC*E40/VT
      CD=-39*VT*GDB
      GO TO 560
  555 GDB=CC/VT
      CD=0.0
      IF (PDB.GT.VT) CD=-CC+GDB*PDB
  560 IF (PSB.GE.0.) GO TO 565
      IF (PSB.LE.-40*VT) GO TO 563
      CS=CC*(DEXP(-PSB/VT)-1.)
      GSB=(CS+CC)/VT
      CS=CS+GSB*PSB
      GO TO 570
  563 GSB=CC*E40/VT
      CS=-39*VT*GSB
      GO TO 570
  565 GSB=CC/VT
      CS=0.0
      IF (PSB.GT.VT) CS=-CC+GSB*PSB
  570 CONTINUE
      IF (IBUG) WRITE(J6,575) GDB,CD,GSB,CS
  575 FORMAT(' GDB CD GSB CS ',4E15.5)
C
C...  PRESET EQUIVALENT CAPACITOR CONDUCTANCES AND CURRENT SOURCES
C
      GGB=0.0
      CIGB=0.0
      GGS=0.0
      CIGS=0.0
      GGD=0.0
      CIGD=0.0
      CGB=0.0
      CGS=0.0
      CGD=0.0
      CJDB=0.0
      CJSB=0.0
C
C...  CHECK IF CHARACTERISTICS PLOT-OUT IS NEEDED
C
      IF (ICHAR) GO TO 600
C
C...  CHECK IF TRANSIENT MODEL IS NEEDED
C
      IF (MODE.EQ.0) GO TO 900
  580 PHIJ=0.55+PHIL/2
      OGS=VPI(NG)-VPI(NS)
      ODS=VPI(ND)-VPI(NS)
      OSB=VPI(NS)-VPI(NB)
      IF (NT.NE.0) GO TO 590
      OGS=-OGS
      ODS=-ODS
      OSB=-OSB
  590 IF (IBUG) WRITE (J6,224) K,OGS,ODS,OSB
C
C...  DRAIN-BULK JUNCTION CAPACITOR
C
600   CJDB=0.
      CJSB=0.
      CJJ=CJUN(I,1)
      IF (CJJ.EQ.0.) GO TO 650
      CJDB=XPARA(K,5)*CJJ
      IF (CJDB.LE.0.0) GO TO 625
      VQT=PDB/PHIJ
      IF (VQT.LT.-.5) GO TO 605
      CJDB=CJDB/DSQRT(1+VQT)
      GO TO 610
  605 CJDB=CJDB*(0.5-VQT)*1.414
C...  CHECK IF THIS IS DC MODEL, NO CAPACITATIVE LINEARIZATION
C              FOR MODE=0
  610 IF (ICHAR) GO TO 625
      X1=CJDB/DELT
      GDB=GDB+X1
      CD=CD+X1*(ODS+OSB)
C
C...  SOURCE-BULK JUNCTION CAPACITOR
C
  625 CJSB=XPARA(K,6)*CJJ
      IF (CJSB.LE.0.0) GO TO 650
      VQT=PSB/PHIJ
      IF(VQT.LT.-.5) GO TO 630
      CJSB=CJSB/DSQRT(1+VQT)
      GO TO 635
  630 CJSB=CJSB*(0.5-VQT)*1.414
  635 IF (ICHAR) GO TO 650
      X1=CJSB/DELT
      GSB=GSB+X1
      CS=CS+X1*OSB
  650 IF (IBUG) WRITE(J6,640) CJDB,GDB,CD,CJSB,GSB,CS
  640 FORMAT (' CJDB GDB CD CJSB GSB CS ',6E15.5)
C
C...  GATE CAPACITORS
C
      CAP=COX(I,1)*XLENG*WIDTH
      CAP1=2.*CAP/3.
      VGSH=VGST-GAM*VSBFRT
C
C     GET CGS AND CGD AT VGS=VTH
C
      CGS1=CAP1
      CGD1=CAP1/(1.+50.*(PDS+0.1))
      IF (PDS.LT..1) CGS1=CGS1/(1.-50.*(PDS-0.1))
      IF (VGSH.GT.0.) GO TO 660
C
C     GATE-BULK CAPACITANCE IN CUTOFF REGION
C
      CGB=CAP
      X1=PGS-(PFB-PHIL)
      IF (X1.GT.0.) CGB=CGB/DSQRT(1.+4.*X1/GAMSQ)
C
C     CGS AND CGD IN CUTOFF
C
      X1=1.-50.*VGSH
      CGS=CGS1/X1
      CGD=CGD1/X1
      GO TO 690
C
C     CGB CAPACITANCE IN THE ON REGION
C
 660  CGB=CAP/DSQRT(1.+4.*(PHIL+GAM*VSBFRT)/GAMSQ)
      CGB=CGB/(1.+50.*VGSH)
C
C     STRAIGHT LINE APPROXIMATION FOR CGS AND CGD NEAR THRESHOLD
C     AND NEAR INVERSION
C
      IF (VGSH.GE.0.1) GO TO 670
C
C     CHECK FOR VDS < 0.1
C
      IF (PDS.GT.0.1) GO TO 667
C
C     VGS-VTH < 0.1
C
C     VDS     < 0.1
C
      VREF=0.2-PDS
      VREF=VREF*VREF
C
C     CGS
C
C     CGS AT VGS-VTH=0.1
C
      CGS=CAP1*(1.-(0.1-PDS)*(0.1-PDS)/VREF)
C     SCALE THE VALUE FOR VGS-VTH
      CGS=(CGS-CGS1)*VGSH/0.1+CGS1
C
C     CGD
C
C     CGD AT VGS-VTH=0.1
 663  CGD=CAP1*(1.-0.01/VREF)
C     SCALE THE VALUE FOR VGS-VTH
      CGD=(CGD-CGD1)*VGSH/0.1+CGD1
      GO TO 685
C
C     CGS AND CGD FOR PDS > 0.1, VGS-VTH <0.1
C
 667  CGS=CAP1
C     CGD AT VGS-VTH=0.1 IS ZERO
C     SCALE THE VALUE FOR VGS-VTH
      CGD=CGD1*(0.1-VGSH/0.1)
      GO TO 685
C
C     CHECK REGION OF OPERATION
C
 670  IF (VGSH.GT.PDS) GO TO 680
C
C     SATURATED REGION
C
      CGS=CAP1
      GO TO 685
C
C     LINEAR REGION
C
 680  VREF=(2.*VGSH-PDS)*(2.*VGSH-PDS)
      CGS=CAP1*(1.-(VGSH-PDS)*(VGSH-PDS)/VREF)
      CGD=CAP1*(1.-VGSH*VGSH/VREF)
C
C     SET CGD FOR ON TO BE AT LEAST CGD1
C
 685  CGD=DMAX1(CGD,CGD1)
C
C...  INVERT DRAIN AND SOURCE IF TRANSISTOR IS IN INVERSE MODE
C
  690 IF(INV.EQ.0) GO TO 700
      PDS=-PDS
      X1=PGS
      PGS=PGD
      PGD=X1
      X1=CGD
      CGD=CGS
      CGS=X1
C
C...  ADD OVERLAP CAPACITORS
C
  700 IF (IBUG) WRITE(J6,705) CGB,CGS,CGD
  705 FORMAT (' CGB CGS CGD ',3E15.5)
      CGD=CGD+COX(I,1)*WIDTH*(XJD(I,1)+XJN(I,1))
      CGS=CGS+COX(I,1)*WIDTH*(XJS(I,1)+XJN(I,1))
      IF (ICHAR) GO TO 900
C
C...  LINEARIZE GATE CAPACITANCES
C
      IF (CGB.LE.0.) GO TO 710
      GGB=CGB/DELT
      CIGB=GGB*(OGS+OSB)
  710 IF (CGS.LE.0.) GO TO 720
      GGS=CGS/DELT
      CIGS=GGS*OGS
  720 IF (CGD.LE.0.) GO TO 900
      GGD=CGD/DELT
      CIGD=GGD*(OGS-ODS)
C
C...  CHANGE CURRENT DIRECTION FOR P-CHANNEL DEVICE
C
  900 IF (NT.NE.0) GO TO 950
      CD=-CD
      CS=-CS
      CDSO=-CDSO
      CIDS=-CIDS
      CIGB=-CIGB
      CIGD=-CIGD
      CIGS=-CIGS
  950 CDS(K)=CIDS*1000.
      IF (IBUG) WRITE(J6,955) GGB,CIGB,GGS,CIGS,GGD,CIGD
  955 FORMAT (' GB, GS, GD  ',6E15.5)
C
C...  ADD PARASITIC RESISTORS
C
      X1=0.0
      IF (N1.NE.ND) X1=XPARA(K,3)
      X2=0.0
      IF (N3.NE.NS) X2=XPARA(K,4)
C
C...  ADD CONDUCTANCES AND CURRENT VECTORS TO MATRIX
C
      YD(N1)=YD(N1)+X1
      YD(NG)=YD(NG)+GGB+GGS+GGD
      YD(N3)=YD(N3)+X2
      YD(NB)=YD(NB)+GSB+GDB+GGB
      YD(ND)=YD(ND)+X1+GMI+GG-GMBI+GDB+GGD
      YD(NS)=YD(NS)+X2+GM +GG-GMB +GSB+GGS
      Y(N7) =Y(N7)-GGB
      Y(N8) =Y(N8)-GGD
      Y(N9) =Y(N9)-GGS
      Y(N10)=Y(N10)-GGB
      Y(N11)=Y(N11)-GDB
      Y(N12)=Y(N12)-GSB
      Y(N13)=Y(N13)+GM-GMI-GGD
      Y(N14)=Y(N14)-GMB+GMBI-GDB
      Y(N15)=Y(N15)-GM-GG+GMB
      Y(N16)=Y(N16)-GM+GMI-GGS
      Y(N17)=Y(N17)+GMB-GMBI-GSB
      Y(N18)=Y(N18)-GMI-GG+GMBI
      Y(N19)=Y(N19)-X1
      Y(N20)=Y(N20)-X1
      Y(N21)=Y(N21)-X2
      Y(N22)=Y(N22)-X2
      V(NG)=V(NG)+CIGB+CIGS+CIGD
      V(NB) =V(NB)-CD-CS-CIGB
      V(ND)=V(ND)-CDSO+CD-CIGD
      V(NS)=V(NS)+CDSO+CS-CIGS
  990 CONTINUE
 1000 RETURN
      END
      SUBROUTINE TIMSOL (ITRLIM)
C
C     .... SUBROUTINE TO CALCULATE VOLTAGES AT A GIVEN TIME
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON Y(600),YL(600),YV(200),YC(200),YD(250),V(250),VCUR(10),
     1   V1(250),VPI(250),
     1 VGS(100),VDS(100),VSB(100),CDS(100),VPPL(250),V2(250)
      COMMON/PRINT/PLTP(4,200,6),BCUR(100),PCUR(100),OUPUT(10),VSLP(10),
     1 CSLP(10)
      COMMON /TRANS/ MREF(100),NQ(100,28),XPARA(100,6),VT,TOLER,NXTR,
     1 ITR,IND,IBUG
      COMMON /ELMTS/ KIND(100),ND(100,4),VALU(100),NELT
      COMMON /DIODE/ NAMD(100),VALD(100,4),NDI(100,4),VDIO(100),
     1   CDIO(100),NDIOD
      COMMON /VSRCE/ VSRC(10),VLSRC(10),NAMV(10),TVLT(10,10),
     1 VVAL(10,10),NVVAL(10),KVOL(10),NV(10,2),NVSC
      COMMON /CSRCE/ CSRC(10),CLSRC(10),NAMC(10),TCUR(10,10),
     1 CVAL(10,10),NCVAL(10),KCUR(10),NCS(10,2),NCSC
      COMMON /NODES/ NREN(100),LNOD,NX,MDIM,NNOD,NUT,NLT,NVT
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,ICONV,ICHAR
      LOGICAL IBUG,ICHAR
C
C     ... ASSIGN SOURCE VALUES FOR NEW TIME
      IF (NVSC.EQ.0) GO TO 370
      DO 360 I=1,NVSC
      IF (KVOL(I)-1) 360,350,345
 345  VSRC(I)=VVAL(1,I)*DSIN(VVAL(2,I)*QTIME+VVAL(3,I))+VVAL(4,I)
      GO TO 360
 350  N=NVVAL(I)
      IF (VSLP(I).EQ.0.0) GO TO 355
      VSRC(I)=VVAL(N,I)+VSLP(I)*(QTIME-TVLT(N,I))
      GO TO 360
 355  VSRC(I)=VVAL(N,I)
 360  CONTINUE
C
 370  IF (NCSC.EQ.0) GO TO 400
      DO 390 I=1,NCSC
      IF (KCUR(I)-1) 390,380,375
 375  CSRC(I)=CVAL(1,I)*DSIN(CVAL(2,I)*QTIME+CVAL(3,I))
      GO TO 390
 380  N=NCVAL(I)
      IF (CSLP(I).EQ.0.0) GO TO 385
      CSRC(I)=CVAL(N,I)+CSLP(I)*(QTIME-TCUR(N,I))
      GO TO 390
 385  CSRC(I)=CVAL(N,I)
 390  CONTINUE
C
C     ... CLEAR Y-MATRIX AND C-VECTOR
400   DO 105 I=1,NUT
105   Y(I)=0.0
      DO 110 I=1,NLT
110   YL(I)=0.0
      DO 115 I=1,NVT
115   YV(I)=0.0
      DO 120 I=1,NNOD
120   YD(I)=0.0
      DO 124 I=1,NNOD
      VV=V(I)
      VV1=V1(I)
      VV2=V2(I)
      DVV=VV-VV1
      AVV=DABS(DVV)
      IF (AVV.LT.TOLER) GO TO 122
      ICONV=0
      IF (AVV.LT.5D-1) GO TO 122
      VV=VV1+5D-1
      IF (DVV.LT.0D0) VV=VV1-5D-1
 122  IF (DABS(VV-VV2).LT.5D-7) VV=(VV+VV1)/2D0
      V2(I)=VV1
      V1(I)=VV
      V(I)=0D0
 124  CONTINUE
C
C     .... ADD R,C,L ELEMENT CONTRIBUTION
      IF (NELT.EQ.0) GO TO 155
      DO 150 N=1,NELT
      N1=ND(N,1)
      N2=ND(N,2)
      N3=ND(N,3)
      N4=ND(N,4)
      DELVP=VPI(N1)-VPI(N2)
      IF (KIND(N)-2) 125,130,135
C     .... RESISTOR
125   G=VALU(N)
      GO TO 145
C     ... CAPACITOR
C     ... TRAPEZOIDAL INTEGRATION
 130  G=VALU(N)/DELT
      CT=G*DELVP+BCUR(N)
C     ... BACKWARD EULER INTEGRATION
C130  G=VALU(N)/(2*DELT)
C     CT=G*DELVP
      GO TO 140
C     ... INDUCTOR
135   G=VALU(N)*DELT
      CT=-G*DELVP-BCUR(N)
140   V(N1)=V(N1)+CT
      V(N2)=V(N2)-CT
145   YD(N1)=YD(N1)+G
      YD(N2)=YD(N2)+G
      Y(N3)=Y(N3)-G
      Y(N4)=Y(N4)-G
150   CONTINUE
C
C     ... ADD TRANSISTORS
155   ICONV=1
      CALL CKTMOD(1)
      CALL DIMOD(1)
C
C     ... ADD CURRENT SOURCES
      IF (NCSC.EQ.0) GO TO 159
      DO 157 I=1,NCSC
      N1=NCS(I,1)
      N2=NCS(I,2)
      V(N1)=V(N1)-CSRC(I)
  157 V(N2)=V(N2)+CSRC(I)
  159 CONTINUE
C
C     .... SOLVE EQUATIONS FOR NEW VOLTAGES
      ITR=ITR+1
      ITER=ITER+1
      CALL SOLUTN
C
C     .... CHECK FOR CONVERGENCE OF NON-LINEAR MODELS
      IF (ITR.LE.1) GO TO 470
      IF (ICONV.EQ.0) GO TO 470
      DO 165 I=1,MDIM
      IF (DABS(V(I)-V1(I)).GT.TOLER) GO TO 470
  165 CONTINUE
C
C     ... CALCULATE BRANCH CURRENTS
      IF (NELT.EQ.0) GO TO 220
      DO 210 N=1,NELT
      N1=ND(N,1)
      N2=ND(N,2)
      DELV=V(N1)-V(N2)
      DELVP=VPI(N1)-VPI(N2)
      IF (KIND(N)-2) 180,190,200
C.... RESISTOR
180   PCUR(N)=BCUR(N)
      BCUR(N)=DELV*VALU(N)
      GO TO 210
C     ... CAPACITOR
 190  G=VALU(N)/DELT
      PCUR(N)=BCUR(N)
      BCUR(N)=G*(DELV-DELVP)-BCUR(N)
      GO TO 210
C     ... INDUCTOR
 200  G=VALU(N)*DELT
      PCUR(N)=BCUR(N)
      BCUR(N)=G*(DELV+DELVP)+BCUR(N)
210   CONTINUE
C     ... GET CURRENT SOURCE CURRENT
220   IF (NCSC.EQ.0) GO TO 465
      DO 230 I=1,NCSC
      CLSRC(I)=CSRC(I)
230   CONTINUE
C     ... GET VOLTAGE SOURCE VALUES
465   RETURN
C
470   ICONV=0
      IF ( ITR-ITRLIM) 400,500,500
500   RETURN
      END
      SUBROUTINE CLKST(INIT)
      COMMON /IO/ I5,J6
C
C     .... SET AND READ CPU TIME USED
C     FOR STANFORD USERS
C
      CALL XCLOCK(INIT)
      RETURN
      ENTRY CLKRD(INIT)
      CALL XCLOCK(J)
	J=J-INIT
	CALL XCLOCK(INIT)
C
C     FOR FAIRCHILD USERS
C
C     INIT=IRCPU(DUMMY)
C     RETURN
C     ENTRY CLKRD(INIT)
C     J=IRCPU(DUMMY)-INIT
      ET=J/1000.
      WRITE (J6,960) ET
      RETURN
 960  FORMAT (1X,10HRUN TIME =,F7.3,8H SECONDS//)
      END
      SUBROUTINE PLOT
C
C.... SUBROUTINE TO PRINT TIME RESPONSE PLOTS
C
      IMPLICIT REAL*8 (A-H,O-Z)
      COMMON /IO/ I5,J6
      COMMON FA(50),FB(50),FC(50),FFA(50),FCR(50),VFNR(200),
     1 LINE(101,2),DM(449)
      COMMON /PRINT/ PLTP(4,200,6)
      COMMON /PLOTS/ PMIN(6),PMAX(6),FSTR,FSTP,
     1 NP(2,4,6),NPLT,NPTS,NHAR,KPLO(4,6),NPVAL(6),NAMP(4,6)
      COMMON /TIMEV/ QTIME,DELT,TIMP,DELP,TMAX,TPRT,DPRT,ITER,ICONV,ICHAR
      COMMON /JOBCNT/ TITLE(9),PRGVER,NALTR,IREQ,ISTOP
      LOGICAL ICHAR,IREQ,ISTOP
      DIMENSION VAL(11),SCAL(5),NUM(5),ITMP(11),IPOS(11)
      DATA NUM/1H+,1H*,1H3,1H4,1H5/, KBL,IHOR,IVER/1H ,1H-,1H^/
      DATA SCAL/8H        ,8HMILLI   ,8HMICRO   ,8HNANO    ,8HPICO    /
      PLTIM(N)=DPRT*(N-1)
C
C
C.... PRESET PRINTOUT LINE FORM
      LINE(1,1)=IHOR
      DO 10 I=2,100,2
      LINE(I,1)=KBL
   10 LINE(I+1,1)=IHOR
      DO 20 I=2,100
   20 LINE(I,2)=KBL
      DO 30 I=1,101,10
   30 LINE(I,2)=IVER
C
      IF (NPTS.GT.200) NPTS=200
      IF (.NOT.IREQ) GO TO 160
      IF (NHAR.GT.49) NHAR=49
      IRM=1
      INRI=0
      DPRD=DPRT/37.3
      FSTP=FSTP+DPRD
      FSTR=FSTR+DPRD
C     LIMITS OF PLOT PROGRAM FOR FOURIER ANALYSIS
      DO 110 KPT=1,NPTS
      IF(PLTIM(KPT).GT.FSTR) GO TO 120
  110 CONTINUE
      GO TO 150
  120 KMIN=KPT-1
      DO 130 KPT=KMIN,NPTS
      IF(PLTIM(KPT).GT.FSTP) GO TO 140
  130 CONTINUE
      GO TO 150
  140 KMAY=KPT-1
      KMAN=KMAY-1
      GO TO 160
  150 INRI=1
      KPTF=KPT
      FKTP=PLTIM(KPT)
C
C.... CHECK THE LIMITS OF THE  PLOTS
C
  160 DO 200 KPLT=1,NPLT
      PMX=PMAX(KPLT)
      PMN=PMIN(KPLT)
      IF (PMX.GT.PMN) GO TO 200
      IF (PMX.EQ.PMN) GO TO 170
      PMAX(KPLT)=PMN
      PMIN(KPLT)=PMX
      GO TO 200
C
C.... GET THE  LIMITS OF PLOTS
  170 PMN=1.E20
      PMX=-1.E20
C
C.... GET THE MAXIMUM AND MINIMUM VALUES
      NVL=NPVAL(KPLT)
      DO 175 I=1,NVL
      DO 175 KPL=1,NPTS
      VA=PLTP(I,KPL,KPLT)
      IF (VA.GT.PMX) PMX=VA
      IF (VA.LT.PMN) PMN=VA
  175 CONTINUE
C
C.... GET THE AVERAGE AND WIDTH
      AVER=(PMN+PMX)/2.0
      WID=PMX-PMN
      IF (WID.LT.1.0E-20) WID=1.0E-20
C
C.... GET THE MOST SIGNIFICANT FIGURE FOR WIDTH
      IEXP=-DLOG10(WID)
      FACTOR=10.**IEXP
      WID=WID*FACTOR
      IF (WID.LE.1.0) FACTOR=FACTOR*10.0
C
C.... GET THE AVERAGE FOR THE PLOT
      IF (AVER.LT.0.0) IAVER=AVER*FACTOR-0.5
      IF (AVER.GE.0.0) IAVER=AVER*FACTOR+0.5
      AVER=IAVER/FACTOR
C
C.... GET THE WIDTH OF THE PLOT
      WID=PMX-AVER
      IF (WID.LT.(AVER-PMN)) WID=AVER-PMN
      IF (WID.LT.1.0E-20) WID=1.0E-20
C
C.... GET NORMALIZED NUMBER FOR WIDTH
      WID=WID*FACTOR
      IF (WID.GT.1.0) GO TO  180
      WID=1.0
      GO TO 195
  180 IF (WID.GT.2.0) GO TO 185
      WID=2.0
      GO TO 195
  185 IF (WID.GT.5.0) GO TO 190
      WID=5.0
      GO TO 195
  190 WID=10.0
C
C.... GET MIN AND MAX AND STORE THE VALUES
  195 WID=WID/FACTOR
      PMIN(KPLT)=AVER-WID
      PMAX(KPLT)=AVER+WID
  200 CONTINUE
C
C.... GET SCALING FOR TIME
210   IEXP=-(DLOG10(TMAX)+0.0001)
      IEXP=(IEXP+6)/3
      IF (TMAX.GE.1.) IEXP=1
      IF (IEXP.GT.5) IEXP=5
      FACTOR=1000.**(IEXP-1)
      TPRT=DPRT*FACTOR
C
C.... SEQUENCE THROUGH PLOTS
      DO 600 KPLT=1,NPLT
C.... PRINT OUTPUTS
      WRITE (J6,810) TITLE,PRGVER
      NVL=NPVAL(KPLT)
      NL=NVL
      IF (NL.GT.2) NL=2
      DO 220 I=1,NVL
      WRITE (J6,820) NUM(I),NAMP(I,KPLT)
      IF (KPLO(I,KPLT).EQ.0) WRITE (J6,821) (NP(J,I,KPLT),J=1,2)
      IF (KPLO(I,KPLT).NE.0) WRITE (J6,822) NP(1,I,KPLT)
220   CONTINUE
      WRITE (J6,825) SCAL(IEXP)
C.... CALCULATE AND PRINT COORDINATE VALUES
      PMN=PMIN(KPLT)
      PMX=PMAX(KPLT)
      WID=(PMX-PMN)/100.
C
C.... GET POWER FACTOR FOR OUTPUT VALUE
      IF (PMX.LT.-PMN) PMX=-PMN
      IPMX=-(DLOG10(PMX)+0.0001)
      IPMX=(IPMX+6)/3
      IF (PMX.GE.1.) IPMX=1
      IF (IPMX.GT.5) IPMX=5
      PFACT=1000.**(IPMX-1)
      DO 230 I=1,11
  230 VAL(I)=((I-1)*(WID*10.)+PMN)*PFACT
      WRITE (J6,830) VAL,SCAL(IPMX)
C
C.... PRINT PLOT
      PRT=0.
      DO 370 KPT=1,NPTS
C
C.... JCHAR = 1 => GRID LINE PRINTOUT
C.... JCHAR = 2 => NORMAL LINE PRINTOUT
      JCHAR=2
      IF (KPT-(KPT-1)/10*10.EQ.1) JCHAR=1
C
C.... GET COORDINATE VALUES
      DO 320 I=1,NVL
      VAL(I)=PLTP(I,KPT,KPLT)
      NPNT=(VAL(I)-PMN)/WID+1.5
      IF (NPNT.GT.101) NPNT=101
      IF (NPNT.LT.1) NPNT=1
      IPOS(I)=NPNT
      ITMP(I)=LINE(NPNT,JCHAR)
      LINE(NPNT,JCHAR)=NUM(I)
      VAL(I)=VAL(I)*PFACT
320   CONTINUE
C
C.... PRINT LINE
      WRITE (J6,840) PRT,(LINE(I,JCHAR),I=1,101),(VAL(I),I=1,NL)
C
C.... RESTORE THE ORIGINAL LINE
      I=NVL
  360 LINE(IPOS(I),JCHAR)=ITMP(I)
      I=I-1
      IF (I.GT.0) GO TO 360
C
C...  GET NEXT TIME
      PRT=PRT+TPRT
370   CONTINUE
      WRITE (J6,880)
C
C     ... PROGRAM TO PERFORM FOURIER ANALYSIS
      IF (.NOT.IREQ) GO TO 590
      IF(INRI.EQ.0) GO TO 410
      PRINT 930,KPTF,FKTP
      GO TO 590
  410 INU=0
      DO 580 II=1,NL
C        NUFU = 2N + 1    IS ODD
      NUFU=KMAY-KMIN
      IF((NUFU-NUFU/2-NUFU/2).EQ.0)GO TO 430
      FDIV=(FSTP-FSTR)/NUFU
      DO 420 KPT=KMIN,KMAN
      DPPI=FSTR+(KPT-KMIN)*FDIV-PLTIM(KPT)
      INU=INU+1
  420 VFNR(INU)=PLTP(II,KPT,KPLT)+(PLTP(II,KPT+1,KPLT)-PLTP(II,KPT,KPLT)
     1)*DPPI/DPRT
      GO TO 470
C
  430 NUFU=NUFU-1
      FDIV=(FSTP-FSTR)/NUFU
      DPPI=FSTR-FDIV-PLTIM(KMIN-1)
      FDIX=DPRT+DPRT-FDIV
      KMO=0
      KMQ=0
      DO 460 KPT=KMIN,KMAN
      IF(KMO.EQ.1)GO TO 440
      DPPI=DPPI+FDIV-DPRT*(1+KMQ)
      KMQ=0
      INU=INU+1
      VFNR(INU)=PLTP(II,KPT,KPLT)+(PLTP(II,KPT+1,KPLT)-PLTP(II,KPT,KPLT)
     1)*DPPI/DPRT
      DIFX=FDIX-DPPI
      IF (DIFX.LE.0.0) KMO=1
      GO TO 450
  440 KMO=0
      KMQ=1
  450 CONTINUE
  460 CONTINUE
  470 IF(NUFU.EQ.INU)GO TO 480
      PRINT 900,NUFU,INU
      GO TO 590
  480 CONTINUE
      PRINT 890,NHAR,FSTR,FSTP,NUFU
C
C     ... FOURIER ANALYSIS AND OUTPUT CALCULATIONS
      NUFV=(NUFU-1)/2
      CALL FORIT(VFNR,NUFV,NHAR,FA,FB)
      PRINT 910
      NHAS=NHAR+1
      DO 490 I=1,NHAS
      FC(I)=DSQRT(FA(I)*FA(I)+FB(I)*FB(I))
  490 FFA(I)=DATAN2(-FB(I),FA(I))*180./3.1415926
      DO 500 I=1,NHAS
      IPOR=I-1
      FCR(I)=100.*FC(I)/FC(IRM+1)
  500 PRINT 920,IPOR,FB(I),FA(I),FC(I),FCR(I),FFA(I)
 580  CONTINUE
  590 CONTINUE
600   CONTINUE
      RETURN
C
 810  FORMAT (1H1,9A8,8X,6HMSINC-,A3//1HX)
 820  FORMAT (1X,A1,1H:,1X,A4,2I3)
821   FORMAT (1H+,7X,2I3)
822   FORMAT (1H+,7X,A4)
  825 FORMAT (/,2X,'TIME IN ',A5,'-SECONDS',/)
  830 FORMAT (2X,11F10.2,2X,A8/9X,11(1HI,9X)/)
  840 FORMAT (1X,F7.3,1X,101A1,2(1X,F9.4))
 880  FORMAT (1H1)
  890 FORMAT(1X,' FOURIERANALYSIS IN ',I4,' HARMONICS FROM',E11.4,' TILL
     1',E11.4,' SECONDS CALCULATED WITH',I5,' POINTS '/)
  900 FORMAT(5X,' ERROR = GIVEN NUMBER OF INTERPOLATIONPOINTS',I6,' DIFF
     1ERS FROM COMPUTED NUMBER ',I6/)
  910 FORMAT(1X,'ORDER HARM',3X,'DSINE',8X,'CODSINE',15X,'MAGNITUDE  REL
     1 MAG   PHASE'/)
  920 FORMAT(7X,I2,3X,2E12.4,9X,1E11.4,2F11.4)
  930 FORMAT(5X,'ERROR = TIME LIMITS OF FOUR OUTSIDE COMPUTED OUTPUTTIME
     1          POINT IS ',I3,' TIME IS ',1PE8.2)
      END
      SUBROUTINE FORIT (FNT,N,M,A,B)
      IMPLICIT REAL*8 (A-H,O-Z)
C
      DIMENSION FNT(1),A(M),B(M)
C
C     ... SET CONSTANTS
      COEF=1.0/(N+0.5)
      CONST=3.141593*COEF
      S1=DSIN(CONST)
      C1=DCOS(CONST)
      C=1.0
      S=0.0
      FNTZ=FNT(1)
      J=1
      M1=M+1
      N2=N+N+1
C
C     ... COMPUTE FOURIER COEFFICIENTS RECURSIVELY
   70 U2=0.0
      U1=0.0
      I=N2
   75 U0=FNT(I)+2.0*C*U1-U2
      U2=U1
      U1=U0
      I=I-1
      IF (I-1) 80,80,75
   80 A(J)=COEF*(FNTZ+C*U1-U2)
      B(J)=COEF*S*U1
      IF (J-M1) 90,100,100
   90 Q=C1*C-S1*S
      S=C1*S+S1*C
      C=Q
      J=J+1
      GO TO 70
  100 A(1)=A(1)*0.5
      RETURN
      END
