(PREDICATE (SENSE BUS= SCAN)) 
(PREDICATE (AND (SENSE POINTER-BIT TYPE OLD)
		(SENSE MACHINE-NUMBER= MACHINE-NUMBER DATUM OLD))) 
(PREDICATE (AND (SENSE GC-INTERRUPT-REQUEST) (SENSE GC INTERRUPT-ENABLES))) 
(PREDICATE (OR (AND (SENSE GC-INTERRUPT-REQUEST)
		    (SENSE GC INTERRUPT-ENABLES))
	       (AND (SENSE CONS-SERVER-INTERRUPT-REQUEST)
		    (SENSE CONS-SERVER INTERRUPT-ENABLES))
	       (AND (SENSE DMA-INTERRUPT-REQUEST)
		    (SENSE DMA INTERRUPT-ENABLES))
	       (AND (SENSE EXTERNAL-INTERRUPT-REQUEST)
		    (SENSE EXTERNAL INTERRUPT-ENABLES)))) 
(PREDICATE (SENSE -SOMEBODY-ISNT-READY-TO-GC)) 
(PREDICATE (AND (SENSE BUS= TYPE COMPARE-REG)
		(NOT (SENSE SIGN-BIT DATUM COMPARE-REG))
		(NOT (SENSE SIGN-BIT DATUM ADDER)))) 
(PREDICATE (SENSE BUS= TYPE COUNT)) 
(PREDICATE (SENSE =17 CLASS MAIN-BUS)) 
(PREDICATE (SENSE THARGS-FLAG)) 
(PREDICATE (OR (NOT (SENSE POINTER-BIT TYPE OLD)) (SENSE =-1 MACHINE-NUMBER DATUM OLD))) 
(PREDICATE (AND (SENSE DMA-INTERRUPT-REQUEST) (SENSE DMA INTERRUPT-ENABLES))) 
(PREDICATE (SENSE =36 COUNT ENV-STACK)) 
(PREDICATE (AND (SENSE CONS-SERVER-INTERRUPT-REQUEST) (SENSE CONS-SERVER INTERRUPT-ENABLES))) 
(PREDICATE (SENSE LOW-BIT DATUM EXP)) 
(PREDICATE (SENSE FREE=MEMTOP)) 
(PREDICATE (SENSE =0 HIGH-BITS DATUM EXP)) 
(PREDICATE (AND (SENSE POINTER-BIT MAIN-BUS) (NOT (SENSE =17 CLASS MAIN-BUS)))) 
(PREDICATE (SENSE RELOCATE-REQUEST-TO-ME)) 
(PREDICATE (SENSE =0 TYPE MAIN-BUS)) 
(PREDICATE (SENSE =0 COUNT ENV-STACK)) 
(PREDICATE (SENSE -SOMEBODY-NEEDS-GC)) 
(PREDICATE (SENSE CONT-FLAG)) 
(PREDICATE (SENSE =0 DATUM MAIN-BUS)) 
(PREDICATE (SENSE SBUS-ERROR-FLAG)) 
(PREDICATE (SENSE BUS= TYPE VAL)) 
 
