(defreplicator column-with-special (i)
  '((primary-parameters ((v-pitch) (v-spacing) (special-rate)))
    (dont-menu-select t)
    (constraints ((v-pitch instance-list v-pitch v-spacing)
		  (v-spacing instance-list v-spacing))))
  (replicator-transform 'identity 0 (* i (>> v-pitch)))
  (if ( 0 (\ i (>> special-rate)))
      (replicator-instance (>> (*rep-instance 0)))
      (replicator-instance (>> (*rep-instance 1)))))

(deflayout adder
    '((primary-parameters (size))
      (dont-menu-select t))
    (replicate 'bits column (list (>> size))
	       (list (part () adder-cell))))



