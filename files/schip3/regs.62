  (fracture vdd-stretch horizontal (pt 39. 25.))
  (fracture top-stretch horizontal (pt 40. 39.)))




;;;; incrementer or decrementer

(deflayout incrementer-decrementer
  `((primary-parameters 
    ( (increment-or-decrement 'increment) (bottom-bit? nil) (top-stretch 0.) (vdd-stretch 0.)
       (gnd-stretch 0.) (bottom-stretch 0.) (right-stretch 0.) (left-stretch 0.)))
  (auxiliary-parameters 
    ( (xfrm 'identity)top-stretch-top top-stretch-bottom vdd-stretch-top vdd-stretch-bottom 
      gnd-stretch-top gnd-stretch-bottom bottom-stretch-top bottom-stretch-bottom 
      right-stretch-right right-stretch-left left-stretch-right left-stretch-left ))
  (constraints 
    ( (vertical-stretch top-stretch-bottom top-stretch-top top-stretch xfrm)
       (vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
       (vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm)
       (vertical-stretch bottom-stretch-bottom bottom-stretch-top bottom-stretch xfrm)
       (horizontal-stretch right-stretch-left right-stretch-right right-stretch xfrm)
       (horizontal-stretch left-stretch-left left-stretch-right left-stretch xfrm))))
  (part 'bus rectangle (top-right (pt 156. 43.)) (length 3.) (width 55.) (layer 'metal))
  (part 'vdd rectangle (top-right (pt 156. 30.)) (length 3.) (width 55.) (layer 'metal))
  (part 'gnd rectangle (top-right (pt 156. 9.)) (length 3.) (width 55.) (layer 'metal))
  (part nil square-contact (layer 'diff) (bottom-left (pt 118. 6.)))
  (part nil rectangle (bottom-left (pt 110. 13.)) (length 7.) (width 2.) (layer 'poly))
  (part 'read-to-local-bus rectangle (bottom-left (pt 102. -3.)) (length 47.) (width 2.) 
    (layer 'poly))
  (part nil rectangle (bottom-left (pt 105. 41.)) (length 2.) (width 22.) (layer 'diff))
  (part 'value-in rectangle (bottom-left (pt 101. 21.)) (length 3.) (width 55.) 
    (layer 'metal))
  (part nil square-contact (layer 'poly) (bottom-left (pt 108. 20.)))
  (part nil rectangle (top-right (pt 118. 17.)) (bottom-left (pt 115. 15.)) (layer 'diff))
  (part nil rectangle (top-right (pt 118. 8.)) (bottom-left (pt 113. 6.)) (layer 'diff))
  (part nil rectangle (top-right (pt 115. 32.)) (length 26.) (width 2.) (layer 'diff))
  (part nil rectangle (top-right (pt 117. 13.)) (bottom-left (pt 110. 11.)) (layer 'poly))
  (part nil rectangle (bottom-left (pt 135. 1.)) (length 15.) (width 2.) (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt 137. 27.)))
  (part nil rectangle (bottom-left (pt 152. 19.)) (length 2.) (width 1.) (layer 'poly))
  (part nil standard-pullup (bottom-left (pt 144. 13.)) (xfrm 'negx))
  (part nil standard-pullup (channel-length 8.) (bottom-left (pt 154. 13.)) (xfrm 'negx))
  (part nil rectangle (top-right (pt 150. 27.)) (bottom-left (pt 148. 24.)) (layer 'diff))
  (part nil rectangle (top-right (pt 138. 16.)) (bottom-left (pt 137. 13.)) (layer 'diff))
  (part 'carry-out-bar rectangle (top-right (pt 147. 13.)) (length 16.) (width 2.) 
    (layer 'poly))
  (part nil rectangle (top-right (pt 147. 15.)) (bottom-left (pt 144. 13.)) (layer 'poly))
  (part nil rectangle (bottom-left (pt 144. 6.)) (length 2.) (width 6.) (layer 'diff))
  (part nil rectangle (top-right (pt 150. 13.)) (length 7.) (width 2.) (layer 'diff))
  (part 'carry-out rectangle (top-right (pt 154. 13.)) (length 16.) (width 2.) 
    (layer 'poly))
  (part nil standard-pullup (channel-length 8.) (bottom-left (pt 124. 13.)) (xfrm 'negx))
  (part nil rectangle (top-right (pt 120. 27.)) (bottom-left (pt 118. 24.)) (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt 118. 27.)))
  (part nil rectangle (bottom-left (pt 141. 27.)) (length 2.) (width 7.) (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt 140. 6.)))
  (conditional-part
    (or (not (>> bottom-bit?)) (eq (>> increment-or-decrement) (quote increment))) 
     nil butting-contact (bottom-left (pt 124. 24.)) (xfrm 'rot270))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil rectangle (top-right (pt 152. 37.)) (bottom-left (pt 148. 35.)) (layer 'poly))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil rectangle (top-right (pt 145. 42.)) (bottom-left (pt 128. 40.)) (layer 'poly))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil rectangle (top-right (pt 130. 40.)) (bottom-left (pt 128. 37.)) (layer 'poly))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil rectangle (top-right (pt 144. 35.)) (bottom-left (pt 132. 33.)) (layer 'poly))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil rectangle (top-right (pt 144. 37.)) (bottom-left (pt 112. 34.)) (layer 'metal))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil square-contact (layer 'poly) (bottom-left (pt 108. 33.)))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil square-contact (layer 'poly) (bottom-left (pt 144. 33.)))
  (conditional-part
    (not (>> bottom-bit?)) 
     'carry-in rectangle (bottom-left (pt 152. 35.)) (length 9.) (width 2.) (layer 'poly))
  (conditional-part
    (not (>> bottom-bit?)) 
     'carry-in-bar rectangle (bottom-left (pt 145. 40.)) (length 4.) (width 2.) 
    (layer 'poly))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil rectangle (top-right (pt 127. 35.)) (bottom-left (pt 125. 24.)) (layer 'diff))
  (part 'carry-bar-pass transistor-replacer 
    (options (if (>> bottom-bit?) (quote short) (quote normal))) (center (pt 126. 38.)))
  (part 'carry-pass transistor-replacer 
    (options (if (>> bottom-bit?) (quote short) (quote normal))) (center (pt 114. 35.)))
  (part nil rectangle (top-right (pt 115. 41.)) (bottom-left (pt 113. 38.)) (layer 'diff))
  (part 'local-bus rectangle (bottom-left (pt 101. -1.)) (top-right (pt 156. 2.)) 
    (layer 'metal))
  (conditional-part
    (not (>> bottom-bit?)) 
     'carry-flash rectangle (bottom-left (pt 132. 7.)) (length 26.) (width 2.) 
    (layer 'poly))
  (conditional-part
    (eq (>> increment-or-decrement) (quote decrement)) 
     'value-bar-flash rectangle (top-right (pt 126. 17.)) (length 10.) (width 2.) 
    (layer 'poly))
  (conditional-part
    (eq (>> increment-or-decrement) (quote increment)) 
     'value-flash rectangle (top-right (pt 130. 20.)) (length 13.) (width 2.) (layer 'poly))
  (part nil rectangle (bottom-left (pt 105. 0.)) (top-right (pt 107. 41.)) (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt 107. -1.)))
  (part nil rectangle (bottom-left (pt 104. 6.)) (top-right (pt 109. 8.)) (layer 'poly))
  (part nil rectangle (bottom-left (pt 120. 1.)) (top-right (pt 122. 6.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 148. 27.)) (top-right (pt 150. 29.)) (layer 'diff))
  (part nil transistor-replacer (channel-width (if (>> bottom-bit?) 2. 4.)) 
    (options (if (eq (>> increment-or-decrement) 'increment) 'normal 'short))
    (center (pt 129. 4.)) (xfrm 'rot90))
  (part nil transistor-replacer (channel-width (if (>> bottom-bit?) 2. 4.)) 
    (options (if (eq (>> increment-or-decrement) 'decrement) 'normal 'short))
    (center (pt 125. 4.)) (xfrm 'rot90))
  (part nil transistor-replacer (channel-width (if (>> bottom-bit?) 2. 4.)) 
    (options (if (>> bottom-bit?) 'short 'normal)) (center (pt 133. 4.)) (xfrm 'rot90))
  (fracture left-stretch vertical (pt 102. 31.))
  (fracture right-stretch vertical (pt 155. 32.))
  (fracture bottom-stretch horizontal (pt 147. -2.))
  (fracture gnd-stretch horizontal (pt 109. 8.))
  (fracture vdd-stretch horizontal (pt 145. 29.))
  (fracture top-stretch horizontal (pt 118. 43.)))

(deflayout counter-cell nil
  (part 'reg rw-reg-cell )
  (part 'inc incrementer (value-in-contact (>> value-contact reg))))

(deflayout counter `((primary-parameters ((size 5))))
  (replicate 'bits column (list (>> size) 1) (list (part () counter-cell))))



(defdefault eq-test-hack (right-source continue-value?)
  (continue-value? (right-source) (not (eq right-source 'neighbor)))
  (right-source (continue-value?) (if (eq continue-value? t) 'global 'bail-out)))


(deflayout eq-test
  `((primary-parameters 
    ( (right-source 'neighbor) (continue-value? t) (bottom-bit? t) (top-stretch 0.)
       (vdd-stretch 0.) (gnd-stretch 0.) (bottom-stretch 0.) (right-stretch 0.)
       (left-stretch 0.)))
  (auxiliary-parameters 
    ( (xfrm 'identity)top-stretch-top top-stretch-bottom vdd-stretch-top vdd-stretch-bottom 
      gnd-stretch-top gnd-stretch-bottom bottom-stretch-top bottom-stretch-bottom 
      right-stretch-right right-stretch-left left-stretch-right left-stretch-left ))
  (constraints 
    ((eq-test-hack right-source continue-value?)
     (vertical-stretch top-stretch-bottom top-stretch-top top-stretch xfrm)
       (vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
       (vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm)
       (vertical-stretch bottom-stretch-bottom bottom-stretch-top bottom-stretch xfrm)
       (horizontal-stretch right-stretch-left right-stretch-right right-stretch xfrm)
       (horizontal-stretch left-stretch-left left-stretch-right left-stretch xfrm))))
  (part nil rectangle (bottom-left (pt 106. 40.)) (top-right (pt 129. 42.)) (layer 'poly))
  (part nil square-contact (layer 'diff) (bottom-left (pt 114. 5.)))
