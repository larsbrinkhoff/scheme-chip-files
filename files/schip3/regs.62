;;;; field to field connector to shift type to datum for example

;;; This can be used to shift one field of a register into another, filling the unused
;;; part of the destination if its bigger than the source.
;;; It uses only local busses.
;;; there are three area of interest
;;; the first is the source field it begins at souce-start and is bus-size long
;;; the second is the target of the source bits, begins at target-start and is bus-size long
;;; enclosing the target area is the desination area 
;;;   beginning at destination start and is destination-size bits long
;;; the part of destination which is not target had destination-fill supplied
;;; as its value.  Destination-fill is either zero or one.
;;; For example shift type to datum zero filling the extra bits.
;;; This does not load anything into the bits in the source field (but allows
;;; someone else to, in fact source and target can overlap)

(defconstraint field-shift-source (position source-start source-size source-position source?)
  (source-position (source-start source-size position)
		   (if (and ( position source-start)
			    (< position (+ source-start source-size)))
		       (- position source-start)
		       0))
  (source? (source-start source-size position)
	   (and ( position source-start) (< position (+ source-start source-size)))))

(defconstraint field-shift-destination (destination-source destination-position position
						   destination-start destination-size
						   target-start bus-size destination-fill)
  (destination-source (destination-start destination-size target-start bus-size position
					 destination-fill)
		      (cond ((or (< position destination-start)
				 ( position (+ destination-start destination-size))) 'none)
			    ((and ( position target-start)
				  (< position (+ target-start bus-size)))
			     'bus)
			    (t destination-fill)))
  (destination-position (target-start bus-size position)
			(cond ((and ( position target-start)
				    (< position (+ target-start bus-size)))
			       (- position target-start))
			      (t 0))))

(deflayout field-shifter
  `((primary-parameters 
      ((source? t) (bus-size 4.) (source-position 0.) (destination-position 0.)
       (destination-source 'bus) (continue-value? nil)
       (top-stretch 0.) (vdd-stretch 0.) (gnd-stretch 0.)
       (bottom-stretch 0.) (right-stretch 0.) (left-stretch 0.)))
    (auxiliary-parameters 
      ((xfrm 'identity) (source-start 0) (destination-start 0) (destination-size 0)
       (target-start 0) (destination-fill 'zero) (position 0)
       top-stretch-top top-stretch-bottom vdd-stretch-top vdd-stretch-bottom 
       gnd-stretch-top gnd-stretch-bottom bottom-stretch-top bottom-stretch-bottom 
       right-stretch-right right-stretch-left left-stretch-right left-stretch-left ))
    (constraints 
      ((field-shift-source position source-start bus-size source-position source?)
       (field-shift-destination destination-source destination-position position
				destination-start destination-size target-start bus-size
				destination-fill)
       (vertical-stretch top-stretch-bottom top-stretch-top top-stretch xfrm)
       (vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
       (vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm)
       (vertical-stretch bottom-stretch-bottom bottom-stretch-top bottom-stretch xfrm)
       (horizontal-stretch right-stretch-left right-stretch-right right-stretch xfrm)
       (horizontal-stretch left-stretch-left left-stretch-right left-stretch xfrm))))
  (replicate 'cross-bus row (list (>> bus-size))
    (list (part nil rectangle (bottom-left (pt 65. 156.)) (top-right (pt 67. 203.))
		(layer 'diff)))
    (h-pitch 6.) (bottom-left (pt 65. 156.)))
  (part 'bus rectangle (top-right (pt (+ 3. (>> x bottom-right cross-bus)) 202.))
	(bottom-left (pt 54. 199.)) (layer 'metal))
  (part 'vdd rectangle (top-right (pt (+ 3. (>> x bottom-right cross-bus)) 189.))
	(bottom-left (pt 54. 186.)) (layer 'metal))
  (part 'gnd rectangle (top-right (pt (+ 3. (>> x bottom-right cross-bus)) 168.)) 
    (bottom-left (pt 54. 165.)) (layer 'metal))
  (part 'local-bus rectangle (top-right (pt (+ 3. (>> x bottom-right cross-bus)) 161.)) 
    (bottom-left (pt 54. 158.)) (layer 'metal))
  (part 'load-local rectangle (bottom-left (pt 61. 156.)) (top-right (pt 63. 203.)) 
    (layer 'poly))
  (conditional-part
    (eq (>> 'destination-source) (quote bus)) 
     'program-connect square-contact (layer 'diff) 
    (center (pt (>> x center (*rep (>> destination-position)) (quote cross-bus)) 173.)))
  (conditional-part
    (eq (>> 'destination-source) (quote bus)) 
     'by-pass-bus rectangle (bottom-left (pt 60.0 172.0)) 
    (top-right (pt (>> x bottom-left program-connect) 175.)) (layer 'metal))
  (conditional-part
    (eq (>> 'destination-source) (quote bus)) 
     nil square-contact (layer 'diff) (bottom-left (pt 56. 171.)))
  (conditional-part
    (eq (>> 'destination-source) (quote one)) 
     nil rectangle (bottom-left (pt 58.0 170.0)) (length 16.0) (width 2.0) (layer 'diff))
  (conditional-part (not (eq (>> destination-source) 'none))
     nil rectangle (bottom-left (pt 58. 158.)) (length 13.0) (width 2.0) (layer 'diff))
  (conditional-part (not (eq (>> destination-source) 'none))
     nil square-contact (layer 'diff) (bottom-left (pt 56. 158.)))
  (conditional-part (not (eq (>> destination-source) 'none))
     nil rectangle (bottom-left (pt 56.0 163.0)) (length 2.0) (width 5.0) (layer 'poly))
  (conditional-part
    (eq (>> 'destination-source) (quote one)) 
     'vdd-flash square-contact (layer 'diff) (bottom-left (pt 56. 186.)))
  (conditional-part
    (eq (>> 'destination-source) (quote zero)) 
     'gnd-flash square-contact (layer 'diff) (bottom-left (pt 56. 167.)))
  (conditional-part (>> source?)
    'value-in-flash square-contact (layer 'diff) 
    (center (pt (>> x center (*rep (>> source-position)) (quote cross-bus)) 181.)))
  (conditional-part (or (>> source?) (>> continue-value?))
    'value-in rectangle (top-right (pt (>> x bottom-right value-in-flash) 183.))
    (bottom-left (pt 54. 179.)) (layer 'metal))
  (conditional-part
    (>> continue-value?) 
     'value-out rectangle (bottom-left (pt (>> x bottom-right value-in-flash) 179.)) 
    (top-right (pt (+ 3. (>> x bottom-right cross-bus)) 183.)) (layer 'metal))
  (fracture left-stretch vertical (pt 55. 176.))
  (fracture right-stretch vertical (pt-to-right (>> bottom-right cross-bus) 1))
  (fracture bottom-stretch horizontal (pt 64. 158.))
  (fracture gnd-stretch horizontal (pt 80. 167.))
  (fracture vdd-stretch horizontal (pt 60. 187.))
  (fracture top-stretch horizontal (pt 61. 202.)))



