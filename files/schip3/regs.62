  (part nil rectangle (width 8.) (length 2.) (bottom-left (pt 128. 17.)) (layer 'poly))
  (part nil rectangle (width 7.) (length 2.) (bottom-left (pt 123. 24.)) (layer 'diff))
  (part 'signal rectangle (bottom-left (pt 104.0 -3.0)) (length 47.0) (width 2.0) 
    (layer 'poly))
  (part 'value-in rectangle (top-right (pt 108. 24.)) (bottom-left (pt 102. 21.)) 
