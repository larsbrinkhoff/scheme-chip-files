  (part nil rectangle (bottom-left (pt 131. 26.)) (top-right (pt 137. 28.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 137. 6.)) (top-right (pt 143. 8.)) (layer 'diff))
