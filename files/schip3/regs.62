  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil square-contact (layer 'diff) (bottom-left (pt 135. 38.)))
  (conditional-part (or (>> continue-value?) (eq (>> local-or-global) 'local))
    'local-bus rectangle (bottom-left (pt 131. -2.)) (top-right (pt 141. 1.)) 
    (layer 'metal))
