    (layer 'poly))
  (part 'gnd rectangle (bottom-left (pt -4. 2.)) (length 3.) (width 53.) (layer 'metal))
  (part nil square-contact (layer 'diff) (bottom-left (pt 11. 2.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 13. 23.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 30. 22.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 26. 2.)))
  (part nil butting-contact (bottom-left (pt 35. 14.)) (xfrm 'rot180))
  (part nil rectangle (bottom-left (pt 30. 17.)) (length 6.) (width 2.) (layer 'diff))
  (part 'value-bar rectangle (bottom-left (pt 16. 10.)) (length 3.) (width 6.) 
    (layer 'metal))
  (part nil rectangle (top-right (pt 17. 9.)) (length 2.) (width 8.) (layer 'poly))
  (part nil inline-pullup (channel-length 8.) (channel-width 2.) (bottom-left (pt 11. 10.)))
  (part nil rectangle (top-right (pt 15. 10.)) (length 8.) (width 4.) (layer 'diff))
  (part nil inline-pullup (channel-length 8.) (channel-width 2.) (bottom-left (pt 45. 15.)) 
    (xfrm 'rot90))
  (part nil rectangle (top-right (pt 45. 16.)) (bottom-left (pt 43. 12.)) (layer 'diff))
  (part nil rectangle (top-right (pt 43. 14.)) (length 2.) (width 5.) (layer 'diff))
  (part nil rectangle (bottom-left (pt 38. -1.)) (length 13.) (width 2.) (layer 'diff))
  (part nil rectangle (top-right (pt 45. 24.)) (bottom-left (pt 43. 20.)) (layer 'diff))
  (part nil rectangle (top-right (pt 43. 24.)) (bottom-left (pt 38. 22.)) (layer 'diff))
  (part nil rectangle (top-right (pt 40. 30.)) (bottom-left (pt 38. 24.)) (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt 22. 10.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 30. 29.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 22. 29.)))
  (part nil rectangle (top-right (pt 30. 33.)) (bottom-left (pt 26. 30.)) (layer 'metal))
  (part nil rectangle (top-right (pt 40. 32.)) (bottom-left (pt 34. 30.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 26. 12.)) (length 2.) (width 5.) (layer 'diff))
  (wire 'read (from (pt 42. 40.)) (run-layer 'poly) (jog-y (pt 47. 26.)) (jog-y (pt 42. 4.)) 
      (to-y (pt 42. -7.)))
  (part nil pass-transistor (center (pt 20. 32.)) (xfrm 'rot90))
  (part nil rectangle (bottom-left (pt 17. 33.)) (top-right (pt 17. 33.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 8. 31.)) (top-right (pt 17. 33.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 13. 26.)) (top-right (pt 13. 26.)) (layer 'metal))
  (part nil butting-contact (bottom-left (pt 9. 18.)) (xfrm 'rot180))
  (part nil square-contact (layer 'diff) (bottom-left (pt -4. 29.)))
  (part nil rectangle (bottom-left (pt 7. 18.)) (top-right (pt 9. 33.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt -4. 29.)) (length 2.) (width 11.) (layer 'diff))
  (part nil rectangle (bottom-left (pt 7. 7.)) (top-right (pt 9. 12.)) (layer 'poly))
  (wire 'load (from (pt 6. 40.)) (run-layer 'poly) (jog-y (pt 2. 37.)) (jog-y (pt 6. 4.)) 
      (to-y (pt 21. -7.)))
  (part 'local-bus rectangle (bottom-left (pt -4. -5.)) (length 3.) (width 40.) 
