  (part 'vdd rectangle (bottom-left (pt 126. 26.)) (length 3.) (width 22.) (layer 'metal))
  (part 'gnd rectangle (bottom-left (pt 126. 5.)) (length 3.) (width 22.) (layer 'metal))
