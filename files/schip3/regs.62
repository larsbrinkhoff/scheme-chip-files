  (part nil rectangle (width 28.) (length 2.) (bottom-left (pt 116. 0.)) (layer 'diff))
  (conditional-part
    (eq (>> right-source) (quote global)) 
     nil square-contact (layer 'poly) (bottom-left (pt 144. 39.)))
  (part nil rectangle (width 20.) (length 2.) (bottom-left (pt 125. 3.)) (layer 'poly))
  (part nil square-contact (layer 'diff) (bottom-left (pt 137. 27.)))
  (part nil rectangle (width 4.) (length 20.) (bottom-left (pt 130. 6.)) (layer 'diff))
