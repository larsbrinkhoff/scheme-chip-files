  (conditional-part
    (eq (>> zero-or-one) (quote zero)) 
     'zero-contact square-contact (layer 'diff) (bottom-left (pt 135. 8.)))
  (conditional-part
    (>> continue-value?) 
     'value rectangle (bottom-left (pt 131. 19.)) (top-right (pt 141. 23.)) (layer 'metal))
  (part nil rectangle (bottom-left (pt 136. -2.)) (length 40.) (width 2.) (layer 'diff))
  (conditional-part
    (eq (>> local-or-global) (quote local)) 
     nil square-contact (layer 'diff) (bottom-left (pt 135. -2.)))
  (conditional-part
    (eq (>> local-or-global) (quote local)) 
     nil rectangle (bottom-left (pt 134. 3.)) (top-right (pt 140. 5.)) (layer 'poly))
  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil rectangle (bottom-left (pt 134. 35.)) (top-right (pt 140. 37.)) (layer 'poly))
  (conditional-part
    (and (eq (>> zero-or-one) (quote one)) (eq (>> local-or-global) (quote value-bus))) 
     nil rectangle (bottom-left (pt 134. 23.)) (top-right (pt 140. 25.)) (layer 'poly))
  (conditional-part
    (eq (>> local-or-global) (quote value-bus)) 
     nil square-contact (layer 'diff) (bottom-left (pt 135. 18.)))
  (conditional-part
    (and (eq (>> zero-or-one) (quote zero)) (eq (>> local-or-global) (quote value-bus))) 
     nil rectangle (bottom-left (pt 134. 15.)) (top-right (pt 140. 17.)) (layer 'poly))
  (fracture left-stretch vertical (pt 132. 31.))
  (fracture right-stretch vertical (pt 140. 31.))
  (fracture bottom-stretch horizontal (pt 140. -3.))
  (fracture gnd-stretch horizontal (pt 140. 6.))
  (fracture vdd-stretch horizontal (pt 140. 27.))
  (fracture top-stretch horizontal (pt 137. 42.)))

(deflayout constant-source-reg
   '((primary-parameters (constant size)))
  (replicate 'bits bit-tester-reg (list (>> size))
	     (list (part () rw-reg-constant-source (zero-or-one 'zero))
		   (part () rw-reg-constant-source (zero-or-one 'one)))
	     (test-number (>> constant))))



;;;; a source of left addresses and right addresses

;;; local or global can be either local, global or value-bus
;;; the first two refer two the two standard buses the third refers
;;; to the bus attached to the output of a reg.  This is intended for the
;;; row which is the low bit of address which is not in any actual word.

