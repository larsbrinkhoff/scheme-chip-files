  (part nil rectangle (bottom-left (pt 30. 3.)) (top-right (pt 38. 7.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 36. 0.)) (top-right (pt 41. 2.)) (layer 'poly))
  (part nil square-contact (layer 'diff) (bottom-left (pt 36. -5.)))
  (wire 'phi-2 (from (pt 28. 40.)) (run-layer 'poly) (jog-y (pt 24. 8.)) (jog-y (pt 28. 0.)) 
