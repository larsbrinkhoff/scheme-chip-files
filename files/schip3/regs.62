;;; -*- Mode: Lisp; Base: 10.; Package: dpl; -*-

;;;; basic cells

(deflayout transistor-replacer
  '((primary-parameters ((options 'normal) (channel-length 2) (channel-width 2))))
  (part 'drain rectangle (layer 'diff) (length 2) (width (>> channel-width)))
  (part 'source rectangle (layer 'diff) (length 2) (width (>> channel-width))
	(top-left (pt-below (>> bottom-left drain) (>> channel-length))))
  (conditional-part
    (eq (>> options) 'short)
    'connect rectangle (width (>> channel-width)) (length (>> channel-length))
    (layer 'diff) (top-center (>> bottom-center drain)))
  (conditional-part
    (eq (>> options) 'normal)
    'channel rectangle (layer 'diff) (top-center (>> bottom-center drain))
    (width (>> channel-width)) (length (>> channel-length)))
  (conditional-part
    (eq (>> options) 'normal)
    'gate rectangle (layer 'poly) (length (>> channel-length))
    (width (+ (>> channel-width) 4)) (top-center (>> bottom-center drain))))

(deflayout matrix
   `((primary-parameters
       ((vdd-stretch 0.) (gnd-stretch 0.) (width 58.) (continue-value? nil)))
     (auxiliary-parameters
       ((xfrm 'identity) vdd-stretch-top vdd-stretch-bottom
	gnd-stretch-top gnd-stretch-bottom))
     (constraints 
       ((vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
	(vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm))))
   (part 'bus rectangle (bottom-left (pt -9. 36.)) (length 3.) (width (>> width))
	 (layer 'metal))
   (part 'vdd rectangle (bottom-left (pt -9. 23.)) (length 3.) (width (>> width))
	 (layer 'metal))
   (part 'gnd rectangle (bottom-left (pt -9. 2.)) (length 3.) (width (>> width))
	 (layer 'metal))
   (conditional-part (>> continue-value?) 
     'value-out rectangle (bottom-left (pt -9 16.)) (length 4.) (width (>> width))
     (layer 'metal))
   (conditional-part (>> continue-value?)
      'local-bus rectangle (bottom-left (pt -9 -5.)) (length 3.) (width (>> width))
      (layer 'metal))
   (fracture gnd-stretch horizontal (pt 8. 4.))
   (fracture vdd-stretch horizontal (pt 42. 25.)))


;;; a cell for jumping a bus over a power line.  The jumper is on poly.
;;; bus-space should be set to the width of the power line being jumped.
;;; bus-connection is where the bus is touched
;;; output-connection is where to route a connecting signal to

(deflayout bus-jumper
   `((primary-parameters 
       ((bus-space 0.)))
     (auxiliary-parameters 
       ((xfrm 'identity) bus-space-right bus-space-left bus-connection output-connection))
     (constraints 
       ((horizontal-stretch bus-space-left bus-space-right bus-space xfrm))))
    (part nil rectangle (bottom-left (pt 0. 0.)) (top-right (pt 2. 3.)) (layer 'metal))
    (part nil square-contact (layer 'poly) (bottom-left (pt 2. -1.)))
    (part nil rectangle (bottom-left (pt 6. 1.)) (top-right (pt 12. 3.)) (layer 'poly))
    (part nil square-contact (layer 'poly) (bottom-left (pt 12. -1.)))
    (setq-my bus-connection (pt 0. 1.5))
    (setq-my output-connection (pt 16. 1.))
    (fracture bus-space vertical (pt 9. 2.)))



;;;; basic normal register

;;; if neither continue-value? nor left-local-connect are present then there is
;;; no need for the load-local control line and it is omitted and the width compressed.
;;; driver for this cell should also know about this.

(deflayout normal-register
  `((primary-parameters 
      ((left-output-connect nil) (left-local-connect nil)
       (continue-value? nil) (local-bus? t)
       (top-stretch 0.) (vdd-stretch 0.) (gnd-stretch 0.) (bottom-stretch 0.)
       (right-stretch 0.) (left-stretch 0.)))
    (auxiliary-parameters 
      ((xfrm 'identity)top-stretch-top top-stretch-bottom vdd-stretch-top vdd-stretch-bottom 
       gnd-stretch-top gnd-stretch-bottom bottom-stretch-top bottom-stretch-bottom 
       right-stretch-right right-stretch-left left-stretch-right left-stretch-left ))
    (constraints 
      ((vertical-stretch top-stretch-bottom top-stretch-top top-stretch xfrm)
       (vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
       (vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm)
       (vertical-stretch bottom-stretch-bottom bottom-stretch-top bottom-stretch xfrm)
       (horizontal-stretch right-stretch-left right-stretch-right right-stretch xfrm)
       (horizontal-stretch left-stretch-left left-stretch-right left-stretch xfrm))))
  (part nil rectangle (bottom-left (pt 10. 30.)) (length 2.) (width 12.) (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt 45. 35.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 0. 35.)))
  (part 'bus rectangle (length 3.) (top-right (pt 49. 39.)) 
    (width (if (>> local-bus?) 58. 49.)) (layer 'metal))
  (part 'vdd rectangle (top-right (pt 49. 26.)) (length 3.) 
    (width (if (>> local-bus?) 58. 49.)) (layer 'metal))
  (part 'restore rectangle (bottom-left (pt 19. -7.)) (length 47.) (width 2.) (layer 'poly))
  (part 'gnd rectangle (top-right (pt 49. 5.)) (length 3.) 
    (width (if (>> local-bus?) 58. 49.)) (layer 'metal))
  (part nil square-contact (layer 'diff) (bottom-left (pt 11. 1.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 13. 22.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 30. 22.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 36. 2.)))
  (part nil butting-contact (bottom-left (pt 30. 13.)) (xfrm 'rot270))
  (part nil rectangle (bottom-left (pt 7. 7.)) (length 7.) (width 2.) (layer 'poly))
  (part nil rectangle (bottom-left (pt 36. 9.)) (length 2.) (width 7.) (layer 'poly))
  (part nil rectangle (bottom-left (pt 30. 17.)) (length 6.) (width 2.) (layer 'diff))
  (part 'value-bar rectangle (bottom-left (pt 16. 9.)) (length 3.) (width 6.) 
    (layer 'metal))
  (part nil butting-contact (bottom-left (pt 9. 20.)) (xfrm 'rot180))
  (part nil rectangle (bottom-left (pt 7. 6.)) (length 2.) (width 10.) (layer 'poly))
  (part nil inline-pullup (channel-length 8.) (channel-width 2.) (bottom-left (pt 11. 9.)))
  (part nil rectangle (bottom-left (pt 11. 1.)) (length 8.) (width 4.) (layer 'diff))
  (part nil inline-pullup (channel-length 8.) (channel-width 2.) (bottom-left (pt 45. 15.)) 
    (xfrm 'rot90))
  (part nil rectangle (top-right (pt 45. 16.)) (bottom-left (pt 43. 12.)) (layer 'diff))
  (part nil rectangle (top-right (pt 43. 14.)) (length 2.) (width 6.) (layer 'diff))
  (part nil rectangle (bottom-left (pt 37. 6.)) (length 6.) (width 4.) (layer 'diff))
  (part nil rectangle (top-right (pt 45. 24.)) (bottom-left (pt 43. 20.)) (layer 'diff))
  (part nil rectangle (top-right (pt 43. 24.)) (bottom-left (pt 38. 22.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 38. 24.)) (length 12.) (width 2.) (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt 22. 9.)))
  (part 'phi-2 rectangle (bottom-left (pt 27. -7.)) (length 47.) (width 2.) (layer 'poly))
  (part nil square-contact (layer 'diff) (bottom-left (pt 30. 29.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 22. 29.)))
  (part nil rectangle (top-right (pt 40. 32.)) (bottom-left (pt 34. 30.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 26. 10.)) (length 2.) (width 4.) (layer 'diff))
  (part nil rectangle (bottom-left (pt 38. 36.)) (length 2.) (width 7.) (layer 'diff))
  (part nil rectangle (bottom-left (pt 8. 22.)) (length 14.) (width 2.) (layer 'diff))
  (part nil rectangle (bottom-left (pt 7. 20.)) (top-right (pt 10. 22.)) (layer 'diff))
  (conditional-part
    (>> continue-value?) 
     'value-out rectangle (bottom-left (pt 45. 16.)) (top-right (pt 49. 20.)) (layer 'metal))
  (conditional-part
    (>> local-bus?) 
     'local-bus rectangle (bottom-left (pt 2. -5.)) (top-right (pt 49. -2.)) (layer 'metal))
  (conditional-part
    (>> local-bus?) 
     nil square-contact (layer 'diff) (bottom-left (pt -2. -5.)))
  (conditional-part
    (>> local-bus?) 
     'load-local rectangle (bottom-left (pt -8. -7.)) (length 47.) (width 2.) (layer 'poly))
  (conditional-part
   (>> local-bus?)
     nil rectangle (bottom-left (pt -6. 12.)) (top-right (pt -1. 14.)) (layer 'poly))
  (conditional-part
    (>> local-bus?) 
     nil rectangle (top-right (pt -3. 15.)) (length 14.) (width 2.) (layer 'diff))
  (conditional-part
    (>> local-bus?) 
     nil square-contact (layer 'diff) (bottom-left (pt -5. 15.)))
  (conditional-part
    (>> local-bus?) 
     nil rectangle (bottom-left (pt -1. 15.)) (top-right (pt 5. 19.)) (layer 'metal))
  (conditional-part
    (>> local-bus?) 
     nil rectangle (bottom-left (pt -5. -1.)) (length 2.) (width 7.) (layer 'diff))
  (wire 'load-global (from (pt 6. 40.)) (run-layer 'poly) (jog-y (pt 2. 27.)) 
      (jog-y (pt 6. 3.)) (to-y (pt -7. -7.)))
  (wire 'read (from (pt 42. 40.)) (run-layer 'poly) (jog-y (pt 47. 26.)) (jog-y (pt 42. 3.)) 
      (to-y (pt 29. -7.)))
  (conditional-part
    (>> left-output-connect) 
     'value-out-left rectangle (bottom-left (pt -9. 29.)) (top-right (pt 22. 32.)) 
    (layer 'metal))
  (part nil rectangle (bottom-left (pt 26. 29.)) (length 3.) (width 4.) (layer 'metal))
  (conditional-part
    (>> left-local-connect) 
     'left-local-bus-connect rectangle (bottom-left (pt -9. -5.)) (top-right (pt -2. -2.)) 
    (layer 'metal))
  (part nil rectangle (bottom-left (pt 37. 2.)) (top-right (pt 40. 6.)) (layer 'diff))
  (part nil rectangle (bottom-left (pt 0. 36.)) (top-right (pt 10. 38.)) (layer 'diff))
  (fracture left-stretch vertical (if (>> local-bus?) (pt -8 32.) (pt 1. 32.)))
  (fracture right-stretch vertical (pt 48. 20.))
  (fracture bottom-stretch horizontal (pt 43. -6.))
  (fracture gnd-stretch horizontal (pt 8. 4.))
  (fracture vdd-stretch horizontal (pt 42. 25.))
  (fracture top-stretch horizontal (pt 34. 39.)))



;;;; backup register 

(deflayout shadow-register
  `((primary-parameters 
      ((top-stretch 0.) (vdd-stretch 0.) (gnd-stretch 0.) (bottom-stretch 0.)
       (right-stretch 0.) (left-stretch 0.)))
    (auxiliary-parameters 
      ((xfrm 'identity)top-stretch-top top-stretch-bottom vdd-stretch-top vdd-stretch-bottom 
       gnd-stretch-top gnd-stretch-bottom bottom-stretch-top bottom-stretch-bottom 
       right-stretch-right right-stretch-left left-stretch-right left-stretch-left))
    (constraints 
      ((vertical-stretch top-stretch-bottom top-stretch-top top-stretch xfrm)
       (vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
       (vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm)
       (vertical-stretch bottom-stretch-bottom bottom-stretch-top bottom-stretch xfrm)
       (horizontal-stretch right-stretch-left right-stretch-right right-stretch xfrm)
       (horizontal-stretch left-stretch-left left-stretch-right left-stretch xfrm))))
  (part 'bus rectangle (bottom-left (pt -4. 36.)) (length 3.) (width 53.) (layer 'metal))
  (part 'vdd rectangle (bottom-left (pt -4. 23.)) (length 3.) (width 53.) (layer 'metal))
