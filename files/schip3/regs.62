  (conditional-part
    (>> continue-value?) 
     'value rectangle (bottom-left (pt 126. 19.)) (length 4.) (width 22.) (layer 'metal))
  (conditional-part
    (eq (>> local-or-global) (quote local)) 
     nil square-contact (layer 'diff) (bottom-left (pt 135. -2.)))
  (conditional-part
    (eq (>> local-or-global) (quote value-bus)) 
     nil square-contact (layer 'diff) (bottom-left (pt 135. 18.)))
  (part 'left-address rectangle (bottom-left (pt 140. -4.)) (top-right (pt 142. 43.)) 
