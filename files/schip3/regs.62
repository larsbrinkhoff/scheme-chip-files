;;;; arbitary bit pattern tester

(defdefault global-continue-hack (local-or-global continue-value?)
  (continue-value? (local-or-global) (if (eq local-or-global 'global) () 'bail-out))
  (local-or-global (continue-value?) (if (null continue-value?) 'local 'bail-out)))

(deflayout bit-tester
  `((primary-parameters 
    ((zero-or-one 'one) (continue-value? nil) (bottom-bit? t) (local-or-global 'local)
     (top-stretch 0.) (vdd-stretch 0.) (gnd-stretch 0.) (bottom-stretch 0.)
     (right-stretch 0.) (left-stretch 0.)))
  (auxiliary-parameters 
    ((xfrm 'identity) top-stretch-top top-stretch-bottom vdd-stretch-top vdd-stretch-bottom 
     gnd-stretch-top gnd-stretch-bottom bottom-stretch-top bottom-stretch-bottom 
     right-stretch-right right-stretch-left left-stretch-right left-stretch-left ))
  (constraints 
    ((global-continue-hack local-or-global continue-value?)
     (vertical-stretch top-stretch-bottom top-stretch-top top-stretch xfrm)
     (vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
     (vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm)
     (vertical-stretch bottom-stretch-bottom bottom-stretch-top bottom-stretch xfrm)
     (horizontal-stretch right-stretch-left right-stretch-right right-stretch xfrm)
     (horizontal-stretch left-stretch-left left-stretch-right left-stretch xfrm))))
  (conditional-part
    (eq (>> zero-or-one) (quote one)) 
     nil rectangle (top-right (pt 115. 15.)) (length 2.0) (width 5.0) (layer 'poly))
  (conditional-part
    (eq (>> zero-or-one) (quote one)) 
     nil rectangle (bottom-left (pt 119. 26.)) (length 5.) (width 2.) (layer 'diff))
  (conditional-part
    (eq (>> zero-or-one) (quote one)) 
     nil standard-pullup (channel-length 8.) (bottom-left (pt 115. 13.)))
  (conditional-part
    (eq (>> zero-or-one) (quote one)) 
     nil rectangle (bottom-left (pt 125. 11.)) (top-right (pt 127. 20.)) (layer 'poly))
  (conditional-part
    (and (eq (>> local-or-global) (quote local)) (eq (>> zero-or-one) (quote one))) 
     nil square-contact (layer 'poly) (bottom-left (pt 125. 20.)))
  (conditional-part
    (eq (>> zero-or-one) (quote one)) 
     nil rectangle (bottom-left (pt 120. 6.)) (length 11.) (width 2.) (layer 'diff))
  (conditional-part
    (eq (>> zero-or-one) (quote one)) 
     nil rectangle (bottom-left (pt 118. 9.)) (top-right (pt 127. 11.)) (layer 'poly))
  (conditional-part
    (eq (>> zero-or-one) (quote one)) 
     'foo rectangle (bottom-left (pt 114. 6.)) (top-right (pt 121. 8.)) (layer 'diff))
  (conditional-part
    (not (eq (>> zero-or-one) (quote one))) 
     'one-flash rectangle (bottom-left (pt 110.0 15.0)) (length 5.0) (width 2.0) 
    (layer 'poly))
  (conditional-part
    (eq (>> zero-or-one) (quote zero)) 
     nil square-contact (layer 'poly) (bottom-left (pt 108. 20.)))
  (part 'signal rectangle (bottom-left (pt 103.0 -3.0)) (length 47.0) (width 2.0) 
    (layer 'poly))
  (conditional-part
    (eq (>> local-or-global) (quote local)) 
     'value-in rectangle (bottom-left (pt 102. 20.)) (length 4.0) (width 10.0) (layer 'metal))
  (part 'bus rectangle (bottom-left (pt 102. 40.)) (length 3.) (width 28.) (layer 'metal))
  (part 'vdd rectangle (bottom-left (pt 102. 27.)) (length 3.) (width 28.) (layer 'metal))
  (part 'gnd rectangle (bottom-left (pt 102. 6.)) (length 3.) (width 28.) (layer 'metal))
  (part nil rectangle (bottom-left (pt 107.0 6.0)) (length 2.0) (width 8.0) (layer 'diff))
  (part nil rectangle (bottom-left (pt 107.0 6.0)) (length 11.0) (width 2.0) (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt 113. 5.)))
  (conditional-part
    (>> continue-value?) 
     'value-out rectangle (top-right (pt 130. 24.)) (length 4.0) (width 5.0) (layer 'metal))
  (conditional-part
    (or (>> bottom-bit?) (eq (>> zero-or-one) (quote one))) 
     nil square-contact (layer 'diff) (bottom-left (pt 117. 27.)))
  (conditional-part
    (>> bottom-bit?) 
     'bottom-bit-pullup inline-pullup (channel-length 8.) (channel-width 2.) 
    (bottom-left (pt 107. 38.)) (xfrm 'rot270))
  (conditional-part
    (>> bottom-bit?) 
     nil rectangle (bottom-left (pt 121. 27.)) (top-right (pt 123. 36.)) (layer 'diff))
  (conditional-part
    (>> continue-value?) 
     'local-bus rectangle (bottom-left (pt 102. -1.)) (top-right (pt 130. 2.)) (layer 'metal))
  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil square-contact (layer 'poly) (bottom-left (pt 125. 39.)))
  (conditional-part
    
    (or (>> continue-value?) (and (eq (>> local-or-global) (quote local)) (eq (>> zero-or-one) (quote one)))) 
     nil rectangle (bottom-left (pt 112. 20.)) (top-right (pt 125. 24.)) (layer 'metal))
  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil rectangle (bottom-left (pt 125. 20.)) (top-right (pt 127. 39.)) (layer 'poly))
  (conditional-part
    (and (eq (>> zero-or-one) (quote zero)) (eq (>> local-or-global) (quote global))) 
     nil rectangle (bottom-left (pt 108. 20.)) (top-right (pt 125. 22.)) (layer 'poly))
  (conditional-part
    (>> bottom-bit?) 
     nil rectangle (bottom-left (pt 105. 30.)) (top-right (pt 113. 32.)) (layer 'poly))
  (part nil butting-contact (bottom-left (pt 109. 13.)) (xfrm 'rot90))
  (part nil rectangle (bottom-left (pt 110. 4.)) (top-right (pt 112. 15.)) (layer 'poly))
  (fracture left-stretch vertical (pt 103. 34.))
  (fracture right-stretch vertical (pt 129. 22.))
  (fracture bottom-stretch horizontal (pt 109. -2.))
  (fracture gnd-stretch horizontal (pt 117. 8.))
  (fracture vdd-stretch horizontal (pt 116. 28.))
  (fracture top-stretch horizontal (pt 109. 43.)))

(defreplicator bit-tester-reg (i)
  '((primary-parameters ((test-number) (v-pitch) (v-spacing)))
    (constraints ((v-pitch instance-list v-pitch v-spacing)
		  (v-spacing instance-list v-spacing))))
  (replicator-transform 'identity 0 (* i (>> v-pitch)))
  (if (bit-test (lsh 1 i) (>> test-number))
      (replicator-instance (>> (*rep-instance 0)))
      (replicator-instance (>> (*rep-instance 1)))))



