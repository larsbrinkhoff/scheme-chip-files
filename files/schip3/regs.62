;;;; driver for clocks phi-1 and phi-2 and freeze-bar
;;; inputs are freeze phi-1 phi-2
;;; outputs are freeze-bar phi-1 phi-2


(deflayout clock-freeze-driver
  `((primary-parameters 
      ((right-stretch 0.) (left-stretch 0.)))
    (auxiliary-parameters 
      ((xfrm 'identity)right-stretch-right right-stretch-left left-stretch-right 
       left-stretch-left ))
    (constraints 
