  (fracture top-stretch horizontal (pt 137. 42.)))



;;;; shifters

;;; both have options for local or global bus operation and options for
;;; shift in value at the extreme.

(deflayout shift-right
  `((primary-parameters 
      ((continue-value? t) (top-bit? nil) (shift-in-value 'zero) (bottom-bit? nil)
       (local-or-global 'local) (top-stretch 0.) (left-stretch 0.)
       (vdd-stretch 0.) (gnd-stretch 0.) (bottom-stretch 0.) (right-stretch 0.)))
    (auxiliary-parameters 
      ((xfrm 'identity)top-stretch-top top-stretch-bottom vdd-stretch-top vdd-stretch-bottom 
       gnd-stretch-top gnd-stretch-bottom bottom-stretch-top bottom-stretch-bottom 
       right-stretch-right right-stretch-left left-stretch-right left-stretch-left ))
    (constraints 
      ((vertical-stretch top-stretch-bottom top-stretch-top top-stretch xfrm)
       (vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
       (vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm)
       (vertical-stretch bottom-stretch-bottom bottom-stretch-top bottom-stretch xfrm)
       (horizontal-stretch right-stretch-left right-stretch-right right-stretch xfrm)
       (horizontal-stretch left-stretch-left left-stretch-right left-stretch xfrm))))
  (part 'bus rectangle (bottom-left (pt 1. 36.)) (length 3.) (width 13.) (layer 'metal))
  (part 'vdd rectangle (bottom-left (pt 1. 23.)) (length 3.) (width 13.) (layer 'metal))
  (part 'gnd rectangle (bottom-left (pt 1. 2.)) (length 3.) (width 13.) (layer 'metal))
  (part 'shift rectangle (bottom-left (pt 2. -7.)) (length 47.) (width 2.) (layer 'poly))
  (part 'value-in rectangle (bottom-left (pt 1. 16.)) (length 4.) (width 8.) 
    (layer 'metal))
  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil rectangle (top-right (pt 7. 39.)) (length 30.) (width 2.) (layer 'diff))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil square-contact (layer 'poly) (bottom-left (pt 9. 16.)))
  (conditional-part
    (not (>> bottom-bit?)) 
     nil rectangle (bottom-left (pt 11. 20.)) (length 20.) (width 2.) (layer 'poly))
  (conditional-part
    (not (>> top-bit?)) 
     nil rectangle (bottom-left (pt 11. -7.)) (length 20.) (width 2.) (layer 'poly))
  (conditional-part
    (not (>> top-bit?)) 
     nil butting-contact (bottom-left (pt 7. 13.)) (xfrm 'rot270))
  (conditional-part
    (>> continue-value?) 
     'value-out rectangle (bottom-left (pt 9. 16.)) (length 4.) (width 5.) (layer 'metal))
  (part 'local-bus rectangle (bottom-left (pt 1. -5.)) (length 3.) (width 13.) 
    (layer 'metal))
  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil square-contact (layer 'diff) (bottom-left (pt 5. 35.)))
  (conditional-part
    (and (>> top-bit?) (eq (>> shift-in-value) (quote one))) 
     nil square-contact (layer 'diff) (bottom-left (pt 5. 23.)))
  (conditional-part
    (and (>> top-bit?) (eq (>> shift-in-value) (quote zero))) 
     nil square-contact (layer 'diff) (bottom-left (pt 5. 3.)))
  (conditional-part
    (and (>> top-bit?) (eq (>> shift-in-value) (quote zero))) 
     nil rectangle (bottom-left (pt 5. 2.)) (top-right (pt 7. 13.)) (layer 'diff))
  (conditional-part
    (eq (>> local-or-global) (quote local)) 
     nil rectangle (bottom-left (pt 5. -5.)) (top-right (pt 7. 27.)) (layer 'diff))
  (conditional-part
    (eq (>> local-or-global) (quote local)) 
     nil square-contact (layer 'diff) (bottom-left (pt 5. -5.)))
  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil rectangle (bottom-left (pt 4. 32.)) (top-right (pt 9. 34.)) (layer 'poly))
  (conditional-part
    (eq (>> local-or-global) (quote local)) 
     nil rectangle (bottom-left (pt 4. 0.)) (top-right (pt 9. 2.)) (layer 'poly))
  (fracture left-stretch vertical (pt 2. 19.))
  (fracture right-stretch vertical (pt 13. 19.))
  (fracture bottom-stretch horizontal (pt 1. -6.))
  (fracture gnd-stretch horizontal (pt 8. 3.))
  (fracture vdd-stretch horizontal (pt 7. 24.))
  (fracture top-stretch horizontal (pt 13. 39.)))



;;; the low order bit can be forced to shift in zero, one, or can be supplied
;;; by a control line (this option indicated by shift-in-value being 'supplied)

(deflayout shift-left
  `((primary-parameters 
    ((top-output-desired? nil) (top-bit? nil) (shift-in-value 'zero)
       (local-or-global 'local) (continue-value? t) (bottom-bit? nil) (top-stretch 0.)
       (vdd-stretch 0.) (gnd-stretch 0.) (bottom-stretch 0.) (right-stretch 0.)
       (left-stretch 0.)))
  (auxiliary-parameters 
    ((xfrm 'identity)top-stretch-top top-stretch-bottom vdd-stretch-top vdd-stretch-bottom 
      gnd-stretch-top gnd-stretch-bottom bottom-stretch-top bottom-stretch-bottom 
      right-stretch-right right-stretch-left left-stretch-right left-stretch-left 
      left-shift-left right-shift-left ))
  (constraints 
    ((vertical-stretch top-stretch-bottom top-stretch-top top-stretch xfrm)
       (vertical-stretch vdd-stretch-bottom vdd-stretch-top vdd-stretch xfrm)
       (vertical-stretch gnd-stretch-bottom gnd-stretch-top gnd-stretch xfrm)
       (vertical-stretch bottom-stretch-bottom bottom-stretch-top bottom-stretch xfrm)
       (horizontal-stretch right-stretch-left right-stretch-right right-stretch xfrm)
       (horizontal-stretch left-stretch-left left-stretch-right left-stretch xfrm))))
  (part 'bus rectangle (bottom-left (pt -5. 36.)) (length 3.) (width 14.) (layer 'metal))
  (part 'vdd rectangle (bottom-left (pt -5. 23.)) (length 3.) (width 14.) (layer 'metal))
  (part 'gnd rectangle (bottom-left (pt -5. 2.)) (length 3.) (width 14.) (layer 'metal))
  (part nil square-contact (layer 'diff) (bottom-left (pt 4. 16.)))
  (part 'shift rectangle (bottom-left (pt 1. -7.)) (length 47.) (width 2.) (layer 'poly))
  (conditional-part
    (or (eq (>> local-or-global) (quote local))
	(and (>> bottom-bit?) (not (eq (>> shift-in-value) (quote supplied))))) 
     nil rectangle (bottom-left (pt -2. -1.)) (length 40.) (width 2.) (layer 'diff))
  (conditional-part
    (eq (>> local-or-global) (quote local)) 
     nil square-contact (layer 'diff) (bottom-left (pt -4. -5.)))
  (part 'local-bus rectangle (bottom-left (pt -5. -5.)) (length 3.) (width 14.) 
    (layer 'metal))
  (part 'value-in rectangle (top-right (pt 4. 20.)) (length 4.) (width 9.) (layer 'metal))
  (conditional-part
    (or (not (>> bottom-bit?)) (eq (>> shift-in-value) (quote supplied))) 
     nil rectangle (bottom-left (pt -2. 37.)) (top-right (pt 6. 39.)) (layer 'diff))
  (conditional-part
    (or (not (>> top-bit?)) (>> top-output-desired?)) 
     nil rectangle (top-right (pt 6. 16.)) (length 23.) (width 2.) (layer 'diff))
  (conditional-part
    (and (>> bottom-bit?) (eq (>> shift-in-value) (quote zero))) 
     nil square-contact (layer 'diff) (bottom-left (pt -4. 4.)))
  (conditional-part
    (and (eq (>> bottom-bit?) t) (eq (>> shift-in-value) (quote one))) 
     nil square-contact (layer 'diff) (bottom-left (pt -4. 23.)))
  (conditional-part
    (or (not (>> bottom-bit?)) (eq (>> shift-in-value) (quote supplied))) 
     nil rectangle (bottom-left (pt 4. 37.)) (length 3.) (width 2.) (layer 'diff))
  (conditional-part
    (>> continue-value?) 
     'value-out rectangle (bottom-left (pt 4. 16.)) (length 4.) (width 5.) (layer 'metal))
  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil square-contact (layer 'diff) (bottom-left (pt -4. 35.)))
  (conditional-part
    (and (eq (>> local-or-global) (quote local)) (>> bottom-bit?)
	 (not (eq (>> shift-in-value) (quote supplied)))) 
     nil rectangle (bottom-left (pt -4. 0.)) (top-right (pt 1. 2.)) (layer 'poly))
  (conditional-part
    (and (eq (>> local-or-global) (quote global)) (>> bottom-bit?)) 
     nil rectangle (bottom-left (pt -4. 32.)) (top-right (pt 1. 34.)) (layer 'poly))
  (setq-my left-shift-left (pt -6. 27.))
  (setq-my right-shift-left (pt 14. 27.))
  (fracture left-stretch vertical (pt -4. 29.))
  (fracture right-stretch vertical (pt 8. 15.))
  (fracture bottom-stretch horizontal (pt -1. -6.))
  (fracture gnd-stretch horizontal (pt 4. 4.))
  (fracture vdd-stretch horizontal (pt 7. 24.))
  (fracture top-stretch horizontal (pt 7. 39.)))



