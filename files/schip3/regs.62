    (layer 'poly))
  (conditional-part
    (eq (>> local-or-global) (quote global)) 
     nil square-contact (layer 'diff) (bottom-left (pt 135. 38.)))
  (part 'local-bus rectangle (bottom-left (pt 126. -2.)) (length 3.) (width 22.) 
    (layer 'metal))
