;;; -*- mode: LISP; package: DPL -*-

;;; Routing in the land-of-ns

(schip-code clocking-in-ns (land-of-ns clock-circuits gnd-wiring)
  (group clocking-in-ns
	 (wireq phi2 (run-layer 'poly)
		(from (>> (*path '(clock phi2))
			  next-state land-of-ns))
		(to-y (+ (>> apparent-top next-state land-of-ns)
			 *metal-spacing* 1))
		(run-layer 'metal)
		(to-x (- (>> apparent-left
			     left-gnd control-pla) *metal-spacing* 1))
		(run-layer 'poly)
		(to-x (>> bottom-phi2-corner clock-circuits))
		(drop-contact))
	 (wireq phi1 (run-layer 'poly)
		(from (>> (*path '(clock phi1))
			  next-state land-of-ns))
		(to-y (+ (>> y end-pt phi2) *metal-pitch*))
		(run-layer 'metal)
		(to-x (- (>> apparent-left
			     left-gnd control-pla) *metal-spacing* 1))
		(run-layer 'poly)
		(to-x (>> bottom-phi1-corner clock-circuits))
		(drop-contact))
	 (wireq phi1-to-control-pla (run-layer 'poly)
		(from (>> end-pt input-clock control-pla))
		(to-x (>> bottom-phi1-corner clock-circuits))
		(drop-contact))
	 (wireq phi2-to-control-pla-bottom (run-layer 'poly)
		(from (>> start-pt bottom-output-clock control-pla))
		(to-x (+ (>> x (*path '(input (read stack)))
			     next-state land-of-ns)
			 8))
		(to-y (>> end-pt phi2))
		(drop-contact))))

(schip-code pred-inputs (land-of-ns main-regs control-pla pads)
  (group main-reg-pred-inputs
	 (setq-my pred (>> predicate-select land-of-ns))
	 (setq-my metal-right (- (>> apparent-right right-power-bus main-regs) 2))
	 (let ((hrout-pairs ())
	       (k (- (>> apparent-bottom main-regs) *metal-spacing* 1))
	       (paths (reverse
			(cdr (assq 'output
				   (cdr (>> connection-points main-regs)))))))
	   (setq paths
		 (sort paths
		       '(lambda (x y)
			  (> (>> y (*path
				     (translate-from-dpath-to-pred (car x)))
				 pred)
			     (>> y (*path
				     (translate-from-dpath-to-pred (car y)))
				 pred)))))
	   (dolist (path paths)
	     (let ((pth (car path)))
	       (wire () (run-layer 'poly)
		     (from (>> (*path `(output ,pth)) main-regs))
		     (to-y k)
		     (-x 1)
		     (run-layer 'metal)
		     (to-x (>> metal-right))
		     (run-layer 'poly)
		     (drop-contact))
	       (push (list k (>> y (*path (translate-from-dpath-to-pred pth))
				 pred))
		     hrout-pairs)
	       (setq k (- k *metal-pitch*))))
	   (setq-my next-metal-channel k)
	   (setq-my poly-right (+ (>> metal-right) 2))
	   (setq k (+ k 2))
	   (wire () (run-layer 'poly)
		 (from (>> poly-point (*path '(relocate-request-to-me
						 control-inputs))
			   bottom-pads pads))
		 (to-y k)
		 (to-x (>> poly-right)))
	   (push (list k (>> y (*path '(relocate-request-to-me
					 control-inputs pad-senses))
			     pred))
		 hrout-pairs)
	   (setq k (- k *poly-pitch*))
	   (wire () (run-layer 'poly)
		 (from (>> apparent-top-center to-pred-select
			   (*path '(-somebody-needs-gc control-inputs))
			   bottom-pads pads))
		 (to-y k)
		 (to-x (>> poly-right)))
	   (push (list k (>> y
			     (*path '(-somebody-needs-gc
				       control-inputs pad-senses))
			     pred))
		 hrout-pairs)
	   (setq k (- k *poly-pitch*))
	   (wire () (run-layer 'poly)
		 (from (>> apparent-top-center to-pred-select
			   (*path '(-somebody-isnt-ready-to-gc control-inputs))
			   bottom-pads pads))
		 (run-layer 'poly)
		 (to-y k)
		 (to-x (>> poly-right)))
	   (push (list k (>> y
			     (*path '(-somebody-isnt-ready-to-gc
				       control-inputs pad-senses))
			     pred))
		 hrout-pairs)
	   (setq k (- k *poly-pitch*))
	   (dolist (pp '(external-interrupt-request
			  dma-interrupt-request
			  cons-server-interrupt-request))

	     (let ((path `(,pp external-predicates pad-senses)))
	       (wire () (run-layer 'poly)
		     (from (>> poly-point (*path (butlast path))
			       bottom-pads pads))
		     (to-y k)
		     (to-x (>> poly-right)))
	       (push (list k (>> y (*path path) pred)) hrout-pairs)
	       (setq k (- k *poly-pitch*))))
	   (partq hrout hrout (loc-pairs hrout-pairs))
	   (rot90 (>> hrout))
	   (align (>> hrout)
		  (>> first-end-pt hrout)
		  (pt (- (>> apparent-left pred) 3) (cadar hrout-pairs)))
	   (let ((hrout-left (>> apparent-left hrout))
		 (hrout-right (>> apparent-right hrout))
		 (pred-left (>> apparent-left pred))
		 (poly-right (>> poly-right)))
	     (dolist (pr hrout-pairs)
	       (wire () (run-layer 'poly)
		     (from (pt hrout-left (car pr)))
		     (to-x poly-right))
	       (wire () (run-layer 'poly)
		     (from (pt hrout-right (cadr pr)))
		     (to-x pred-left))))
	   (let ((end-pt (>> (*path '(sbus-error-flag
				       external-predicates pad-senses))
			     pred)))
	     (wireq sbus (run-layer 'poly)
		    (from (>> poly-point
			      (*path '(sbus-error-flag external-predicates))
			      bottom-pads pads))
		    (+y 4)
		    (run-layer 'poly)
		  (to-y (min k (y-of-pt end-pt)))
		  (to-x (- (>> apparent-left pred) *poly-spacing*))
		  (jog-y end-pt))))))

(schip-code above-pred
	    (main-regs land-of-ns pred-inputs gnd-wiring vdd-wiring control-pla)
  (group dispatch-decoder-inputs
	 (let ((k (- (>> apparent-bottom to-next-state vdd-wiring)
		     (* 2 *metal-pitch*)
		     *poly-spacing* 1))
	       (hrout-pairs ())
	       (collect-first-x (>> apparent-left right-power-bus main-regs)))
	   (dotimes (i 7)
	     (wire () (run-layer 'poly)
		   (from (>> (*path
			       `(right-external-bus
				  (right-external-bus ,(+ i 30)))) main-regs))
		   (to-x collect-first-x)
		   (push (list k (>> y *current-cp*)) hrout-pairs))
	     (setq k (- k *poly-pitch*)))
	   (setq-my bottom-poly-channel k)
	   (partq collect-hrout hrout (loc-pairs hrout-pairs))
	   (int-pos (>> collect-hrout))
	   (align (>> collect-hrout)
		  (>> first-end-pt collect-hrout)
		  (pt collect-first-x (cadar hrout-pairs)))
	   (dotimes (i 7)
	     (wire () (run-layer 'poly)
		   (from (pt (>> x first-start-pt collect-hrout)
			     (car (nth i hrout-pairs))))
		   (jog-x (>> (*path `((nth ,(- 6  i)) body))
			      inputs dispatch-decoder
			      land-of-ns))))))
  (group pred-select-wires
	 (let ((k0 (- (>> bottom-poly-channel dispatch-decoder-inputs) 1))
	       (j (- (>> apparent-left predicate-select land-of-ns)
		     (* 4 *poly-pitch*)
		     *poly-spacing*))
	       (k 0))
	   (dotimes (i 5)
	     (wire () (run-layer 'diff)
		   (from (>> (*path `((nth , i) predicate-select))
			     bottom-ofield output-plane control-pla))
		   (to-y (- (>> apparent-bottom to-next-state vdd-wiring)
			    *metal-spacing* 1))
		   (run-layer 'metal)
		   (to-y k0)
		   (run-layer 'poly) 
		   (-y (+ k 1))
		   (to-x j)
		   (jog-y (>> (*path `((nth ,i) select))
			      predicate-select land-of-ns)))
	     (setq k (+ k *poly-pitch*))
	     (setq j (+ j *poly-pitch*)))))
  (group control-pla-outputs
	 (let ((side (+ (>> apparent-right right-power-bus main-regs)
		     *metal-spacing* 1))
	       (paths '((wait-for-memdone memory-wait)
			(relocate-requested-or-returned? memory-wait)
			(set-if i-need-gc gc-flags)
			(set i-need-gc gc-flags)
			((nth 0) flag-bit-value gc-flags)
			(set i-am-ready-to-gc gc-flags)))
	       (tchan (- (>> apparent-bottom to-next-state vdd-wiring)
			    *metal-spacing* 1))
	       (bchan (>> next-metal-channel main-reg-pred-inputs))
	       (ends (list (>> wait-for-memdone-point
			       (*path '(freeze control-inputs))
			       bottom-pads pads)
			   (>> relocate-requested-or-returned?-point
			       (*path '(freeze control-inputs))
			       bottom-pads pads)
			   (>> apparent-top-center set-if
			       (*path '(-somebody-needs-gc control-inputs))
			       bottom-pads pads)
			   (>> apparent-top-center set-input
			       (*path '(-somebody-needs-gc control-inputs))
			       bottom-pads pads)
			   (>> apparent-top-center val-input
			       (*path '(-somebody-needs-gc control-inputs))
			       bottom-pads pads)
			   (>> apparent-top-center set-input
			       (*path '(-somebody-isnt-ready-to-gc control-inputs))
			       bottom-pads pads))))
	   (loop for path in paths
		 and end in ends
		 and kk from 0 by *metal-pitch*
		 do
		 (wire () (run-layer 'diff)
		       (from (>> (*path path)
				 bottom-ofield output-plane control-pla))
		       (to-y tchan)
		       (drop-contact)
		       (run-layer 'metal)
		       (-y kk)
		       (to-x (+ side kk))
		       (to-y (- bchan kk))
		       (to-x end)
		       (run-layer 'poly)
		       (to-y end)))
	   (setq-my next-metal-horizontal-channel
		    (- bchan (* (length paths) *metal-pitch*)))
	   (setq-my next-metal-vertical-channel
		    (+ side (* (length paths) *metal-pitch*)))
	   (setq-my top-next-channel
		    (- tchan (* (length paths) *metal-pitch*)))
	   (wireq ready-val (run-layer 'poly)	  ; same as ((nth 0) val)
		 (from (>> apparent-top-center val-input
			   (*path '(-somebody-isnt-ready-to-gc control-inputs))
			   bottom-pads pads))
		 (to-y (+ (>> next-metal-horizontal-channel) (* 2 *metal-pitch*)))
		 (drop-contact))))
  (group true-probe
	 (partq pad probe-output-pad
		(vdd-width 4)
		(gnd-width (>> right-gnd-width predicate-select land-of-ns))
		(xfrm 'negx)
		(input-wire? nil)
		(output-wire? nil)
		(apparent-bottom-right
		  (pt-offset (>> apparent-top-right predicate-select land-of-ns)
			     -160 *metal-to-metal*)))
	 (wireq pad-gnd (run-layer 'metal)
		(run-width (>> right-gnd-width predicate-select land-of-ns))
		(from (>> apparent-center-left gnd pad))
		(to-x (- (>> apparent-left pad) (>> *half-width*)))
		(to-y (>> apparent-top right-gnd predicate-select land-of-ns)))
	 (wireq pad-vdd (run-layer 'metal)
		(from (>> center inv-vdd-cont pad))
		(to-x (>> apparent-left down-to-pred vdd-wiring))))
  (group true-and-pc-freeze
	 (setq-my op-to (- (>> apparent-bottom to-next-state vdd-wiring)
			   (* 7 *metal-pitch*) 5))
	 (wireq pc-freeze-wire (run-layer 'poly)
		(from (>> pc-freeze-point (*path '(freeze control-inputs))
			  bottom-pads pads))
		(to-y (>> next-metal-horizontal-channel control-pla-outputs))
		(run-layer 'metal)
		(save-cp 'pc-freeze-run)
		(to-x (>> next-metal-vertical-channel control-pla-outputs))
		(to-y (>> op-to))
		(to-x (+ (>> apparent-right pred-select-wires) *metal-spacing* 1))
		(to-y (- (>> apparent-bottom to-next-state vdd-wiring)
			 *metal-spacing* 1))
		(jump-over (>> down-to-pred vdd-wiring) '+x)
		(jump-over (>> connect-disp vdd-wiring) '+x)
		(to-x (- (>> apparent-left connect-next-state-stacks vdd-wiring)
			 *metal-spacing* 4 1))
		(run-layer 'poly)
		(+x 4)
		(drop-contact))
	 (wireq pc-freeze-input-to-load-state (run-layer 'poly)
		(from (>> freeze-input-point logic
			  (*path '(load-state control-inputs))
			  bottom-pads pads))
		(to-y (>> y pc-freeze-run pc-freeze-wire))
		(drop-contact))
	 (wireq true-wire (run-layer 'poly)
		(from (>> apparent-top-center t-or-f
			  (*path '(-somebody-needs-gc control-inputs))
			  bottom-pads pads))
		(to-y (- (>> next-metal-horizontal-channel control-pla-outputs)
			 *metal-pitch*))
		(run-layer 'metal)
		(to-x (+ (>> next-metal-vertical-channel control-pla-outputs)
			 *metal-pitch*))
		(to-y (- (>> op-to) *metal-pitch*))
		(to-x (+ (>> apparent-right pred-select-wires)
			 *metal-pitch* *metal-spacing* 1))
		(to-y (- (>> y end-pt pc-freeze-wire) *metal-pitch*))
		(jump-over (>> down-to-pred vdd-wiring) '+x)
		(jump-over (>> connect-disp vdd-wiring) '+x)
		(to-x (- (>> x end-pt pc-freeze-wire) 4))
		(run-layer 'poly)
		(+x 4)
		(drop-contact))
	 (wireq true-from-pred (run-layer 'diff)
		(from (>> true-output-point predicate-select land-of-ns))
		(to-x (+ (>> apparent-right predicate-select land-of-ns)
			 *metal-spacing*))
		(to-y (+ (>> apparent-top pad-vdd true-probe)
			 *metal-spacing*))
		(to-x (- (>> apparent-right predicate-select land-of-ns)
			 *metal-spacing*))
		(drop-contact)
		(+y 4)
		(run-layer 'metal)
		(to-y (>> end-pt true-wire)))
	 (wireq true-to-probe-pad (run-layer 'poly)
		(from (>> input-pt pad true-probe))
		(to-x (>> end-pt true-from-pred))
		(drop-contact))
	 (wireq freeze-to-pred (run-layer 'poly)
		(from (>> disable-pt predicate-select land-of-ns))
		(to-y (+ (>> apparent-top predicate-select land-of-ns)
			 *metal-spacing*))
		(run-layer 'metal)
		(to-x (+ (>> next-metal-vertical-channel control-pla-outputs)
			 (* 2 *metal-pitch*)))
		(run-layer 'poly)
		(-x (* 2 *metal-pitch*))
		(drop-contact))
	 (wireq freeze-to-ns-op (run-layer 'poly)
		(from (>> (*path '(freeze)) inputs ns-op-decoder land-of-ns))
		(to-y (>> end-pt pc-freeze-wire))
		(drop-contact))))

(schip-code load-state-wiring
	    (land-of-ns pads vdd-wiring gnd-wiring control-pla
			clock-circuits clocking-in-ns)
  (group load-state-pad-inputs
	 (let ((bottom-y (+ (>> y bottom-freeze-corner clock-circuits)
			    (* 2 *metal-pitch*)))
	       (k (+ (>> apparent-right next-state land-of-ns)
		     *metal-spacing* 1))
	       (hrout-pairs ()))
	   (dotimes (i 9)
	     (wire () (run-layer 'poly)
		   (from (>> poly-output (*path `((nth ,i) state))
			       bottom-pads pads))
		   (to-y bottom-y)
		   (drop-contact)
		   (push (list k (>> x *current-cp*)) hrout-pairs))
	     (setq k (+ k *metal-pitch*)))
	   (partq hrout hrout (loc-pairs hrout-pairs)
		  (layer 'metal) (pitch *metal-pitch*))
	   (align-y (>> hrout)
		    (>> first-end-pt hrout)
		    (- bottom-y 2))))
  (group load-state-pla-inputs
	 (let ((top-y (- (>> y end-pt phi2 clocking-in-ns) *metal-pitch*) 1)
	       (side (+ (>> apparent-right next-state land-of-ns)
			*metal-spacing* 1))
	       (start-bot (- (>> apparent-top hrout load-state-pad-inputs)
			     2))
	       (pla-first (+ 20 (>> apparent-bottom control-pla)))
	       (pla-end (>> y (*path '((nth 0) body)) input-plane control-pla)))
	   (loop for i from 0 below 9
		 and k from 0 by *metal-pitch*
		 and j from 0 by *poly-pitch*
		 do
		 (progn
		   (wire () (run-layer 'poly)
			 (from (pt (+ side k) start-bot))
			 (drop-contact)
			 (jump-over+y (>> connect-ns gnd-wiring)
				      (+ *metal-spacing* 1))
			 (to-y top-y)
			 (run-layer 'poly)
			 (to-y (- pla-first j))
			 (to-x (>> (*path `((nth ,i) body))
				   input-plane control-pla))
			 (to-y (- pla-end 6))
			 (run-layer 'metal)
			 (+y 4)
			 (run-layer 'diff)
			 (drop-contact))
		   (wire () (run-layer 'poly)
			 (from (>> (*path `(left-external-bus
					     (left-external-bus ,i)))
				   next-state land-of-ns))
			 (to-x (+ side k))
			 (drop-contact)))))))

(schip-code dispatch-outputs (land-of-ns gnd-wiring)
  (group dispatch-outputs
	 (let ((k (- (>> apparent-bottom dispatch-decoder land-of-ns)
		     *poly-spacing*)))
	   (dotimes (i 9)
	     (wire () (run-layer 'poly)
		   (from (>> (*path `((nth ,i) extra-type-cont))
			     outputs dispatch-decoder land-of-ns))
		   (to-y (- k (* i *poly-pitch*)))
		   (jog-x (>> (*path `(output ((cross-bus ,(- 8 i))
					       extra-type-cont)))
			      next-state land-of-ns)))
	     (wire () (run-layer 'poly)
		   (from (>> (*path `((nth ,i) user-type))
			     outputs dispatch-decoder land-of-ns))
		   (to-y (- k (* (+ i 9) *poly-pitch*)))
		   (jog-x (>> (*path `(output ((cross-bus ,(- 8 i)) user-type)))
			      next-state land-of-ns)))))))

(schip-code ns-op-control-wiring
	    (land-of-ns above-pred clocking-in-ns vdd-wiring control-pla
			bottom-pad-connections)
  (group ns-op-inputs
	 (let ((k (- (>> apparent-bottom control-pla) *poly-spacing*)))
	   (dotimes (i 5)
	     (wire () (run-layer 'metal)
		   (from (>> (*path `((nth ,i) op-decoder))
			     bottom-ofield output-plane control-pla))
		   (if (oddp i) (+x 4) (-x 4))
		   (run-layer 'poly)
		   (to-y (- k (* i *poly-pitch*)))
		   (jog-x (>> (*path `((nth ,i) code))
			      inputs ns-op-decoder land-of-ns)))))
	 (wireq true-into-ns-op (run-layer 'poly)
		(from (>> (*path '(true)) inputs ns-op-decoder land-of-ns))
		(to-y (>> end-pt true-wire true-and-pc-freeze))
		(drop-contact)))
  (group ns-op-outputs
	 (wireq read-etc (run-layer 'poly)
		(from (>> (*path '(read extra-type-cont next-state-machine))
			  outputs ns-op-decoder land-of-ns))
		(to-y (+ (>> apparent-top next-state land-of-ns) *poly-spacing*))
		(jog-x (>> (*path '(input (read extra-type-cont)))
			   next-state land-of-ns)))
	 (let ((chan (list (list (>> apparent-left ns-op-decoder land-of-ns)
				 'poly)
			   (list (+ (>> apparent-right connect-next-state-stacks
					vdd-wiring)
				    *metal-spacing* 1)
				 'metal)))
	       (conns (list '((read user-type next-state-machine)
			      (read user-type))
			    '((pop-arg-stack pc-stack next-state-machine)
			      (pop stack-1 stack)
			      (pop stack-2 stack)
			      (pop stack))
			    '((read pc-stack next-state-machine)
			      (read stack))
			    '((push-arg-stack pc-stack
					      next-state-machine)
			      (read explicit-pc stack)
			      (push stack)
			      (push stack-1 stack)
			      (push stack-2 stack))
			    '((read true-explicit-ns next-state-machine)
			      (read true))
			    '((read false-explicit-ns next-state-machine)
			      (read false))))
	       (k (+ (>> y end-pt phi1 clocking-in-ns) *metal-pitch*)))
	   (wireq pc-freeze (run-layer 'poly)
		  (run-width 4)
		  (from (>> end-pt pc-freeze-wire true-and-pc-freeze))
		  (to-x (+ (>> apparent-right connect-next-state-stacks vdd-wiring)
			   *metal-spacing* 1))
		  (drop-contact)
		  (+x 4)
		  (save-cp 'here)
		  (run-layer 'metal)
		  (to-x (- (>> apparent-left left-gnd control-pla)
			   *metal-spacing* 5))
		  (run-layer 'poly)
		  (run-width 4)
		  (+x 4)
		  (drop-contact)
		  (to-x (- (>> x bottom-freeze-corner clock-circuits)
			   *metal-pitch* *metal-pitch*))
		  (drop-contact)
		  (+y 4)
		  (drop-contact)
		  (run-layer 'metal))
	   (wireq pc-freeze-down (run-layer 'poly)
		  (from (pt-cp (>> here pc-freeze)))
		  (+x 6)
		  (to-y k)
		  (jog-x (>> (*path '(clock freeze)) next-state land-of-ns)))
	   (dolist (conn conns)
	     (op-router (cons (>> (*path (car conn))
				  outputs ns-op-decoder land-of-ns)
			      (mapcar
				#'(lambda (pth)
				    (>> (*path `(input ,pth))
					next-state land-of-ns))
				(cdr conn)))
			chan k 'horizontal)
	     (setq k (+ k *metal-pitch*)))
	   (wireq true (run-layer 'poly)
		  (run-width 4)
		  (from (>> end-pt true-wire true-and-pc-freeze))
		  (to-x (+ (>> apparent-right connect-next-state-stacks vdd-wiring)
			   *metal-spacing* 1))
		  (drop-contact)
		  (+x 4)
		  (run-layer 'metal)
		  (to-x (- (>> apparent-left left-gnd control-pla)
			   *metal-spacing* 5))
		  (run-layer 'poly)
		  (run-width 4)
		  (+x 4)
		  (drop-contact)
		  (to-x (- (>> x bottom-freeze-corner clock-circuits)
			   *metal-pitch*))
		  (drop-contact)
		  (+y 4)
		  (drop-contact)
		  (run-layer 'metal))
	   (wireq load-state-to-pc (run-layer 'poly)
		  (from (>> read-pc-point logic
			    (*path '(load-state control-inputs))
			    bottom-pads pads))
		  (to-y (+ (>> y bottom-freeze-corner clock-circuits)
			   *metal-pitch*))
		  (run-layer 'metal)
		  (to-x (- (>> apparent-left left-gnd control-pla)
			   *metal-spacing* 4 1))
		  (run-layer 'poly)
		  (+x 4)
		  (run-width 4)
		  (drop-contact)
		  (to-x (- (>> x bottom-freeze-corner clock-circuits)
			   *metal-pitch*))
		  (drop-contact)
		  (+y 4)
		  (run-layer 'metal)
		  (to-y (+ (>> y end-pt phi1 clocking-in-ns) *metal-pitch*))
		  (run-layer 'poly)
		  (to-x (- (>> apparent-left left-gnd control-pla)
			   *metal-spacing* 1))
		  (run-layer 'metal)
		  (to-x (>> (*path '(input (read pc))) next-state land-of-ns))
		  (run-layer 'poly)
		  (to-y (>> (*path '(input (read pc))) next-state land-of-ns))))))

(schip-code explicit-states (land-of-ns vdd-wiring)
  (group explicit-states
	 (let ((explicit-pairs ())
	       (true-pairs ())
	       (false-pairs ()))
	   (dotimes (i 9)
	     (wire () (run-layer 'metal)
		   (from (>> (*path `((nth ,i) pc-explicit-ns))
			     bottom-ofield output-plane control-pla))
		   (if (evenp i) (+x 4) (-x 4))
		   (run-layer 'poly)
		   (drop-contact)
		   (push (list (>> x (*path
				       `(input ((input ,(- 8 i))
						explicit-pc stack)))
				   next-state land-of-ns)
			       (>> x *current-cp*)
			       (>> y (*path
				       `(input ((input ,(- 8 i))
						explicit-pc stack)))
				   next-state land-of-ns))
			 explicit-pairs))
	     (wire () (run-layer 'metal)
		   (from (>> (*path `((nth ,i) true-explicit-ns))
			     bottom-ofield output-plane control-pla))
		   (if (oddp i) (+x 4) (-x 4))
		   (run-layer 'poly)
		   (drop-contact)
		   (push (list (>> x (*path `(input ((input ,(- 8 i)) true)))
				   next-state land-of-ns)
			       (>> x *current-cp*)
			       (>> y (*path `(input ((input ,(- 8 i)) true)))
				   next-state land-of-ns))
			 true-pairs))
	     (wire () (run-layer 'metal)
		   (from (>> (*path `((nth ,i) false-explicit-ns))
			     bottom-ofield output-plane control-pla))
		   (if (evenp i) (+x 4) (-x 4))
		   (run-layer 'poly)
		   (drop-contact)
		   (push (list (>> x (*path `(input ((input ,(- 8 i)) false)))
				   next-state land-of-ns)
			       (>> x *current-cp*)
			       (>> y (*path `(input ((input ,(- 8 i)) false)))
				   next-state land-of-ns))
			 false-pairs)))
	   (partq ex-hrout hrout
		  (loc-pairs explicit-pairs)
		  (layer 'poly) (pitch *poly-pitch*))
	   (negy (>> ex-hrout))
	   (align-y (>> ex-hrout)
		    (>> first-end-pt ex-hrout)
		    (- (>> y (*path '((nth 0) pc-explicit-ns))
			   bottom-ofield output-plane control-pla) 2))
	   (partq tf-hrout hrout
		  (loc-pairs (append (reverse false-pairs) (reverse true-pairs)))
		  (layer 'poly) (pitch *poly-pitch*))
	   (negy (>> tf-hrout))
	   (align-y (>> tf-hrout)
		    (>> y first-end-pt tf-hrout)
		    (>> y first-end-pt ex-hrout))
	   (let ((ex-bot (>> apparent-bottom ex-hrout))
		 (tf-bot (>> apparent-bottom tf-hrout)))
	     (dolist (pr explicit-pairs)
	       (wire () (run-layer 'poly)
		     (from (pt (car pr) ex-bot))
		     (to-y (caddr pr))))
	     (dolist (pr false-pairs)
	       (wire () (run-layer 'poly)
		     (from (pt (car pr) tf-bot))
		     (to-y (caddr pr))))
	     (dolist (pr true-pairs)
	       (wire () (run-layer 'poly)
		     (from (pt (car pr) tf-bot))
		     (to-y (caddr pr))))))))
