  (part nil padinverter (bottom-left (pt 111. -145.)) (xfrm 'rot180))
  (part nil rectangle (layer 'poly) (bottom-left (pt 111. -152.)) (top-right (pt 113. -150.)))
  (part 'right-conn rectangle (layer 'diff) (bottom-left (pt 121. -168.)) (width 4.) 
    (length (+ (>> gnd-width) 21.)))
