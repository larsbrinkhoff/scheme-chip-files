	(width 70) (length 70) (origin (pt 64 -64)))
  (part () rectangle (layer 'pad)
	(width 70) (length 70) (origin (pt 64 -64)))
  (partq nofeet rectangle (layer 'metal)
	 (width 80) (length 20) (origin (pt 64 -110))))

