;;; -*- package: DPL; mode: LISP -*-

;;; Pads for SCHEME-81

(defvar *scheme-81-pad-types*
	'(padvdd padground padout padin pulldown-pad
		 padinbuffered iopadbuffered
		 padinandinverted need-gc ready-gc freeze-pad
		 probe-logic-pad probe-output-pad))

(defcell padvdd ((vdd-width 8))
  (partq vdd-bus rectangle (layer 'metal)
	 (width 128) (length (>> vdd-width))
	 (bottom-center (pt 64 -8)))
  (partq expanse rectangle (layer 'metal)
	 (width 80) (length 80) (origin (pt 64 -64)))
  (partq nofeet rectangle (layer 'metal)
	 (width 80) (length 20) (origin (pt 64 -17.5)))
  (part () rectangle (layer 'noglass)
	(width 70) (length 70) (origin (pt 64 -64)))
  (part () rectangle (layer 'pad)
	(width 70) (length 70) (origin (pt 64 -64))))

(defcell padblank ((vdd-width 8) (gnd-width 8))
  (partq vdd-bus rectangle (layer 'metal)
	 (width 128) (length (>> vdd-width)) (bottom-center (pt 64 -8)))
  (partq gnd-bus rectangle (layer 'metal)
	 (width 104) (length (>> gnd-width))
	 (top-center (pt 64 -120)))
  (partq expanse rectangle (layer 'metal)
	 (width 80) (length 80) (origin (pt 64 -64)))
  (part () rectangle (layer 'noglass)
	(width 70) (length 70) (origin (pt 64 -64)))
  (part () rectangle (layer 'pad)
	(width 70) (length 70) (origin (pt 64 -64))))

(defcell padground ((vdd-width 8) (gnd-width 8))
