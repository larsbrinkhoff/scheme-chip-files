(defcell pad-farm ((vdd-width 20) (gnd-width 50))
  (loop for type
	in *scheme-81-pad-types*
	and x from 0 by 200
	do (part* () type
		  (gnd-width (>> gnd-width))
		  (vdd-width (>> vdd-width))
		  (top-center (pt x 0)))))

(defcell probe-pad ()
  (partq expanse rectangle (layer 'metal)
	 (width 80) (length 80))
  (part () rectangle (layer 'noglass)
	(width 70) (length 70))
  (setq-my connect-pt (>> apparent-bottom-center expanse)))

(defcell probe-output-pad
	 ((vdd-width 4)
	  (gnd-width 4)
	  (input-wire? t)
	  (output-wire? t))
  (partq probe probe-pad)
  (setq-my expanse (>> expanse probe))
  (partq extend-metal rectangle (layer 'metal)
	 (length 4) (width 60)
	 (top-center (>> connect-pt probe)))
  (partq extend-diff rectangle (layer 'diff)
	 (length 4) (width 60)
	 (bottom-center (>> bottom-center extend-metal)))
  (loop for i from 2 by 8 below 60
	with pt = (>> bottom-left extend-diff)
	do (part () square-contact (layer 'diff)
		 (bottom-center
		   (pt-to-right pt i))))
  (partq pd rect-e-fet (channel-width 60)
	 (top-center (pt-above (>> bottom-center extend-metal) 1)))
  (wireq gnd (run-layer 'metal)
	 (run-width (>> gnd-width))
	 (from (pt-below (>> bottom-left extend-diff)
			 (+ (>> *half-width*) 4)))
	 (to-x (>> right extend-diff)))
  (partq extend-gnd-diff rectangle (layer 'diff)
	 (length 4) (width 60)
	 (top-center (>> top-center gnd)))
  (loop for i from 2 by 8 below 60
	with pt = (>> top-left extend-gnd-diff)
	do (part () square-contact (layer 'diff)
		 (top-center (pt-to-right pt i))))
  (partq input-inv double-contact-inverter
	 (ew 8) (dw 2) (el 2)
	 (dl 4) (xfrm 'rot180))
  (align (>> input-inv)
	 (>> apparent-top-right source-diffusion pulldown input-inv)
	 (pt-above (>> apparent-bottom-right gnd) 1))
  (partq diff-extend rectangle (width 8) (layer 'diff)
	 (length (>> gnd-width))
	 (bottom-right
	   (>> apparent-top-right source-diffusion pulldown input-inv)))
  (wireq gate-connet (run-layer 'poly)
	 (from (pt-to-right (>> apparent-bottom-right contact pullup input-inv) 1))
	 (jog-y (>> apparent-center-right gate-poly pd)))
  (partq inv-vdd-cont square-contact (layer 'diff)
	 (top-center
	   (pt-above
	     (>> apparent-bottom-center drain-diffusion
		 transistor pullup input-inv) 1)))
  (if (>> input-wire?)
      (wireq input (run-layer 'poly)
	     (from (>> apparent-center-left gate-poly pulldown input-inv))
	     (flash nil)
	     (to-y (>> apparent-bottom inv-vdd-cont))))
  (if (>> input-wire?)
      (setq-my input-pt (>> end-pt input))
      (setq-my input-pt (>> apparent-center-left gate-poly pulldown input-inv)))
  (if (>> output-wire?)
      (wireq output-wire (run-layer 'poly)
	     (from (pt-offset (>> apparent-bottom-left expanse) 2 -2))
	     (drop-contact)
	     (to-y (>> end-pt input)))))

(defcell probe-circuit ((vdd-width 4))
  (partq phi1-nor nor-cell)
  (partq input-pullup double-contact-pullup (xfrm 'negx)
	 (apparent-top-right (pt-to-left (>> top-left pu phi1-nor) 2))
	 (channel-length 4))
  (partq input-inv-vdd-con square-contact (layer 'diff)
	 (bottom-center
	   (pt-below (>> top-center drain-diffusion transistor input-pullup)
		     1)))
  (partq phi2-nor nor-cell (xfrm 'negx)
	 (apparent-center-left
	   (pt-to-right (>> apparent-center-right phi1-nor) 4)))
  (partq phi2-inv double-contact-inverter
	 (center-left (pt-to-right (>> apparent-center-right phi2-nor) 1))
	 (dl 4) (ew 4))
  (partq phi1-inv double-contact-inverter
	 (center-left (pt-to-right (>> apparent-center-right phi2-inv) 4))
	 (dl 4) (ew 4))
  (partq input-gate rectangle (layer 'poly) (length 6) (width 2)
	(top-right (>> apparent-center-right contact input-pullup)))
  (wireq phi1-to-nor (run-layer 'poly)
	 (from (>> apparent-bottom-right gate-poly pd2 phi1-nor))
	 (to-y (+ (>> apparent-bottom input-inv-vdd-con)
		  (>> vdd-width) *metal-spacing*))
	 (-x 1)
	 (run-layer 'metal)
	 (to-x (+ (>> apparent-left contact pullup phi1-inv) 2))
	 (run-layer 'poly)
	 (-x 1)
	 (to-y (>> apparent-bottom-left contact pullup phi1-inv)))
  (partq phi2-gate rectangle (layer 'poly) (length 6) (width 2)
	(top-right (>> apparent-center-left contact pullup phi2-inv)))
  (wireq input-to-nor (run-layer 'poly)
	 (from (pt-to-right (>> apparent-top-center poly contact input-pullup) 1))
	 (to-y (+ (>> apparent-top phi1-to-nor) *metal-spacing*))
	 (run-layer 'metal)
	 (to-x (>> apparent-bottom-left gate-poly pd2 phi2-nor))
	 (run-layer 'poly)
	 (to-y (>> start-pt phi1-to-nor)))
  (wireq phi2-in (run-layer 'poly)
	 (from (pt-to-right
		 (>> apparent-bottom-right gate-poly pulldown phi2-inv) 1))
	 (to-y (>> apparent-top input-to-nor)))
  (wireq phi1-in (run-layer 'poly)
	 (from (pt-to-right
		 (>> apparent-bottom-right gate-poly pulldown phi1-inv) 1))
	 (to-y (>> apparent-top input-to-nor)))
  (partq phi1-inv-vdd-con square-contact (layer 'diff)
	 (bottom-center
	   (pt-below (>> top-center drain-diffusion transistor pullup phi1-inv)
		     1)))
  (partq phi1-inv-gnd-con square-contact (layer 'diff)
	 (top-center (pt-above
		       (>> bottom-center source-diffusion pulldown phi1-inv)
		       1)))
  (partq phi2-inv-vdd-con square-contact (layer 'diff)
	 (bottom-center
	   (pt-below (>> top-center drain-diffusion transistor pullup phi2-inv)
		     1)))
  (partq phi2-inv-gnd-con square-contact (layer 'diff)
	 (top-center (pt-above
		       (>> bottom-center source-diffusion pulldown phi2-inv)
		       1)))
  (setq-my not-input-pt (pt (>> x start-pt input-to-nor) (>> apparent-top input-to-nor)))
  (wireq phi1-out (run-layer 'poly)
	 (from (>> apparent-top-center poly contact pu phi1-nor))
	 (to-y (>> apparent-top input-to-nor)))
  (setq-my phi1-out-pt (>> end-pt phi1-out))
  (wireq phi2-out (run-layer 'poly)
	 (from (>> apparent-top-center poly contact pu phi2-nor))
	 (to-y (>> apparent-top input-to-nor)))
  (setq-my phi2-out-pt (>> end-pt phi2-out)))

(defcell probe-logic-pad ((gnd-width 8) (vdd-width 8))
  (partq probe-pad probe-pad)
  (partq logic probe-circuit (vdd-width (>> vdd-width)) (xfrm 'rot180)
	 (apparent-top-right
	   (pt-offset (>> apparent-bottom-right probe-pad)
		      (- 0 2)
		      (- (+ 8 (- (>> gnd-width) 4))))))
  (wireq connect-logic (run-layer 'poly)
	 (from (pt-to-left
		 (>> apparent-top-center poly contact input-pullup logic) 1))
	 (to-y (- (>> apparent-bottom probe-pad) 2))
	 (drop-contact))
  (wireq gnd (run-layer 'metal)
	 (run-width (>> gnd-width))
	 (from (pt-above (>> apparent-bottom-left phi1-inv-gnd-con logic) (>> *half-width*)))
	 (to-x (>> apparent-right logic)))
  (wireq vdd (run-layer 'metal)
	 (run-width (>> vdd-width))
	 (from (pt-below (>> apparent-top-left phi1-inv-vdd-con logic) (>> *half-width*)))
	 (to-x (>> apparent-right input-inv-vdd-con logic))))