	(width 2) (length (+ (>> gnd-width) 1)))
  (setq-my inv-output-point (pt 94. -168.))
  (setq-my real-output-point (pt 83. -168.)))

;;; memory wait and freeze random logic

(defcell nor-pullup ((channel-length 4) (channel-width 2))
  (partq transistor rect-d-fet
	 (channel-length (>> channel-length))
	 (channel-width (>> channel-width)))
  (partq contact double-contact
	 (xfrm 'rot90)
	 (apparent-center-left
	   (pt-to-left (>> apparent-bottom-right gate-poly transistor) 1)))
  (partq diff-c rectangle (layer 'diff)
	 (length 2) (width 11)
	 (top-right (pt-below (>> apparent-bottom-right diff contact) 1)))
  (part () rectangle (layer 'diff) (length 1) (width 2)
	(top-center (>> apparent-bottom-center transistor)))
  (part () rectangle  (layer 'diff) (length 1) (width 4)
	(top-center (>> apparent-bottom-center diff contact))))

(defcell nor-cell ()
  (partq pu nor-pullup)
  (partq pd1 pass-transistor (channel-width 4))
  (align (>> pd1) (>> top-center pd1)
	 (>> apparent-bottom-left diff-c pu))
  (partq pd2 pass-transistor (channel-width 4))
  (align (>> pd2) (>> center-left pd2)
	 (pt-to-right (>> center-right pd1) *poly-to-poly*))
  (partq pd1-gnd-contact square-contact (layer 'diff)
	 (top-center (pt-above (>> bottom-center pd1) 1)))
  (partq pd2-gnd-contact square-contact (layer 'diff)
	 (top-center (pt-above (>> bottom-center pd2) 1)))
  (partq vdd-connect square-contact (layer 'diff)
	 (bottom-center (pt-below (>> top-center drain-diffusion transistor pu)
				  1))))

(defcell nor-cell-1 nil
  (part 'pu nor-pullup (bottom-left (pt -3. -7.)))
  (part 'pd1 pass-transistor (channel-width 4.) (bottom-left (pt -5. -12.)))
  (part 'pd2 pass-transistor (channel-width 4.) (bottom-left (pt 5. -12.)))
  (part 'pd1-gnd-contact square-contact (layer 'diff) 
    (top-center (pt-above (>> bottom-center pd1) 1.)))
  (part 'pd2-gnd-contact square-contact (layer 'diff) 
    (top-center (pt-above (>> bottom-center pd2) 1.)))
  (part 'vdd-connect square-contact (layer 'diff) 
    (bottom-center (pt-below (>> top-center drain-diffusion transistor pu) 1.))))

(defcell memory-wait-logic ()
  (partq nor nor-cell)
  (partq pla-inverter double-contact-inverter (xfrm 'negx)
	 (apparent-center-right (pt-to-left (>> center-left nor) 1))
	 (dl 4) (ew 4))
  (partq pla-inv-vdd-con square-contact (layer 'diff)
	 (bottom-center
	   (pt-below (>> top-center drain-diffusion transistor pullup pla-inverter)
		     1)))
  (partq pla-inv-gnd-con square-contact (layer 'diff)
	 (top-center (pt-above
		       (>> bottom-center source-diffusion pulldown pla-inverter)
		       1)))
  (partq pad-inverter double-contact-inverter
	 (apparent-center-left (pt-to-right (>> center-right nor) 1))
	 (dl 4) (ew 4))
  (partq pad-inv-vdd-con square-contact (layer 'diff)
	 (bottom-center
	   (pt-below (>> top-center drain-diffusion transistor pullup pad-inverter)
		     1)))
  (partq pad-inv-gnd-con square-contact (layer 'diff)
	 (top-center (pt-above
		       (>> bottom-center source-diffusion pulldown pad-inverter)
		       1)))
  (part () rectangle (layer 'poly) (length 6) (width 2)
	(top-left (>> apparent-center-right contact pullup pla-inverter)))
  (part () rectangle (layer 'poly) (length 6) (width 2)
	(top-right (>> apparent-center-left contact pullup pad-inverter)))
  (partq pad-in-rect rectangle (layer 'poly)
	 (width 2) (length 7)
	 (top-center (>> apparent-top-right gate-poly pulldown pad-inverter)))
  (wireq pla-in-wire (run-layer 'poly)
	 (from (>> apparent-center-left gate-poly pulldown pla-inverter))
	 (-x 1)
	 (to-y (>> top nor)))
  (setq-my pla-input-pt (>> end-pt pla-in-wire))
  (setq-my pad-input-pt (>> apparent-bottom-center pad-in-rect)))

(defcell relocate-logic ()
  (partq nor nor-cell)
  (partq pla-inverter double-contact-inverter (xfrm 'negx)
	 (apparent-center-right (pt-to-left (>> center-left nor) 1))
	 (dl 4) (ew 4))
  (partq pla-inv-vdd-con square-contact (layer 'diff)
	 (bottom-center
	   (pt-below (>> top-center drain-diffusion transistor pullup pla-inverter)
		     1)))
  (partq pla-inv-gnd-con square-contact (layer 'diff)
	 (top-center (pt-above
		       (>> bottom-center source-diffusion pulldown pla-inverter)
		       1)))
  (setq-my pla-input-pt
	   (>> apparent-center-left gate-poly pulldown pla-inverter))
  (part () rectangle (layer 'poly) (length 6) (width 2)
	(top-left (>> apparent-center-right contact pullup pla-inverter)))
  (partq last-nor-pd pass-transistor (channel-width 4)
	 (center-left (pt-to-right (>> center-right pd2 nor) 3)))
  (partq last-nor-contact square-contact (layer 'diff)
	 (top-center (pt-above (>> bottom-center last-nor-pd) 1)))
  (partq pad-1-rect rectangle (layer 'poly)
	 (width 2) (length 7)
	 (top-center (>> top-right gate-poly pd2 nor)))
  (partq pad-2-rect rectangle (layer 'poly)
	 (width 2) (length 7)
	 (top-center (>> top-right gate-poly last-nor-pd)))
  (part () rectangle (layer 'diff)
	(bottom-right (>> top-right drain-diffusion last-nor-pd))
	(top-left (>> apparent-top-right diff-c pu nor)))
  (wireq pla-input-wire (run-layer 'poly)
	 (from (>> apparent-center-left gate-poly pulldown pla-inverter))
	 (-x 1)
	 (to-y (>> top nor)))
  (setq-my pla-input-pt (>> end-pt pla-input-wire))
  (setq-my pad-1-input-pt (>> bottom-center pad-1-rect))
  (setq-my pad-2-input-pt (>> bottom-center pad-2-rect)))

(defcell nor-and-inverter ()
  (partq nor nor-cell)
  (wireq nor-in-1 (run-layer 'poly)
	 (run-width 2)
	 (from (>> apparent-center-left gate-poly pd1 nor))
	 (-x 1)
	 (to-y (>> top nor)))
  (wireq nor-in-2 (run-layer 'poly)
	 (run-width 2)
	 (from (>> apparent-center-right gate-poly pd2 nor))
	 (flash nil)
	 (to-y (>> top nor)))
  (wireq connect (run-layer 'metal)
	 (run-width 4)
	 (from (>> apparent-center-left contact pu nor))
	 (to-x (+ (>> right nor-in-2) *poly-to-diff* 3)))
  (partq odc double-contact (xfrm 'rot270)
	 (apparent-center-left (>> end-pt connect)))
  (partq pad-pd pass-transistor (channel-width 4)
	 (center-left (pt-to-right (>> start-pt nor-in-2) 3)))
  (part () rectangle (layer 'diff) (width 4) (length 3)
	(bottom-center (>> top-center pad-pd)))
  (wireq gate-connect (run-layer 'poly)
	 (from (>> apparent-center-right odc))
	 (+x 2) (to-y (>> bottom gate-poly pad-pd)))
  (partq pad-pd-contact square-contact (layer 'diff)
	 (top-center (pt-above (>> bottom-center pad-pd) 1)))
  (partq pad-in-rect rectangle (layer 'poly) (width 2) (length 7)
	 (top-center (>> apparent-top-right gate-poly pad-pd)))
  (partq inv double-contact-inverter (xfrm 'negx) (dl 4) (ew 4))
  (align (>> inv) (>> apparent-bottom-left gate-poly pulldown inv)
	 (>> apparent-bottom-right gate-connect))
  (partq inv-vdd-con square-contact (layer 'diff)
	 (bottom-center
	   (pt-below (>> top-center drain-diffusion transistor pullup inv)
		     1)))
  (partq inv-gnd-con square-contact (layer 'diff)
	 (top-center (pt-above
		       (>> bottom-center source-diffusion pulldown inv)
		       1)))
  (setq-my pad-input-pt (>> apparent-bottom-center pad-in-rect)))

(defcell waiting-circuitry ()
  (partq output-nor nor-and-inverter)
  (partq wait-cell memory-wait-logic
	 (center-right (pt-to-left (>> center-left output-nor)
				   *poly-to-poly*)))
  (partq relocate-cell relocate-logic (xfrm 'negx)
	 (apparent-center-left
	   (pt-to-right (>> center-right output-nor) 0)))
  (wireq wait-to-nor (run-layer 'poly)
	 (from (>> apparent-top-center poly contact pu nor wait-cell))
	 (to-y (+ (>> top wait-cell) *metal-to-metal* 2))
	 (run-layer 'metal)
	 (to-x (>> end-pt nor-in-1 output-nor))
	 (run-layer 'poly)
	 (to-y (>> top output-nor)))
  (wireq relocate-to-nor (run-layer 'poly)
	 (from (>> apparent-top-center poly contact pu nor relocate-cell))
	 (to-y (+ (>> top relocate-cell) *metal-to-metal* 2))
	 (run-layer 'metal)
	 (to-x (>> end-pt nor-in-2 output-nor))
	 (run-layer 'poly)
	 (to-y (>> top output-nor)))
  (wireq output (run-layer 'poly)
	 (from (pt-to-right
		 (>> apparent-top-center poly contact pullup inv output-nor) 1))
	 (to-y (>> top output-nor)))
  (wireq gnd (run-layer 'metal)
	 (run-width 4)
	 (from (>> center pla-inv-gnd-con wait-cell))
	 (to-x (>> center pla-inv-gnd-con relocate-cell)))
  (wireq vdd (run-layer 'metal)
	 (run-width 4)
	 (from (pt (- (>> x pla-input-pt wait-cell) 5)
		   (>> y center pla-inv-vdd-con wait-cell)))
	 (to-x (+ (>> x pla-input-pt relocate-cell) 7)))
  (setq-my wait-for-memdone (>> pla-input-pt wait-cell))
  (setq-my -memory-done (>> pad-input-pt wait-cell))
  (setq-my relocate-request-from-me-acknowledged (>> pad-1-input-pt relocate-cell))
  (setq-my relocate-request-to-me (>> pad-2-input-pt relocate-cell))
  (setq-my relocate-requested-or-returned? (>> pla-input-pt relocate-cell))
  (setq-my pc-freeze (>> end-pt output))
  (setq-my freeze (>> pad-input-pt output-nor)))

(defcell freeze-pad ((vdd-width 20)
		     (gnd-width 20))
  (partq pad padinbuffered
	 (vdd-width (>> vdd-width))
	 (gnd-width (>> gnd-width)))
  (setq-my expanse (>> expanse pad))
  (setq-my vdd-bus (>> vdd-bus pad))
  (setq-my gnd-bus (>> gnd-bus pad))
  (partq waiting-circuitry waiting-circuitry (xfrm 'negy)
	 (apparent-top-center (pt-below (>> bottom-center pad) 17)))
  (wireq freeze-wire (run-layer 'poly)
	 (run-width 2)
	 (from (>> poly-point pad))
	 (to-y (+ (>> apparent-top waiting-circuitry)
		  *metal-to-metal* 2))		 
	 (save-cp 'fork)
	 (to-x (>> freeze waiting-circuitry))
	 (to-y (>> freeze waiting-circuitry))
	 (restore-cp 'fork)
	 (run-layer 'metal)
	 (to-x (>> left pad)))
  (wireq mem-done-wire (run-layer 'poly)
	 (from (>> -memory-done waiting-circuitry))
	 (to-y (+ (>> y end-pt freeze-wire) 7))
	 (run-layer 'metal)
	 (to-x (>> end-pt freeze-wire)))
  (wireq rrfma (run-layer 'poly)
	 (from (>> relocate-request-from-me-acknowledged waiting-circuitry))
	 (to-y (>> end-pt mem-done-wire))
	 (run-layer 'metal)
	 (to-x (>> right pad)))
  (wireq rrtm (run-layer 'poly)
	 (from (>> relocate-request-to-me waiting-circuitry))
	 (to-y (>> end-pt freeze-wire))
	 (run-layer 'metal)
	 (to-x (>> end-pt rrfma)))
  (wireq left-vdd-connect (run-layer 'diff)
	 (from (>> start-pt vdd waiting-circuitry))
	 (drop-contact)
	 (run-width 4)
	 (to-y (+ (>> apparent-bottom pad) 2))
	 (to-x (>> apparent-bottom-left guard-bottom padin pad)))
  (wireq right-vdd-connect (run-layer 'diff)
	 (from (>> end-pt vdd waiting-circuitry))
	 (drop-contact)
	 (run-width 4)
	 (to-y (>> end-pt left-vdd-connect))
	 (to-x (>> apparent-bottom-right guard-bottom padin pad)))
  (setq-my freeze-point (>> end-pt freeze-wire))
  (setq-my -memory-done-point (>> end-pt mem-done-wire))
  (setq-my relocate-request-to-me-point (>> end-pt rrtm))
  (setq-my relocate-request-from-me-acknowledged-point (>> end-pt rrfma))
  (setq-my wait-for-memdone-point (>> wait-for-memdone waiting-circuitry))
  (setq-my relocate-requested-or-returned?-point
	   (>> relocate-requested-or-returned? waiting-circuitry))
  (setq-my pc-freeze-point (>> pc-freeze waiting-circuitry)))

