(defcell padbuffer ()
  (part nil double-contact-inverter
	(el 2.) (ew 12.) (dl 4) (dw 2) (bottom-left (pt 14. -13.)) (xfrm 'negx))
  (part nil double-contact-inverter
	(dl 4.) (el 2) (ew 4) (dw 2) (bottom-left (pt 25. -13.)) (xfrm 'negx))
  (part nil rectangle (layer 'poly) (bottom-left (pt 14. -11.))
	(top-right (pt 16. -5.)))
  (part nil rect-d-fet (channel-length 2.) (channel-width 4.)
	(bottom-left (pt 24. -7.)))
  (part nil pulldown (channel-width 16.) (bottom-left (pt 24. -13.)))
  (part nil rectangle (layer 'poly) (bottom-left (pt 23. -11.))
	(top-right (pt 26. -9.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 7. 3.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 18. 3.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 26. 3.)))
  (part nil rectangle (layer 'diff) (bottom-left (pt 26. -1.))
	(top-right (pt 30. 3.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 17. -16.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt -2. -16.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 6. -16.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 26. -16.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 38. -16.)))
  (part 'gnd-bus rectangle (layer 'metal) (bottom-left (pt -2. -16.)) 
    (top-right (pt 42. -12.)))
  (part 'vdd-bus rectangle (layer 'metal) (bottom-left (pt -2. 3.))
	(top-right (pt 42. 7.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 38. -8.)))
  (part nil square-contact (layer 'poly) (bottom-left (pt 38. -4.)))
  (setq-my input-point (pt -4. -10.))
  (setq-my poly-point (pt 40. 0.)))

(defcell padinbuffered
    ((vdd-width 8.) (gnd-width 20.))
  (part 'padin padin (gnd-width (>> gnd-width)) (vdd-width (>> vdd-width)) 
    (bottom-left (pt 0. -128.)))
  (setq-my expanse (>> expanse padin))
  (setq-my vdd-bus (>> vdd-bus padin))
  (setq-my gnd-bus (>> gnd-bus padin))
  (part 'buffer padbuffer (bottom-left (pt 111. -132.)) (xfrm 'rot180))
  (part nil rectangle (layer 'poly) (bottom-left (pt 111. -139.)) (top-right (pt 113. -137.)))
  (part 'left-con rectangle (layer 'diff) (bottom-right (pt 125. -155.)) (width 4.) 
    (length (+ (>> gnd-width) 21.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 121. -155.)))
  (part nil rectangle (layer 'metal) (bottom-left (pt 109. -155.)) 
    (top-right (pt 125. -151.)))
  (part 'right-con rectangle (layer 'diff) (bottom-right (pt 7. -155.)) (width 4.) 
    (length (+ (>> gnd-width) 21.)))
  (part nil rectangle (layer 'metal) (bottom-left (pt 3. -155.)) (top-right (pt 65. -151.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 3. -155.)))
  (part nil rectangle (layer 'poly)
	(bottom-left (pt 117. -139.))
	(width 2) (length (+ (>> gnd-width) 3)))
  (part nil rectangle (layer 'poly)
	(bottom-left (pt 113. -139.))
	(top-right (pt 119. -137.)))
  (setq-my poly-point (pt 67. -148.))) 

