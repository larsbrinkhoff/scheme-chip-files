  (part nil rectangle (layer 'metal) (bottom-left (pt 3. -168.)) (top-right (pt 77. -164.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 3. -168.)))
  (part nil rectangle (layer 'poly) (bottom-left (pt 113. -152.)) (top-right (pt 119. -150.)))
