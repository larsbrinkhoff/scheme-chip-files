  (part nil double-contact-inverter (dl 4.) (dw 2.) (el 2.) (ew 12.) 
    (bottom-left (pt 14. -13.)) (xfrm 'negx))
  (part nil double-contact-inverter (dl 4.) (dw 2.) (el 2.) (ew 4.) 
    (bottom-left (pt 25. -13.)) (xfrm 'negx))
  (part nil rectangle (layer 'poly) (bottom-left (pt 14. -11.))
	(top-right (pt 16. -5.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 7. 3.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 18. 3.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 17. -16.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt -2. -16.)))
  (part nil square-contact (layer 'diff) (bottom-left (pt 6. -16.)))
  (part nil rectangle (layer 'poly) (bottom-left (pt 12. -3.))
	(top-right (pt 14. 7.)))
  (part nil rectangle (layer 'poly) (bottom-left (pt 23. -3.))
	(top-right (pt 25. 7.)))
  (part 'gnd-bus rectangle (layer 'metal) (bottom-left (pt -2. -16.)) (length 4.0) 
    (width 23.0))
  (part 'vdd-bus rectangle (layer 'metal) (bottom-left (pt -3. 3.))
	(top-right (pt 30. 7.)))
  (setq-my input-point (pt -4. -10.))
  (setq-my inv-output-pt (pt 13. 7.))
  (setq-my real-output-pt (pt 24. 7.)))

