;;; -*- package: DPL; mode: LISP

;;; Routing in the land-of-uarg

(schip-code decoder-drouting (main-regs decoders vdd-wiring clock-circuits)
  (group decoder-drouting
	 (let ((*drout-connection-list* nil)
	       (*drout-maximum-channels-used*)
	       (*drout-bottom-y* (+ (>> top main-regs)
				    *metal-pitch* *metal-spacing*))
	       (*drout-jog-y* (+ (>> apparent-top main-regs) 2)))
	   (drout-reset)
	   (collect-uarg-load-connections *me*)
	   (collect-non-uarg-connections *me*)
	   (collect-uarg-read-connections *me*)
	   (collect-clock-connections *me*)
	   (drout-rout-list)
	   (format t "~&Drout Channels used: ~D" *drout-maximum-channels-used*)
	   (do-drout-wiring)
	   (group unused-dpath-controls
		  (let ((upaths '((load-local type temp-reg-0) 
				  (load-local datum temp-reg-0) 
				  (load-local interrupt-enables) 
				  (load-local errcode) 
				  (load-local memtop) 
				  (load-local type free) 
				  (load-local machine-number) 
				  (load-local type temporary)))
			(rightmost (>> (*path
					 '(input (load-local type temp-reg-0)))
				       main-regs))
			(pt '())
			(close '()))
		    (wireq gnd-over (run-layer 'metal)	  
			   (from (pt (>> apparent-right vertical-gnd-connection
					 gnd-wiring)
				     (+ (>> top main-regs) *metal-spacing*)))
			   (to-x rightmost))
		    (dolist (path upaths)
		      (setq pt (>> (*path `(input ,path)) main-regs))
		      (setq close (find-conn-closeness pt))
		      (if (> (length close) 1) (error "Close on both sides" path))
		      (wire () (run-layer 'poly)	  
			    (from pt)
			    (to-y (>> end-pt gnd-over))
			    (cond ((null close))
				  ((eq (car close) 'left) (+x 1))
				  ((eq (car close) 'right) (-x 1)))
			    (drop-contact))))))))

(schip-code constant-outputs (decoders main-regs)
  (group constant-outputs
	 (let ((hrout-pairs ())
	       (end-y (>> y (*path '((nth 0) type-source))
			  outputs constant-decoder decoders)))
	   (dotimes (i 3)
	     (push (list (>> x (*path `(input ((input ,i) datum-source)))
			     main-regs)
			 (>> x (*path `((nth ,(- 2 i)) datum-source))
			     outputs constant-decoder decoders)
			 (>> y (*path `(input ((input ,i) datum-source)))
			     main-regs))
		   hrout-pairs))
	   (dotimes (i 7)
	     (push (list (>> x (*path `(input ((input ,i) type-source)))
			     main-regs)
			 (>> x (*path `((nth ,(- 6 i)) type-source))
			     outputs constant-decoder decoders)
			 (>> y (*path `(input ((input ,i) type-source)))
			     main-regs))				      
		   hrout-pairs))
	   (partq hrout hrout (loc-pairs hrout-pairs)
		  (layer 'poly) (pitch *poly-pitch*))
	   (negy (>> hrout))
	   (align-y (>> hrout)
		    (>> y first-end-pt hrout)
		    end-y)
	   (dolist (pr hrout-pairs)
	     (wire () (run-layer 'poly)
		   (from (pt (car pr) (caddr pr)))
		   (to-y (>> apparent-bottom hrout)))))))

(schip-code non-uarg-pad-outputs
	    (pads vdd-wiring decoders clock-circuits data-enable-lines)
  (group non-uarg-pad-outputs
	 (partq zorch-inv pla-inverter-row
		(element-number 13)
		(gnd-width 6)
		(vdd-width 6)
		(jog-over t)
		(dc? nil)
		(bc? nil))
	 (align-x (>> zorch-inv)
		  (>> apparent-left zorch-inv)
		  (+ (>> apparent-right non-uarg-decoder decoders)
		     *metal-to-metal*))
	 (align-y (>> zorch-inv)
		  (>> apparent-bottom zorch-inv)
		  (+ (>> apparent-top connect-decoders vdd-wiring) 2))
	 (partq non-uarg-zorcher inv-sb-output-driver-split-row
		(element-number 13)
		(gap-mesh 1000))
	 (connect (>> top-poly pus zorch-inv) (>> zorch-inv)
		  (>> input non-uarg-zorcher) (>> non-uarg-zorcher))
	 (wireq zorcher-inv-gnd (run-layer 'metal)
		(run-width 6)
		(from (>> apparent-center-left gnd pds zorch-inv))
		(to-x (- (>> apparent-right left-gnd non-uarg-decoder decoders)
			 (>> *half-width*)))
		(to-y (>> apparent-bottom left-gnd non-uarg-decoder decoders)))
	 (wireq zorcher-vdd (run-layer 'metal)
		(run-width 8)
		(from (pt (+ (>> apparent-right non-uarg-zorcher)
			     *metal-to-metal*
			     (>> *half-width*))
			  (>> apparent-top top-vdd non-uarg-zorcher)))
		(to-y (>> top connect-decoders vdd-wiring)))
	 (wire () (run-layer 'metal)
	       (run-width 6)
	       (from (>> apparent-center-right vdd pus zorch-inv))
	       (to-x (>> left zorcher-vdd)))
	 (wire () (run-layer 'metal)
	       (run-width 6)
	       (from (>> apparent-center-right top-vdd non-uarg-zorcher))
	       (to-x (>> left zorcher-vdd)))
	 (wire () (run-layer 'metal)
	       (run-width 6)
	       (from (>> apparent-center-right mid-vdd non-uarg-zorcher))
	       (to-x (>> left zorcher-vdd)))
	 (wire () (run-layer 'metal)
	       (run-width 6)
	       (from (>> apparent-center-left gnd non-uarg-zorcher))
	       (to-x (>> apparent-right non-uarg-decoder decoders)))
	 (wireq gnd-for-decoders (run-layer 'metal)
		(run-width (>> right-gnd-width uarg-read-decoder decoders))
		(from (pt (>> apparent-right left-gnd non-uarg-decoder decoders)
			  (+ (>> apparent-top non-uarg-zorcher)
			     *metal-to-metal*
			     (>> *half-width*))))
		(to-x (>> apparent-left right-gnd uarg-read-decoder decoders)))
	 (let ((paths (reverse
			(list-fringe
			  (find-subfield-named 'external-registers
					       *top-pad-field*))))
	       (k1 (- (>> apparent-bottom non-uarg-decoder decoders)
		      *poly-spacing*))
	       (j1 (1+ (>> x end-pt left-output *rep-first
			   pla-rep non-uarg-zorcher)))
	       (k2 (- (>> apparent-bottom (*rep 3) rep top-pads pads)
		      *metal-spacing*
		      (* 2 *metal-pitch*)))
	       (j2 (+ (>> apparent-right
			  (*path '((nth 8) top-data-bus)) top-pads pads)
		      *metal-spacing*))
	       (k3 (- (>> apparent-bottom (*rep 27) rep top-pads pads)
		      *metal-spacing*)))
	   (wireq enable-output (run-layer 'poly)
		  (from (>> (*path '(enable-output external-registers))
				   outputs non-uarg-decoder decoders))
		  (to-y k1)
		  (jog-x (>> top-input-pt *rep-first pla-rep pds zorch-inv))
		  (from (>> end-pt left-output *rep-first
			    pla-rep non-uarg-zorcher))
		  (to-y (+ (>> top gnd-for-decoders) *metal-spacing* 1))
		  (to-x j1)
		  (drop-contact)
		  (run-layer 'metal)
		  (to-y k2)
		  (run-layer 'poly)
		  (to-y (>> start-pt output-enable-wire data-enable-lines))
		  (drop-contact))
	   (wireq enable-input (run-layer 'poly)
		  (from (>> (*path '(enable-input external-registers))
				   outputs non-uarg-decoder decoders))
		  (to-y (- k1 *poly-pitch*))
		  (jog-x (>> bot-input-pt (*rep 1) pla-rep pds zorch-inv))
		  (from (>> end-pt right-output (*rep 1) pla-rep non-uarg-zorcher))
		  (to-y (+ (>> top gnd-for-decoders) *metal-spacing* 1))
		  (to-x (+ j1 *metal-pitch*))
		  (drop-contact)
		  (run-layer 'metal)
		  (to-y k2)
		  (run-layer 'poly)
		  (to-y (>> start-pt input-enable-wire data-enable-lines))
		  (drop-contact))
	   (setq k1 (- k1 (* 2 *poly-pitch*)) j1 (+ j1 (* 2 *metal-pitch*)))
	   (loop for path in paths
		 and i from 2
		 do
		 (progn
		   (wire () (run-layer 'poly)
			 (from (>> (*path path) outputs non-uarg-decoder decoders))
			 (to-y k1)
			 (jog-x (>> input-pt (*rep i) pla-rep pds zorch-inv))
			 (from (>> output-pt (*rep i) pla-rep non-uarg-zorcher))
			 (to-y (+ (>> top gnd-for-decoders) *metal-spacing* 1))
			 (to-x j1)
			 (drop-contact)
			 (run-layer 'metal)
			 (to-y k2)
			 (to-x j2)
			 (to-y k3)
			 (to-x (>> poly-point (*path path) top-pads pads))
			 (run-layer 'poly)
			 (to-y (>> poly-point (*path path) top-pads pads)))
		   (setq k1 (- k1 *poly-pitch*)
			 j1 (+ j1 *metal-pitch*)
			 k2 (- k2 *metal-pitch*)
			 j2 (+ j2 *metal-pitch*)
			 k3 (- k3 *metal-pitch*))))
	   (setq-my next-metal-hplace j1)
	   (setq-my next-metal-place j2))))


;;; arg1
;;;       arg2
;;;              targ
;;;    read
;;;    load

(schip-code uarg-datums
	    (control-pla main-regs vdd-wiring land-of-uarg clock-circuits)
  (group explicit-datums
	 (format t "~&Making datums")
	 (let ((arg1-pairs ())
	       (arg2-pairs ())
	       (target-pairs ())
	       j)
	   (setq-my uas (>> uarg-stacks land-of-uarg))
	   (setq-my ofield (>> top-ofield output-plane control-pla))
	   (dotimes (i 6)
	     (setq j (- 5 i))
	     (push (list (>> x center (*rep j) arg-1-explicit uas)
			 (>> x (*path `((nth ,j) arg1-data)) ofield))
		   arg1-pairs)
	     (push (list (>> x center (*rep j) arg-2-explicit uas)
			 (>> x (*path `((nth ,j) arg2-data)) ofield))
		   arg2-pairs)
	     (push (list (>> x center (*rep j) target-explicit uas)
			 (>> x (*path `((nth ,j) target-data)) ofield))
		   target-pairs))
	   (partq hrout hrout
		  (loc-pairs (append target-pairs arg2-pairs arg1-pairs))
		  (layer 'metal) (pitch *metal-pitch*))
	   (align-y (>> hrout)
		    (>> first-end-pt hrout)
		    (>> y (*path '((nth 0) target-data)) ofield))
	   (let ((pb (>> apparent-bottom right-power-bus data-path uas))
		 (ytop (>> apparent-bottom arg-1-explicit uas)))
	     (dolist (pr (>> loc-pairs hrout))
	       (wire () (run-layer 'poly)
		     (from (pt (car pr) ytop))
		     (drop-contact)
		     (to-y (- pb *metal-to-metal* 3))
		     (run-layer 'metal)
		     (to-y (>> apparent-top hrout)))))))
  (group load-and-read-datums
	 (let ((constant-pairs nil)
	       (non-uarg-pairs nil)
	       (read-pairs nil)
	       (load-pairs nil)
	       path
	       j)
	   (setq-my uas (>> uarg-stacks land-of-uarg))
	   (setq-my ofield (>> top-ofield output-plane control-pla))
	   (setq-my constant-wires-left-x
		    (- (>> apparent-left write-bus uas)
		       (* 11 *metal-pitch*)
		       *metal-spacing*
		       21))
	   (dotimes (i 5)
	     (setq j (- 4 i))
	     (setq path `((nth ,j) constant-source))
	     (wire () (run-layer 'metal)
		   (from (>> (*path path) ofield))
		   (+y 21)
		   (run-layer 'poly)
		   (drop-contact)
		   (push (list (+ (>> constant-wires-left-x) (* j *metal-pitch*))
			       (>> x *current-cp*)
			       path)
			 constant-pairs)))
	   (setq-my non-uarg-left-x
		    (+ (>> constant-wires-left-x) (* 5 *metal-pitch*)))
	   (dotimes (i 6)
	     (setq j (- 5 i))
	     (setq path `((nth ,j) non-uarg-register-operations))
	     (wire () (run-layer 'metal)
		   (from (>> (*path path) ofield))
		   (+y 21)
		   (run-layer 'poly)
		   (drop-contact)
		   (push (list (+ (>> non-uarg-left-x) (* j *metal-pitch*))
			       (>> x *current-cp*)
			       path)
			 non-uarg-pairs))
	     (setq path `((nth ,j) explicit-load-uarg))
	     (wire () (run-layer 'diff)
		   (from (>> (*path path) ofield))
		   (run-width 4)
		   (+y 9)
		   (run-layer 'metal)
		   (+y 12)
		   (run-layer 'poly)
		   (drop-contact)
		   (push (list (>> x center (*rep j) write-bus uas)
			       (>> x *current-cp*)
			       path)
			 read-pairs))
	     (setq path `((nth ,j) explicit-read-uarg))
	     (wire () (run-layer 'metal)
		   (from (>> (*path path) ofield))
		   (+y 9)
		   (run-layer 'diff)
		   (run-width 4)
		   (+y 8)
		   (run-layer 'metal)
		   (+y 4)
		   (run-layer 'poly)
		   (drop-contact)
		   (push (list (>> x center (*rep j) read-bus uas)
			       (>> x *current-cp*)
			       path)
			 load-pairs)))
	   (partq hrout hrout
		  (loc-pairs (append constant-pairs non-uarg-pairs
				     read-pairs load-pairs))
		  (layer 'poly) (pitch *poly-pitch*))
	   (align-y (>> hrout)
		    (>> first-end-pt hrout)
		    (+ (>> y (*path '((nth 0) explicit-read-uarg)) ofield) 22))
	   (let ((pb (>> apparent-bottom right-power-bus data-path uas))
		 (ytop (>> apparent-bottom arg-1-explicit uas)))
	     (dolist (pr (>> loc-pairs hrout))
	       (wire () (run-layer 'poly)
		     (from (pt (car pr) ytop))
		     (drop-contact)
		     (to-y (>> apparent-top hrout)))))))
  (group random-wiring-starts
	 (setq-my ofield (>> top-ofield output-plane control-pla))
	 (do ((fr (reverse
		    (list-fringe
		      (find-subfield-named 'random-signals
					   *control-pla-output-field*)))
		  (cdr fr))
	      (x (+ (>> apparent-right down-to-ns vdd-wiring) *metal-spacing* 1)
		 (+ x *metal-pitch*))
	      (y (+ (>> apparent-top control-pla) *metal-spacing*)
		 (+ y *metal-pitch*))
	      (top (- (>> apparent-bottom top-vdd vdd-wiring)
		      *metal-spacing* 1))
	      (pairs ()))
	     ((null fr) (setq-my pairs pairs))
	   (wire () (run-layer 'metal)
		 (from (>> (*path (car fr)) ofield))
		 (to-y y)
		 (to-x x)
		 (to-y top)
		 (push (list (car fr) x) pairs)))))

(schip-code lsd-stuff (land-of-uarg control-pla vdd-wiring uarg-datums)
  (group lsd
	 (partq lsd-thing lsd (nbits 23))
	 (align-y (>> lsd-thing)
		  (>> apparent-top cell1-gnd *rep-first row lsd-thing)
		  (+ (>> apparent-top top-vdd vdd-wiring) 4 6))
	 (align-x (>> lsd-thing)
		  (>> apparent-left row lsd-thing)
		  (+ (>> apparent-right down-to-ns vdd-wiring)
		     (* 10 *metal-pitch*)
		     20
		     4))
	 (setq-my rep (>> row lsd-thing))
	 (do ((prs (reverse (>> loc-pairs hrout load-and-read-datums)) (cdr prs))
	      (i 22 (1- i))
	      (pairs ()))
	     ((null prs)
	      (partq hrout hrout (loc-pairs pairs)
		     (layer 'poly) (pitch *poly-pitch*)))
	   (push (list (caar prs) (>> x input-pt (*rep i) rep) (caddar prs)) pairs))
	 (negy (>> hrout))
	 (align-y (>> hrout) (>> apparent-top hrout) (>> apparent-bottom rep))
	 (do ((prs (>> loc-pairs hrout) (cdr prs))
	      (bottom-y (>> apparent-bottom read-bus uarg-stacks land-of-uarg))
	      (top-y (>> apparent-bottom hrout)))
	     ((null prs))
	   (wire () (run-layer 'metal)
		 (from (pt (caar prs) bottom-y))
		 (to-y top-y)
		 (run-layer 'poly)
		 (drop-contact))))
  (group lsd-pads
	 (setq-my leftmost (+ (>> apparent-right down-to-ns vdd-wiring)
			      (* 5 *metal-pitch*)
			      *metal-spacing* 1))
	 (setq-my rightmost (>> constant-wires-left-x load-and-read-datums))
	 (setq-my topmost (>> apparent-bottom hrout lsd))
	 (setq-my bottommost (>> apparent-top right-power-bus data-path
				uarg-stacks land-of-uarg))
	 (partq control-pad probe-logic-pad
		(gnd-width 8)
		(vdd-width 4)
		(xfrm 'rot270)
		(apparent-bottom-right
		  (pt (- (>> rightmost) 100)
		      (+ (>> bottommost) 200))))
	 (partq data-pad probe-output-pad
		(gnd-width 8)
		(vdd-width 4)
		(xfrm 'rot270)
		(apparent-bottom-right
		  (pt-above (>> apparent-top-right control-pad)
			    200)))
	 (wireq extend-uarg-gnd (run-layer 'metal)
		(run-width (>> power-bus-size data-path uarg-stacks land-of-uarg))
		(from (>> apparent-center-left right-power-bus data-path
			  uarg-stacks land-of-uarg))
		(to-x (>> apparent-left gnd control-pad)))
	 (wireq probe-pad-gnd (run-layer 'metal)
		(run-width 8)
		(from (>> apparent-bottom-center gnd data-pad))
		(to-y (>> top extend-uarg-gnd)))
	 (wireq probe-pad-vdd (run-layer 'metal)
		(run-width 4)
		(from (>> apparent-top-center vdd control-pad))
		(to-y (>> apparent-bottom top-vdd vdd-wiring)))
	 (wireq lsd-gnd (run-layer 'metal)
		(run-width 8)
		(from (pt-to-left (>> apparent-top-right right-gnd
				      constant-decoder decoders)
				  (>> *half-width*)))
		(jog-y (>> end-pt cell2-gnd *rep-last
			   rep lsd)))
	 (wireq phi1-down (run-layer 'poly)
		(from (pt (>> leftmost)
			  (>> y start-pt phi1-circuit clock-circuits)))
		(drop-contact)
		(jump-over-y (>> top-vdd vdd-wiring) 6)
		(to-y (>> end-pt phi1-in logic control-pad))
		(run-layer 'poly)
		(to-x (>> end-pt phi1-in logic control-pad)))
	 (wireq phi2-down (run-layer 'poly)
		(from (pt (+ (>> leftmost) *metal-pitch*)
			  (>> y start-pt phi2-circuit clock-circuits)))
		(drop-contact)
		(jump-over-y (>> top-vdd vdd-wiring) 6)
		(to-y (>> end-pt phi2-in logic control-pad))
		(run-layer 'poly)
		(to-x (>> end-pt phi2-in logic control-pad)))
	 (wireq data-out-wire (run-layer 'poly)
		(from (pt-below (>> apparent-top-right gate-poly
				    transistor pu cell2 *rep-last rep lsd) 1))
		(to-x (+ (>> apparent-right lsd) 4))
		(to-y (+ (>> apparent-top lsd-gnd) *metal-spacing*))
		(run-layer 'metal)
		(to-x (+ (>> leftmost) (* *metal-pitch* 4)))
		(run-layer 'poly)
		(to-y (- (>> apparent-bottom top-vdd vdd-wiring)
			 *metal-spacing* 1))
		(run-layer 'metal)
		(to-y (>> end-pt input data-pad))
		(run-layer 'poly)
		(to-x (>> end-pt input data-pad)))
	 (wireq phi2-control-wire (run-layer 'poly)
		(from (>> phi2-out-pt logic control-pad))
		(to-x (+ (>> leftmost) (* *metal-pitch* 3)))
		(run-layer 'metal)
		(to-y (- (>> apparent-bottom top-vdd vdd-wiring)
			 *metal-spacing* 1))
		(run-layer 'poly)
		(to-y (+ (>> apparent-top lsd-gnd)
			 *metal-spacing*
			 *metal-pitch*))
		(run-layer 'metal)
		(to-x (>> apparent-right data-out-wire)))
	 (wireq phi1-control-wire (run-layer 'poly)
		(from (>> phi1-out-pt logic control-pad))
		(to-x (+ (>> leftmost) (* *metal-pitch* 2)))
		(run-layer 'metal)
		(to-y (- (>> apparent-bottom top-vdd vdd-wiring)
			 *metal-spacing* 1))
		(run-layer 'poly)
		(to-y (+ (>> apparent-top lsd-gnd)
			 *metal-spacing*
			 (* 2 *metal-pitch*)))
		(run-layer 'metal)
		(to-x (>> apparent-right data-out-wire)))
	 (dotimes (i 23)
	   (wire () (run-layer 'poly)
		 (from (>> c1-pt (*rep i) rep lsd))
		 (to-y (>> end-pt phi2-control-wire))
		 (drop-contact))
	   (wire () (run-layer 'poly)
		 (from (>> c2-pt (*rep i) rep lsd))
		 (to-y (>> end-pt phi1-control-wire))
		 (drop-contact)))
	 (wireq data-in-wire (run-layer 'poly)
		(from (>> end-pt output-wire data-pad))
		(to-x (+ (>> leftmost) (* *metal-pitch* 5)))
		(run-layer 'metal)
		(to-y (- (>> apparent-bottom top-vdd vdd-wiring)
			 *metal-spacing* 1))
		(run-layer 'diff)
		(jog-y (>> apparent-center-left
			   clock-trans cell1 *rep-first rep lsd)))
	 (wireq control-input (run-layer 'poly)
		(from (>> not-input-pt logic control-pad))
		(to-x (+ (>> leftmost) (* *metal-pitch* 6)))
		(run-layer 'metal)
		(to-y (- (>> apparent-bottom top-vdd vdd-wiring)
			 *metal-spacing* 1))
		(run-layer 'poly)
		(jog-y (>> apparent-center-right gate-poly input-trans
			   *rep-last rep lsd)))))

(schip-code decoder-inputs (lsd-stuff decoders uarg-datums
				      clock-circuits non-uarg-pad-outputs)
  (group decoder-inputs
	 (let ((pairs (>> loc-pairs hrout lsd))
	       (start-bot (+ (>> y start-pt phi1-circuit clock-circuits) *metal-pitch*))
	       (non-uarg-top (+ (>> apparent-top decoders) *poly-spacing*))
	       (after-constant-bot
		 (- (+ (>> apparent-top decoders) *poly-spacing*)
		    (* 6 *metal-pitch*)))
	       (constant-jog-x (- (>> x end-pt phi1 clocking-to-main-regs) *metal-pitch*)))
	   (setq-my constant-decoder-inputs (>> inputs constant-decoder decoders))
	   (do ((i 0 (1+ i))
		(pr pairs (cdr pr))
		(y start-bot (+ y *metal-pitch*))
		(end-y (>> (*path '((nth 0) body)) constant-decoder-inputs)))
	       ((= i 5))
	     (wire () (run-layer 'poly)
		   (from (>> output-pt (*rep i) rep lsd))
		   (to-y y)
		   (run-layer 'metal)
		   (to-x (>> (*path `((nth ,i) body)) constant-decoder-inputs))
		   (run-layer 'poly)
		   (to-y end-y)))
	   (setq-my uarg-load-inputs (>> inputs uarg-load-decoder decoders))
	   (do ((i 0 (1+ i))
		(j 11 (1+ j))
		(pr (nthcdr 11 pairs) (cdr pr))
		(y1 (+ start-bot (* 5 *metal-pitch*)) (+ y1 *metal-pitch*))
		(jx constant-jog-x (- jx *metal-pitch*))
		(y2 (- non-uarg-top (* 6 *metal-pitch*)) (+ y2 *metal-pitch*))
		(ex (+ (>> apparent-right uarg-load-decoder decoders)
		       *metal-spacing* 1)
		    (+ ex *poly-pitch*))
		(ey (+ (>> apparent-top uarg-load-decoder decoders) *poly-pitch*)
		    (+ ey *poly-pitch*)))
	       ((= i 6))
	     (wire () (run-layer 'poly)
		   (from (>> output-pt (*rep j) rep lsd))
		   (to-y y1)
		   (run-layer 'metal)
		   (to-x jx)
		   (to-y y2)
		   (to-x ex)
		   (run-layer 'poly)
		   (-x 1)
		   (to-y ey)
		   (jog-x (>> (*path `((nth ,i) body)) uarg-load-inputs))))
	   (setq-my non-uarg-inputs (>> inputs non-uarg-decoder decoders))
	   (do ((i 0 (1+ i))
		(j 5 (1+ j))
		(pr (nthcdr 5 pairs) (cdr pr))
		(y1 (+ start-bot (* 11 *metal-pitch*)) (+ y1 *metal-pitch*))
		(jx (- constant-jog-x (* 6 *metal-pitch*)) (- jx *metal-pitch*))
		(y2 non-uarg-top (+ y2 *metal-pitch*))
		(poly-jump (>> next-metal-hplace non-uarg-pad-outputs)))
	       ((= i 6))
	     (wire () (run-layer 'poly)
		   (from (>> output-pt (*rep j) rep lsd))
		   (to-y y1)
		   (run-layer 'metal)
		   (to-x jx)
		   (to-y y2)
		   (to-x poly-jump)
		   (run-layer 'poly)
		   (jog-x (>> (*path `((nth ,i) body)) non-uarg-inputs))))
	   (setq-my uarg-read-inputs (>> inputs uarg-read-decoder decoders))
	   (do ((i 0 (1+ i))
		(j 17 (1+ j))
		(pr (nthcdr 17 pairs) (cdr pr))
		(y1 (+ start-bot (* 17 *metal-pitch*)) (+ y1 *metal-pitch*))
		(jx (- constant-jog-x (* 12 *metal-pitch*)) (- jx *metal-pitch*))
		(y2 (+ non-uarg-top (* 6 *metal-pitch*)) (+ y2 *metal-pitch*))
		(ye (>> y (*path '((nth 0) body)) uarg-read-inputs)))
	       ((= i 6))
	     (wire () (run-layer 'poly)
		   (from (>> output-pt (*rep j) rep lsd))
		   (to-y start-bot)
		   (run-layer 'metal)
		   (to-y y1)
		   (to-x jx)
		   (to-y y2)
		   (to-x (>> (*path `((nth ,i) body)) uarg-read-inputs))
		   (run-layer 'poly)
		   (to-y ye)))
	   (do ((pr (>> pairs random-wiring-starts) (cdr pr))
		(ys (- (>> apparent-bottom top-vdd vdd-wiring) *metal-spacing* 1))
		(ye (+ start-bot (* 22 *metal-pitch*) 5) (+ ye *poly-pitch*)))
	       ((null pr))
	     (wire () (run-layer 'poly)
		   (from (pt (cadr (car pr)) ys))
		   (drop-contact)
		   (to-y ye)
		   (jog-x (>> poly-point (*path (caar pr)) top-pads pads)))))))

(schip-code clocking-in-uarg
	    (land-of-uarg control-pla ns-op-control-wiring
			  gnd-wiring clock-circuits)
  (group clocking-in-uarg
	 (setq-my gnd-obstacle 
		  (>> right-power-bus data-path uarg-stacks land-of-uarg))
	 (wireq phi2 (run-layer 'metal)
		(from (pt (+ (>> x start-pt top-output-clock control-pla) 10)
			  (- (>> apparent-bottom gnd-obstacle)
			     (* 2 *metal-pitch*)
			     *metal-spacing* 1)))
		(to-x (- (>> left up-to-stacks gnd-wiring) *metal-spacing* 1))
		(run-layer 'poly)
		(to-x (>> top-phi2-corner clock-circuits))
		(drop-contact))
	 (wireq phi1 (run-layer 'metal)
		(from (pt (+ (>> apparent-right uarg-stacks land-of-uarg)
			     (* 4 *metal-pitch*)
			     *metal-spacing* 1)
			  (+ (>> y start-pt phi2) *metal-pitch*)))
		(to-x (- (>> left up-to-stacks gnd-wiring) *metal-spacing* 1))
		(run-layer 'poly)
		(to-x (>> top-phi1-corner clock-circuits))
		(drop-contact))
	 (wireq phi2-to-control-pla-top (run-layer 'poly)
		(from (>> start-pt top-output-clock control-pla))
		(+x 10)
		(to-y (>> start-pt phi2))
		(drop-contact))
	 (wireq freeze (run-layer 'metal)
		(from (>> end-pt pc-freeze ns-op-outputs))
		(to-y (+ (>> y start-pt phi1) *metal-pitch*))
		(run-layer 'poly)
		(to-x (- (>> left up-to-stacks gnd-wiring) *metal-spacing* 1))
		(run-layer 'metal)
		(to-x (+ (>> x start-pt phi1) *metal-pitch*))
		(drop-contact))
	 (wireq true (run-layer 'metal)
		(from (pt (- (>> apparent-left uarg-op-decoder land-of-uarg)
			     *metal-spacing* 1)
			  (- (>> y start-pt phi2) *metal-pitch*)))
		(to-x (- (>> left up-to-stacks gnd-wiring) *metal-spacing* 1))
		(run-layer 'poly)
		(to-x (>> x end-pt true ns-op-outputs))
		(drop-contact))
	 (wireq true-down (run-layer 'metal)
		(from (>> end-pt true))
		(to-y (>> end-pt true ns-op-outputs)))
	 (wireq phi1-to-uarg (run-layer 'poly)
		(from (>> (*path `(clock phi1))
			  data-path uarg-stacks land-of-uarg))
		(to-x (>> start-pt phi1))
		(run-layer 'metal)
		(jump-over-y (>> gnd-obstacle) (+ *metal-spacing* 1))
		(to-y (>> start-pt phi1))
		(flash nil))
	 (wireq phi2-to-uarg (run-layer 'poly)
		(from (>> (*path `(clock phi2))
			  data-path uarg-stacks land-of-uarg))
		(to-x (- (>> x start-pt phi1) *metal-pitch*))
		(run-layer 'metal)
		(jump-over-y (>> gnd-obstacle) (+ *metal-spacing* 1))
		(to-y (>> start-pt phi2))
		(flash nil))
	 (wire () (run-layer 'metal)
	       (from (>> end-pt phi2-to-control-pla-top))
	       (to-x (>> end-pt phi2-to-uarg)))
	 (wireq freeze-to-uarg (run-layer 'poly)
		(from (>> (*path `(clock freeze))
			  data-path uarg-stacks land-of-uarg))
		(to-x (>> end-pt freeze))
		(run-layer 'metal)
		(jump-over-y (>> gnd-obstacle) (+ *metal-spacing* 1))
		(to-y (>> end-pt freeze)))
	 (wireq true-to-uarg-decoder (run-layer 'poly)
		(from (>> (*path '(true)) inputs uarg-op-decoder land-of-uarg))
		(to-x (>> start-pt true))
		(run-layer 'metal)
		(to-y (+ (>> apparent-top gnd-obstacle) *metal-spacing* 1))
		(run-layer 'poly)
		(to-y (>> start-pt true))
		(drop-contact))))

(schip-code uarg-control (clocking-in-uarg)
  (group uarg-decoder-input
	 (let ((k (- (>> x end-pt true-to-uarg-decoder clocking-in-uarg)
		     *metal-pitch*))
	       (jp (>> y end-pt true clocking-in-uarg)))
	   (setq-my ofield (>> top-ofield output-plane control-pla))
	   (setq-my decin (>> inputs uarg-op-decoder land-of-uarg))
	   (dotimes (i 5)
	     (wire () (run-layer 'metal)
		   (from (>> (*path `((nth ,(- 4 i)) op-decoder)) ofield))
		   (to-y (+ (>> apparent-top control-pla)
			    (* i *metal-pitch*)
			    *metal-spacing*))
		   (to-x (- k (* i *metal-pitch*)))
		   (to-y jp)
		   (run-layer 'poly)
		   ;; (to-y (+ (>> apparent-top gnd-obstacle clocking-in-uarg)
		   ;;    *metal-spacing* 1))
		   ;; (run-layer 'metal)
		   (to-y (>> (*path `((nth ,(- 4 i)) code)) decin))
		   ;; (to-x k)
		   ;; (run-layer 'poly)
		   ;; (drop-contact)
		   (to-x (>> (*path '((nth 0) code)) decin))))
	   (setq-my dpath (>> data-path uarg-stacks land-of-uarg))
	   (wireq read-arg1 (run-layer 'metal)
		(from (>> (*path '(arg1-stack read-source)) ofield))
		(to-y (+ (>> apparent-top control-pla)
			 (* 5 *metal-pitch*)
			 *metal-spacing*))
		(to-x (+ (>> apparent-right uarg-stacks land-of-uarg)
			 (* 2 *metal-pitch*)
			 *metal-spacing* 1))
		(jump-over+y (>> gnd-obstacle clocking-in-uarg)
			     (+ *metal-spacing* 1))
		(to-y (>> (*path '(input (read read-output arg-1))) dpath))
		(run-layer 'poly)
		(to-x (>> (*path '(input (read read-output arg-1))) dpath)))
	   (wireq read-arg2 (run-layer 'metal)
		(from (>> (*path '(arg2-stack read-source)) ofield))
		(to-y (+ (>> apparent-top control-pla)
			 (* 6 *metal-pitch*)
			 *metal-spacing*))
		(to-x (+ (>> apparent-right uarg-stacks land-of-uarg)
			 (* 1 *metal-pitch*)
			 *metal-spacing* 1))
		(jump-over+y (>> gnd-obstacle clocking-in-uarg)
			     (+ *metal-spacing* 1))
		(to-y (>> (*path '(input (read read-output arg-2))) dpath))
		(run-layer 'poly)
		(to-x (>> (*path '(input (read read-output arg-2))) dpath)))
	   (wireq load-target (run-layer 'metal)
		(from (>> (*path '(target-stack load-source)) ofield))
		(to-y (+ (>> apparent-top control-pla)
			 (* 7 *metal-pitch*)
			 *metal-spacing*))
		(to-x (+ (>> apparent-right uarg-stacks land-of-uarg)
			 *metal-spacing* 1))
		(jump-over+y (>> gnd-obstacle clocking-in-uarg)
			     (+ *metal-spacing* 1))
		(to-y (>> (*path '(input (read write-output target))) dpath))
		(save-cp 'outer-pt)
		(run-layer 'poly)
		(to-x (>> (*path '(input (read write-output target))) dpath)))
	   (wireq load-explicit (run-layer 'metal)
		  (from (>> (*path '(explicit load-source)) ofield))
		  (+y 5)
		  (run-layer 'poly)
		  (to-x (- (>> x (*path '((nth 0) explicit-load-uarg)) ofield) 4)))
	   (wireq read-explicit (run-layer 'metal)
		  (from (>> (*path '(explicit read-source)) ofield))
		  (+y 13)
		  (run-layer 'poly)
		  (to-x (- (>> x (*path '((nth 0) explicit-read-uarg)) ofield)
			   4)))))
  (group uarg-decoder-output
	 (let ((arg1-conns
		 (list
		   '((load uarg-data push-source arg1-stack uarg-stacks)
		     (read explicit arg-1))
		   '((load transfer-bus push-source
			   arg1-stack uarg-stacks)
		     (load-global arg-1))
		   '((read transfer-bus arg1-stack uarg-stacks)
		     (read arg-1))
		   '((push-arg-stack arg1-stack uarg-stacks)
		     (push stack-0 arg-1)
		     (push stack-1 arg-1))
		   '((load-local arg1-stack uarg-stacks)
		     (load-local arg-1))
		   '((pop-arg-stack arg1-stack uarg-stacks)
		     (pop stack-0 arg-1)
		     (pop stack-1 arg-1))))
	       (arg2-conns
		 (list
		   '((load uarg-data push-source arg2-stack uarg-stacks)
		     (read explicit arg-2))
		   '((load transfer-bus push-source
			   arg2-stack uarg-stacks)
		     (load-global arg-2))
		   '((read transfer-bus arg2-stack uarg-stacks)
		     (read arg-2))
		   '((push-arg-stack arg2-stack uarg-stacks)
		     (push stack-0 arg-2)
		     (push stack-1 arg-2))
		   '((load-local arg2-stack uarg-stacks)
		     (load-local arg-2))
		   '((pop-arg-stack arg2-stack uarg-stacks)
		     (pop stack-0 arg-2)
		     (pop stack-1 arg-2))))
	       (target-conns
		 (list
		   '((load uarg-data push-source target-stack uarg-stacks)
		     (read explicit target))
		   '((load transfer-bus push-source
			   target-stack uarg-stacks)
		     (load-global target))
		   '((read transfer-bus target-stack uarg-stacks)
		     (read target))
		   '((push-arg-stack target-stack uarg-stacks)
		     (push stack-0 target)
		     (push stack-1 target))
		   '((load-local target-stack uarg-stacks)
		     (load-local target))
		   '((pop-arg-stack target-stack uarg-stacks)
		     (pop stack-0 target)
		     (pop stack-1 target)))))
	   (setq-my oups (>> outputs uarg-op-decoder land-of-uarg))
	   (setq-my dp (>> data-path uarg-stacks land-of-uarg))
	   (loop for conn in target-conns
		 and k from
		 (+ (>> x end-pt freeze clocking-in-uarg)
		    *metal-pitch*)
		 by *metal-pitch*
		 do
		 (op-router (cons (>> (*path (car conn)) oups)
				  (mapcar
				    #'(lambda (pth)
					(>> (*path `(input ,pth)) dp))
				    (cdr conn)))
			    () k 'vertical))
	   (loop for conn in arg2-conns
		 and k from
		(+ (>> x end-pt freeze clocking-in-uarg)
		    (* (1+ (length target-conns)) *metal-pitch*))
		 by *metal-pitch*
		 do
		 (op-router (cons (>> (*path (car conn)) oups)
				  (mapcar
				    #'(lambda (pth)
					(>> (*path `(input ,pth)) dp))
				    (cdr conn)))
			    () k 'vertical))
	   (loop for conn in arg1-conns
		 and k from
		 (+ (>> x end-pt freeze clocking-in-uarg)
		    (* (+ (length target-conns) (length arg2-conns) 1)
		       *metal-pitch*))
		 by *metal-pitch*
		 do
		 (op-router (cons (>> (*path (car conn)) oups)
				  (mapcar
				    #'(lambda (pth)
					(>> (*path `(input ,pth)) dp))
				    (cdr conn)))
			    () k 'vertical)))))

