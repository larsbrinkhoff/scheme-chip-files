;;; -*- package: DPL; mode: LISP -*-

;;; SCHEME-81 Pads

(defun initialize-pad-fields ()
  (setq *top-pad-field* (instantiate-field 'top-pads))
  (setq *side-pad-field* (instantiate-field 'side-pads))
  (setq *bottom-pad-field* (instantiate-field 'bottom-pads))
  (remtype 'scheme-pads)
  't)

;;; xsize and ysize are related to the size of the pads.
;;; Experiment!!

(defcell scheme-pads
	 ((xsize 5000)
	  (ysize 4200)
	  (vdd-width 50)
	  (gnd-width 20))
  (or (boundp '*top-pad-field*)
      (initialize-pad-fields))
  (schip-part top-pads (paddy fake-paddy)
	 (field *top-pad-field*)
	 (vdd-width (>> vdd-width))
	 (gnd-width (>> gnd-width))
	 (total-width (>> xsize)))
  (schip-part bottom-pads (paddy fake-paddy)
	 (field *bottom-pad-field*)
	 (vdd-width (>> vdd-width))
	 (gnd-width (>> gnd-width))
	 (total-width (>> xsize)))
  (negy (>> bottom-pads))
  (align (>> bottom-pads)
	 (>> apparent-top-left bottom-pads)
	 (pt-below
	   (>> apparent-bottom-left top-pads)
	   (>> ysize)))
  (schip-part side-pads (paddy fake-paddy)
	 (field *side-pad-field*)
	 (vdd-width (>> vdd-width))
	 (gnd-width (>> gnd-width))
	 (total-width (- (>> apparent-bottom top-pads)
			 (>> apparent-top bottom-pads))))
  (rot90 (>> side-pads))
  (align-y (>> side-pads)
	   (>> center side-pads)
	   (+ (>> apparent-top bottom-pads) (half (>> ysize))))
  (align-x (>> side-pads)
	   (>> apparent-right gnd-bus *rep-first rep side-pads)
	   (>> apparent-right gnd-bus *rep-first rep bottom-pads))
  (wireq vdd-circuit (run-layer 'metal)
	 (run-width (>> vdd-width))
	 (from (>> apparent-center-right vdd-bus *rep-first rep top-pads))
	 (to-x (+ (max (>> apparent-right vdd-bus *rep-last rep top-pads)
		       (>> apparent-right vdd-bus *rep-last rep bottom-pads))
		  (>> *half-width*)))
	 (save-cp 'right-center)
	 (jog-y (>> apparent-center-left vdd-bus *rep-first rep bottom-pads))
	 (jog-x (>> apparent-top-center vdd-bus *rep-last rep side-pads))
	 (jog-y (>> start-pt *current-wire*)))
  (group silly-vdd-pad
	 (partq () rectangle (layer 'noglass)
		(length 70) (width 70))
	 (partq () rectangle (layer 'pad)
		(length 70) (width 70)))
  (align (>> silly-vdd-pad)
	 (>> center silly-vdd-pad)
	 (pt (>> x right-center vdd-circuit)
	     (+ (>> apparent-bottom vdd-circuit)
		(half (>> ydim vdd-circuit)))))
  (wireq top-gnd (run-layer 'metal)
	 (run-width (>> gnd-width))
	 (from (>> apparent-center-left gnd-bus (*rep 2) rep top-pads))
	 (to-x (>> apparent-center-right gnd-bus *rep-last rep top-pads)))
  (wireq side-and-bottom-pad-gnd
	 (run-layer 'metal)
	 (run-width (>> gnd-width))
	 (from (>> apparent-top-center gnd-bus *rep-last rep side-pads))
	 (jog-y (>> apparent-center-right gnd-bus
		    (*rep (- (>> pad-number bottom-pads) 2)) rep bottom-pads)))
  (wireq connect-side-and-top-pads
	 (run-layer 'metal)
	 (run-width (>> gnd-width))
	 (from (>> start-pt side-and-bottom-pad-gnd))
	 (jog-y (>> start-pt top-gnd)))
  (wireq bottom-right-gnd
	 (run-layer 'metal)
	 (run-width (>> gnd-width))
	 (from (>> end-pt side-and-bottom-pad-gnd))
	 (to-x (>> apparent-left gnd-bus *rep-last rep bottom-pads))))