
(label transport-loop)
(move l (a new) (@a+ scan))
(label transport-loop-entry)
(cmp l (a scan) (a free))
(b eq finish-gc)
(move l (@a scan) (a old))
(tst b (@ao scan 3))
(b eq bump-scan)

(cmp b (& broken-heart) (@ao 3 old))
(b eq snap-broken-heart)
(move l (& 37700000000) (a new))
(and l (a old) (a new))
(eor l (a free) (a new))
(move l (@a old) (d count))
(move l (a free) (@a+ old))
(move l (d count) (@a+ free))
(move b (@ao scan 3) (a temp))			;type of old
(lsl w (a temp) 1)
(jmp b (@ao temp relocate-dispatch))

(label relocate-dispatch)
(bra error)
(bra list-copy)
(bra array-copy)
(bra list-copy)
(bra hunk3-copy)
(bra list-copy)
(bra array-copy)
(bra list-copy)

(label array-copy)
(move l (@a+ old) (@a+ free))
(dbra count array-copy)
(goto transport-loop)

(label hunk3-copy)
(move l (@a+ old) (@a+ free))

(label list-copy)
(move l (@a old) (@a+ free))
(goto transport-loop)

(label bump-scan)
(add l (& 4) (a scan))
(goto transport-loop)

(label snap-broken-heart)
(move b (@ao scan 3) (a temp))
(move l (@a old) (@a scan))
(move b (a temp) (@ao scan))
(add l (& 4) (a scan))
(bra transport-loop-entry)