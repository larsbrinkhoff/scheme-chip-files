;;; -*-LISP-*-
;;; SCHEME Machine & Microcode by GJS, HANSON, GLS, JAR, H, TK, NLM, RMS.

;;; We define the data paths in terms of bit vectors.
;;; A register is a vector.  So is a bus.  So is a field, which is a
;;; subvector of another vector.  So is a concatenation of vectors.
;;; So is the reverse of a vector.

;42 non-pointer types.  34 list-pointer types.  A very few array-pointer types.
(defvector word all
  (subfield type				;opcodes are TYPEs of sexprs
	    (width 7)
	    (position 0)

	    ;; Tell defdispatch what to do to define a data-type.
	    ;; The subclasses are the "value"s of subfields class and list-bit.
	    (dispatch-class data-type (values-from class list-bit))
	    (subfield list-bit
		      (width 1.)
		      (position 0)
		      (values (non-pointer 0)))
	    (subfield class
		      (width 4.)
		      (position 0)
		      (values (array-pointer 17) (list-pointer 10 17))))

  (subfield count			;counter for PUSH-COUNTER racks
	    (width 5)			;These bits are chosen so that, together
					;with two bits "10" above them,
					;the result is always a list-pointer type.
	    (position 2))
  (subfield datum
	    (width 29.)
	    (position (width-of-type type word))
	    (subfield typenum
		      (width (width-of-type type word))
		      (position (- (width-of-type word)
				   (width-of-type type word))))
	    (subfield rest
		      (width (- (width-of-type datum word)
				(width-of-type type word)))
		      (position 0))
	    (subfield machine-number (width 4) (position 0))
	    (subfield high-bits
		      (width (1- (width-of-type datum word)))
		      (position 0))
	    (subfield low-bit
		      (width 1)
		      (position (1- (width-of-type datum word))))
	    (subfield low-bits
		      (width (1- (width-of-type datum word)))
		      (position 1))
	    (subfield high-bit
		      (width 1)
		      (position 0))))

(defvector micro-state eval
	   (subfield type
		     (same-type type word)
		     (position 0))
	   (subfield all-but-type
		     (width 2)
		     (position (width-of-type type word)))
	   (subfield low-bit
		     (width 1)
		     (position (1- (width-of-type micro-state)))))

(defvector micro-state allocator
	   (subfield type
		     (same-type type word)
		     (position 0)))

(defvector memory-address all
  (width (1+ (width-of-type datum word)))
  (subfield datum
	    (same-type datum word)
	    (position 0))
  (subfield bottom-bit
	    (width 1)
	    (position (width-of-type datum word))))

(defvector sbus-word all
	   (subfield word (same-type word))
	   (subfield error (width 1))
	   (subfield halt (width 1))		;Means microcode has halted.
	   (subfield mem-request (width 1))
	   (subfield mem-done (width 1))
	   (subfield operation-done (width 1))
	   (subfield write (width 1))
	   (subfield low-address-bit (width 1))
	   (subfield external-interrupt-request (width 1))
	   (subfield external-interrupt-grant (width 1))
	   (subfield cons-server-request (width 1))
	   (subfield cons-server-grant (width 1))
	   (subfield relocate-request-to-me (width 1))
	   (subfield relocate-request-from-me (width 1))
	   (subfield freeze (width 1))
	   (subfield -somebody-needs-gc (width 1))
	   (subfield -somebody-doesnt-need-gc (width 1)))

(defvector bit
	   (width 1))

;;; A bus is a device which one can source from and drive, in order for
;;; data to be transferred, it must be done on the same cycle.

;;; A register can actually store data.  It has an input and an output.

;;; Both registers and buses are declared giving the name
;;; of the vector which says how many bits there are,
;;; and divides them into subfields.

;;; Both can have a set of control-bits listed.
;;; Each control bit is a circuit node, a part of the register or
;;; bus, which causes connections to be made if it is set.

;;; A register or bus can also have status bits, which are
;;; computed from the contents of the bus or register, and
;;; available as outputs.

;;; A PCLSR clause in the definition of a register sets up
;;; both a shadow register and control bits "PCLSR-SAVE"
;;; and "PCLSR-RESTORE" to read and write it.

;;; The name of a register or bus can be global, or can be local
;;; to one machine.  If it is global, a machine name of "all" is used.

(defmacro normal-register ()
  `(control-bits (load ((bitvec input *me*) (bitvec main-bus)))
		 (read ((bitvec main-bus) (bitvec output *me*)))))

(defmacro split-loader ()
  `(control-bits (load fan-out ((bitvec (load type) *me*)
				(bitvec (load datum) *me*)))
		 ((load type) ((bitvec type main-bus)
			       (bitvec type input *me*)))
		 ((load datum) ((bitvec datum main-bus)
				(bitvec datum input *me*)))
		 (read ((bitvec main-bus) (bitvec output *me*)))))

(defmacro split-reader ()
  `(control-bits (load ((bitvec main-bus) (bitvec input *me*)))
		 (read fan-out ((bitvec (read type) *me*)
				(bitvec (read datum) *me*)))
		 ((read type) ((bitvec type output *me*)
			       (bitvec type main-bus)))
		 ((read datum) ((bitvec datum output *me*)
				(bitvec datum main-bus)))))

(defmacro incrementer ()
  `(control-bits (inc ((vincrement (bitvec output *me*))
		       (bitvec input *me*)))))

(defmacro decrementer ()
  `(control-bits (dec ((vdecrement (bitvec output *me*))
		       (bitvec input *me*)))))

(defmacro bus-eq ()
  `(status-bits (=bus? (vreduce vand
				(veqv (bitvec output *me*)
				      (bitvec main-bus))))))

(defmacro bus-inc-load ()
  `(control-bits (inc-load ((vinc (bitvec main-bus))
			    (bitvec input *me*)))))

(defmacro pc-saver ()
  `(control-bits (load ((bitvec nextpc-bus) (bitvec input *me*)))
		 (read ((bitvec output *me*) (bitvec newpc-bus)))))

;EVAL machine sequencer.

(defmachine eval real-newpc-bus nextpc-bus uconstant-bus)

(defbus uconstant-bus micro-state eval	;microcode constants, alternate pcs
  (control-bits (constant-type ((bitvec type *me*)
				(bitvec type main-bus)))))

(defbus nextpc-bus micro-state eval)	; next pc if not branch

(defbus real-newpc-bus micro-state eval
  (control-bits (normal-running ((bitvec *me*) (bitvec newpc-bus)))
		(goto-cons-server ((bitvec *me*) cons-server-entry)))
  (connects ((vnot (bitvec goto-cons-server *me*))
	     (bitvec normal-running *me*))))

(defbus newpc-bus micro-state eval	;the next micro-state in
  (control-bits (goto-next ((bitvec nextpc-bus) (bitvec *me*)))
		(goto-alt ((bitvec uconstant-bus) (bitvec *me*)))
		(dispatch ((bitvec type main-bus) (bitvec type *me*))
			  (0 (bitvec all-but-type *me*)))))

(defregister eval-machine-running bit all
  (control-bits (set ((bitvec input *me*) 1))
		(clear ((bitvec input *me*) 0)))
  (status-bits (stopped (vor (bitvec freeze sbus)
			     (vnot (bitvec output *me*))))))

;These registers are used to save pcs so they can be returned to.
;for rack suboperations.
(defregister rackpc micro-state eval (pc-saver))

;for microcode subroutines.
(defregister micropc micro-state eval (pc-saver))

;for calling pcons and pncons.
(defregister conspc micro-state eval (pc-saver))

(defregister cons-server-pc micro-state eval
  (control-bits (load ((bitvec input *me*) (bitvec newpc-bus)))
		(read ((bitvec newpc-bus) (bitvec output *me*))))
  (connects ((vand (bitvec cons-server-request sbus)
		   (vnot (bitvec stopped eval-machine-running))
		   (vnot (bitvec output inhibit-cons-server))
		   (vnot (bitvec output I-need-gc)))
	     (bitvec load *me*)
	     (bitvec goto-cons-server real-newpc-bus))))

(defregister waitpc micro-state eval			;for busy waiting
  (connects ((bitvec newpc-bus) (bitvec input *me*)))
  (control-bits (wait ((bitvec output *me*) (bitvec newpc-bus)))))

(defbus main-bus word all
  (control-bits (datum<=0 ((bitvec datum *me*) 0))
		(sbus bidirectional
		      ((bitvec word sbus) (bitvec *me*))
		      ((bitvec low-address-bit sbus)
		       (bitvec main-bus-extra-address-bit))))
  (status-bits (array-pointer? (vreduce vand (bitvec class type word *me*)))
	       (not-pointer? (vnot (bitvec list-bit type word *me*)))
	       (list-pointer? (vand (bitvec list-bit type word *me*)
				    (vnot (bitvec array-pointer? *me*))))
	       (not-list-pointer? (vnot (bitvec list-pointer? *me*)))
	       (non-GC-pointer? (vreduce vand (bitvec machine-number *me*)))
	       (datum=0? (vnot (vreduce vor (bitvec datum *me*))))
	       (datum<2? (vnot (vreduce vor (bitvec high-bits datum *me*))))
	       (at-max-count? (vreduce vand (bitvec count *me*)))
	       (non-zero-count? (vreduce vor (bitvec count *me*)))))

(defbus main-bus-extra-address-bit bit all
  (control-bits (left ((bitvec *me*) 0))
		(right ((bitvec *me*) 1))))

(defbus sbus sbus-word all
  (control-bits (main-bus bidirectional
			  ((bitvec main-bus) (bitvec word *me*))
			  ((bitvec low-address-bit sbus)
			   (bitvec main-bus-extra-address-bit)))
		(signal-operation-done ((bitvec operation-done *me*) 1))
		(signal-relocate-request ((bitvec relocate-request-from-me *me*) 1))
		(signal-mem-request ((bitvec mem-request *me*) 1))
		(signal-write ((bitvec write *me*) 1))
		(gc-needed ((bitvec -somebody-needs-gc *me*) 0))
		(gc-not-needed ((bitvec -somebody-doesnt-need-gc *me*) 0)))
  (status-bits
    (operation-local? (bitvec local? op *me*))

    ;; Assumes that sbus and main-bus are connected
    ;; at the time this is checked!
    (operation-for-me? (vor (bitvec operation-local? *me*)
			    (bitvec address-for-me? main-bus))))
  (connects
    ((bitvec external-interrupt-grant sbus) (bitvec output interrupt-grant))
    ((bitvec gc-needed sbus) (bitvec output I-need-gc))
    ((bitvec gc-not-needed sbus) (vnot (bitvec output I-need-gc)))))

;;; Define the control signals which control all pclsring in parallel.

(defbus pclsr-restore bit eval
  (connects ((bitvec pclsr-restore) 
	     (bitvec pclsr-restore env)
	     (bitvec pclsr-restore cont)
	     (bitvec pclsr-restore thargs)
	     (bitvec pclsr-restore val)
	     (bitvec pclsr-restore exp))))

(defbus pclsr-save bit eval
  (connects ((bitvec pclsr-save)
	     (bitvec pclsr-save env)
	     (bitvec pclsr-save cont)
	     (bitvec pclsr-save thargs)
	     (bitvec pclsr-save val)
	     (bitvec pclsr-save exp))))

(defmacro def-uconstant-flag-bit (name)
  `(defregister ,name bit all
		(control-bits
		  (set ((bitvec input *me*) (bitvec lowbit uconstant-bus))))))

(def-uconstant-flag-bit interrupt-enable)

(def-uconstant-flag-bit interrupt-grant)

(def-uconstant-flag-bit gc-interrupt-enable)

(defregister I-need-gc bit all
  (control-bits (set ((bitvec input *me*) 1))
		(clear ((bitvec input *me*) 0))))

(def-uconstant-flag-bit inhibit-cons-server)

(defbus interrupt-pending bit all
   (connects ((bitvec interrupt-pending)
	      (vor (vand (bitvec external-interrupt-request sbus)
			 (bitvec output interrupt-enable))
		   (vand (vnot (bitvec -somebody-needs-gc sbus))
			 (bitvec output gc-interrupt-enable))))))

;;; The EXP register is used to hold an expression being evaluated.

(defregister exp word all (pclsr) (normal-register)
  (control-bits (rsh0 ((bitvec low-bits datum input *me*)
		       (bitvec high-bits datum output *me*))
		      ((bitvec high-bit datum input *me*) 0))))
;;; The VAL register is used to hold the value of the expression just evaluated.

(defregister val word all (pclsr) (split-loader) (incrementer) (decrementer)
  (control-bits (lsh0 ((bitvec high-bits datum input *me*)
		       (bitvec low-bits datum output *me*))
		      ((bitvec low-bit datum input *me*) 0))
		(lsh1 ((bitvec high-bits datum input *me*)
		       (bitvec low-bits datum output *me*))
		      ((bitvec low-bit datum input *me*) 1)))
  (status-bits (=type? (vnot (vreduce vor
				      (vxor (bitvec type main-bus)
					    (bitvec type output *me*)))))
	       (=datum? (vnot (vreduce vor
				       (vxor (bitvec datum main-bus)
					     (bitvec datum output *me*)))))
	       (=? (vand (bitvec =datum? *me*) (bitvec =type? *me*)))))

;This register is used only temporarily
;to get the address of a value cell, to be read or written
;by the next macroinstruction.
;It is also used for arg and value of ARRAY-CONS, and by GC.
;Any ASSIGN or SAVE of a rack can clobber VCELL.

(defregister vcell word all (normal-register) (decrementer))

(defregister machine-number (machine-number datum word) all
  (control-bits (load ((bitvec input *me*) (bitvec machine-number main-bus)))
		(read ((bitvec output *me*) (bitvec machine-number main-bus))))
  (status-bit (=bus? (vreduce vand (veqv (bitvec output *me*)
					 (bitvec machine-number main-bus))))))

;Two registers used for passing arguments to CONS.  The cons
;server must be disabled whenever these are being used or during
;anything which is storing through FREE and hasn't incremented it yet.

(defregister first-argument word all (normal-register)) 
(defregister second-argument word all (normal-register))

(defregister free word all (normal-register) (incrementer))
(defregister memtop word all (normal-register) (bus-eq))
(defregister space1-free word all (normal-register))
(defregister space2-free word all (normal-register))

;;Array arithmetic

;ADDER always adds the contents of VAL to twice those of COMPARE-REG.
;When the output is used, the bottom bit controls the sbus half-cell
;and the rest of the bits go on the main bus.

(defadder adder memory-address eval
  (connect ((bitvec high-bits datum output compare-reg)
	    (bitvec low-bits datum input2 *me*))
	   (0 (bitvec high-bit datum input2 *me*))
	   ((bitvec low-bit datum output compare-reg)
	    (bitvec bottom-bit input2 *me*))
	   ((bitvec datum output val)
	    (bitvec datum input1 *me*))
	   ((bitvec bottom-bit input1 *me*) 1))
  (control-bits (select ((bitvec datum main-bus)
			 (bitvec datum output *me*))
			((bitvec bottom-bit output *me*)
			 (bitvec main-bus-extra-address-bit)))))

;COMPARATOR Always compares the contents of COMPARE-REG with the MAIN-BUS
;and asserts in-bounds if compare-reg is nonnegative
;and less than what is on the main-bus.

(defadder comparator (datum word) eval
  (connect ((bitvec input1 *me*) (bitvec datum output compare-reg))
	   ((bitvec input2 *me*) (vnot (bitvec datum main-bus)))
	   ((bitvec carry-in *me*) 1))
  (status-bits (in-bounds (vnot (bitvec carry-out *me*)))))

(defregister compare-reg word all (normal-register) (incrementer))

;;; INTVECTOR Holds array to index into with interrupt code
;;; to get the routine to call to handle the interrupt.
;;; The interrupt routine is responsible for setting
;;; interrupt-grant, if it is an external interrupt,
;;; and also for re-enabling interrupts.

(defregister intvector word all (normal-register))

;;; ERRCODE Holds error code while registers are being saved
;;; to make the control point to return to.

(defregister errcode word all (normal-register))

;;; SPLIT-REG is a random register which provides certain
;;; extra datapaths which are necessary, such as transferring
;;; the TYPE field of the MAIN-BUS to the DATUM field.

(defregister split-reg word all (split-reader)
  (control-bits (type-to-datum ((bitvec type output *me*)
				(bitvec typenum datum main-bus))
			       (0 (bitvec rest datum main-bus)))))

;;; Racks

;A rack is a register together with a stack to save it on.
;(defrack foo) automatically defines four registers
;known as (buffer foo) which contains the actual data
;	  (stack foo) which contains the pointer to the stack-list.
;		It is possible to load just the datum of this register.
;		The type field holds the count (for a push-counter)
;		or the in-use bit (for a push-optimizer).
;	  (stack-bottom foo) which points to the bottom of the stack region.
;	  (stack-top foo) which points to the top of the stack region.
;	  (stack-free foo) which points at the first free word in the
;		stack region.  This register can be loaded with one
;		plus the bus and can be compared with the bus.

(defrack env push-counter word eval
  (buffer (pclsr) (normal-register))
  (stack-bottom (normal-register))
  (stack-top (normal-register))
  (stack-free (normal-register) (bus-eq) (bus-inc-load)))
  (stack (pclsr) (split-loader) (incrementer) (decrementer)))

(defrack cont push-optimizer word eval
  (buffer (pclsr) (normal-register))
  (stack-bottom (normal-register))
  (stack-top (normal-register))
  (stack-free (normal-register) (bus-eq) (bus-inc-load))
  (stack (pclsr) (split-loader)
	 (control-bits (set-in-use ((bitvec in-use-bit *me*) 1))
		       (clear-in-use ((bitvec in-use-bit *me*) 0)))
	 (status-bits (in-use (bitvec in-use-bit)))))

(defrack thargs push-optimizer word eval
  (buffer (pclsr) (normal-register))
  (stack-bottom (normal-register))
  (stack-top (normal-register))
  (stack-free (normal-register) (bus-eq) (bus-inc-load))
  (stack (pclsr) (split-loader)
	 (control-bits (set-in-use ((bitvec in-use-bit *me*) 1))
		       (clear-in-use ((bitvec in-use-bit *me*) 0)))
	 (status-bits (in-use (bitvec in-use-bit *me*)))))

;;; (defmicrofun <name> <args> <machine> . <body>)
;;; defines an macro which expands into the result of evalling <body>
;;; with the <args> bound.  The resulting expansion should when run
;;; place data on main-bus.
;;; a microfun can be used only in contexts which want
;;; "something to put data on the main-bus".

(defmacro defmicrofun (name args machine . body)
  `(defmicrosequence ,name ,args (bitvec main-bus) machine ,body))

;;; (defmicropred <name> <args> <machine> <output-bit> . <body>)
;;; is similar to defmicrofun except that the expansion when run
;;; causes the <output-bit> to be driven with the desired boolean value.
;;; A micropred can be used only as the argument of an IF.

(defmacro defmicropred (name args machine output-bit . body)
  `(defmicrosequence ,name ,args ,output-bit ,machine ,body))

;;; (defmicrostatement <name> <args> <machine> . <body>)
;;; is similar to microfun except that it is used
;;; at top level to expand into entire macroinstructions.

(defmacro defmicrostatement (name args machine . body)
  `(defmicrosequence ,name ,args (bitvec) ,machine ,body))

;;; The defmicro... macros expand into code which uses these primitives:

; (ASSERT (BITVEC ...)) says to turn on a signal when executed.
; The signal is allocated an output line from the microcode PLA.

; (UCONSTANT value) says to output the value on the uconstant bus,
; which comes directly out of the microcode PLA.

; (NEXTPC value) says to output the value on the nextpc-bus,
; making it the address for normal instruction sequencing.

; (SAME-CYCLE <multi-cycle> <one-cycle> <one-cycle> ...)
; causes all the one-cycle operations to happen on the same
; cycle as the last cycle of the multi-cycle operation.
; That is, they become part of one horizontally-wide microinstruction.

; (BLOCK <code> <more-code> ...)
; causes the individual pieces of code (which can be one microinstruction
; each, or more than one) to be done sequentially.
; A BLOCK may appear as the first argument of a SAME-CYCLE,
; in which case the remaining arguments of the SAME-CYCLE
; are merged into the last microinstruction in the BLOCK.

; (FLUSHABLE-NO-OP) is a no-op that can be deleted
; if it doesn't get SAME-CYCLE'd with something else.

; (GOTO pc) when unconditional says to output pc on the nextpc-bus,
; which comes directly out of the microcode PLA,
; and to route it to be the next PC.
; This is not really primitive; it is implemented below.

; (BUSY-WAIT) causes the last instruction to be repeated.
; Presumably it is used conditionally!
; It routs the waitpc register into the newpc-bus.
; Also, this automatically inhibits
; any other kind of jumping, at a low level in the hardware.
; This is not really primitive; it is implemented below.

; Other kinds of jumps include (RETURN registername)
; and (DISPATCH).  They are implemented
; with DEFMICROSTATEMENTs below.

; (IF condition iftrue &optional iffalse)
; is the only form of conditional.
; The arms of the conditional must be some kind of single-cycle action.
; The condition should be the name of a signal,
; or may use a defmicropred which expands into one.
; In that case, the "body" of the defmicropred
; is same-cycled with the IF microinstruction.
; This is intended to set up other data paths
; so that the signal being tested will contain the
; value that is to be tested.
; In addition, the normal use of (not ...) is allowed.
; IF works by turning on a special output line from the microcode PLA
; (each condition has its own such output line)
; and putting the alternate successor PCs out on the
; uconstant bus and the nextpc-bus.
; The output line goes into the control PLA
; together with the signal being tested
; to produce signals which decide which of the two PCs
; to jump to.
; If the alternative of the IF is nonexistent, the IF
; falls through in that case.  This means that the PC
; used is the address of the "next instruction".  This PC
; always comes out on the nextpc-bus, and the PC
; which onvolves actually jumping comes out on the uconstant bus.
; If an arm of the conditional is a RETURN, DISPATCH
; or BUSY-WAIT, then no explicit PC needs to come out
; of the PLA.
; This is not really primitive; it is implemented below.

;;; Implement jump instructions.

;Implement an unconditional jump
;as a jump on a condition which is always true.
;We must not drive the pc-loading data path controls directly
;because the control PLA wants to drive them.
;We must work through the control PLA.

(defmicrostatement dispatch () all
  `(if (true?) (dispatch)))

(defmicrostatement return (regname) eval
  `(if (true?) (return ,regname)))

(defmicrostatement busy-wait () all
  '(if (true?) (busy-wait)))

(defmicrostatement goto (label) all
  `(if (true?) (goto ,label)))

(defmicropred true? () all 1)

(defmicrostatement if (condition iftrue &optional iffalse) all
  (let (uconstant nextpc)

       ;; Eliminate negative conditions.

       (do () ((not (eq (car condition) 'not)))
	   (psetq iffalse iftrue
		  iftrue iffalse
		  condition (cadr condition)))

       ;; Decide whether we need to use the uconstant or change the nextpc.
       ;; UCONSTANT and NEXTPC get the instructions to set them
       ;; or NIL if there is no need to set them.
       ;; If we extract a jump address from an arm of the conditional,
       ;; change that arm to UCONSTANT-BRANCH,
       ;; or NIL if we put its jump address into nextpc.

       (cond ((and (null iftrue)
		   (eq 'goto (car iffalse)))
	      (setq uconstant `(uconstant ,(cadr iffalse))
		    iffalse 'uconstant-branch))
	     ((eq (car iftrue) 'goto)
	      (setq uconstant `(uconstant ,(cadr iftrue))
		    iftrue 'uconstant-branch)
	      (and (eq (car iffalse 'goto))
		   (setq nextpc `(nextpc ,(cadr iffalse))
			 iffalse nil)))

    (and iftrue (gencontrolterm condition 'iftrue iftrue))
    (and iffalse (gencontrolterm condition 'iffalse iffalse))
    `(same-cycle ,uconstant ,nextpc
		 ,(and iftrue
		       `(assert (bitvec (iftrue ,(cdr condition))
					microcode-pla)))
		 ,(and iffalse
		       `(assert (bitvec (iffalse ,(cdr condition))
					microcode-pla))))))

;This is a sample definition of a term in the PLA.
;It specifies a logical combination of some inputs, and
;a list of outputs to be turned on in that case.
;The inputs to the PLA are not explicitly listed.
;They are declared implicitly by appearing in a term.
;
; (defplaterm control-pla
;	      (vand (bitvec (iftrue (datum=0? main-bus)) microcode-pla)
;		    (bitvec datum=0? main-bus))
;	      (uconstant-branch))
;
;Control PLA terms such as these are defined automatically by
;the IF construct when they are needed.
;Note that condition-signal can be just 1 for an unconditional branch.

(defun gencontrolterm (condition-signal sense branch-type)
  (let ((condition (cond ((eq sense 'iftrue) condition-signal)
			 ((eq sense 'iffalse)
			  `(vnot ,condition-signal))
			 ((t (error sense '|not IFTRUE or IFFALSE|)))))
	(term `(bitvec (,sense ,(cdr condition-signal)) microcode-pla)))
    (or (equal condition-signal 1)
	(setq term `(vand ,term condition)))
    (eval `(defplaterm control-pla
		       ,term
		       (,branch-type)))))

;Now we define the control PLA, which takes in
;both branch-condition signals from the microcode PLA
;and the signals to be tested by the conditions,
;and generates the signals controlling branching.

;Here we define the outputs.  (The inputs are implicitly defined)
;Each of the outputs aside from uconstant-branch (which implements GOTO)
;has a name which is the same as the microcode expression
;used to ask for that kind of branch.
;This allows the IF construct to be implemented very simply
;and detects errors where an IF arm is not a defined type of branch.

(defpla control eval
  (outputs (uconstant-branch
	    (busy-wait)
	    (return rackpc)
	    (return micropc)
	    (return conspc)
	    (return cons-server-pc)
	    (dispatch))))

;Connect the control PLA outputs to the data paths that
;do the actual jumping.  This is probably not the way
;we really want to implement these connections,
;but it says what the logical effect of them is to be.

(defconnect ((bitvec read waitpc)
	     (vor (bitvec (busy-wait) control-pla)
		  (bitvec stopped eval-machine-running)))
	    ((bitvec goto-next newpc-bus)
	     (vnot (vor (bitvec uconstant-branch control-pla)
			(bitvec (return rackpc) control-pla)
			(bitvec (return micropc) control-pla)
			(bitvec (return conspc) control-pla)
			(bitvec (return cons-server-pc) control-pla)
			(bitvec (dispatch) control-pla)
			(bitvec (busy-wait) control-pla))))
	    ((bitvec goto-alt newpc-bus)
	     (vand (bitvec uconstant-branch control-pla)
		   (vnot (bitvec (busy-wait) control-pla))))
	    ((bitvec read rackpc)
	     (vand (bitvec (return rackpc) control-pla)
		   (vnot (bitvec (busy-wait) control-pla))))
	    ((bitvec read micropc)
	     (vand (bitvec (return micropc) control-pla)
		   (vnot (bitvec (busy-wait) control-pla))))
	    ((bitvec read conspc)
	     (vand (bitvec (return conspc) control-pla)
		   (vnot (bitvec (busy-wait) control-pla))))
	    ((bitvec read cons-server-pc)
	     (vand (bitvec (return cons-server-pc) control-pla)
		   (vnot (bitvec (busy-wait) control-pla))))
	    ((bitvec dispatch newpc-bus)
	     (vand (bitvec (dispatch) control-pla)
		   (vnot (bitvec (busy-wait) control-pla)))))


(defmicrostatement put-on-main-bus (source) all
  (expand-microfuns source nil))

(defmicrofun read-reg (regname) all
  `(assert (bitvec read ,regname)))

(defmicrostatement load-reg (regname source) all
  `(same-cycle (put-on-main-bus ,source)
	       (assert (bitvec load ,regname))))

(defmicrofun constant-type (constant) all
  `(same-cycle (uconstant ,constant)			;output constant
	       (assert (bitvec constant-type uconstant-bus))))	;couple busses

(defmicrostatement ucall (target-pc) all
  `(same-cycle (assert (bitvec load micropc))
	       (goto ,target-pc)))

(defmicrostatement ucall-return-elsewhere (pc-to-call place-to-return)
  `(same-cycle (if (true?) (goto ,pc-to-call) (goto ,place-to-return))
	       (assert (bitvec load micropc))))

(defmicrostatement ucall-conspc (target-pc) all
  `(same-cycle (assert (bitvec load conspc))
	       (disable-cons-server)
	       (goto ,target-pc)))

(defmicrostatement ucall-conspc-return-elsewhere (pc-to-call place-to-return)
  `(same-cycle (if (true?) (goto ,pc-to-call) (goto ,place-to-return))
	       (assert (bitvec load conspc))))

(defmicrostatement set-uconstant-flag (name value)
  `(same-cycle (uconstant ,value)
	       (assert (bitvec set ,name))))

(defmicrostatement disable-cons-server () eval
  '(set-uconstant-flag inhibit-cons-server 1))

(defmicrostatement enable-cons-server () eval
  '(set-uconstant-flag inhibit-cons-server 0))

;Used by main loop to check for interrupt
;while simultaneously saving the registers for pclsring.

(defmicropred interrupt? () eval
  '(bitvec interrupt-pending))

(defmicropred datum=0? (source) all
  '(bitvec datum=0? main-bus)
  `(put-on-main-bus ,source))

(defmicropred datum<2? (source) eval
  '(bitvec datum<2? main-bus)
  `(put-on-main-bus ,source))

(defmicropred low-bit=1? (source) eval
  '(bitvec low-bit main-bus)
  `(put-on-main-bus ,source))

(defmicropred =val? (source) eval
  '(bitvec =? val)
  `(put-on-main-bus ,source))

;;; load and store with split-reg eliminates conflict on uconstant-
;;; bus when this is used in an if statement.

(defmicropred type=type-val? (typename) eval
  '(bitvec =type? val)
  `(block (load-reg split-reg (constant-type ,typename))
	  (fetch split-reg)))

(defmicropred array-pointer? (arg) eval
  `(bitvec array-pointer? main-bus)
  `(put-on-main-bus ,arg))

(defmicropred non-GC-pointer? (arg) eval
  `(bitvec non-GC-pointer? main-bus)
  `(put-on-main-bus ,arg))

(defmicropred array-index-ok? (arg) eval
  '(bitvec in-bounds comparator)
  `(put-on-main-bus ,arg))

(defmicropred compare-reg-<? (arg) eval
  '(bitvec in-bounds comparator)
  `(put-on-main-bus ,arg))

(defmicropred =memtop? (arg) eval
  '(bitvec =bus? memtop)
  `(put-on-main-bus ,arg))

(defmicrostatement rightshift-exp () eval
  `(assert (bitvec rsh0 exp)))

(defmicrostatement leftshift-val-0 () eval
  `(assert (bitvec lsh0 val)))

(defmicrostatement leftshift-val-1 () eval
  `(assert (bitvec lsh1 val)))

(defmicrostatement increment-val () eval
  `(assert (bitvec inc val)))

(defmicrostatement decrement-val () eval
  `(assert (bitvec dec val)))

(defmicrostatement decrement-vcell () eval
  `(assert (bitvec dec vcell)))

;Increment FREE and do the GOTO if we run out of space to cons in.
;USES THE MAIN-BUS!

(defmicrostatement increment-free (if else) eval
  '(same-cycle (assert (bitvec inc free))
	       (if (=memtop? (fetch free)) ,if ,else)))

(defmicrofun make-pointer (typename datumsource) all
  (cond ((zerop datumsource)
	 `(same-cycle (constant-type ,typename)
		      (assert (bitvec datum<=0 main-bus))))
	(t
	 `(block (load-reg split-reg ,datumsource)
		 (same-cycle (assert (bitvec (read datum) split-reg))
			     (constant-type ,typename))))))

(defmicrofun type-to-fixnum (typesource) eval
  `(block (load-reg split-reg ,typesource)
	  (same-cycle (constant-type fixnum)
		      (assert (bitvec type-to-datum split-reg)))))

;;; Referencing memory.

;Send value to SBUS, error if it isn't a pointer.

(defmicrostatement sbus-send-pointer (arg) all
  `(same-cycle (put-on-main-bus ,arg)
	       (if (bitvec not-pointer? main-bus)
		   (goto car-or-cdr-of-atom-error))
	       (assert (bitvec signal-mem-request sbus))
	       (assert (bitvec sbus main-bus))))

;Send value to SBUS, error if it isn't a list pointer.

(defmicrostatement sbus-send-list-pointer (arg) all
  `(same-cycle (put-on-main-bus ,arg)
	       (if (not (bitvec list-pointer? main-bus))
		   (goto car-or-cdr-of-atom-error))
	       (assert (bitvec signal-mem-request sbus))
	       (assert (bitvec sbus main-bus))))

(defmicrostatement sbus-send (arg) all
  `(same-cycle (put-on-main-bus ,arg)
	       (assert (bitvec signal-mem-request sbus))
	       (assert (bitvec sbus main-bus))))

;Transfer data to or from sbus.

(defmicrofun read-sbus-data () all
  '(assert (bitvec sbus main-bus)))

(defmicrofun sbus-receive () all
  '(same-cycle (assert (bitvec sbus main-bus))
	       (assert (bitvec load split-reg))
	       (if (bitvec mem-done sbus) (busy-wait))
	       (if (bitvec error sbus) (goto pclsr-for-error))))

(defmicrostatement sbus-end-transaction () all
  (expand-microfuns '(sbus-receive)))


(defmicrofun left (arg) all
  `(block (same-cycle (sbus-send-pointer ,arg)
		      (assert (bitvec left main-bus-extra-address-bit)))
	  (sbus-receive)))

(defmicrofun right (arg) all
  `(block (same-cycle (sbus-send-list-pointer ,arg)
		      (assert (bitvec right main-bus-extra-address-bit)))
	  (sbus-receive)))

(defmicrofun index-fetch () all
  `(block (sbus-send (assert (bitvec select adder)))
	  (sbus-receive)))

;Two-argument memory operations must put the two arguments
;on the sbus on sequential cycles.  If the computation of the
;second argument takes more than one cycle, then it has to be
;precomputed and left somewhere.  expand-second-arg figures out how.
;It returns precompute, which says how to compute the arg and stache it away,
;and usevalue, which is how to get the value from where it has been stached.

(defmicrostatement set-left (arg new) all
  (let (precompute usevalue)
    (desetq (precompute usevalue) (expand-second-arg new))
    `(block ,precompute
	    (same-cycle (sbus-send-pointer ,arg)
			(assert (bitvec left main-bus-extra-address-bit)))
	    (same-cycle (assert (bitvec signal-write sbus))
			(sbus-send ,usevalue))
	    (sbus-end-transaction))))

(defmicrostatement set-right (arg new) all
  (let (precompute usevalue)
    (desetq (precompute usevalue) (expand-second-arg new))
    `(block ,precompute
	    (same-cycle (sbus-send-list-pointer ,arg)
			(assert (bitvec right main-bus-extra-address-bit)))
	    (same-cycle (assert (bitvec signal-write sbus))
			(sbus-send ,usevalue))
	    (sbus-end-transaction))))

(defmicrostatement index-store (new) all
  (let (precompute usevalue)
    (desetq (precompute usevalue) (expand-second-arg new))
    `(block ,precompute
	    (sbus-send (assert (bitvec select adder)))
	    (same-cycle (assert (bitvec signal-write sbus))
			(sbus-send ,usevalue))
	    (sbus-end-transaction))))

(defmicrofun pcons (arg1 arg2) all
  `(block (same-cycle (assign first-argument ,arg1)
		      (disable-cons-server))
	  (same-cycle (assign second-argument ,arg2)
		      (ucall-conspc pcons-subroutine))
	  (fetch first-argument)))

(defmicrofun pncons (arg) eval
  `(block (same-cycle (assign first-argument ,arg)
		      (ucall-conspc pncons-subroutine)
		      (disable-cons-server))
	  (fetch first-argument)))

;;;		The Implementation of Racks

;;; Assumptions:  The type field of the CONT stack (a push-optimizer) is
;;; used for holding retpc.  Hence all retpc's are types of PAIR class.
;;; Push-optimizers have a special bit allocated for IN-USE -- avoiding crap.
;;; The IN-USE bit for the push-counter implementation is NOT ZEROP of the 
;;; count field.  The count field resides in the type field of the
;;; stack pointer.  (That means no one else can use the type field of a
;;; push-counter to hold cruft.)  In addition, we assume that PCONS returns a
;;; pointer (list) of zero type.  This causes the stack push for a counter
;;; rack to automatically create the correct state, but it causes trouble
;;; for initialization.

(defmicropred in-use? (rack) eval
  `(bitvec in-use stack ,rack))

(defmicrostatement mark-in-use! (rack) eval
  `(assert (bitvec set-in-use stack ,rack)))

(defmicrostatement clear-in-use! (rack) eval
  `(assert (bitvec clear-in-use stack ,rack)))

(defmicropred at-max-count? (rack) eval 
  '(bitvec at-max-count? main-bus)
  `(put-on-main-bus (read-reg (bitvec rack-stack ,rack))))

(defmicropred non-zero-count? (rack) eval 
  '(bitvec non-zero-count? main-bus)
  `(put-on-main-bus (read-reg (bitvec rack-stack ,rack))))

(defmicrostatement increment-count (rack) eval
  `(assert (bitvec inc (stack ,rack))))

(defmicrostatement decrement-count (rack) eval
  `(assert (bitvec dec (stack ,rack))))

(defmicropred stack-full? (rack) eval
  `(bitvec =bus? (stack-free ,rack))
  `(put-on-main-bus (stack-top ,rack)))

(defmicrostatement conditional-rack-push (condition rack) eval
  `(same-cycle (assert (bitvec load rackpc))
	       (if ,condition (goto (push ,rack)))))

(defmicrostatement conditional-rack-pop (condition rack) eval
  `(same-cycle (assert (bitvec load rackpc))
	       (if ,condition (goto (pop ,rack)))))


;; Note that double parentheses in DEFPC syntax allow multiple-names as well
;; as the extended name lists.

(defmacro define-pusher (rack)
  `(progn 'compile
     (defpc ((push ,rack))
	    (same-cycle (if (not (stack-full? ,rack))
			    (goto (push-not-full ,rack)))
			;; Make a new stack for the rack
			(assign vcell (make-pointer fixnum stack-size)))

	    ;; Don't waste lots of space on stacks
	    ;; if we are running the GC interrupt and have little space left.
	    (if (bitvec output I-need-gc) (goto (push-need-gc ,rack)))
	    (ucall-conspc array-cons)

	    ;; If no room to cons a stack, cons one cell.
	    (same-cycle (if (not (array-pointer? (fetch vcell)))
			    (goto (push-need-gc ,rack)))
			;; Else take this array and use as a stack.
			(load-reg (stack-bottom ,rack) (fetch vcell))
			(load-reg (stack-free ,rack) (fetch vcell)))
	    (load-reg (stack-top ,rack) (fetch free))
	    (goto (push-not-full ,rack)))


     ;; Stack is empty and no room to cons one:
     ;; cons one cell and use IT as the stack, for just this one push.
     ;; Since GC is coming, all would be dispelled soon anyway.

     (defpc ((push-need-gc ,rack))
	    (same-cycle (assign (stack-free ,rack) (fetch free))
			(increment-free ()))
	    (load-reg (stack-top ,rack) (fetch free))
	    (goto (push-not-full ,rack)))

     (defpc ((push-not-full ,rack))
	    (set-left (fetch (stack-free ,rack)) (fetch (buffer ,rack)))
	    (set-right (fetch (stack-free ,rack)) (fetch (stack ,rack)))
	    (same-cycle (load-reg (stack ,rack) (fetch (stack-free ,rack)))
			(assert (bitvec load-inc (stack-free ,rack)))
			(return rackpc)))

     (defpc ((pop ,rack))
	    (load-reg (buffer ,rack) (left (fetch (stack ,rack))))
	    (same-cycle (load-reg (stack ,rack)
				  (right (fetch (stack ,rack))))
			(assert (bitvec load compare-reg)))
	    (if (compare-reg-<? (fetch (stack-bottom ,rack)))
		(return rackpc))
	    (if (not (compare-reg-<? (fetch (stack-top ,rack))))
		(return rackpc))
	    (same-cycle (assert (bitvec load-inc (stack-free ,rack)))
			(put-on-main-bus (fetch (stack ,rack))))
	    (return rackpc))))

(defmicrofun fetch (rack) all
  (rack-typeq rack
	      ((register) `(read-reg ,rack))
	      ((push-optimizer push-counter)
	       `(read-reg (bitvec buffer ,rack)))))

;Do any deferred pushes or pops.

(defmicrostatement make-safe (rack) all
  (rack-typeq rack
	      ((register) nil)
	      ((push-optimizer)
	       `(same-cycle (conditional-rack-push (in-use? ,rack) ,rack)
			    (clear-in-use! ,rack)))
	      ((push-counter)
	       `(conditional-rack-push (non-zero-count? ,rack) ,rack)))

(defmicrostatement assign (rack source) all
  (rack-typeq rack
	      ((register) `(load-reg ,rack ,source))
	      ((push-optimizer)
	       `(block (same-cycle (conditional-rack-push (in-use? ,rack) ,rack)
				   (clear-in-use! ,rack))
		       (load-reg (bitvec buffer ,rack) ,source)))
	      ((push-counter)
	       `(block (conditional-rack-push (non-zero-count? ,rack) ,rack)
		       (load-reg (bitvec buffer ,rack) ,source)))))

(defmicrostatement assign-type (rack source) all
  (rack-typeq rack
	      ((register) `(load-reg (bitvec type ,rack) ,source))
	      ((push-optimizer)
	       `(block (same-cycle (conditional-rack-push (in-use? ,rack) ,rack)
				   (clear-in-use! ,rack))
		       (load-reg (bitvec type buffer ,rack) ,source)))
	      ((push-counter)
	       `(block (conditional-rack-push (non-zero-count? ,rack) ,rack)
		       (load-reg (bitvec type buffer ,rack) ,source)))))

(defmicrostatement assign-extra-type (rack source) eval
  (rack-typeq rack
	      ((push-optimizer)
	       `(block (same-cycle (conditional-rack-push (in-use? ,rack) ,rack)
				   (clear-in-use! ,rack))
		       (load-reg (bitvec type stack ,rack) ,source)))))

(defmicrostatement save (rack) eval
  (rack-typeq rack
	      ((push-optimizer)
	       `(same-cycle (conditional-rack-push (in-use? ,rack) ,rack)
			    (mark-in-use! ,rack)))
	      ((push-counter)
	       `(block (conditional-rack-push (at-max-count? ,rack) ,rack)
		       (increment-count ,rack)))))	 ;so we must reset it!

;Do (save-after-assign cont (assign  ...)).
;Like doing a separate save after the assign
;but uses no extra microinstructions.
;Can be used after an assign-type or assign-extra-type also.

(defmicrostatement save-after-assign (rack assignment) all
  (rack-typeq rack
	      ((push-optimizer) `(same-cycle ,assignment (mark-in-use! ,rack)))
	      ((push-counter) `(same-cycle ,assignment (increment-count ,rack)))))

(defmicrostatement duplicate (rack) eval
  `(save ,rack))

(defmicrostatement restore (rack) eval
  (rack-typeq rack
	      ((push-optimizer)
	       `(same-cycle (conditional-rack-pop (not (in-use? ,rack)) ,rack)
			    (clear-in-use! ,rack)))
	      ((push-counter)
	       `(block (conditional-rack-pop (not (non-zero-count? rack)) ,rack)
		       (decrement-count ,rack)))))

;Obscure rack operations.

;Dispell the whole stack of a rack (for GC).

(defmicrostatement flush-stack (rack) all
  (rack-typeq rack
	      `(same-cycle (load-reg (bitvec stack-bottom ,rack)
				     (fetch (bitvec stack-top ,rack)))
			   (load-reg (bitvec stack-free ,rack)
				     (fetch (bitvec stack-top ,rack))))))

;Get a stack pointer to save for a rack,
;making sure that the rack is in a standard state so that
;restoring the stack pointer with set-state will win.
;This is used only for making a control point.

(defmicrofun get-state (rack) eval
  (rack-typeq rack
	      ((push-optimizer push-counter)
	       `(block (save ,rack)
		       (make-safe ,rack)
		       ;; Dispell the used part of the stack area.
		       (load-reg (stack-bottom ,rack) (fetch (stack-free ,rack)))
		       (read-reg (bitvec stack ,rack))))))

;Restore a saved stack pointer.  Used only to return to a control point.

(defmicrostatement set-state (rack source) eval
  (rack-typeq rack
	      ((push-optimizer)
	       `(same-cycle (load-reg (bitvec stack ,rack) ,source)
			    (clear-in-use! ,rack)
			    (conditional-rack-pop (true?) ,rack)))
	      ((push-counter)
	       `(block (load-reg (bitvec stack ,rack) ,source)
		       (restore ,rack)))))

;Initialize a rack with an empty stack.
;Used when the machine starts, and for processing an interrupt.
;(shouldn't the racks initialize to unbound? -hanson).

(defmicrostatement reset (rack) eval
  (rack-typeq rack
	      ((push-optimizer)
	       `(block (same-cycle (load-reg (bitvec stack ,rack)
					     (make-pointer unbound 0))
				   (clear-in-use! ,rack))
		       (load-reg (bitvec buffer ,rack) (make-pointer *nil 0))))
	      ((push-counter)
	       `(block (load-reg (bitvec stack ,rack)
				 (pcons (make-pointer unbound 0)
					(make-pointer unbound 0)))
		       (load-reg (bitvec buffer ,rack) (make-pointer *nil 0))))))

;;; The microcode for the eval state machine controller starts here

(defpc boot-load
  (assign machine-number (read-sbus-data))
  (ucall reset-racks)
  (ucall flush-rack-stacks)
  (save-after-assign cont (assign-extra-type cont halt))
  (assign exp (get-input))

  ;actually a cons of error handler and int array
  (assign intvector (right (fetch exp)))
  (goto execute-left-exp))

(defdispatch halt (data-type non-pointer) user-type
  (same-cycle (assert (bitvec halt sbus))
	      (goto halt)))

(defpc reset-racks
  (reset env)
  (reset cont)
  (reset thargs)
  (return micropc))

(defpc flush-rack-stacks
  (flush-stack env)
  (flush-stack cont)
  (flush-stack thargs)
  (return micropc))

;Define subroutines used by conditional-rack-push, one for each rack.

(define-pusher thargs)
(define-pusher cont)
(define-pusher env)

;;; SCODE Control Structures.
;;;
;;; These assorted pieces of microcode are the basis of the control structure
;;; of the interpreter.  Execute-exp is the "dispatcher" of the interpreter.
;;; Pop-return invokes the continuation that was previously built.  The
;;; rest primarily perform standard combinations of operations along with
;;; an execute-exp.

;don't enable-cons-server and uconstant-branch both use the uconstant bus
;simultaneously here? -hanson

(defpc execute-exp
  (same-cycle (put-on-main-bus (fetch exp))
	      (enable-cons-server)
	      (assert (bitvec pclsr-save))
	      (if (interrupt?)
		  (goto process-interrupt)
		  (dispatch))))

(defpc pop-return
  (if (type=type-val? unbound)
      (goto unbound-val-error))
  (restore cont)
  (same-cycle (put-on-main-bus (read-reg (bitvec stack cont)))
	      (dispatch)))

(defpc sequence-send
  (duplicate env)
  (goto save-right-eval-left-exp))

(defpc save-right-eval-left-exp
  (save-after-assign cont (assign cont (right (fetch exp))))
  (goto execute-left-exp))

(defdispatch sequence-return (data-type list-pointer) extra-type-cont
  (restore env)
  (goto execute-cont))

(defdispatch execute-cont (data-type list-pointer) extra-type-cont
  (assign exp (fetch cont))
  (goto execute-exp))

(defpc (execute-left-exp execute-procedure)
  (assign exp (left (fetch exp)))
  (goto execute-exp))

(defpc execute-right-exp
  (assign exp (right (fetch exp)))
  (goto execute-exp))

;;; Constants.
;;; car/cdr of NIL,UNBOUND is NIL, UNBOUND! Generalized car/cdr needs this.
;;; check in fygc for these types.

(defdispatch (symbol (list 0)) (data-type list-pointer) user-type
  (assign val (fetch exp))
  (goto pop-return))

(defdispatch (character-string array) (data-type array-pointer) user-type
  (assign val (fetch exp))
  (goto pop-return))

(defdispatch ((*nil 0)) (data-type non-pointer) user-type
  (assign val (make-pointer *nil 0))
  (goto pop-return))

(defdispatch *t (data-type non-pointer) user-type
  (assign val (make-pointer *t 0))
  (goto pop-return))

(defdispatch (fixnum character unbound) (data-type non-pointer) user-type
  (assign val (fetch exp))
  (goto pop-return))

;This type is used only during GC.  We should never run into one.

(defdispatch broken-heart (data-type non-pointer) random-type
  (assert (bitvec halt sbus))
  (goto broken-heart))

;;; Global variables.

(defdispatch global (data-type list-pointer) user-type
  (assign val (left (fetch exp)))
  (goto pop-return))

(defdispatch set-global (data-type list-pointer) user-type
  (set-left (fetch exp) (fetch val))
  (goto pop-return))


(defdispatch unbound-global? (data-type list-pointer) user-type
  (assign val (left (fetch exp)))
  (goto unbound-check))

(defpc unbound-check
  (if (type=type-val? unbound) (goto *t) (goto *nil)))

(defdispatch makunbound-global (data-type list-pointer) user-type
  (set-left (fetch exp) (make-pointer unbound 0))
  (goto *nil))

;;; Local variables.

(defdispatch local (data-type non-pointer) user-type
  (ucall lookup-exp)
  (assign val (fetch vcell))
  (goto pop-return))

(defdispatch set-car-local (data-type non-pointer) user-type
  (ucall lookup-exp)
  (set-left (fetch vcell) (fetch val))
  (goto pop-return))

(defdispatch set-cdr-local (data-type non-pointer) user-type
  (ucall lookup-exp)
  (set-right (fetch vcell) (fetch val))
  (goto pop-return))


(defdispatch unbound-local? (data-type non-pointer) user-type
  (ucall lookup-exp)
  (assign val (fetch vcell))
  (goto unbound-check)))

(defdispatch makunbound-car-local (data-type non-pointer) user-type
  (ucall lookup-exp)
  (set-left (fetch vcell) (make-pointer unbound 0))
  (goto *nil))

(defdispatch makunbound-cdr-local (data-type non-pointer) user-type
  (ucall lookup-exp)
  (set-right (fetch vcell) (make-pointer unbound 0))
  (goto *nil))

;;; Environment searching routines.

;;; Allows destructuring LET, side effects on env, rest args, etc.

(defpc lookup-exp
       (assign vcell (fetch env))
       (goto general-car-cdr))

;;; Does a general car-cdr operation on VCELL according
;;; to the encoding in datum field of EXP.

(defpc general-car-cdr
       (if (datum<2? (fetch exp))
	   (return micropc))
       (if (low-bit=1? (fetch exp))
	   (goto general-car-cdr-do-car)
	   (goto general-car-cdr-do-cdr)))

(defpc general-car-cdr-do-car
       (same-cycle (assign vcell (left (fetch vcell)))
		   (rightshift-exp)
		   (goto general-car-cdr)))

(defpc general-car-cdr-do-cdr
       (same-cycle (assign vcell (right (fetch vcell)))
		   (rightshift-exp)
		   (goto general-car-cdr)))

; The machinery for primitive operations.

(defdispatch primitive-apply-1 (data-type list-pointer) user-type
  (assign-extra-type cont execute-cont)
  (goto save-right-eval-left-exp))

(defdispatch primitive-apply-2 (data-type list-pointer) user-type
  (assign thargs (fetch val))
  (goto primitive-apply-N))

(defdispatch primitive-apply-N (data-type list-pointer) user-type
  (assign-extra-type cont primitive-apply-N-return)
  (save thargs)
  (goto save-right-eval-left-exp))

(defdispatch primitive-apply-N-return (data-type list-pointer) extra-type-cont
  (restore thargs)
  (goto execute-cont))

; The basic primitives.

(defdispatch primitive-eq (data-type non-pointer) user-type
  (if (=val? (fetch thargs)) (goto *t) (goto *nil)))

(defdispatch primitive-zerop (data-type non-pointer) user-type
  (if (datum=0? (fetch val)) (goto *t) (goto *nil)))

(defdispatch primitive-add1 (data-type non-pointer) user-type
  (increment-val)
  (goto pop-return))

(defdispatch primitive-sub1 (data-type non-pointer) user-type
  (decrement-val)
  (goto pop-return))

(defdispatch primitive-lsh-0 (data-type non-pointer) user-type
  (leftshift-val-0)
  (goto pop-return))

(defdispatch primitive-lsh-1 (data-type non-pointer) user-type
  (leftshift-val-1)
  (goto pop-return))

(defdispatch primitive-type (data-type non-pointer) user-type
  (assign val (type-to-fixnum (fetch val)))
  (goto pop-return))

(defdispatch primitive-set-type (data-type non-pointer) user-type
  (assign-type val (fetch thargs))
  (goto pop-return))

; Primitives to control the garbage collector.

(defdispatch primitive-set-memtop  (data-type non-pointer) user-type
  (assign memtop (fetch val))
  (goto pop-return))

(defdispatch primitive-get-free (data-type non-pointer) user-type
  (assign val (fetch free))
  (goto pop-return))

(defdispatch primitive-set-free-pointers  (data-type non-pointer) user-type
  (assign space1-free (fetch val))
  (assign space2-free (fetch thargs))
  (goto pop-return))

(defdispatch garbage-collect (data-type non-pointer) user-type
  (ucall make-control-point)
  (flush-rack-stacks)
  (same-cycle (assert (bitvec set I-need-gc))
	      ;wait for acknowledge from all procs
	      (if (not (bitvec -somebody-doesnt-need-gc sbus)) (busy-wait)))

  ;;cons the two root pointers.
  (same-cycle (assign val (pcons (fetch val) (fetch intvector)))
	      (assert (bitvec clear eval-machine-running))
	      (assert (bitvec set gc-processor-running)))

  ;; This machine doesn't start running again until GC is through
  ;; and I-need-gc is already cleared.
  (assign intvector (right (fetch val)))
  (assign val (left (fetch val)))
  (assign exp (make-pointer *nil 0))
  (goto control-point-1))

; Primitives to control the interrupt system.

(defdispatch allow-interrupts (data-type non-pointer) user-type
  (set-uconstant-flag interrupt-enable 1)
  (goto *nil))

(defdispatch allow-gc-interrupts (data-type non-pointer) user-type
  (set-uconstant-flag gc-interrupt-enable 1)
  (goto *nil))

(defdispatch primitive-set-interrupt-grant (data-type non-pointer) user-type
  (set-uconstant-flag interrupt-grant 1)
  (goto *nil))

(defdispatch primitive-clear-interrupt-grant (data-type non-pointer) user-type
  (set-uconstant-flag interrupt-grant 0)
  (goto *nil))

; Implementation of lists.

(defdispatch primitive-cons (data-type non-pointer) user-type
  (assign val (pcons (fetch val) (fetch thargs)))
  (goto pop-return))


(defdispatch primitive-car (data-type non-pointer) user-type
  (assign val (left (fetch val)))
  (goto pop-return))

(defdispatch primitive-cdr (data-type non-pointer) user-type
  (assign val (right (fetch val)))
  (goto pop-return))

(defdispatch primitive-general-car-cdr (data-type non-pointer) user-type
  (assign vcell (fetch val))
  (ucall general-car-cdr)
  (assign val (fetch vcell))
  (goto pop-return))


(defdispatch primitive-rplaca (data-type non-pointer) user-type
  (set-left (fetch val) (fetch thargs))
  (goto pop-return))

(defdispatch primitive-rplacd (data-type non-pointer) user-type
  (set-right (fetch val) (fetch thargs))
  (goto pop-return))

(defdispatch primitive-general-rplaca (data-type non-pointer) user-type
  (assign vcell (fetch val))
  (ucall general-car-cdr)
  (set-left (fetch vcell) (fetch thargs))
  (goto pop-return))

(defdispatch primitive-general-rplacd (data-type non-pointer) user-type
  (assign vcell (fetch val))
  (ucall general-car-cdr)
  (set-right (fetch vcell) (fetch thargs))
  (goto pop-return))


;This is the pc at which the low level hardware starts the cons server.
;The main program level pc is saved in cons-server-pc.
;The data to be consed should appear on the sbus on the two cycles
;after we set cons-server-grant.

(defpc cons-server-entry
  (same-cycle (disable-cons-server)
	      (assert (bitvec cons-server-grant sbus)))
  (assign first-argument (read-sbus-data))
  (same-cycle (assign second-argument (read-sbus-data))
	      (ucall-conspc pcons-subroutine))
  (same-cycle (assert (bitvec main-bus sbus))
	      (assert (bitvec signal-operation-done sbus))
	      (put-on-main-bus (fetch first-argument)))
  (same-cycle (enable-cons-server)
	      (return cons-server-pc)))

;CONS the values in FIRST-ARGUMENT and SECOND-ARGUMENT.
;Result goes in FIRST-ARGUMENT.

(defpc pcons-subroutine
  (set-left (fetch free) (fetch first-argument))
  (set-right (fetch free) (fetch second-argument))
  (same-cycle (load-reg first-argument (fetch free))
	      (increment-free (goto pcons-exhausted)
			      (return conspc))))

;NCONS the value in FIRST-ARGUMENT.
;Result goes in FIRST-ARGUMENT.

(defpc pncons-subroutine
  (set-left (fetch free) (fetch first-argument))
  (set-right (fetch free) (make-pointer *nil 0))
  (same-cycle (load-reg first-argument (fetch free))
	      (increment-free (goto pcons-exhausted)
			      (return conspc))))

(defpc pcons-exhausted
  (same-cycle (assert (bitvec set I-need-gc))
	      (return conspc)))

; Implementation of arrays.

(defdispatch primitive-array-cons-immediate (data-type non-pointer) user-type
  (same-cycle (assign vcell (make-pointer fixnum (fetch exp)))
	      (ucall-conspc-return-elsewhere array-cons
					     primitive-array-cons-return)))

(defdispatch primitive-array-cons (data-type non-pointer) user-type
  (same-cycle (assign vcell (fetch val))
	      (ucall-conspc-return-elsewhere array-cons
					     primitive-array-cons-return)))

(defpc primitive-array-cons-return
  (same-cycle (assign val (fetch vcell))
	      (if (array-pointer? (fetch vcell))
		  (goto pop-return)
		  (goto execute-exp))))


(defdispatch primitive-array-ref-immediate (data-type non-pointer) user-type
  (assign compare-reg (make-pointer fixnum (fetch exp)))
  (ucall-return-elsewhere array-ref-subroutine pop-return))

(defdispatch primitive-array-ref (data-type non-pointer) user-type
  (assign compare-reg (fetch thargs))
  (ucall-return-elsewhere array-ref-subroutine pop-return))


(defdispatch primitive-array-set-immediate (data-type non-pointer) user-type
  (same-cycle (disable-cons-server)
	      (assign compare-reg (make-pointer fixnum (fetch exp))))
  (assign second-argument (fetch thargs))
  (ucall-return-elsewhere array-set-subroutine pop-return))

(defdispatch primitive-array-set (data-type non-pointer) user-type
  (same-cycle (disable-cons-server)
	      (assign compare-reg (left (fetch thargs))))
  (assign second-argument (left (right (fetch thargs))))
  (ucall-return-elsewhere array-set-subroutine pop-return))

;Index array in VAL by index in COMPARE-REG.
;Element into VAL.

(defpc array-ref-subroutine
  (if (not (array-pointer? (fetch val))) (goto array-error))
  (if (not (array-index-ok? (left (fetch val)))) (goto index-error))
  (same-cycle (assign val (index-fetch))
	      (enable-cons-server)
	      (return micropc)))

;Index array in VAL by index in COMPARE-REG.
;and store there the value which is in SECOND-ARGUMENT.

(defpc array-set-subroutine
  (if (not (array-pointer? (fetch val))) (goto array-error))
  (if (not (array-index-ok? (left (fetch val)))) (goto index-error))
  (same-cycle (index-store (fetch val))
	      (enable-cons-server)
	      (return micropc)))

;Cons an array of size in VCELL full of object in THARGS.
;Keep the value to be returned in SECOND-ARGUMENT for the while.
;Return address is stored in CONSPC.
;The cons server should be disabled already.
;On return, if we have succeeded, VCELL contains the array.
;Otherwise, VCELL still contains a fixnum and I-need-GC is set.

(defpc array-cons
  (assign second-argument (fetch free))
  (set-left (fetch free) (fetch vcell))
  (goto array-fill))

(defpc array-fill
    (same-cycle
       (if (datum=0? (fetch vcell)) (goto array-fill-end))
       (decrement-vcell))
    (set-right (fetch free) (fetch thargs))
    (same-cycle
       (if (datum=0? (fetch vcell)) (goto array-fill-end))
       (decrement-vcell))
    (increment-free (goto array-fill-exhausted))
    (set-left (fetch free) (fetch thargs))
    (goto array-fill))

;If we don't have space to make the whole array, return NIL
;to let EVAL know it lost.

(defpc array-fill-exhausted
  (same-cycle ;Don't waste the space we tried to use.
	      (load-reg free (fetch second-argument))
	      (assert (bitvec set I-need-gc))
	      (return conspc)))

(defpc array-fill-end
  (same-cycle (assign vcell second-argument)

	      ;;Note: we abort here even if we exactly just made it,
	      ;;but avoiding that is more hair and not worth it.
	      (increment-free (goto array-fill-exhausted) (return conspc))))

;;; arglist construction.

(defdispatch first-argument (data-type list-pointer) user-type
  (cont-call sequence-send)
  (assign thargs (pncons (fetch val)))
  (goto sequence-return))

(defdispatch next-argument (data-type list-pointer) user-type
  (save thargs)
  (cont-call sequence-send)
  (restore thargs)

  ;; Use load-reg to avoid unnecessary conditional-rack-push
  ;; which would never do anything.
  (load-reg thargs (pcons (fetch val) (fetch thargs)))
  (goto sequence-return))

(defdispatch last-argument (data-type list-pointer) user-type
  (same-cycle (save thargs)
	      (cont-call sequence-send))
  (same-cycle (assign exp (fetch cont))
	      (restore thargs))
  (assign cont (pcons (fetch val) (fetch thargs)))	;will save anyway!
  (goto execute-function))

(defdispatch spread-argument (data-type list-pointer) user-type
  (cont-call sequence-send)
  (assign thargs (fetch val))
  (goto execute-function))

(defdispatch spread-partial-argument (data-type list-pointer) user-type
  (cont-call sequence-send)
  (assign thargs (fetch val))
  (goto sequence-return))

;;; procedures, let, sequences, conditionals.

(defdispatch procedure (data-type list-pointer) user-type
  (assign val
	  (make-pointer closure
			(pcons (fetch exp)
			       (fetch env))))
  (goto pop-return))

(defdispatch primitive-let (data-type list-pointer) user-type
  (ucall-return-elsewhere cons-env sequence))

(defpc cons-env
  (assign env (pcons (fetch thargs) (fetch env)))
  (return micropc))

(defdispatch sequence (data-type list-pointer) user-type
  (assign-extra-type cont sequence-return)
  (goto sequence-send))

(defdispatch conditional (data-type list-pointer) user-type
  (if (type=type-val? *nil)
      (goto execute-right-exp)
      (goto execute-left-exp)))

;;; control points.

(defdispatch get-control-point (data-type list-pointer) user-type
  (ucall-return-elsewhere make-control-point sequence))

(defpc make-control-point
	(assign val
		(make-pointer control-point
			      (pcons (get-state cont)
				     (pcons (get-state env)
					    (get-state thargs)))))
	(return micropc))

(defpc restore-control-point
       (set-state cont (left (fetch val)))
       (assign val (right (fetch val)))
       (set-state env (left (fetch val)))
       (set-state thargs (right (fetch val)))
       (return micropc))

;;; various versions of apply.

(defdispatch apply-no-args (data-type list-pointer) user-type
  (assign-extra-type cont internal-apply-no-args)
  (save-after-assign cont (assign cont (make-pointer *nil 0)))
  (goto execute-left-exp))

(defdispatch internal-apply-no-args (data-type list-pointer) extra-type-cont
  (ucall-return-elsewhere unclose execute-procedure))

(defdispatch apply-1-arg (data-type list-pointer) user-type
  (cont-call sequence-send)
  (assign exp (fetch cont))
  (assign cont (fetch val))				;may as well
  (goto execute-function))

(defpc execute-function					;cont has thargs!
  (save-after-assign cont (assign-extra-type cont internal-apply))
  (restore env)
  (goto execute-exp))

(defdispatch internal-apply (data-type list-pointer) extra-type-cont
  (assign thargs (fetch cont))				;undoing confusion
  (goto internal-apply-1))

(defpc internal-apply-1
  (if (type=type-val? closure) (goto closure))
  (if (type=type-val? control-point) (goto control-point)
      (goto unknown-function-type-error)))

(defpc closure
  (ucall unclose)
  (ucall-return-elsewhere cons-env execute-procedure))

(defpc unclose
  (assign env (right (fetch val)))
  (assign exp (left (fetch val)))
  (return micropc))

(defpc control-point
  (assign exp (left (fetch thargs)))
  (goto control-point-1))

(defpc control-point-1
  (ucall restore-control-point)
  (assign val (fetch exp))
  (goto pop-return))

;;; interrupt points

(defpc process-interrupt
       (same-cycle (set-uconstant-flag interrupt-enable 0)
		   (set-uconstant-flag gc-interrupt-enable 0))
       		;These two can be same-cycled because
		;they put the same thing on the uconstant bus.
       (load-reg errcode (make-pointer fixnum 0))
       (goto process-interrupt-0))

(defpc process-interrupt-0
       (save cont)
       (assign-extra-type cont interrupt-restore)
       (save env)
       (save-after-assign env (assign env (fetch val)))	;(save val)
       (save-after-assign env (assign env (fetch exp)))	;(save exp)
       (assign env (fetch errcode))
       (assign compare-reg (make-pointer fixnum 0))	;Index 0 for GC,
       (if (not (bitvec -somebody-needs-gc sbus))
	   (goto process-interrupt-1))
       (increment-compare-reg)			;1 for error,
       (if (bitvec nonzero? errcode)
	   (goto process-interrupt-1))

       ;else read index from external source.
       (assign compare-reg (get-input))
       (goto process-interrupt-1))

(defpc process-interrupt-1
       (assign val (fetch intvector))
       (ucall array-ref-subroutine)		;Re-enables cons server.
       (assign exp (fetch val))
       (ucall make-control-point)
       (ucall reset-racks)
       ;; We can use load-reg instead of assign to save one instruction
       ;; since thargs has just been reset.
       (load-reg thargs (fetch val))
       (assign-extra-type cont done)
       (goto execute-exp))

(defdispatch interrupt-restore (data-type list-pointer) user-type
  (ucall restore-control-point)
  (same-cycle (restore env)			;Discard error code.  Pop exp.
	      (assign exp (fetch env)))		;Note second cycle of restore
						;is just (decrement-count env).
  (same-cycle (restore env)			;Pop the val.
	      (assign val (fetch env)))
  (restore env)					;Pop the original env.
  (restore cont)
  (goto execute-exp))

; Error handlers.

(defpc unbound-val-error
       (assign split-reg (make-pointer fixnum ubv-error-code))
       (goto pclsr-for-error))

(defpc unknown-function-type-error
       (assign split-reg (make-pointer fixnum udf-error-code))
       (goto pclsr-for-error))

(defpc sbus-error
  (if (bitvec nonzero? errcode)
      (goto error-within-error)
      (goto pclsr-for-error)))

(defpc array-error
  (assign split-reg (make-pointer fixnum array-error-code))
  (goto pclsr-for-error))

(defpc index-error
  (assign split-reg (make-pointer fixnum index-error-code))
  (goto pclsr-for-error))

(defpc car-or-cdr-of-atom-error
  (sbus-end-tracsaction)
  (assign split-reg (make-pointer fixnum car-or-cdr-of-atom-error-code))
  (goto pclsr-for-error))

(defpc pclsr-for-error
  (same-cycle
    (load-reg errcode (fetch split-reg))
    (assert (bitvec pclsr-restore)))
;;;??? must fix up the stack-free if stack has been restored upward.
  (pclsr-rack cont)
  (pclsr-rack env)
  (pclsr-rack thargs)
  (goto process-interrupt-0))

;Define the GC machine.

(defmachine allocator newpc-bus nextpc-bus uconstant-bus)

;microcode constants, alternate pcs.
(defbus uconstant-bus allocator-micro-state allocator
  (control-bits (constant-type ((bitvec type main-bus) (bitvec type *me*)))))

;next pc if not branch.
(defbus nextpc-bus allocator-micro-state allocator)

;the next micro-state in.
(defbus newpc-bus allocator-micro-state allocator
  (control-bits (goto-next ((bitvec allocator-nextpc-bus) (bitvec *me*)))
		(goto-alt ((bitvec allocator-uconstant-bus) (bitvec *me*)))))

;for microcode subroutines
(defregister micropc micro-state eval (pc-saver))

(defregister waitpc micro-state allocator		;for busy waiting
  (connects ((bitvec input *me*) (bitvec newpc-bus)))
  (control-bits (wait ((bitvec newpc-bus) (bitvec output *me*)))))

(defregister gc-machine-running bit allocator
  (control-bits (set ((bitvec input *me*) 1))
		(clear ((bitvec input *me*) 0)))
  (status-bits (stopped (vor (bitvec freeze sbus)
			     (vnot (bitvec output *me*))))))

(defregister scan memory-address allocator (incrementer)
  (control-bits (load ((bitvec datum main-bus) (bitvec high-bits input *me*))
		      ((bitvec main-bus-low-address-bit)
		       (bitvec low-bit input *me*)))
		(read ((bitvec datum main-bus) (bitvec high-bits output *me*))
		      ((bitvec low-bit output *me*)
		       (bitvec main-bus-low-address-bit))))
  (status-bits (=bus? (vand (vreduce vand (veqv (bitvec high-bits output *me*)
						(bitvec datum main-bus)))
			    (veqv (bitvec low-bit output *me*)
				  (bitvec main-bus-low-address-bit))))))

;Set up the low address bit, for loading or comparing against SCAN.

(defmicrofun left-address (arg)
  `(same-cycle (put-on-main-bus ,arg)
	       (assert (bitvec left main-bus-low-address-bit))))

(defmicrofun right-address (arg)
  `(same-cycle (put-on-main-bus ,arg)
	       (assert (bitvec right main-bus-low-address-bit))))

;Increment the word-address in SCAN.  Adds one to the low address bit.
(defmicrostatement increment-scan () allocator
  '(assert (bitvec inc scan)))

;Read or write using SCAN as memory address.

(defmicrofun scan-indirect () all
  `(block (sbus-send (assert (bitvec read scan)))
	  (sbus-receive)))

(defmicrostatement set-scan-indirect (new) all
  (let (precompute usevalue)
    (desetq (precompute usevalue) (expand-second-arg new))
    `(block ,precompute
	    (sbus-send (fetch scan))
	    (same-cycle (assert (bitvec signal-write sbus))
			(sbus-send ,usevalue))
	    (sbus-end-transaction))))

(defmicropred type=type-forward? (typename) eval
  '(bitvec =type? forward)
  `(block (load-reg split-reg (constant-type ,typename))
	  (fetch split-reg)))

(defmicropred my-pointer? (pointer) all
  `(bitvec =bus? machine-number)
  `(put-on-main-bus ,pointer))

;;; Handle relocate request from another machine.
;;; When the request comes in, the data is on the sbus
;;; and stays there until we signal done.

(defmicrostatement sbus-return-relocated-pointer (arg) allocator
  `(same-cycle (put-on-main-bus ,arg)
	       (assert (bitvec sbus main-bus))
	       (assert (bitvec signal-operation-done sbus))))

(defmicropred sbus-has-relocate-for-me? () allocator
  `(bitvec relocate-request-to-me sbus))

;;; Send relocate request to another machine.

(defmicrofun relocate (arg) allocator
  `(block (same-cycle (put-on-main-bus ,arg)
		      (assert (bitvec signal-relocate-request sbus))
		      (assert (bitvec sbus main-bus)))
	  (same-cycle (assert (bitvec sbus main-bus))
		      (if (not (bitvec relocate-done-or-lost)) (busy-wait)))))

(defbus relocate-done-or-lost bit allocator
  (connects ((bitvec *me*) (vor (bitvec operation-done sbus)
				(bitvec relocate-request-to-me sbus)))))

;Now we define the control PLA, which takes in
;both branch-condition signals from the microcode PLA
;and the signals to be tested by the conditions,
;and generates the signals controlling branching.
;
;Here we define the outputs.  (The inputs are implicitly defined)
;Each of the outputs aside from uconstant-branch (which implements GOTO)
;has a name which is the same as the microcode expression
;used to ask for that kind of branch.
;This allows the IF construct to be implemented very simply
;and detects errors where an IF arm is not a defined type of branch.

(defpla control allocator
  (outputs (uconstant-branch
	    (busy-wait)
	    (return micropc))))

;Connect the control PLA outputs to the data paths that
;do the actual jumping.  This is probably not the way
;we really want to implement these connections,
;but it says what the logical effect of them is to be.

(defconnect ((bitvec read waitpc) (vor (bitvec (busy-wait) control-pla)
				       (bitvec stopped gc-machine-running)))
	    ((bitvec goto-next newpc-bus)
	     (vnot (vor (bitvec uconstant-branch control-pla)
			(bitvec (return micropc) control-pla)
			(bitvec (busy-wait) control-pla))))
	    ((bitvec goto-alt newpc-bus)
	     (vand (bitvec uconstant-branch control-pla)
		   (vnot (bitvec (busy-wait) control-pla))))
	    ((bitvec read micropc)
	     (vand (bitvec (return micropc) control-pla)
		   (vnot (bitvec (busy-wait) control-pla)))))

;;; Minsky, Fenichel, Yochelson garbage collector, with arrays.

;;; registers are

;;;	Space1-free, Space2-free are pointers to bases of workspaces
;;;	FREE is pointer to first free word in current workspace

;;;	SCAN is address of the first untraced cell in new space
;;;      It is a word address, not a cons-cell address; it has a low bit.
;;;	OLD points at old space object being transported
;;;	FORWARD points at cons being constructed in newspace

;;;	Still need INCREMENT-OLD, DECREMENT-FORWARD

;The register OLD is the same as COMPARE-REG, which can increment.
;NEW is the same as FIRST-ARGUMENT.
;FORWARD is the same as VCELL, because VCELL can decrement.

(defsyn old compare-reg)
(defsyn new first-argument)
(defsyn forward vcell)

(defpc gc-start
       (assign free (fetch space1-free))
       (assign space1-free (fetch space2-free))
       (assign space2-free (fetch free))
       (assign scan (left-address (fetch free)))
       ;; Process the root of all storage,
       ;; left around in VAL by the eval machine.
       (assign old (fetch val))
       (ucall relocate-pointer)
       (assign val (fetch new))
       (goto transport-loop))

(defpc transport-loop
       (if (sbus-has-relocate-for-me?) (goto process-relocate-msg))
       (if (=scan? (left-address (fetch free))) (goto my-scan-finished))
       (assign old (scan-indirect))
       (if (not-pointer? (fetch old)) (goto bump-scan))
       (if (not (my-pointer? (fetch old))) (goto external-relocate))
       (ucall relocate-pointer)
       (set-scan-indirect (fetch new))
       (goto bump-scan))

(defpc bump-scan
       (increment-scan)
       (goto transport-loop))

(defpc my-scan-finished
       (assert (bitvec clear I-need-gc))
       (if (not (bitvec -somebody-needs-gc sbus)) (goto transport-loop))
       (same-cycle (assert (bitvec clear gc-machine-running))
		   (assert (bitvec set eval-machine-running))
		   (goto gc-start)))

(defpc process-relocate-msg
       (assign old (read-sbus-data))
       (ucall relocate-pointer)
       (sbus-return-relocated-pointer (fetch new))
       (goto transport-loop))

(defpc external-relocate
       ;; If this pointer points at a slave machine's register,
       ;; GC should ignore it.
       ;; Such pointers have a machine number field of -1.
       (if (non-GC-pointer? (fetch old)) (goto bump-scan))
       ;; Send out relocate request
       ;; and await either operation-done or  relocate request coing in.
       (same-cycle (assign old (relocate old))

		   ;; If this is not set, we gave up
		   ;; because a relocate request came in.
		   (if (not (bitvec operation-done sbus))
		       (goto process-relocate-msg)))

       (set-scan-indirect (fetch scan) (fetch old))
       (goto bump-scan))

(defpc relocate-pointer				;in old, answer in new
       (assign forward (left (fetch old)))
       (if (type=forward? broken-heart) (goto relocate-broken-heart))
       (assert (bitvec set I-need-gc))
       (set-left (fetch free) (fetch forward))
       (assign new (make-pointer (fetch old) (fetch free)))
       (set-left (fetch old) (make-pointer broken-heart (fetch free)))
       (if (array-pointer? (fetch old))
	   (goto array-copy-loop)		;forward has fixnum user length
	   (goto copy-cdr)))

(defpc relocate-broken-heart
  (assign new (make-pointer (fetch old) (fetch forward)))
  (return micropc))

(defpc copy-cdr
  (set-right (fetch free) (right (fetch old)))
  (increment-free)
  (return micropc))

(defpc array-copy-loop				;forward has fixnum user length
  (if (datum=0? (fetch forward)) (return micropc))
  (set-right (fetch free) (right (fetch old)))
  (increment-old)
  (increment-free)
  (decrement-forward)
  (if (datum=0? (fetch forward)) (return micropc))
  (set-left (fetch free) (left (fetch old)))
  (decrement-forward)
  (goto array-copy-loop))
