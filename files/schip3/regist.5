;;;; interbus connector


;;; conditionally gates value bus to cross bus
;;; and computes bus position from global position

(defconstraint cross-bus-position (position start bus-size connection-position
					    connection-desired?)
  (connection-position (start bus-size position)
		   (if (and ( position start)
			    (< position (+ start bus-size)))
		       (- position start)
		       0))
  (connection-desired? (start bus-size position)
	   (and ( position start) (< position (+ start bus-size)))))

