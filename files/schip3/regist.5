;;;; basic cells

(defmacro defbiglayout (name params &body body)
  `(deflayout ,name  ,params
     ,@(loop with rest-body = body
	     for expr-list = (loop repeat 30.
				   for left on rest-body
				   collect (first left)
				   finally (setq rest-body left))
	     until (null expr-list)
	     collect `(let ((foo #'(lambda () ,@ expr-list)))
			(funcall foo)))))
(deflayout matrix
   `((primary-parameters
       ((vdd-stretch 0.) (gnd-stretch 0.) (width 58.) (continue-value? nil))))
