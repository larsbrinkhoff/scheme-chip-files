;;; a cell for jumping a bus over a power line.  The jumper is on poly.
;;; bus-space should be set to the width of the power line being jumped.
;;; bus-connection is where the bus is touched
;;; output-connection is where to route a connecting signal to


(deflayout power-jumper
   `((primary-parameters 
       ((bus-space 0.) (left-stretch 0) (layer 'poly)
	(bridge-width 2)
	(left-cut? t) (right-cut? t) (bridge? t)))
     (auxiliary-parameters (bus-space-left bus-space-right (xfrm 'identity)))
     (constraints ((horizontal-stretch bus-space-left bus-space-right bus-space xfrm))))
    (part 'left-connector rectangle
	  (bottom-left (pt 1. -1.)) (top-right (pt 2. 3.)) (layer 'metal))
    (conditional-part (>> left-cut?)
       'left-cut square-contact (layer (>> layer)) (bottom-left (pt 2. -1.)))
    (conditional-part (>> bridge?)
      'pass-by rectangle (width 6) (length (>> bridge-width))
      (center-left (>> center-right left-cut)) (layer (>> layer)))
    (conditional-part (>> right-cut?)
       'right-cut square-contact (layer (>> layer)) (bottom-left (pt 12. -1.)))
    (setq-my bus-connection (pt 1 1.5))
    (setq-my output-connection (pt 16. 1.))
    (fracture bus-space vertical (pt 9. 2.))
    (setq-my bus-space-left (pt 9. 2.))
    (fracture left-stretch vertical (>> (*pt-to-right* 1) bottom-left left-connector)))



