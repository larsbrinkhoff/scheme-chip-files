;;; -*- Mode: Lisp; Base: 10.; package:dpl; -*-

(defreplicator diagonal (i)
  '((primary-parameters (h-pitch v-pitch)))
  (replicator-instance (>> (*rep-instance 0)))
  (replicator-transform 'identity (* i (>> h-pitch)) (* i (>> v-pitch))))

(defconst uarg-word-size 6)
(defconst uarg-stack-depth 3)

(defun make-a-uarg-description (stack-depth word-size name read-args write-args
				&aux associates)
  (if read-args
      (push `(read-output gated-output-bits (size ,word-size)
			  (starting-position 0) (bus-size ,word-size))
	    associates))
  (if write-args
      (push `(write-output gated-output-bits (size ,word-size)
			   (starting-position 0) (bus-size ,word-size))
	    associates))
  (setq associates (nreverse associates))
  `(,name normal-register (size ,word-size) (starting-position 0)
    (associates
      (explicit undriven-literal (size ,word-size)
		(starting-position 0) (bus-size ,word-size))
      ,@associates
      ,@(do ((i 0 (1+ i))
	     (ans nil))
	    ((= i (1- stack-depth)) (nreverse ans))
	  (push `(,(smash 'stack i) stack
		  (size ,word-size) (starting-position 0))
		ans)))))


(deflayout uarg-system
	   `((primary-parameters ((stack-depth ,uarg-stack-depth)  (word-size ,uarg-word-size)
				  (power-bus-size 6) (left-power? t)
				  (left-jumpers? t) (right-jumpers? t))))
  (part 'data-path register-file
	(description
	  (list (make-a-uarg-description (>> stack-depth) (>> word-size) 'arg-1 t nil)
		(make-a-uarg-description (>> stack-depth) (>> word-size) 'arg-2 t nil)
		(make-a-uarg-description (>> stack-depth) (>> word-size) 'target nil t)))
	(power-bus-size (>> power-bus-size))
	(left-jumpers? (>> left-jumpers?))
	(right-jumpers? (>> right-jumpers?))
	(left-power? (>> left-power?)))
  (let ((right (- (>> apparent-left right-power-bus data-path)
		  *metal-to-metal* 3))
	(a1-ex-right (>> apparent-right (*reg-cell 5 explicit arg-1) data-path))
	(a2-ex-right (>> apparent-right (*reg-cell 5 explicit arg-2) data-path))
	(tg-ex-right (>> apparent-right (*reg-cell 5 explicit target) data-path)))
    (replicate 'arg-1-explicit column (list (>> word-size))
	       (list (part () rectangle (layer 'metal) (length 4)
			   (width (- a1-ex-right right))))
	       (top-right
		 (pt right (- (>> apparent-bottom cells data-path) *metal-to-metal*)))
	       (v-pitch 7))
    (wire-literal-bus '(explicit arg-1) 'cross-bus (>> word-size)
		      (>> data-path) (>> arg-1-explicit))
    (replicate 'arg-2-explicit column (list (>> word-size))
	       (list (part () rectangle (layer 'metal) (length 4)
			   (width (- a2-ex-right right))))
	       (top-right (>> (*pt-below* *metal-to-metal*)
			      apparent-bottom-right arg-1-explicit))
	       (v-pitch 7))
    (wire-literal-bus '(explicit arg-2) 'cross-bus (>> word-size)
		      (>> data-path) (>> arg-2-explicit))
    (replicate 'target-explicit column (list (>> word-size))
	       (list (part () rectangle (layer 'metal) (length 4)
			   (width (- tg-ex-right right))))
	       (top-right (>> (*pt-below* *metal-to-metal*)
			      apparent-bottom-right arg-2-explicit))
	       (v-pitch 7))
    (wire-literal-bus '(explicit target) 'cross-bus (>> word-size)
		      (>> data-path) (>> target-explicit))
    ;;; I want these spaces to be 10 (as they were before)
    ;;; The routing is really screwed otherwise -- JB
    (replicate 'read-bus column (list (>> word-size))
	       (list (part () rectangle (layer 'metal) (length 4)
			   (width (- a1-ex-right right))))
	       (top-right (>> (*pt-below* 10)
			      apparent-bottom-right target-explicit))
	       (v-pitch 7))
    (replicate 'write-bus column (list (>> word-size))
	       (list (part () rectangle (layer 'metal) (length 4)
			   (width (- a1-ex-right right))))
	       (top-right (>> (*pt-below* 10)
			      apparent-bottom-right read-bus))
	       (v-pitch 7))
    (wire-literal-bus '(read-output arg-1) 'cross-bus (>> word-size)
		      (>> data-path) (>> read-bus))
    (wire-literal-bus '(read-output arg-2) 'cross-bus (>> word-size)
		      (>> data-path) (>> read-bus) 'no-jog)
    (wire-literal-bus '(write-output target) 'cross-bus (>> word-size)
		      (>> data-path) (>> write-bus))))


(defun wire-literal-bus (column-path replicator-name word-size data-path horizontal-bus
			 &optional (no-jog? nil)
			 &aux the-rep reps-h-pitch)
  (setq the-rep (the replicator-name
		     (the (eval `(*reg-cell ,(1- word-size) ,@column-path)) data-path))
	reps-h-pitch (the 'h-pitch the-rep))
  (do ((i 0 (1+ i))
       (x (>> x center *rep-first . the-rep) (+ x reps-h-pitch))
       (bottom (the 'apparent-bottom the-rep))
       (right (the 'apparent-left horizontal-bus)))
      ((= i word-size))
    (wire () (run-layer 'poly)
	  (from (pt x bottom))
	  (to-y (the 'center (the (*rep i) horizontal-bus)))
	  (drop-contact)
	  (run-layer 'metal)
	  (if (null no-jog?) (to-x right)))))
