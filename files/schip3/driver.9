;;;; drivers

(deflayout basic-inverting-sb
  `((primary-parameters 
      ((power-bus-needed t) (power-bus-size 4.) (driver-scaling 1.0)
       (pass-second-input? nil) (pass-second-output? nil)))
    (auxiliary-parameters
      ((xfrm 'identity) vdd-stretch gnd-stretch pulldown-stretch pullup-stretch
       pullup-size pulldown-size))
    (constraints 
      ((c+ pullup-size 2 pullup-stretch)
       (c* pullup-size driver-scaling 2)
       (c+ pulldown-size 8 pulldown-stretch)
       (c* pulldown-size driver-scaling 8)
       (c* pulldown-size 4 pullup-size)
       (c+ power-bus-size vdd-stretch 4)
       (c+ power-bus-size gnd-stretch 4))))
  (part 'vdd-connect rectangle (width 2.0) (length 24.0) (bottom-left (pt -5.0 4.0)) 
    (layer 'diff))
  (part 'gnd-connect rectangle (width 2.0) (length 26.0) (bottom-left (pt 9.0 -17.0)) 
    (layer 'diff))
  (part nil square-contact (layer 'diff) (bottom-left (pt -6. 28.)))
  (part nil rectangle (top-right (pt 5. 6.)) (bottom-left (pt -3. 4.)) (layer 'diff))
  (part nil rectangle (top-right (pt 5. 11.)) (bottom-left (pt -3. 9.)) (layer 'diff))
  (part nil rectangle (top-right (pt 1. 13.)) (length 6.0) (width 2.0) (layer 'poly))
  (part nil rectangle (layer 'ion) (bottom-left (pt -4.0 2.0)) (length 11.0) (width 8.0))
  (part nil rectangle (bottom-left (pt 5.0 2.0)) (length 4.0) (width 4.0) (layer 'diff))
  (part nil rectangle (top-right (pt 8. 19.)) (bottom-left (pt 6. -6.)) (layer 'poly))
  (part nil rectangle (top-right (pt 11. 17.)) (bottom-left (pt 4. 9.)) (layer 'diff))
  (conditional-part
    (>> power-bus-needed) 
     'vdd rectangle (width 18.0) (length 4.0) (bottom-left (pt -6.0 28.0)) (layer 'metal))
  (conditional-part
    (>> power-bus-needed) 
     'gnd rectangle (width 18.0) (length 4.0) (bottom-left (pt -6.0 -17.0)) (layer 'metal))
  (part nil square-contact (layer 'diff) (bottom-left (pt 8. -17.)))
  (part 'input rectangle (width 2.0) (length 13.0) (top-right (pt 7. -4.)) (layer 'poly))
  (part 'value-out rectangle (width 2.0) (length 21.0) (bottom-left (pt 1.0 14.0)) 
    (layer 'diff))
  (conditional-part
    (or (>> pass-second-output?) (>> pass-second-input?)) 
     nil square-contact (layer (if (>> pass-second-output?) (quote diff) (quote poly))) 
    (bottom-left (pt -1. -10.)))
  (conditional-part
    (or (>> pass-second-output?) (>> pass-second-input?)) 
     'secondary-input rectangle (top-right (pt 3. -10.)) (bottom-left (pt 1. -17.)) 
    (layer (if (>> pass-second-output?) (quote diff) (quote poly))))
  (conditional-part
    (or (>> pass-second-output?) (>> pass-second-input?)) 
     nil rectangle (top-right (pt 8. -6.)) (bottom-left (pt 3. -10.)) (layer 'metal))
  (conditional-part
    (or (>> pass-second-output?) (>> pass-second-input?)) 
     nil rectangle (top-right (pt 8. 21.)) (bottom-left (pt 5. -6.)) (layer 'metal))
  (conditional-part
    (or (>> pass-second-output?) (>> pass-second-input?)) 
     nil square-contact (layer 'poly) (bottom-left (pt 4. 21.)))
  (part nil rectangle (top-right (pt 4. 17.)) (bottom-left (pt 2. 14.)) (layer 'diff))
  (conditional-part
    (or (>> pass-second-output?) (>> pass-second-input?)) 
     'sneak-chain-out rectangle (bottom-left (pt (if (>> pass-second-output?) 6.0 5.0) 25.0))
     (length 10.0) (width 2.0) (layer 'poly))
  (part nil buried-contact (bottom-left (pt 3. -2.)) (xfrm 'negx))
  (part nil rectangle (bottom-left (pt -2. 2.)) (top-right (pt 2. 8.)) (layer 'poly))
  (part nil rectangle (bottom-left (pt 3. -1.)) (top-right (pt 5. 4.)) (layer 'diff))
  (fracture gnd-stretch horizontal (pt -2. -14.))
  (fracture pullup-stretch horizontal (pt 1. 10.))
  (fracture pulldown-stretch horizontal (pt 2. 13.))
  (fracture vdd-stretch horizontal (pt -3. 29.)))




(deflayout inv-sb-driver-pair
  `((primary-parameters ((power-bus-size 4.) (driver-scaling 1.) (power-bus-needed nil))))
  (part 'driver-1 basic-inverting-sb (driver-scaling (>> driver-scaling)) 
    (pass-second-input? t) (power-bus-needed nil) (power-bus-size (>> power-bus-size)) 
    (bottom-left (pt -6. -17.)))
  (conditional-part
    (>> power-bus-needed) 
     'vdd-1 rectangle (width (>> xdim vdd driver-1)) (length (>> ydim vdd driver-1)) 
    (bottom-left (>> bottom-left vdd driver-1)) (layer 'metal))
  (conditional-part
    (>> power-bus-needed) 
     'gnd-1 rectangle (width (>> xdim gnd driver-1)) (length (>> ydim gnd driver-1)) 
    (bottom-left (>> bottom-left gnd driver-1)) (layer 'metal))
  (part 'driver-2 basic-inverting-sb (driver-scaling (>> driver-scaling)) 
    (pass-second-output? t) (power-bus-needed nil) (power-bus-size (>> power-bus-size)) 
    (bottom-left (>> top-left driver-1)))
  (conditional-part
    (>> power-bus-needed) 
     'vdd-2 rectangle (width (>> xdim vdd driver-2)) (length (>> ydim vdd driver-2)) 
    (bottom-left (>> bottom-left vdd driver-2)) (layer 'metal))
  (conditional-part
    (>> power-bus-needed) 
     'gnd-2 rectangle (width (>> xdim gnd driver-2)) (length (>> ydim gnd driver-2)) 
    (bottom-left (>> bottom-left gnd driver-2)) (layer 'metal))
  (part 'connection-2 rectangle (width 2.) (length 6.) 
    (bottom-left (>> apparent-top-left sneak-chain-out driver-2)) (layer 'poly))
  (part 'connection-1 head-on-buried-contact 
    (apparent-bottom-left (>> (*pt-offset* -1. 1.) apparent-top-left value-out driver-2)) 
    (xfrm 'int-neg))
  (part nil rectangle (bottom-left (>> top-left value-out driver-2)) (length 3.0) (width 2.0)
     (layer 'diff)))

(deflayout inv-sb-driver-dummy-pair
  `((primary-parameters ((power-bus-size 4.) (driver-scaling 1.) (power-bus-needed nil))))
  (invoke 'driver-1 basic-inverting-sb (driver-scaling (>> driver-scaling))
	(power-bus-needed nil) (power-bus-size (>> power-bus-size))
	(pass-second-input? nil) (pass-second-output? nil))
  (conditional-part (>> power-bus-needed)
        'vdd-1 rectangle (layer 'metal) (width (>> xdim vdd driver-1))
	(length (>> ydim vdd driver-1)) (bottom-left (>> bottom-left vdd driver-1)))
  (conditional-part (>> power-bus-needed)
        'gnd-1 rectangle (layer 'metal) (width (>> xdim gnd driver-1))
	(length (>> ydim gnd driver-1)) (bottom-left (>> bottom-left gnd driver-1)))
  (part 'driver-2 basic-inverting-sb (driver-scaling (>> driver-scaling))
	(power-bus-size (>> power-bus-size))  (power-bus-needed nil)
	(pass-second-output? nil) (bottom-left (>> top-left driver-1)))
  (conditional-part (>> power-bus-needed)
        'vdd-2 rectangle (layer 'metal) (width (>> xdim vdd driver-2))
	(length (>> ydim vdd driver-2))
	(bottom-left (>> bottom-left vdd driver-2)))
  (conditional-part (>> power-bus-needed)
        'gnd-2 rectangle (layer 'metal) (width (>> xdim gnd driver-2))
	(length (>> ydim gnd driver-2))
	(bottom-left (>> bottom-left gnd driver-2)))
  (part 'connection-1 head-on-buried-contact 
    (apparent-bottom-left (>> (*pt-offset* -1. 1.) apparent-top-left value-out driver-2)) 
    (xfrm 'int-neg))
  (part nil rectangle (bottom-left (>> top-left value-out driver-2)) (length 3.0) (width 2.0)
     (layer 'diff))
  (part 'input rectangle (layer 'poly) (width *min-poly-size*)
	(top-left (>> apparent-bottom-left input driver-2))
	(length (>> ydim driver-1))))



