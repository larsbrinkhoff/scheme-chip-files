;;;; a driver for driving an input literal

;;; number is the number of literal bits driven.

(defconstraint special-odd-termination (actual-number dims)
  (dims (actual-number) (list (// (1+ actual-number) 2.) 1)))

(defreplicator special-terminating-flipping-row (i)
  '((primary-parameters 
      (h-even-pitch h-odd-pitch actual-number
       h-even-spacing h-odd-spacing
       h-flipping-pitch href (row-like-fracturable? t)))
    (constraints
      ((h-even-pitch instance-list h-even-pitch h-even-spacing)
       (special-odd-termination actual-number max-dims)
       (h-odd-pitch instance-list h-odd-pitch h-odd-spacing)
       (h-even-spacing instance-list h-even-spacing)	
       (h-odd-spacing instance-list h-odd-spacing)
       (c-sum h-flipping-pitch h-even-pitch h-odd-pitch)
       (href instance-list href)))
    (bbox-function corners-bounding-box))
  (let ((odd? (oddp i)))
    (replicator-instance (if (and (oddp (>> actual-number))
				  (= i (1- (car (>> max-dims)))))
			     (>> (*rep-instance 1))
			     (>> (*rep-instance 0))))
    (replicator-transform (if odd? 'negx 'identity)
			  (+ (* (// i 2) (>> h-flipping-pitch))
			     (if odd?
				 (+ (>> h-odd-spacing)
				    (>> href))
				 0))
			  0)))



(deflayout literal-driver
  `((primary-parameters 
      ((power-bus-size 4.) (driver-scaling 1.) (lower-power-bus-size 4)
       (right-stretch 0.) (left-stretch 0.) (number 4))))
  (replicate 'driver-row special-terminating-flipping-row
	     (list (fix (// (1+ (>> number)) 2)))
    (list (part nil two-input-driver (power-bus-size (>> power-bus-size))
		(driver-scaling (>> driver-scaling)) (last-rep? nil)
		(lower-power-bus-size (>> lower-power-bus-size)))
	  (part nil two-input-driver (power-bus-size (>> power-bus-size))
		(driver-scaling (>> driver-scaling)) (last-rep? t)
		(lower-power-bus-size (>> lower-power-bus-size))))
    (actual-number (>> number)) (h-even-spacing -6.) (h-odd-spacing -8.))
  (let ((left-extreme (>> apparent-left))
	(right-extreme (>> apparent-right))
	(typical-guy (>> (*rep 0) driver-row)))
    (dotimes (i 5)
      (let ((vdd-name (smash 'vdd (1+ i))) (gnd-name (smash 'gnd (1+ i))))
	(part* vdd-name 'rectangle (layer 'metal)
	       (top-left (pt (- left-extreme (>> left-stretch))
			     (the 'top (the vdd-name typical-guy))))
	       (bottom-right (pt (+ right-extreme (>> right-stretch))
				 (the 'bottom (the vdd-name typical-guy)))))
	(part* gnd-name 'rectangle (layer 'metal)
	       (top-left (pt (- left-extreme (>> left-stretch))
			     (the 'top (the gnd-name typical-guy))))
	       (bottom-right (pt (+ right-extreme (>> right-stretch))
				 (the 'bottom (the gnd-name typical-guy)))))))
    (part 'phi-1 rectangle (layer 'metal)
	  (top-left (pt (- left-extreme (>> left-stretch))
			(the 'top (the 'phi-1 typical-guy))))
	  (bottom-right (pt (+ right-extreme (>> right-stretch))
			    (the 'bottom (the 'phi-1 typical-guy)))))
    (part 'phi-2 rectangle (layer 'metal)
	  (top-left (pt (- left-extreme (>> left-stretch))
			(the 'top (the 'phi-2 typical-guy))))
	  (bottom-right (pt (+ right-extreme (>> right-stretch))
			    (the 'bottom (the 'phi-2 typical-guy)))))
    (part 'freeze-bar rectangle (layer 'metal)
	  (top-left (pt (- left-extreme (>> left-stretch))
			(the 'top (the 'freeze-bar typical-guy))))
	  (bottom-right (pt (+ right-extreme (>> right-stretch))
			    (the 'bottom (the 'freeze-bar typical-guy)))))))



  
