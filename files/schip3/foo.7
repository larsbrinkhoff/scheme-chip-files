(setq exceptions '(return))

(defun chase1 ()
  (mapc '(lambda (pc)
	   (mapc '(lambda (stmt)
		    (if (and (> (length (get stmt 'right-neighbors)) 1)
			     (not (eq (ctype stmt) 'predicate))
			     (not (memq (get stmt 'statement-type) exceptions)))
			(break chase)))
		 (get pc 'primitive-operations)))
	*pc-list*))

(defun chase2 ()
  (mapc '(lambda (pc)
	   (mapc '(lambda (stmt)
		    (if (or (> (length (get stmt 'consequent)) 1)
			    (> (length (get stmt 'alternative)) 1))
			(break chase)))
		 (get pc 'primitive-operations)))
	*pc-list*))