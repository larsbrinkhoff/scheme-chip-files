(DEF-CODE-STATE G0886
    ((ENTRY-POINT G0060-PC)
     (HAS-UARG? T)
     (SELECTOR 0)
     (BODY 0)
     (STATE-CODE 0)
     )
  ((NOOP) EXPLICIT-READ-UARG)
  (EXPLICIT READ-SOURCE)
  ((CDR-BIT THARGS-STACK MAIN-REGISTERS) EXPLICIT-LOAD-UARG)
  ((WORD THARGS-STACK MAIN-REGISTERS) ARG1-DATA)
  ((THARGS MAIN-REGISTERS) ARG2-DATA)
  ((WORD THARGS-STACK MAIN-REGISTERS) TARGET-DATA)
  ((READ-GLOBAL ZERO CDR-BIT MAIN-REGISTERS)
   NON-UARG-REGISTER-OPERATIONS)
  ((OR (SENSE CDR-BIT THARGS-STACK DATA-SENSES)) PREDICATE-SELECT)
  (((ALL-OPS (PUSH-ARG-STACK PC-STACK NEXT-STATE-MACHINE)
             (READ TRUE-EXPLICIT-NS NEXT-STATE-MACHINE))
    (READ FALSE-EXPLICIT-NS NEXT-STATE-MACHINE)
    (ALL-OPS (LOAD UARG-DATA PUSH-SOURCE TARGET-STACK UARG-STACKS)
             (LOAD-LOCAL ARG2-STACK UARG-STACKS)
             (LOAD UARG-DATA PUSH-SOURCE ARG2-STACK UARG-STACKS)
             (LOAD UARG-DATA PUSH-SOURCE ARG1-STACK UARG-STACKS)
             (PUSH-ARG-STACK ARG2-STACK UARG-STACKS)
             (PUSH-ARG-STACK ARG1-STACK UARG-STACKS)
             (LOAD-LOCAL ARG1-STACK UARG-STACKS)
             (LOAD-LOCAL TARGET-STACK UARG-STACKS)
             (PUSH-ARG-STACK TARGET-STACK UARG-STACKS))
    NIL)
   OP-DECODER)
  (G0592 TRUE-EXPLICIT-NS)
  (G0348 PC-EXPLICIT-NS)
  (G0884 FALSE-EXPLICIT-NS)
  (EXPLICIT LOAD-SOURCE))

