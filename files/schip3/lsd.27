;;; -*- package: DPL; mode: LISP -*-

(defcell lsd-shift-cell
	 ((top-input? t))
  (partq input-bc head-on-buried-contact
	 (xfrm 'negx))
  (partq clock-trans pass-transistor
	 (channel-width 4) (channel-length 2)
	 (xfrm 'rot90)
	 (apparent-center-right (>> apparent-center-left input-bc)))
  (partq pu side-winder-buried-contact-pullup
	 (channel-length 8) (channel-width 2)
	 (apparent-bottom-left
	   (pt-offset
	     (>> apparent-top-right clock-trans) 1 9)))
  (partq pu-cont square-contact (layer 'diff)
	 (apparent-bottom-center
	   (pt-below (>> apparent-top-center drain-diffusion transistor pu) 1)))
  (partq pd pass-transistor (channel-length 2) (channel-width 4)
	 (xfrm 'rot90))
  (align (>> pd)
	 (>> apparent-top-center pd)
	 (pt-offset (>> apparent-bottom-right input-bc) -1 -1))
  (partq pd-gate-extend rectangle (layer 'poly)
	 (length 1) (width 2)
	 (bottom-center (>> apparent-top-center gate-poly pd)))
  (wireq inverter-connect (run-layer 'diff)
	 (from (pt-to-right(>> apparent-bottom-right source-diffusion pd) 1))
	 (to-y (+ (>> apparent-top input-bc) 3))
	 (jog-x (>> apparent-bottom-center source-extension pu)))
  (if (>> top-input?)
      (wireq top-input-wire (run-layer 'diff)
	     (from (pt-to-left
		     (>> apparent-bottom-right source-diffusion clock-trans) 0))
	     (+y 12)
	     (-x 3)
	     (+y 10)
	     (+x 2)
	     (to-y (>> top pu-cont))))
  (wireq clock-wire (run-layer 'poly)
	 (from (>> apparent-bottom-center gate-poly clock-trans))
	 (to-y (>> apparent-bottom pd)))
  (setq-my clock-pt (>> end-pt clock-wire))
  (if (>> top-input?)
      (setq-my top-input-out-pt (>> start-pt inverter-connect))))

(defcell lsd-bit ()
  (partq cell1 lsd-shift-cell (top-input? t)
	 (xfrm 'negy))
  (partq cell2 lsd-shift-cell (top-input? nil)
	 (center-left (pt-to-left (>> center-right cell1) 1))
	 (xfrm 'negy))
  (partq cell-1-out-cont head-on-buried-contact
	 (xfrm 'rot270)
	 (apparent-bottom-center
	   (pt (- (>> x top-input-out-pt cell1) 1)
	       (+ (>> bottom cell1) 3))))
  (partq out-cont-connect rectangle (layer 'diff)
	 (length 5) (width 2)
	 (top-center (>> apparent-bottom-center cell-1-out-cont)))
  (partq sb-cell inv-sb-cell
	 (xfrm 'negx))
  (align-x (>> sb-cell)
	   (>> apparent-left sb-cell)
	   (-  (>> apparent-left pd cell1) 1))
  (align-y (>> sb-cell)
	   (>> apparent-bottom sb-cell)
	   (+ (>> apparent-top cell-1-out-cont) 2))
  (partq sb-vdd-contact square-contact (layer 'diff)
	 (bottom-right (pt-below (>> apparent-top-right vdd-connect sb-cell) 2)))
  (partq input-connect rectangle (layer 'poly)
	 (length 7) (width 2)
	 (top-center (>> apparent-bottom-center gate-poly ef1 sb-cell)))
  (wireq cell1-gnd (run-layer 'diff)
	 (from (>> apparent-bottom-left drain-diffusion pd cell1))
	 (to-y (+ (>> apparent-top sb-cell) 3))
	 (drop-contact))
  (wireq cell2-gnd (run-layer 'diff)
	 (from (>> apparent-bottom-left drain-diffusion pd cell2))
	 (to-y (+ (>> apparent-top cell2) 2))
	 (to-x (+ (>> apparent-right sb-cell) *diff-to-diff* 2))
	 (to-y (>> end-pt cell1-gnd))
	 (+x 1)
	 (drop-contact))
  (wireq cell1-clock (run-layer 'poly)
	 (from (>> clock-pt cell1))
	 (to-y (>> top cell1-gnd)))
  (wireq cell2-clock (run-layer 'poly)
	 (from (>> clock-pt cell2))
	 (flash nil)
	 (+x 1)
	 (+y 5)
	 (to-x (+ (>> apparent-right sb-cell) *poly-to-diff* 1))
	 (to-y (>> top cell1-gnd)))
  (wireq sb-output (run-layer 'diff)
	 (from (>> output-pt sb-cell))
	 (to-y (>> top cell1-gnd)))
  (partq output-bc head-on-buried-contact (xfrm 'rot270)
	 (apparent-bottom-center (>> end-pt sb-output)))
  (partq input-trans rect-e-fet (channel-width 4)
	 (top-center (>> end-pt top-input-wire cell1)))
  (partq input-bc head-on-buried-contact (xfrm 'rot90)
	 (apparent-top-center (>> bottom-center input-trans)))
  (setq-my input-pt (>> apparent-bottom-center input-bc))
  (setq-my c1-pt (>> end-pt cell1-clock))
  (setq-my c2-pt (>> end-pt cell2-clock))
  (setq-my output-pt (>> apparent-top-center output-bc)))

(defcell last-lsd-bit ()
  (partq bit lsd-bit)
  (partq control-pass rect-e-fet (channel-width 4)
	 (xfrm 'rot90)
	 (apparent-top-center
	   (pt-offset (>> apparent-bottom-center clock-trans cell2 bit)
		      -2 -3)))
  (wireq control-pass-wire (from (>> apparent-bottom-center gate-poly control-pass))
	 (run-layer 'poly)
	 (-y 1)
	 (to-x (+ (>> apparent-right pu cell1 bit) 3))
	 (jog-y (>> apparent-center-right input-trans bit)))
  (wireq control-pass-input (run-layer 'diff)
	 (from (pt-below (>> apparent-top-right source-diffusion control-pass) 1))
	 (+x 2)
	 (to-y (>> apparent-top input-bc cell2 bit))))

(defcell lsd ((nbits 4))
  (replicateq row row (list (>> nbits)) (list (part () lsd-bit))
	      (h-spacing -1))
  (group last-lsd
    (setq-my bit (>> *rep-last row))
    (partq control-pass rect-e-fet (channel-width 4)
	   (xfrm 'rot90)
	   (apparent-top-center
	     (pt-offset (>> apparent-bottom-center clock-trans cell2 bit)
			-2 -3)))
    (wireq control-pass-wire
	   (from (>> apparent-bottom-center gate-poly control-pass))
	   (run-layer 'poly)
	   (-y 1)
	   (to-x (+ (>> apparent-right pu cell1 bit) 3))
	   (jog-y (>> apparent-center-right input-trans bit)))
    (wireq control-pass-input (run-layer 'diff)
	   (from (pt-below (>> apparent-top-right source-diffusion control-pass) 1))
	   (+x 2)
	   (to-y (>> apparent-top input-bc cell2 bit)))))