;;; -*- mode: LISP -*-

;;; Scheme-81 circuit definitions

;;; assume d-fet, e-fet has source, drain, gate.
;;; the following nodes are available globally.

;;; "Global" nodes:
(node '*zero*)
(node '*one*)
(node '*phi1*)
(node '*phi2*)
(node '*internal-freeze*)
(node '*load&freeze*)

(defckt pullup ()
  (node 'source)
  (element 'd (>> d-fet))
  (== (>> *one*) (>> drain d))
  (== (>> source) (>> source d))
  (== (>> source) (>> gate d)))

(defckt pulldown ()
  (node 'gate)
  (node 'drain)
  (element 'e (>> e-fet))
  (== (>> *zero*) (>> source e))
  (== (>> drain) (>> drain e))
  (== (>> gate) (>> gate e)))

(defckt inverter ()
  (node 'input)
  (node 'output)
  (element 'pu (>> pullup))
  (element 'pd (>> pulldown))
  (== (>> input) (>> gate pd))
  (== (>> output) (>> drain pd))
  (== (>> output) (>> source pu)))

(defckt pass-gate (field)
  (element 'b (make-bunch (>> field)))
  (do ((i 0 (1+ i))) ((= i (width-of-field (>> field))))
    (assign-to-bunch (element nil (>> e-fet)) (>> b) i)))

(defckt nand-gate ()
  (node 'input-1)
  (node 'input-2)
  (node 'output)
  (element 'pu (>> pullup))
  (element 'p1 (>> e-fet))
  (element 'p2 (>> e-fet))
  (== (>> source pu) (>> drain p1))
  (== (>> source p1) (>> drain p2))
  (== (>> source p2) (>> *zero*))
  (== (>> input-1) (>> gate p1))
  (== (>> input-2) (>> gate p2))
  (== (>> output) (>> source pu)))

(defckt and-gate ()
  (node 'input-1)
  (node 'input-2)
  (node 'output)
  (element 'nand (>> nand-gate))
  (== (>> input-1) (>> input-1 nand))
  (== (>> input-2) (>> input-2 nand))
  (element 'iv (>> inverter))
  (== (>> output nand) (>> input iv))
  (== (>> output iv) (>> output)))

(defckt nor-gate ()
  (node 'input-1)
  (node 'input-2)
  (node 'output)
  (element 'pu (>> pullup))
  (element 'p1 (>> e-fet))
  (element 'p2 (>> e-fet))
  (== (>> source pu) (>> drain p1))
  (== (>> source pu) (>> drain p2))
  (== (>> source p1) (>> *zero*))
  (== (>> source p2) (>> *zero*))
  (== (>> input-1) (>> gate p1))
  (== (>> input-2) (>> gate p2))
  (== (>> output) (>> source pu)))

(defckt or-gate ()
  (node 'input-1)
  (node 'input-2)
  (node 'output)
  (element 'nor (>> nor-gate))
  (== (>> input-1) (>> input-2 nor))
  (== (>> input-2) (>> input-2 nor))
  (element 'iv (>> inverter))
  (== (>> output nor) (>> input iv))
  (== (>> output iv) (>> output)))

;;; mem-done latch
(defckt phi-latch ()
  (node 'clock)
  (node 'input)
  (node 'output)
  (element 'nand (>> nand-gate))
  (== (>> input-1 nand) (>> input))
  (== (>> input-2 nand) (>> clock))
  (element 'iv (>> inverter))
  (element 'pass (>> e-fet))
  (== (>> output nand) (>> source pass))
  (== (>> gate pass) (>> clock))
  (== (>> drain pass) (>> input iv))
  (== (>> output iv) (>> output)))


;;; These are mostly fantasy: they depend on the real cells used in the
;;; data-path generator. The field definitions above specify how
;;; the register cells most look from the outside.
  
(defckt regcell ()
  (node 'phi1-hold)
  (node 'input)
  (node 'output)
  (element 'in1 (>> inverter))
  (element 'in2 (>> inverter))
  (element 'phi2-gate (>> e-fet))
  (element 'phi1-hold-gate (>> e-fet))
  (== (>> output in1) (>> source phi2-gate))
  (== (>> input in2) (>> drain phi2-gate))
  (== (>> *phi2*) (>> gate phi2-gate))
  (== (>> output) (>> source phi1-hold-gate))
  (== (>> input) (>> drain phi1-hold-gate))
  (== (>> phi1-hold) (>> gate phi1-hold-gate))
  (== (>> output) (>> output in2))
  (== (>> input) (>> input in1)))

(defckt reg-driver ()
  (node 'load-1)
  (node 'load-2)
  (node 'phi1-load-1)
  (node 'phi1-load-2)
  (node 'phi1-hold)
  (element 'o1 (>> nor-gate))
  (element 'nl1 (>> inverter))
  (== (>> load-1) (>> input nl1))
  (== (>> output nl1) (>> input-1 o1))
  (element 'o2 (>> nor-gate))
  (element 'nl2 (>> inverter))
  (== (>> load-2) (>> input nl2))
  (== (>> output nl2) (>> input-1 o2))
  (element 'a1 (>> nand-gate))
  (element 'n1 (>> inverter))
  (== (>> output o1) (>> input-1 a1))
  (== (>> *phi1*) (>> input-2 a1))
  (== (>> output a1) (>> input n1))
  (== (>> output n1) (>> phi1-load-1))
  (element 'o (>> nor-gate))				
  (element 'ah (>> nand-gate))
  (element 'nh (>> inverter))
  (== (>> output o1) (>> input-1 o))
  (== (>> output o2) (>> input-2 o))
  (== (>> output o) (>> input-1 ah))
  (== (>> *phi1*) (>> input-2 ah))
  (== (>> output ah) (>> input nh))
  (== (>> output nh) (>> phi1-hold))
  (element 'a2 (>> nand-gate))
  (element 'n2 (>> inverter))
  (== (>> output o2) (>> input-1 a2))
  (== (>> *phi1*) (>> input-2 a2))
  (== (>> output a2) (>> input n2))
  (== (>> output n2) (>> phi1-load-2)))

(defckt stack (depth field)
  (node 'push)
  (node 'pop)
  (defckt stack-bit-slice ()
    (node 'input)
    (node 'output)
    (element 'driver (>> reg-driver))
    (node 'phi1-hold)
    (node 'phi1-push)
    (node 'phi1-pop)
    (== (>> push) (>> load-1 driver))
    (== (>> phi1-push) (>> phi1-load-1 driver))
    (== (>> pop) (>> load-2 driver))
    (== (>> phi1-pop) (>> phi1-load-2 driver))
    (== (>> phi1-hold) (>> phi1-hold driver))
    (defckt stack-cell ()
      (node 'phi1-push-source)
      (node 'phi1-pop-source)
      (element 'r (>> regcell))
      (element 'phi1-push-gate (>> e-fet))
      (element 'phi1-pop-gate (>> e-fet))
      (== (>> input r) (>> drain phi1-push-gate))
      (== (>> phi1-push-source) (>> source phi1-push-gate))
      (== (>> phi1-push) (>> gate phi1-push-gate))
      (== (>> input r) (>> drain phi1-pop-gate))
      (== (>> phi1-pop-source) (>> source p1-pop-gate))
      (== (>> phi1-pop) (>> gate phi1-pop-gate))
      (== (>> phi1-hold) (>> phi1-hold r)))
    (defckt stack-bit-segment (depth)
      (node 'output)
      (node 'phi1-push-source)
      (element 'top (>> stack-cell))
      (== (>> output) (>> output r top))
      (== (>> phi1-push-source) (>> phi1-push-source top))
      (if (= (>> depth) 1)
	  (== (>> *zero*) (>> phi1-pop-source top))
	  (progn (element 'rest (>> stack-bit-segment)
			  (depth (- (>> depth) 1)))
		 (== (>> phi1-pop-source top)
		     (>> output rest))
		 (== (>> output top)
		     (>> phi1-push-source rest)))))
    (element 'seg (>> stack-bit-segment) (depth (>> depth)))
    (== (>> input) (>> phi1-push-source seg))
    (== (>> output) (>> output seg)))
  (element 'bits (make-bunch (>> field)))
  (do ((i 0 (1+ i))) ((= i (width-of-field (>> field))))
    (assign-to-bunch (element () (>> stack-bit-slice)) i)))