;;; -*- mode: LISP; base: 8. -*-

;;;; Code Ops
;;; Friday the twenty-third of April, 1982; 8:50:40 am

;;; Defined herein:

(DEFVAR *PREDICATES*)
(DEFVAR *NON-UARG-OPS*)
(DEFVAR *UARGS*)
(DEFVAR *CONSTANTS*)
(DEFVAR *OP-TABLE*)
(DEFVAR *DISP-PROGRAM*)


;;;; *PREDICATES*
(SETQ *PREDICATES* '(
  (OR (SENSE =-1 MACHINE-NUMBER DATUM TEMPORARY DATA-SENSES)
      (NOT (SENSE POINTER-BIT MAIN-BUS DATA-SENSES)))
  (OR (SENSE -SOMEBODY-NEEDS-GC CONTROL-INPUTS PAD-SENSES))
  (OR (AND (SENSE TEMPORARY=MACHINE-NUMBER DATA-SENSES)
           (SENSE POINTER-BIT MAIN-BUS DATA-SENSES)))
  (OR (SENSE BUS= SCAN DATA-SENSES))
  (OR (SENSE RELOCATE-REQUEST-TO-ME CONTROL-INPUTS PAD-SENSES))
  (OR (SENSE -SOMEBODY-ISNT-READY-TO-GC CONTROL-INPUTS PAD-SENSES))
  (OR (AND (NOT (SENSE -SOMEBODY-NEEDS-GC CONTROL-INPUTS PAD-SENSES))
           (SENSE GC INTERRUPT-ENABLES DATA-SENSES)))
  (OR (AND (SENSE CONS-SERVER INTERRUPT-ENABLES DATA-SENSES)
           (SENSE CONS-SERVER-INTERRUPT-REQUEST
                  EXTERNAL-PREDICATES
                  PAD-SENSES)))
  (OR (AND (SENSE DMA-INTERRUPT-REQUEST
                  EXTERNAL-PREDICATES
                  PAD-SENSES)
           (SENSE DMA INTERRUPT-ENABLES DATA-SENSES)))
  (OR (SENSE SIGN-BIT DATUM VAL DATA-SENSES))
  (OR (SENSE =0 DATUM MAIN-BUS DATA-SENSES))
  (OR (AND (SENSE BUS= DATUM VAL DATA-SENSES)
           (SENSE BUS= TYPE VAL DATA-SENSES)))
  (OR (SENSE CDR-BIT THARGS-STACK DATA-SENSES))
  (OR (SENSE =0 COUNT ENV-STACK DATA-SENSES))
  (OR (SENSE =36 COUNT ENV-STACK DATA-SENSES))
  (OR (SENSE BUS= TYPE VAL DATA-SENSES))
  (OR (SENSE CDR-BIT CONT-STACK DATA-SENSES))
  (OR (AND (SENSE DMA-INTERRUPT-REQUEST
                  EXTERNAL-PREDICATES
                  PAD-SENSES)
           (SENSE DMA INTERRUPT-ENABLES DATA-SENSES))
      (AND (SENSE CONS-SERVER INTERRUPT-ENABLES DATA-SENSES)
           (SENSE CONS-SERVER-INTERRUPT-REQUEST
                  EXTERNAL-PREDICATES
                  PAD-SENSES))
      (AND (SENSE EXTERNAL-INTERRUPT-REQUEST
                  EXTERNAL-PREDICATES
                  PAD-SENSES)
           (SENSE EXTERNAL INTERRUPT-ENABLES DATA-SENSES))
      (AND (NOT (SENSE -SOMEBODY-NEEDS-GC CONTROL-INPUTS PAD-SENSES))
           (SENSE GC INTERRUPT-ENABLES DATA-SENSES)))
  (OR (AND (NOT (SENSE SIGN-BIT DATUM EXP DATA-SENSES))
           (SENSE =2 TYPE EXP DATA-SENSES)
           (NOT (SENSE SIGN-BIT ARRAY-INDEX-ADDER DATA-SENSES))))
  (OR (SENSE =17 CLASS MAIN-BUS DATA-SENSES))
  (OR (SENSE LOW-BIT DATUM EXP DATA-SENSES))
  (OR (SENSE =0 HIGH-BITS DATUM EXP DATA-SENSES))
  (OR (SENSE =0 TYPE MAIN-BUS DATA-SENSES))
  (OR (SENSE FREE=MEMTOP DATA-SENSES))
  (OR TRUE)
  (OR (SENSE SBUS-ERROR-FLAG EXTERNAL-PREDICATES PAD-SENSES))
  (OR (AND (SENSE POINTER-BIT MAIN-BUS DATA-SENSES)
           (NOT (SENSE =17 CLASS MAIN-BUS DATA-SENSES))))
  (OR FALSE)))


;;;; *NON-UARG-OPS*
(SETQ *NON-UARG-OPS* '(
  (NOOP)
  (ALL-OPS (ENABLE-INPUT EXTERNAL-REGISTERS)
           (READ-GLOBAL SBUS-INPUT-RELOCATED-VALUE
                        EXTERNAL-REGISTERS))
  (ALL-OPS (ENABLE-OUTPUT EXTERNAL-REGISTERS)
           (LOAD-GLOBAL SBUS-OUTPUT-RELOCATE-REQUEST
                        EXTERNAL-REGISTERS))
  (ALL-OPS (ENABLE-OUTPUT EXTERNAL-REGISTERS)
           (LOAD-GLOBAL SBUS-OUTPUT-RELOCATED-VALUE
                        EXTERNAL-REGISTERS))
  (ALL-OPS (ENABLE-INPUT EXTERNAL-REGISTERS)
           (READ-GLOBAL SBUS-INPUT-RELOCATE-REQUEST
                        EXTERNAL-REGISTERS))
  (ALL-OPS (LOAD-LOCAL DATUM TEMPORARY MAIN-REGISTERS)
           (READ-LOCAL INCREMENT FREE MAIN-REGISTERS)
           (READ-LOCAL INCREMENT TEMPORARY MAIN-REGISTERS)
           (LOAD-LOCAL DATUM FREE MAIN-REGISTERS))
  (ALL-OPS (LOAD-LOCAL SCAN MAIN-REGISTERS)
           (READ-LOCAL INCREMENT SCAN MAIN-REGISTERS))
  (ALL-OPS (ENABLE-OUTPUT EXTERNAL-REGISTERS)
           (LOAD-GLOBAL WRITE-MAR EXTERNAL-REGISTERS))
  (ALL-OPS (LOAD-GLOBAL READ-MAR EXTERNAL-REGISTERS)
           (ENABLE-OUTPUT EXTERNAL-REGISTERS))
  (ALL-OPS (READ-LOCAL SHADOW WIND-FORMS MAIN-REGISTERS)
           (READ-LOCAL SHADOW THARGS MAIN-REGISTERS)
           (LOAD-LOCAL CONT MAIN-REGISTERS)
           (LOAD-LOCAL THARGS MAIN-REGISTERS)
           (LOAD-LOCAL TYPE CONT-STACK MAIN-REGISTERS)
           (LOAD-LOCAL TYPE EXP MAIN-REGISTERS)
           (READ-LOCAL SHADOW VAL MAIN-REGISTERS)
           (LOAD-LOCAL DATUM VAL MAIN-REGISTERS)
           (READ-LOCAL SHADOW THARGS-STACK MAIN-REGISTERS)
           (LOAD-LOCAL WORD THARGS-STACK MAIN-REGISTERS)
           (LOAD-LOCAL CDR-BIT CONT-STACK MAIN-REGISTERS)
           (LOAD-LOCAL ENV MAIN-REGISTERS)
           (READ-LOCAL SHADOW CONT-STACK MAIN-REGISTERS)
           (READ-LOCAL SHADOW ENV-STACK MAIN-REGISTERS)
           (LOAD-LOCAL CDR-BIT THARGS-STACK MAIN-REGISTERS)
           (LOAD-LOCAL DATUM CONT-STACK MAIN-REGISTERS)
           (LOAD-LOCAL ENV-STACK MAIN-REGISTERS)
           (LOAD-LOCAL WIND-FORMS MAIN-REGISTERS)
           (LOAD-LOCAL DATUM EXP MAIN-REGISTERS)
           (READ-LOCAL SHADOW CONT MAIN-REGISTERS)
           (READ-LOCAL SHADOW ENV MAIN-REGISTERS)
           (LOAD-LOCAL TYPE VAL MAIN-REGISTERS)
           (READ-LOCAL SHADOW EXP MAIN-REGISTERS))
  (ALL-OPS (ENABLE-INPUT EXTERNAL-REGISTERS)
           (READ-GLOBAL SBUS-ERROR-CODE EXTERNAL-REGISTERS))
  (ALL-OPS (ENABLE-INPUT EXTERNAL-REGISTERS)
           (READ-GLOBAL INTERRUPT-NUMBER EXTERNAL-REGISTERS))
  (ALL-OPS (LOAD-GLOBAL SBUS-OUTPUT-CONS EXTERNAL-REGISTERS)
           (READ-LOCAL INCREMENT FREE MAIN-REGISTERS)
           (LOAD-LOCAL DATUM FREE MAIN-REGISTERS)
           (ENABLE-OUTPUT EXTERNAL-REGISTERS))
  (ALL-OPS (READ-GLOBAL ONE CDR-BIT MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS)
           (LOAD-LOCAL ENV-STACK MAIN-REGISTERS)
           (READ-LOCAL INCREMENT COUNT ENV-STACK MAIN-REGISTERS))
  (ALL-OPS (READ-GLOBAL ONE CDR-BIT MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS)
           (LOAD-LOCAL ENV-STACK MAIN-REGISTERS)
           (READ-LOCAL DECREMENT COUNT ENV-STACK MAIN-REGISTERS))
  (ALL-OPS (READ-LOCAL TYPE-TO-DATUM VAL MAIN-REGISTERS)
           (LOAD-LOCAL DATUM VAL MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (READ-LOCAL INCREMENT FREE MAIN-REGISTERS)
           (LOAD-LOCAL DATUM FREE MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (READ-LOCAL DECREMENT VAL MAIN-REGISTERS)
           (LOAD-LOCAL DATUM VAL MAIN-REGISTERS))
  (ALL-OPS (READ-GLOBAL INDEX-ADDER MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (CDR-BIT VAL MAIN-REGISTERS)
           (READ-GLOBAL INDEX-ADDER MAIN-REGISTERS)
           (NEGATE INDEX-PREPARER EXP MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (READ-LOCAL LEFT-SHIFT-1 VAL MAIN-REGISTERS)
           (LOAD-LOCAL DATUM VAL MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (READ-LOCAL LEFT-SHIFT-0 VAL MAIN-REGISTERS)
           (LOAD-LOCAL DATUM VAL MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (READ-LOCAL DECREMENT VAL MAIN-REGISTERS)
           (LOAD-LOCAL DATUM VAL MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (READ-LOCAL INCREMENT VAL MAIN-REGISTERS)
           (LOAD-LOCAL DATUM VAL MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (READ-GLOBAL ONE CDR-BIT MAIN-REGISTERS)
           (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS))
  (ALL-OPS (LOAD-LOCAL ENV-STACK MAIN-REGISTERS)
           (READ-LOCAL INCREMENT COUNT ENV-STACK MAIN-REGISTERS))
  (ALL-OPS (LOAD SHADOW VAL MAIN-REGISTERS)
           (LOAD SHADOW THARGS MAIN-REGISTERS)
           (LOAD SHADOW WIND-FORMS MAIN-REGISTERS)
           (LOAD SHADOW EXP MAIN-REGISTERS)
           (LOAD SHADOW ENV MAIN-REGISTERS)
           (LOAD SHADOW CONT MAIN-REGISTERS)
           (LOAD SHADOW THARGS-STACK MAIN-REGISTERS)
           (LOAD SHADOW ENV-STACK MAIN-REGISTERS)
           (LOAD SHADOW CONT-STACK MAIN-REGISTERS))
  (ALL-OPS (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS)
           (READ-GLOBAL DATUM-SOURCE MAIN-REGISTERS))
  (ALL-OPS (LOAD-LOCAL ENV-STACK MAIN-REGISTERS)
           (READ-LOCAL DECREMENT COUNT ENV-STACK MAIN-REGISTERS))
  (READ-GLOBAL ZERO CDR-BIT MAIN-REGISTERS)
  (READ-GLOBAL ONE CDR-BIT MAIN-REGISTERS)
  (READ-GLOBAL TYPE-SOURCE MAIN-REGISTERS)
  (ALL-OPS (SHIFT INDEX-PREPARER EXP MAIN-REGISTERS)
           (CDR-BIT VAL MAIN-REGISTERS)
           (READ-GLOBAL INDEX-ADDER MAIN-REGISTERS)
           (ENABLE-OUTPUT EXTERNAL-REGISTERS)
           (LOAD-GLOBAL WRITE-MAR EXTERNAL-REGISTERS))
  (ALL-OPS (LOAD-GLOBAL READ-MAR EXTERNAL-REGISTERS)
           (SHIFT INDEX-PREPARER EXP MAIN-REGISTERS)
           (CDR-BIT VAL MAIN-REGISTERS)
           (READ-GLOBAL INDEX-ADDER MAIN-REGISTERS)
           (ENABLE-OUTPUT EXTERNAL-REGISTERS))
  (NEGATE INDEX-PREPARER EXP MAIN-REGISTERS)
  (ALL-OPS (READ-LOCAL RIGHT-SHIFT-0 EXP MAIN-REGISTERS)
           (LOAD-LOCAL DATUM EXP MAIN-REGISTERS))
  (ALL-OPS (LOAD-GLOBAL READ-MAR EXTERNAL-REGISTERS)
           (READ-GLOBAL ONE CDR-BIT MAIN-REGISTERS)
           (ENABLE-OUTPUT EXTERNAL-REGISTERS))
  (ALL-OPS (ENABLE-INPUT EXTERNAL-REGISTERS)
           (READ-GLOBAL READ-MBR EXTERNAL-REGISTERS))
  (ALL-OPS (LOAD-GLOBAL READ-MAR EXTERNAL-REGISTERS)
           (READ-GLOBAL ZERO CDR-BIT MAIN-REGISTERS)
           (ENABLE-OUTPUT EXTERNAL-REGISTERS))
  (ALL-OPS (READ-LOCAL INCREMENT FREE MAIN-REGISTERS)
           (LOAD-LOCAL DATUM FREE MAIN-REGISTERS))
  (ALL-OPS (READ-GLOBAL ONE CDR-BIT MAIN-REGISTERS)
           (ENABLE-OUTPUT EXTERNAL-REGISTERS)
           (LOAD-GLOBAL WRITE-MAR EXTERNAL-REGISTERS))
  (ALL-OPS (ENABLE-OUTPUT EXTERNAL-REGISTERS)
           (LOAD-GLOBAL WRITE-MBR EXTERNAL-REGISTERS))
  (ALL-OPS (READ-GLOBAL ZERO CDR-BIT MAIN-REGISTERS)
           (ENABLE-OUTPUT EXTERNAL-REGISTERS)
           (LOAD-GLOBAL WRITE-MAR EXTERNAL-REGISTERS))))


