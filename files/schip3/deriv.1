
(DEFUN DERIV (EXP VAR)
  (COND ((CONSTANT? EXP) 0)
        ((SAME-VAR? EXP VAR) 1)
        ((SUM? EXP) (DERIV-SUM EXP VAR))
        ((PRODUCT? EXP) (DERIV-PRODUCT EXP VAR))

	; MORE RULES GO HERE.

	))


(DEFUN DERIV-SUM (EXP VAR)
  (MAKE-SUM (DERIV-LIST (ADDENDS EXP) VAR '())))

(DEFUN DERIV-LIST (L VAR DERIVS)
  (COND ((NULL L) DERIVS)
	(T (DERIV-LIST (CDR L) 
		       VAR
		       (CONS (DERIV (CAR L) VAR) DERIVS)))))


(DEFUN DERIV-PRODUCT (EXP VAR)
  (LET ((F (FACTORS EXP)))
       (MAKE-SUM (DERIV-EACH-FACTOR '() (CAR F) (CDR F) VAR))))

(DEFUN DERIV-EACH-FACTOR (LEFT CURRENT RIGHT VAR)
  (CONS (MAKE-PRODUCT (CONCAT-FACTORS LEFT (DERIV CURRENT VAR) RIGHT))
	(COND ((NULL RIGHT) NIL)
	      (T (DERIV-EACH-FACTOR (CONS CURRENT LEFT)
				    (CAR RIGHT)
				    (CDR RIGHT)
				    VAR)))))

(DEFUN CONCAT-FACTORS (L C R)
  (NCONC (REVERSE L) (LIST C) R)

 

(DEFUN SUM? (EXP)
  (AND (NOT (ATOM EXP))
       (EQ (CAR EXP) '+)))

(DEFUN ADDENDS (SUM) (CDR SUM))

(DEFUN MAKE-SUM (EXPS)
  (SCAN+EXPS EXPS 0 '()))

(DEFUN SCAN+EXPS (UNSCANNED NUMERICAL SYMBOLIC)
  (COND ((NULL UNSCANNED)
	 (COND ((NULL SYMBOLIC) NUMERICAL)
	       ((= NUMERICAL 0)
		(COND ((NULL (CDR SYMBOLIC)) (CAR SYMBOLIC))
		      (T (CONS '+ SYMBOLIC))))
	       (T (CONS '+ (CONS NUMERICAL SYMBOLIC)))))
	((NUMBERP (CAR UNSCANNED))
	 (SCAN+EXPS (CDR UNSCANNED)
		    (+ (CAR UNSCANNED) NUMERICAL)
		    SYMBOLIC))
	((SUM? (CAR UNSCANNED))
	 (SCAN+EXPS (APPEND (ADDENDS (CAR UNSCANNED)) (CDR UNSCANNED))
		    NUMERICAL
		    SYMBOLIC))
	(T
	 (SCAN+EXPS (CDR UNSCANNED)
		    NUMERICAL
		    (CONS (CAR UNSCANNED) SYMBOLIC)))))



(DEFUN PRODUCT? (EXP)
  (AND (NOT (ATOM EXP))
       (EQ (CAR EXP) '*)))

(DEFUN FACTORS (PRODUCT) (CDR PRODUCT))
 
(DEFUN MAKE-PRODUCT (EXPS)
  (SCAN*EXPS EXPS 1 '()))

(DEFUN SCAN*EXPS (UNSCANNED NUMERICAL SYMBOLIC)
  (COND ((NULL UNSCANNED)
	 (COND ((= NUMERICAL 0) 0)
	       ((NULL SYMBOLIC) NUMERICAL)
	       ((= NUMERICAL 1)
		(COND ((NULL (CDR SYMBOLIC)) (CAR SYMBOLIC))
		      (T (CONS '* SYMBOLIC))))
	       (T (CONS '* (CONS NUMERICAL SYMBOLIC)))))
	((NUMBERP (CAR UNSCANNED))
	 (SCAN*EXPS (CDR UNSCANNED)
		    (* (CAR UNSCANNED) NUMERICAL)
		    SYMBOLIC))
	((PRODUCT? (CAR UNSCANNED))
	 (SCAN*EXPS (APPEND (FACTORS (CAR UNSCANNED)) (CDR UNSCANNED))
		    NUMERICAL
		    SYMBOLIC))
	(T
	 (SCAN*EXPS (CDR UNSCANNED)
		    NUMERICAL
		    (CONS (CAR UNSCANNED) SYMBOLIC)))))
