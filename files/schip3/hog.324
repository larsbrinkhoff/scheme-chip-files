;;; -*- package: DPL; mode: LISP -*-

;;; Scheme-81 Layout

;;; The Whole Hog

(defcell scheme-81 ()
  (or (boundp '*constant-decoder-input-field*)
      (initialize-plas))
  (dolist (code *scheme-81-maker-codes*)
    (print code)
    (mapc #'eval (get code 'schip-code)))
  (print 'scheme-81))

(schip-code main-regs ()
  (schip-part main-regs (register-file fake-register-file)
    (cell-power-bus-size 8.)
    (right-jumpers? t)
    (right-power-jumper-bridge nil)
    (right-power-jumper-cut nil)
    (left-jumpers? t)
    (left-power-jumper-bridge nil)
    (left-power-jumper-cut nil)
    (description (or *faking-it* main-regs))
    (driver-power-bus-size 8.)
    (driver-lower-power-bus-size 8)
    (driver-scaling 2.)
    (power-bus-size 50.)))

(defconst *decoder-over-spacing* 300)
(defconst *decoder-up-spacing* 380)

(schip-code decoders (main-regs)
  (group decoders
	 (schip-part constant-decoder (decoder fake-constant-decoder)
		     (input-number 5)
		     (pterm-number 29)
		     (output-number 10)
		     (vdd-bus-width 18)
		     (gnd-bus-width 8)
		     (input-field *constant-decoder-input-field*)
		     (output-field *constant-decoder-output-field*))
	 (negy (>> constant-decoder))
	 (align-x (>> constant-decoder)
		  (>> apparent-right constant-decoder)
		  (- (>> apparent-left right-power-bus main-regs)
		     *small-number*))
	 (align-y (>> constant-decoder)
		  (>> apparent-bottom constant-decoder)
		  (+ (>> apparent-top main-regs) *decoder-up-spacing*))
	 (schip-part uarg-load-decoder (decoder fake-uarg-load-decoder)
		     (input-number 6)
		     (pterm-number 45)
		     (output-number 25)
		     (vdd-bus-width 18)
		     (gnd-bus-width 14)
		     (input-field *uarg-load-input-field*)
		     (output-field *uarg-load-output-field*))
	 (rot180 (>> uarg-load-decoder))
	 (align-x (>> uarg-load-decoder)
		  (>> apparent-right uarg-load-decoder)
		  (- (>> apparent-left constant-decoder) *decoder-over-spacing*))
	 (align-y (>> uarg-load-decoder)
		  (>> apparent-bottom uarg-load-decoder)
		  (>> apparent-bottom constant-decoder))
	 (schip-part uarg-read-decoder (decoder fake-uarg-read-decoder)
		     (input-number 6)
		     (pterm-number 45)
		     (output-number 30)
		     (vdd-bus-width 18)
		     (gnd-bus-width 14)
		     (input-field *uarg-read-input-field*)
		     (output-field *uarg-read-output-field*))
	 (rot180 (>> uarg-read-decoder))
	 (align-x (>> uarg-read-decoder)
		  (>> apparent-right left-gnd uarg-read-decoder)
		  (>> apparent-right right-gnd uarg-load-decoder))
	 (align-y (>> uarg-read-decoder)
		  (>> apparent-bottom uarg-read-decoder)
		  (>> apparent-bottom constant-decoder))
	 (schip-part non-uarg-decoder (decoder fake-non-uarg-decoder)
		     (input-number 6)
		     (pterm-number 42)
		     (output-number 67.)
		     (vdd-bus-width 18)
		     (gnd-bus-width 18)
		     (input-field *non-uarg-input-field*)
		     (output-field *non-uarg-output-field*))
	 (rot180 (>> non-uarg-decoder))
	 (align-x (>> non-uarg-decoder)
		  (>> apparent-right non-uarg-decoder)
		  (- (>> apparent-left uarg-read-decoder)
		     125))
	 (align-y (>> non-uarg-decoder)
		  (>> apparent-bottom non-uarg-decoder)
		  (>> apparent-bottom constant-decoder))))

(schip-code control-pla (main-regs)
  (schip-part control-pla (control-pla fake-control-pla)
    (pterm-number 172)
    (right-vdd-width 80)
    (left-gnd-width 72))
  (negx (>> control-pla))
  (align (>> control-pla)
	 (>> apparent-center-left right-vdd control-pla)
	 (let ((ptt (>> apparent-center-right right-power-bus main-regs)))
	   (pt (cloint (x-of-pt ptt)) (cloint (+ (y-of-pt ptt) 200))))))

(schip-code land-of-uarg (control-pla)
  (group land-of-uarg
	 (setq-my uarg-stack-power-bus-width 16)
	 (schip-part uarg-op-decoder (op-decoder fake-uarg-op-decoder)
		     (code-width 5)
		     (pterm-number 22)
		     (output-number 18)
		     (input-field *uarg-op-input-field*)
		     (output-field *uarg-op-output-field*))
	 (int-pos (>> uarg-op-decoder))
	 (align-x (>> uarg-op-decoder)
		  (>> apparent-right uarg-op-decoder)
		  (- (>> apparent-right control-pla) 50))
	 (align-y (>> uarg-op-decoder)
		  (>> apparent-bottom uarg-op-decoder)
		  (+ (>> apparent-top control-pla)
		     (>> uarg-stack-power-bus-width)
		     60))
	 (schip-part uarg-stacks (uarg-system fake-uarg-system)
	   (stack-depth 3)
	   (word-size 6)
	   (power-bus-size 16)
	   (left-power? t)
	   (left-jumpers? nil)
	   (right-jumpers? nil))
	 (rot270 (>> uarg-stacks))
	 (align-y (>> uarg-stacks)
		  (>> apparent-top right-power-bus data-path uarg-stacks)
		  (>> apparent-top left-gnd uarg-op-decoder))
	 (align-x (>> uarg-stacks)
		  (>> x center (*rep 0) arg-2-explicit uarg-stacks)
		  (>> x (*path '((nth 0) arg2-data)) top-ofield
		      output-plane control-pla))))

(schip-code land-of-ns (control-pla)
  (group land-of-ns
	 (schip-part predicate-select (pred-pla fake-pred-pla))
	 (int-pos (>> predicate-select))
	 (align-x (>> predicate-select)
		  (>> apparent-left predicate-select)
		  (+ (>> apparent-right right-vdd control-pla) 20))
	 (align-y (>> predicate-select)
		  (>> apparent-bottom predicate-select)
		  (- (>> apparent-bottom main-regs) 220))
	 (schip-part dispatch-decoder (disp-pla fake-disp-pla))
	 (negy (>> dispatch-decoder))
	 (align-x (>> dispatch-decoder)
		  (>> apparent-left dispatch-decoder)
		  (+ (>> apparent-right predicate-select)
		     *metal-to-metal*
		     (>> vdd-connect-width predicate-select)
		     *metal-to-metal*))
	 (align-y (>> dispatch-decoder)
		  (>> apparent-top dispatch-decoder)
		  (- (>> apparent-bottom control-pla)
		     70))
	 (schip-part ns-op-decoder (op-decoder fake-ns-op-decoder)
		     (code-width 6)
		     (pterm-number 30)
		     (output-number 7)
		     (input-field *ns-op-input-field*)
		     (output-field *ns-op-output-field*))
	 (negy (>> ns-op-decoder))
	 (align-x  (>> ns-op-decoder)
		   (>> apparent-left ns-op-decoder)
		   (+ (>> apparent-right dispatch-decoder)
		      *small-number*))
	 (align-y (>> ns-op-decoder)
		  (>> apparent-top ns-op-decoder)
		  (- (>> apparent-bottom control-pla) *big-number*))
	 (schip-part next-state (register-file fake-next-state)
	   (description (or *faking-it* next-state))
	   (left-power? nil)
	   (left-jumpers? t)
	   (left-power-jumper-bridge nil)
	   (left-power-jumper-cut nil)
	   (right-jumpers? nil)
	   (power-bus-size 16))
	 (negx (>> next-state))
	 (align (>> next-state)
		(>> apparent-top-left next-state)
		(pt-to-right (>> apparent-top-right ns-op-decoder)
			     *small-number*))))

(defvar *make-fake-pads* nil)

(schip-code pads (land-of-ns decoders control-pla land-of-uarg)
  (let ((*faking-it* *make-fake-pads*))
    (setq-my vdd-width 100)
    (setq-my gnd-width 80)
    (partq pads scheme-pads
	   (xsize (+ (- (>> apparent-right control-pla)
			(>> apparent-left main-regs))
		     (* 18 *metal-pitch*)
		     *metal-to-metal* 1
		     266))
	   (ysize (+ (- (>> apparent-top land-of-uarg)
			(>> apparent-bottom land-of-ns))
		     20
		     *metal-to-metal* 2
		     (* 9 *metal-pitch*)
		     (* 6 *metal-pitch*)
		     100		  ;; metal width
		     *metal-to-metal*
		     8			  ;; metal-width of lsd-gnd
		     (* 36 *metal-pitch*)
		     *metal-to-metal*
		     (- 0 51)))
	   (vdd-width (>> vdd-width))
	   (gnd-width (>> gnd-width)))
    (align-y (>> pads)
	     (>> apparent-top-center bottom-pads pads)
	     (- (>> apparent-bottom next-state land-of-ns)
		20			  ;; metal-width
		*metal-to-metal* 2
		(* 9 *metal-pitch*)
		(* 6 *metal-pitch*)))
    (align-x (>> pads)
	     (>> apparent-center-right pads)
	     (+ (>> apparent-right control-pla)
		(* *metal-pitch* 5)
		*metal-to-metal*
		2
		(>> vdd-width pads)))))

(schip-code gnd-wiring (pads)
  (group gnd-wiring
	 (wireq down-from-top-gnd (run-layer 'metal)
		(run-width (>> power-bus-size main-regs))
		(from (pt
			(+ (max
			     (>> apparent-left expanse (*rep 1) rep top-pads pads)
			     (+ (>> apparent-right side-pads pads) 4))
			   (>> *half-width*))
			(>> apparent-bottom (*rep 1) rep top-pads pads)))
		(to-y (- (min
			   (fix (>> y poly-output *rep-last rep side-pads pads))
			   (- (>> apparent-bottom top-pads pads)
			      (* 8 *metal-pitch*)))
			 *metal-pitch* 8)))
	 (wireq connect-enable-pad (run-layer 'metal)
		(run-width 4)
		(from (>> apparent-center-left nor-gnd (*rep 2) rep top-pads pads))
		(to-x (>> apparent-right down-from-top-gnd)))
	 (wireq over-top-gnd (run-layer 'metal)
		(run-width (>> power-bus-size main-regs))
		(from (pt-below (>> apparent-bottom-left down-from-top-gnd)
				(>> *half-width*)))
		(to-x (>> center left-power-bus main-regs)))
	 (wireq vertical-gnd-connection (run-layer 'metal)
		(run-width (>> power-bus-size main-regs))
		(from (>> apparent-top-center left-power-bus main-regs))
		(to-y (+ (>> y end-pt over-top-gnd) (>> *half-width*))))
	 (wireq decoder-gnd (run-layer 'metal)
		(run-width 30)
		(from (pt-offset
			(>> apparent-bottom-right right-gnd
			    non-uarg-decoder decoders)
			(- 0 4)
			(- 0 (>> *half-width*))))
		(to-x (>> right vertical-gnd-connection)))
	 (wireq connect-constant-decoder (run-layer 'metal)
		(run-width (>> left-gnd-width constant-decoder decoders))
		(from (pt-above
			(>> apparent-bottom-left left-gnd
			    constant-decoder decoders)
			(>> *half-width*)))
		(to-x (>> apparent-right uarg-load-decoder decoders)))
	 (wireq up-to-control (run-layer 'metal)
		(run-width (>> left-gnd-width control-pla))
		(from (>> apparent-top-center *rep-last rep bottom-pads pads))
		(+y (- (>> *half-width*) (>> gnd-width bottom-pads pads)))
		(jog-x (>> apparent-bottom-center left-gnd control-pla)))
	 (wireq connect-ns (run-layer 'metal)
		(run-width 20)		  ;metal width
		(from (pt (>> x center top-gnd predicate-select land-of-ns)
			  (- (>> apparent-bottom next-state land-of-ns)
			     (>> *half-width*)
			     *metal-to-metal* 1)))
		(to-x (>> apparent-left left-gnd control-pla)))
	 (wireq up-to-dispatch (run-layer 'metal)
		(run-width (>> top-gnd-width dispatch-decoder land-of-ns))
		(from (pt-above (>> apparent-center-left top-gnd dispatch-decoder
				    land-of-ns)
				(>> *half-width*)))
		(to-y (>> end-pt connect-ns)))
	 (wireq up-to-ns-op (run-layer 'metal)
		(run-width (>> left-gnd-width ns-op-decoder land-of-ns))
		(from (>> apparent-bottom-center left-gnd
			  ns-op-decoder land-of-ns))
		(to-y (>> end-pt connect-ns)))
	 (wireq up-to-next-state (run-layer 'metal)
		(run-width (>> power-bus-size next-state land-of-ns))
		(from (>> apparent-bottom-center left-power-bus next-state
			  land-of-ns))
		(to-y (>> end-pt connect-ns)))
	 (wireq over-to-stacks (run-layer 'metal)
		(run-width (>> power-bus-size data-path uarg-stacks land-of-uarg))
		(from (>> apparent-center-right right-power-bus data-path
			  uarg-stacks land-of-uarg))
		(to-x (>> apparent-right left-gnd control-pla)))
	 (wireq up-to-stacks (run-layer 'metal)
		(run-width (>> power-bus-size data-path uarg-stacks land-of-uarg))
		(from (pt-to-left (>> end-pt over-to-stacks) (>> *half-width*)))
		(to-y (>> apparent-top left-gnd control-pla)))
	 (wireq to-bottom-pads-start (run-layer 'metal)
		(run-width (>> power-bus-size main-regs))
		(from (>> apparent-bottom-center left-power-bus main-regs))
		(to-y (+ (>> y apparent-top-center (*rep 3) rep bottom-pads pads)
			 (* 6 *metal-pitch*)
			 *metal-to-metal* 1)))
	 (wireq to-bottom-pads-cont (run-layer 'metal)
		(run-width 8)
		(from (pt-above (>> apparent-bottom-right to-bottom-pads-start) 4))
		(to-x (>> apparent-left
			  (*path '(-memory-done control-inputs))
			  bottom-pads pads)))
	 (wireq to-bottom-pads-mid (run-layer 'metal)
		(run-width 8)
		(from (pt-above (>> end-pt to-bottom-pads-cont)
				(>> *half-width*)))
		(to-y (- (>> apparent-top bottom-pads pads)
			 (>> *half-width*))))
	 (wireq to-bottom-pads (run-layer 'metal)
		(run-width 8)
		(from (pt-to-left (>> end-pt to-bottom-pads-mid)
				  (>> *half-width*)))
		(to-x (- (>> apparent-left
				 (*path '(load-state control-inputs))
				 bottom-pads pads)
			     15)))
	 (wireq memdone-freeze-down (run-layer 'metal)
		(run-width 6)
		(from (pt (+ (>> apparent-right
				 (*path '(-memory-done control-inputs))
				 bottom-pads pads)
			     (>> *half-width*)
			     *metal-to-metal*)
			  (>> apparent-bottom gnd-bus buffer
			      (*path '(-memory-done control-inputs))
			  bottom-pads pads)))
		(to-y (>> bottom to-bottom-pads)))
	 (wireq gc-left-down (run-layer 'metal)
		(run-width 6)
		(from (pt (+ (>> apparent-right
				 (*path '(relocate-request-to-me control-inputs))
				 bottom-pads pads)
			     10)
			  (>> bottom memdone-freeze-down)))
		(to-y (>> bottom to-bottom-pads)))
	 (wireq control-buffer-gnd (run-layer 'metal)
		(run-width 4)
		(from (>> apparent-center-left gnd-bus buffer
			  (*path '(-memory-done control-inputs))
			  bottom-pads pads))
		(to-x (>> right gc-left-down)))
	 (wireq freeze-logic-gnd (run-layer 'metal)
		(run-width 4)
		(from (>> apparent-center-left gnd waiting-circuitry
			  (*path '(freeze control-inputs))
			  bottom-pads pads))
		(to-x (>> right memdone-freeze-down)))
	 (wireq gc-right-down (run-layer 'metal)
		(run-width 6)
		(from (pt (- (>> apparent-left
				 (*path '(load-state control-inputs))
				 bottom-pads pads)
			     15)
			  (>> bottom gc-left-down)))
		(to-y (>> top to-bottom-pads)))
	 (wireq gc-logic-over (run-layer 'metal)
		(run-width 4)
		(from (pt (>> right gc-left-down)
			  (>> y center ground
			      (*path '(-somebody-needs-gc control-inputs))
			      bottom-pads pads)))
		(to-x (>> right gc-right-down)))
	 (wireq pred-gnd (run-layer 'metal)
		(run-width 4)
		(from (pt (>> right gc-right-down)
			  (>> y center control-buffer-gnd)))
		(to-x (>> apparent-right gnd-bus
			  (*path '(sbus-error-flag external-predicates))
			  bottom-pads pads)))))

(schip-code logo (decoders gnd-wiring)
  (schip-part logo (scheme-81-logo fake-scheme-81-logo)
    (bottom-center (pt-offset (>> top-center decoder-gnd gnd-wiring) -6 124)))
  (schip-part logo2 (bakman rectangle)
    (apparent-bottom-center
      (pt-offset (>> apparent-top-center uarg-op-decoder land-of-uarg)
		 50 140))
    (layer 'metal)
    (length 80)
    (width 300))) 

(schip-code vdd-wiring (pads gnd-wiring)
  (group vdd-wiring
	 (wireq top-vdd (run-layer 'metal)
		(run-width 130)
		(from (pt (>> apparent-left right-power-bus main-regs)
			  (+ (>> apparent-bottom left-power-bus data-path
				 uarg-stacks land-of-uarg)
			     (>> *half-width*))))
		(to-x (>> right pads)))
	 (wireq down-to-ns (run-layer 'metal)
		(run-width 130)
		(from (pt (+ (>> apparent-left right-power-bus main-regs)
			     (>> *half-width*))
			  (>> bottom top-vdd)))
		(to-y (- (>> apparent-bottom control-pla)
			 *metal-to-metal* 1
			 20)))
	 (wireq connect-decoders (run-layer 'metal)
		(run-width (>> top-vdd-width non-uarg-decoder decoders))
		(from (>> apparent-center-left top-vdd non-uarg-decoder decoders))
		(to-x (>> right down-to-ns)))
	 (wireq to-next-state (run-layer 'metal)
		(run-width 20)
		(from (pt-above (>> bottom-right down-to-ns)
				(>> *half-width*)))
		(to-x (>> apparent-right right-power-bus
			  next-state land-of-ns)))
	 (wireq over-for-pred (run-layer 'metal)
		(run-width (>> vdd-connect-width predicate-select land-of-ns))
		(from (>> apparent-center-right vdd-connect
			  predicate-select land-of-ns))
		(to-x (+ (>> apparent-right predicate-select land-of-ns)
			 *metal-to-metal*
			 (>> *width*))))
	 (wireq down-to-pred (run-layer 'metal)
		(run-width (>> vdd-connect-width predicate-select land-of-ns))
		(from (pt-to-left (>> end-pt over-for-pred) (>> *half-width*)))
		(to-y (>> end-pt to-next-state)))
	 (wireq connect-disp (run-layer 'metal)
		(run-width (>> right-vdd-width dispatch-decoder land-of-ns))
		(from (>> apparent-top-center right-vdd
			  dispatch-decoder land-of-ns))
		(to-y (>> end-pt to-next-state)))
	 (wireq connect-ns-op (run-layer 'metal)
		(run-width (>> bottom-vdd-width ns-op-decoder land-of-ns))
		(from (>> apparent-center-right bottom-vdd
			  ns-op-decoder land-of-ns))
		(to-x (>> apparent-left next-state land-of-ns)))
	 (wireq connect-next-state-stacks (run-layer 'metal)
		(run-width (>> power-bus-size next-state land-of-ns))
		(from (>> apparent-top-center right-power-bus
			  next-state land-of-ns))
		(to-y (>> end-pt to-next-state)))
	 (wireq down-to-uarg-op (run-layer 'metal)
		(run-width (>> bottom-vdd-width uarg-op-decoder land-of-uarg))
		(from (>> apparent-top-center bottom-vdd
			  uarg-op-decoder land-of-uarg))
		(to-y (>> apparent-bottom top-vdd)))))

(schip-code data-enable-lines (vdd-wiring gnd-wiring pads)
  (group data-enable-lines
	 (wireq output-enable-wire (run-layer 'metal)
		(run-width 4)
		(from (>> apparent-center-right output-enable
			  (*path '((nth 8) top-data-bus))
			  top-pads pads))
		(to-x (+ (>> apparent-right down-from-top-gnd gnd-wiring)
			 *metal-to-metal* 7))
		(run-layer 'poly)
		(run-width 4)
		(-x 4)
		(drop-contact)
		(to-x (- (>> apparent-left down-from-top-gnd gnd-wiring)
			 *metal-to-metal* 3))
		(drop-contact)
		(-x 4)
		(run-layer 'metal)
		(jog-x (>> apparent-bottom-center output-enable
			   (*path '((nth 0) side-data-bus))
			   side-pads pads))
		(jog-y (>> apparent-center-right output-enable
			   (*path '((nth 5) bottom-data-bus))
			   bottom-pads pads)))
	 (wireq input-enable-wire (run-layer 'metal)
		(run-width 4)
		(from (>> apparent-center-right input-enable
			  (*path '((nth 8) top-data-bus))
			  top-pads pads))
		(to-x (+ (>> apparent-right down-from-top-gnd gnd-wiring)
			 *metal-to-metal* 7))
		(run-layer 'poly)
		(run-width 4)
		(-x 4)
		(drop-contact)
		(to-x (- (>> apparent-left down-from-top-gnd gnd-wiring)
			 *metal-to-metal* 3))
		(drop-contact)
		(-x 4)
		(run-layer 'metal)
		(jog-x (>> apparent-bottom-center input-enable
			   (*path '((nth 0) side-data-bus))
			   side-pads pads))
		(jog-y (>> apparent-center-right input-enable
			   (*path '((nth 5) bottom-data-bus))
			   bottom-pads pads)))
	 (wireq output-to-enable (run-layer 'poly)
		(from (>> input-1 (*rep 2) rep top-pads pads))
		(to-y (>> start-pt output-enable-wire))
		(drop-contact))
	 (wireq input-to-enable (run-layer 'poly)
		(from (>> input-2 (*rep 2) rep top-pads pads))
		(to-y (>> start-pt input-enable-wire))
		(drop-contact))
	 (wireq output-to-data-out (run-layer 'poly)
		(from (>> poly-point (*rep 2) rep bottom-pads pads))
		(to-y (>> center output-enable (*rep 3) rep bottom-pads pads))
		(drop-contact))))

(schip-code clock-circuits (pads vdd-wiring gnd-wiring)
  (group clock-circuits
	 (setq-my top-phi1-corner
		  (pt (- (>> right pads)
			 (>> vdd-width pads) *metal-spacing* 1)
		      (+ (>> apparent-top top-vdd vdd-wiring)
			 4 8 (* *metal-pitch* 5) *metal-spacing*)))
	 (setq-my top-phi2-corner
		  (pt-offset (>> top-phi1-corner)
			     (- 0 *metal-pitch*)
			     (- 0 *metal-pitch*)))
	 (setq-my top-freeze-corner
		  (pt-offset (>> top-phi2-corner)
			     (- 0 *metal-pitch*)
			     (- 0 *metal-pitch*)))
	 (setq-my bottom-phi1-corner
		  (pt (>> x top-phi1-corner)
		      (+ (>> apparent-top
			     (*path '((nth 0) state)) bottom-pads pads)
			 *metal-spacing*)))
	 (setq-my bottom-phi2-corner
		  (pt-offset (>> bottom-phi1-corner)
			     (- 0 *metal-pitch*)
			     *metal-pitch*))
	 (setq-my bottom-freeze-corner
		  (pt-offset (>> bottom-phi2-corner)
			     (- 0 *metal-pitch*)
			     *metal-pitch*))
	 (setq-my clock-left (>> apparent-left control-pla))
	 (wireq phi1-circuit (run-layer 'metal)
		(from (pt (>> clock-left) (>> y top-phi1-corner)))
		(to-x (>> top-phi1-corner))
		(jump-over (>> top-vdd vdd-wiring) '-y)
		(to-y (+ (>> y bottom-phi1-corner) 4))
		(run-layer 'poly)
		(-y 4)
		(drop-contact)
		(run-width 4)
		(to-x (- (>> apparent-left left-gnd control-pla)
			 *metal-spacing* 1))
		(drop-contact)
		(-x 4)
		(run-layer 'metal)
		(to-x (>> clock-left)))
	 (wireq connect-phi1 (run-layer 'poly)
		(from (>> apparent-top-center poly-wire (*path '(phi-1))
			  bottom-pads pads))
		(to-y (>> bottom-phi1-corner))
		(+x 2)
		(drop-contact)
		(-x 4)
		(drop-contact))
	 (wireq phi2-circuit (run-layer 'metal)
		(from (pt (>> clock-left) (>> y top-phi2-corner)))
		(to-x (>> top-phi2-corner))
		(jump-over (>> top-vdd vdd-wiring) '-y)
		(to-y (+ (>> y bottom-phi2-corner) 4))
		(run-layer 'poly)
		(-y 4)
		(drop-contact)
		(run-width 4)
		(to-x (- (>> apparent-left left-gnd control-pla)
			 *metal-spacing* 1))
		(drop-contact)
		(-x 4)
		(run-layer 'metal)
		(to-x (>> clock-left)))
	 (wireq connect-phi2 (run-layer 'poly)
		(from (>> apparent-bottom-center poly-wire
			  (*path '(phi-2)) top-pads pads))
		(to-y (>> top-phi2-corner))
		(+x 2)
		(drop-contact)
		(-x 4)
		(drop-contact))
	 (wireq freeze (run-layer 'metal)
		(from (pt (- (>> apparent-left (*path '(freeze control-inputs))
				 bottom-pads pads)
			     *metal-spacing*)
			  (>> y bottom-freeze-corner)))
		(to-x (- (>> apparent-left left-gnd control-pla)
			 *metal-spacing* 4 1))
		(run-layer 'poly)
		(+x 4)
		(drop-contact)
		(run-width 4)
		(to-x (>> bottom-freeze-corner))
		(drop-contact)
		(+y 4)
		(run-layer 'metal)
		(jump-over (>> top-vdd vdd-wiring) '+y)
		(to-y (>> top-freeze-corner))
		(to-x (>> clock-left)))
	 (wireq connect-freeze (run-layer 'metal)
		(from (>> freeze-point (*path '(freeze control-inputs))
			  bottom-pads pads))
		(to-x (>> start-pt freeze))
		(run-layer 'poly)
		(to-y (>> start-pt freeze))
		(drop-contact)
		(+x 4)
		(drop-contact)))
  (group clocking-to-main-regs
	 (setq-my first-down-x (- (>> apparent-left constant-decoder decoders)
				  *metal-spacing* 1))
	 (wireq  freeze (run-layer 'metal)
		(from (>> end-pt freeze clock-circuits))
		(to-x (>> first-down-x))
		(to-y (+ (>> apparent-top connect-constant-decoder gnd-wiring)
			 *metal-spacing* 4 1))
		(run-layer 'poly)
		(-y 4)
		(drop-contact)
		(to-y (>> apparent-bottom constant-decoder decoders)))
	 (wireq phi2 (run-layer 'metal)
		(from (>> start-pt phi2-circuit clock-circuits))
		(to-x (- (>> first-down-x) *metal-pitch*))
		(to-y (+ (>> apparent-top connect-constant-decoder gnd-wiring)
			 *metal-spacing* 4 1))
		(run-layer 'poly)
		(-y 4)
		(drop-contact)
		(to-y (>> end-pt freeze)))
	 (wireq phi1 (run-layer 'metal)
		(from (>> start-pt phi1-circuit clock-circuits))
		(to-x (- (>> first-down-x) *metal-pitch* *metal-pitch*))
		(to-y (+ (>> apparent-top connect-constant-decoder gnd-wiring)
			 *metal-spacing* 4 1))
		(run-layer 'poly)
		(-y 4)
		(drop-contact)
		(to-y (>> end-pt freeze))))) 

(schip-code bottom-pad-connections (pads clock-circuits)
  (group bottom-pad-connections
	 (wireq state-pad-output-enable (run-layer 'poly)
		(from (>> read-state-point logic
			  (*path '(load-state control-inputs))
			  bottom-pads pads))
		(to-y (>> center output-enable (*path '(state))
			  bottom-pads pads))
		(run-layer 'metal)
		(to-x (>> apparent-right output-enable (*path '((nth 8) state))
			  bottom-pads pads)))
	 (wireq state-pad-input-enable (run-layer 'poly)
		(from (>> load-state-point logic
			  (*path '(load-state control-inputs))
			  bottom-pads pads))
		(to-y (>> center input-enable (*path '(state))
			  bottom-pads pads))
		(run-layer 'metal)
		(to-x (>> end-pt state-pad-output-enable)))
	 (wireq connect-memdone (run-layer 'metal)
		(from (>> -memory-done-point (*path '(freeze control-inputs))
			  bottom-pads pads))
		(to-x (- (>> apparent-left (*path '(freeze control-inputs))
			     bottom-pads pads)
			 *metal-spacing*))
		(run-layer 'poly)
		(jog-x  (>> poly-point (*path '(-memory-done control-inputs))
			    bottom-pads pads)))
	 (wireq connect-rrtm (run-layer 'poly)
		(from (>> poly-point
			  (*path '(relocate-request-to-me control-inputs))
			  bottom-pads pads))
		(to-y (>> relocate-request-to-me-point
			  (*path '(freeze control-inputs))
			  bottom-pads pads))
		(run-layer 'metal)
		(to-x (>> relocate-request-to-me-point
			  (*path '(freeze control-inputs))
			  bottom-pads pads)))
	 (wireq connect-rrfma (run-layer 'poly)
		(from (>> poly-point
			  (*path '(relocate-request-from-me-acknowledged
				    control-inputs))
			  bottom-pads pads))
		(to-y (>> relocate-request-from-me-acknowledged-point
			  (*path '(freeze control-inputs))
			  bottom-pads pads))
		(run-layer 'metal)
		(to-x (>> relocate-request-from-me-acknowledged-point
			  (*path '(freeze control-inputs))
			  bottom-pads pads)))
	 (wireq need-gc-phi-1 (run-layer 'poly)
		(from (>> apparent-top-center phi-1-input
			  (*path '(-somebody-needs-gc control-inputs))
			  bottom-pads pads))
		(to-y (>> end-pt phi1-circuit clock-circuits))
		(run-layer 'metal)
		(to-x (>> end-pt phi1-circuit clock-circuits)))
	 (wireq need-gc-phi-2 (run-layer 'poly)
		(from (>> apparent-top-center phi-2-input
			  (*path '(-somebody-needs-gc control-inputs))
			  bottom-pads pads))
		(to-y (>> end-pt phi2-circuit clock-circuits))
		(run-layer 'metal)
		(to-x (>> end-pt phi2-circuit clock-circuits)))
	 (wireq ready-gc-phi-1 (run-layer 'poly)
		(from (>> apparent-top-center phi-1-input
			  (*path '(-somebody-isnt-ready-to-gc control-inputs))
			  bottom-pads pads))
		(to-y (>> end-pt phi1-circuit clock-circuits))
		(drop-contact))
	 (wireq ready-gc-phi-2 (run-layer 'poly)
		(from (>> apparent-top-center phi-2-input
			  (*path '(-somebody-isnt-ready-to-gc control-inputs))
			  bottom-pads pads))
		(to-y (>> end-pt phi2-circuit clock-circuits))
		(drop-contact)))
  (group silly-probe-pair
	 (partq output probe-output-pad
		(gnd-width 8)
		(vdd-width 4)
		(input-wire? nil)
		(output-wire? nil))
	 (align-y (>> output) (>> bottom output)
		  (+ (>> apparent-top to-bottom-pads-cont gnd-wiring) 20))
	 (align-x (>> output) (>> center inv-vdd-cont output)
		  (+ (>> x center (*rep 5) rep bottom-pads pads)
		     (half (- (>> x center (*rep 6) rep bottom-pads pads)
			      (>> x center (*rep 5) rep bottom-pads pads)))))
	 (partq input probe-pad
		(apparent-top-right (pt-to-left (>> apparent-top-left output)
						200)))
	 (wireq connect (run-layer 'poly)
		(from (>> input-pt output))
		(to-x (>> connect-pt input))
		(run-layer 'metal)
		(to-y (>> connect-pt input)))
	 (wireq gnd (run-layer 'metal)
		(run-width 8)
		(from (>> apparent-top-left gnd output))
		(to-y (>> apparent-top to-bottom-pads-cont gnd-wiring)))
	 (wireq vdd (run-layer 'diff)
		(from (>> center inv-vdd-cont output))
		(run-width 4)
		(to-y (>> apparent-bottom gnd-bus (*rep 5) rep bottom-pads pads)))
	 (wireq cross (run-layer 'diff)
		(run-width 8)
		(from (pt (>> apparent-left driver (*rep 5) rep bottom-pads pads)
			  (+ (>> y end-pt vdd) (>> *half-width*))))
		(to-x (>> apparent-left driver (*rep 6) rep bottom-pads pads)))))

(schip-code data-bus-routing (pads main-regs gnd-wiring)
  (group data-bus-routing
	 (let ((ans nil))
	   (dotimes (i 6)
	     (push
	       (create-nect (>> y (*path `(left-external-bus
					    (left-external-bus ,(- 36 i))))
				main-regs)
			    'left)
	       ans))
	   (dotimes (i 22)
	     (push
	       (create-nect (>> y (*path `(left-external-bus
					    (left-external-bus ,(- 36 (+ i 6)))))
				main-regs)
			    (>> y poly-output (*path `((nth ,i) side-data-bus))
				side-pads pads))
	       ans))
	   (dotimes (i 9)
	     (push
	       (create-nect (>> y (*path `(left-external-bus
					    (left-external-bus
					      ,(- 36 (+ i 28)))))
				main-regs)
			    'right)
	       ans))
	   (setq-my nect-list ans)
	   (let ((start-y (>> x (*path '(left-external-bus (left-external-bus 0)))
			      main-regs)))
	     (partq nect-wirer nect-wirer
		    (nect-list ans)
		    (start-y 0)
		    (end-y (- start-y
			      (>> x poly-output (*path '((nth 0) side-data-bus))
				  side-pads pads)))
		    (first-track-y (- start-y
				      (- (>> apparent-left main-regs)
					 *metal-spacing*
					 1)))
		    (left-x (>> apparent-bottom to-bottom-pads-start gnd-wiring))
		    (right-x (- (>> apparent-bottom over-top-gnd gnd-wiring) 15)))
	   (rot90 (>> nect-wirer))
	   (align (>> nect-wirer)
		  (>> first-start-pt nect-wirer)
		  (>> (*path `(left-external-bus
				(left-external-bus 0))) main-regs))
	   (let ((ypos (+ (>> apparent-top (*rep 3) rep bottom-pads pads)
			  (* 5 *metal-pitch*)
			  *metal-spacing*))
		 (first-x (>> x left-end-pt nect-wirer))
		 (first-y (>> y left-end-pt nect-wirer))
		 (end-y (>> y poly-output
			    (*path '((nth 0) bottom-data-bus))
			    bottom-pads pads)))
	     (dotimes (i 6)
	       (let ((nect (nth (+ 31. i) (>> nect-list nect-wirer))))
		 (wire () (run-layer 'metal)
		       (from (pt (- first-x (* (nect-track nect) *metal-pitch*))
				 first-y))
		       (to-y (- ypos (* i *metal-pitch*)))
		       (to-x (>> poly-output
				 (*path `((nth ,i) bottom-data-bus))
				 bottom-pads pads))
		       (run-layer 'poly)
		       (to-y end-y)))))
	   (let ((ypos (- (>> apparent-bottom (*rep 3) rep top-pads pads)
			  *metal-spacing*))
		 (first-x (>> x right-end-pt nect-wirer))
		 (first-y (>> y right-end-pt nect-wirer))
		 (end-y (>> y poly-output
			    (*path '((nth 0) top-data-bus))
			    top-pads pads)))
	     (dotimes (i 9)
	       (wire () (run-layer 'metal)
		     (from (pt (- first-x (* (- 8 i) *metal-pitch*)) first-y))
		     (jump-over (>> over-top-gnd gnd-wiring) '+y)
		     (to-y (- ypos (* i *metal-pitch*)))
		     (to-x (>> poly-output
			       (*path `((nth ,(- 8 i)) top-data-bus))
			       top-pads pads))
		     (run-layer 'poly)
		     (to-y end-y)))
	     (wireq top-side-datum (run-layer 'metal)
		    (from (pt (- first-x (* 9 *metal-pitch*)) first-y))
		    (to-y (- (>> apparent-bottom over-top-gnd gnd-wiring)
			     *metal-spacing* 5))
		    (run-layer 'poly)
		    (run-width 4)
		    (+y 4)
		    (drop-contact)
		    (to-y (>> poly-output *rep-last rep side-pads pads))
		    (run-width 2)
		    (+x 1)
		    (to-x (>> poly-output *rep-last rep side-pads pads))))))))